hment of component parts to manufacturing and final assembly; and offering shipment delivery to distribution centers or end delivery points, as well as e-commerce fulfillment. This segment also offers dedicated transportation; transportation management and brokerage; e-commerce and last mile; and contract manufacturing and contract packaging. The company was founded in 1933 and is headquartered in Coral Gables, Florida.","employees":51600,"website":"https://www.ryder.com","country":"United States","city":"Coral Gables","officers":[{"name":"Mr. Robert E. Sanchez","title":"Executive Chair"},{"name":"Mr. John J. Diez CPA","title":"CEO & Director"},{"name":"Ms. Cristina A. Gallo-Aquino","title":"CFO, EVP & Principal Accounting Officer"}]},"sector_medians":{"fpe":17.65,"tpe":25.99,"ps":2.167,"pfcf":26.66,"peg":1.42,"pb":3.505,"ev_ebitda":14.96,"rev_growth":0.11,"eps_growth":0.176,"eps_growth_fwd":0.1478,"eps_growth_next":0.1459,"div_yield":0.0066,"roe":0.149,"roa":0.05825,"de":66.95,"gross_margin":0.3185,"op_margin":0.1262,"profit_margin":0.0723,"current_ratio":1.665},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.2,"sector":17.65,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":20.99,"sector":25.99,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":0.8052,"sector":2.167,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":6.863,"sector":26.66,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.86,"sector":1.42,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":3.538,"sector":3.505,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":274.7,"sector":66.95,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.083,"sector":0.11,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.255,"sector":0.176,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.156,"sector":0.1478,"verdict":"In line"},{"k":"eps_growth_next","label":"E