h various forms of employee-paid and employer-paid plans. Its Retirement Plan Services segment provides employers with retirement plan products and services primarily in the defined contribution retirement plan marketplace; individual and group variable annuities, group fixed annuities, and mutual fund-based programs; and various plan services, including plan recordkeeping, compliance testing, participant education, and trust and custodial services. It distributes its products through consultants, brokers, planners, agents, financial advisors, third-party administrators, financial institutions, and other intermediaries. Lincoln National Corporation was founded in 1905 and is headquartered in Radnor, Pennsylvania.","employees":9423,"website":"https://www.lincolnfinancial.com","country":"United States","city":"Radnor","officers":[{"name":"Ms. Ellen R. Gail Cooper C.F.A., F.S.A.","title":"Chairman, President & CEO"},{"name":"Mr. Sean Nigel Woodroffe","title":"Executive VP and Chief People, Communications & Enterprise Services Officer"},{"name":"Mr. James Waltman Reid","title":"Executive VP & President of Workplace Solutions"}]},"sector_medians":{"fpe":10.53,"tpe":12.77,"ps":3.425,"pfcf":12.43,"peg":1.32,"pb":1.618,"ev_ebitda":10.75,"rev_growth":0.1,"eps_growth":0.152,"eps_growth_fwd":0.1315,"eps_growth_next":0.1087,"div_yield":0.0217,"roe":0.1279,"roa":0.01565,"de":53.89,"gross_margin":0.2437,"op_margin":0.326,"profit_margin":0.2552,"current_ratio":1.531},"valuation":[{"k":"fpe","label":"Forward P/E","v":4.751,"sector":10.53,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":3.533,"sector":12.77,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.4086,"sector":3.425,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":3.829,"sector":12.43,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.01,"sector":1.32,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":0.7646,"sector":1.618,"verdict":"Undervalued"},{"k":"de","label":"Deb