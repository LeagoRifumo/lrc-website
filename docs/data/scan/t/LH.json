ns for providers, MCOs, and ACOs; online and mobile applications that enable patients to check offerings, schedule PSC visits, check-in upon PSC arrival, complete documentation, access tests and test results, and manage their accounts; and Generative AI enabled Test Selection, a generative AI enabled tool. It serves clients, third party, medicare/medicaid, patients, pharmaceutical, biotechnology, medical device, diagnostic companies, and CROs. It has a collaboration with the Children's Hospital of Philadelphia to accelerate the discovery, development, and availability of pediatric diagnostics. The company was founded in 1995 and is headquartered in Burlington, North Carolina.","employees":71000,"website":"https://www.labcorp.com","country":"United States","city":"Burlington","officers":[{"name":"Mr. Adam H. Schechter","title":"President, CEO & Chairman"},{"name":"Ms. Julia A.  Wang","title":"Executive VP & CFO"},{"name":"Dr. Brian J. Caveney J.D., M.D., M.P.H.","title":"Exec VP, President of Biopharma Laboratory Services & Chief Medical and Scientific Officer"}]},"sector_medians":{"fpe":18.61,"tpe":33.93,"ps":3.635,"pfcf":28.33,"peg":1.535,"pb":4.049,"ev_ebitda":15.63,"rev_growth":0.069,"eps_growth":0.163,"eps_growth_fwd":0.0996,"eps_growth_next":0.0961,"div_yield":0.0041,"roe":0.1375,"roa":0.06451,"de":69.17,"gross_margin":0.5591,"op_margin":0.2013,"profit_margin":0.09747,"current_ratio":1.466},"valuation":[{"k":"fpe","label":"Forward P/E","v":18.92,"sector":18.61,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":30.4,"sector":33.93,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":2.063,"sector":3.635,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":28.49,"sector":28.33,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":1.64,"sector":1.535,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":3.404,"sector":4.049,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":77.25,"sector":69.17,"verdict"