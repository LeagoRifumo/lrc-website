nown as Allmerica Financial Corp. and changed its name to The Hanover Insurance Group, Inc. in December 2005. The Hanover Insurance Group, Inc. was founded in 1852 and is headquartered in Worcester, Massachusetts.","employees":4900,"website":"https://www.hanover.com","country":"United States","city":"Worcester","officers":[{"name":"Mr. John Conner Roche","title":"President, CEO & Director"},{"name":"Mr. Jeffrey Mark Farber","title":"Executive VP & CFO"},{"name":"Mr. Richard William Lavey","title":"Executive VP & COO"}]},"sector_medians":{"fpe":10.61,"tpe":12.66,"ps":3.475,"pfcf":11.64,"peg":1.31,"pb":1.605,"ev_ebitda":10.53,"rev_growth":0.106,"eps_growth":0.16,"eps_growth_fwd":0.1329,"eps_growth_next":0.1099,"div_yield":0.02175,"roe":0.1268,"roa":0.01564,"de":54.45,"gross_margin":0.2391,"op_margin":0.3554,"profit_margin":0.2541,"current_ratio":1.509},"valuation":[{"k":"fpe","label":"Forward P/E","v":12.01,"sector":10.61,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":11.29,"sector":12.66,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.214,"sector":3.475,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":7.595,"sector":11.64,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.34,"sector":1.31,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":2.241,"sector":1.605,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":22.98,"sector":54.45,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.043,"sector":0.106,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.249,"sector":0.16,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.079,"sector":0.1329,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":-0.0465,"sector":0.1099,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.2519,"sector":0.2391,"verdict":"In line"},{"k":"op_margin","label":"Operating margin","v":0.1475,"secto