 for seeking alternative products and provide product comparisons; and other lending as a service that offers pre-qualified borrower referrals and offers loans to third-party partner. The company was founded in 2011 and is based in San Francisco, California.","employees":6100,"website":"https://www.sofi.com","country":"United States","city":"San Francisco","officers":[{"name":"Mr. George Thompson Hutton","title":"Independent Non Executive Chairman"},{"name":"Mr. Anthony J. Noto","title":"CEO & Director"},{"name":"Mr. Christopher  Lapointe","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":10.61,"tpe":12.89,"ps":3.433,"pfcf":12.03,"peg":1.3,"pb":1.609,"ev_ebitda":10.69,"rev_growth":0.109,"eps_growth":0.153,"eps_growth_fwd":0.1337,"eps_growth_next":0.1104,"div_yield":0.0215,"roe":0.1283,"roa":0.01521,"de":54.95,"gross_margin":0.2245,"op_margin":0.3601,"profit_margin":0.2534,"current_ratio":1.509},"valuation":[{"k":"fpe","label":"Forward P/E","v":18.74,"sector":10.61,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":29.82,"sector":12.89,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":4.52,"sector":3.433,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":12.03,"verdict":"—"},{"k":"peg","label":"PEG","v":0.51,"sector":1.3,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.986,"sector":1.609,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":35.23,"sector":54.95,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.439,"sector":0.109,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.64,"sector":0.153,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.6013,"sector":0.1337,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.4595,"sector":0.1104,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.8415,"sector":0.2245,"verdict":"Strong"},{"k":"op_margin",