ali Therapeutics Inc.; UCB; Eisai Co., Ltd.; Genentech, Inc.; Neurimmune SubOne AG; Ionis Pharmaceuticals, Inc.; Samsung Bioepis; and Sage Therapeutics, Inc., as well as collaborations with Stoke Therapeutics, Inc. for the development and commercialization of zorevunersen, a disease modifying medicine for the treatment of Dravet syndrome; Dayra Therapeutics, Inc. to develop oral macrocyclic peptides; Vanqua Bio, Inc. for developing Vanqua's preclinical oral C5aR1 antagonist compound; City Therapeutics, Inc. to develop select novel RNAi therapies; and ALTEOGEN Inc. to develop subcutaneous (SC) formulations of biologics utilizing ALT-B4. The company was founded in 1978 and is headquartered in Cambridge, Massachusetts.","employees":7500,"website":"https://www.biogen.com","country":"United States","city":"Cambridge","officers":[{"name":"Mr. Christopher A. Viehbacher","title":"President, CEO & Director"},{"name":"Ms. Robin C. Kramer","title":"Executive VP & CFO"},{"name":"Ms. Nicole  Murphy","title":"Executive VP and Head of Pharmaceutical Operations & Technology"}]},"sector_medians":{"fpe":18.94,"tpe":30.13,"ps":4.427,"pfcf":28.89,"peg":1.335,"pb":4.543,"ev_ebitda":16.87,"rev_growth":0.102,"eps_growth":0.167,"eps_growth_fwd":0.0901,"eps_growth_next":0.1184,"div_yield":0,"roe":-0.00633,"roa":0.01963,"de":37.14,"gross_margin":0.5204,"op_margin":0.03842,"profit_margin":0,"current_ratio":3.161},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.37,"sector":18.94,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":44.89,"sector":30.13,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":3.724,"sector":4.427,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":29.47,"sector":28.89,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":2.61,"sector":1.335,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.98,"sector":4.543,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":44.33,"sector":37.14,"verdict":"In line"},{"k