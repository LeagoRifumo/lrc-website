ch as credit card and electronic transfer; learning management system; an integrated commerce payment platform; and a school management platform that provides administrative, information and financial management, and communication functions for K-12 schools. The Asset Generation and Management segment invest, allocates an manages loan assts. The Nelnet Bank segment operates as an internet industrial bank. It also offers investment advisory, investment, and reinsurance services, as well as engages in the real estate investment; and solar engineering, procurement, and construction businesses. The company was founded in 1977 and is headquartered in Lincoln, Nebraska.","employees":5744,"website":"https://www.nelnet.com","country":"United States","city":"Lincoln","officers":[{"name":"Mr. Michael Sullivan Dunlap J.D.","title":"Executive Chairman of the Board"},{"name":"Mr. Jeffrey R. Noordhoek","title":"Chief Executive Officer"},{"name":"Mr. James D. Kruger CPA","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":10.78,"tpe":12.58,"ps":3.482,"pfcf":11.55,"peg":1.31,"pb":1.595,"ev_ebitda":11.14,"rev_growth":0.088,"eps_growth":0.1195,"eps_growth_fwd":0.1346,"eps_growth_next":0.1035,"div_yield":0.022,"roe":0.1288,"roa":0.01563,"de":54.51,"gross_margin":0.2344,"op_margin":0.3725,"profit_margin":0.2565,"current_ratio":1.507},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.14,"sector":10.78,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":17.53,"sector":12.58,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":3.235,"sector":3.482,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":11.55,"verdict":"—"},{"k":"peg","label":"PEG","v":0.46,"sector":1.31,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.239,"sector":1.595,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":187.3,"sector":54.51,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.108,"sector":0.088,"verdict":"W