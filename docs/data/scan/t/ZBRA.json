eractive touchscreen displays; workflow optimization solutions, such as workforce management, workflow execution and task management, and prescriptive analytics, and communications and collaboration solutions; and cloud-based software. The company serves retail and e-commerce, manufacturing, transportation and logistics, healthcare, public sector, and other industries through direct sales force and network of channel partners. The company was founded in 1969 and is headquartered in Lincolnshire, Illinois.","employees":10700,"website":"https://www.zebra.com","country":"United States","city":"Lincolnshire","officers":[{"name":"Mr. William J. Burns","title":"CEO & Director"},{"name":"Mr. Nathan Andrew Winters","title":"Chief Financial Officer"},{"name":"Ms. Cristen L. Kogl J.D.","title":"Chief Legal Officer, General Counsel & Corporate Secretary"}]},"sector_medians":{"fpe":17.95,"tpe":32.6,"ps":6.454,"pfcf":32.35,"peg":0.98,"pb":7.747,"rev_growth":0.2175,"eps_growth":0.464,"eps_growth_fwd":0.2596,"eps_growth_next":0.1939,"div_yield":0.00115,"roe":0.2326,"roa":0.07978,"de":48.45,"gross_margin":0.586,"op_margin":0.2256,"profit_margin":0.1916,"current_ratio":1.562},"valuation":[{"k":"fpe","label":"Forward P/E","v":17.38,"sector":17.95,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":35.52,"sector":32.6,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":3.135,"sector":6.454,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":31.78,"sector":32.35,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":0.62,"sector":0.98,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":5.346,"sector":7.747,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":86.23,"sector":48.45,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.204,"sector":0.2175,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":1.215,"sector":0.464,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth 