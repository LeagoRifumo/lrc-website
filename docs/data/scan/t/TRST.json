gage-backed securities. In addition, it operates as the executor of estates and trustee of personal trusts; provides asset and wealth management, estate planning and related advice, and custodial services; and acts as trustee for various types of employee benefit plans, and corporate pension and profit-sharing trusts. The company operates through banking offices in Albany, Columbia, Dutchess, Greene, Montgomery, Orange, Putnam, Rensselaer, Rockland, Saratoga, Schenectady, Schoharie, Ulster, Warren, Washington, and Westchester counties of New York; Brevard, Charlotte, Flagler, Hillsborough, Indian River, Lake, Manatee, Martin, Orange, Osceola, Palm Beach, Polk, Sarasota, Seminole, and Volusia counties in Florida; Bennington County in Vermont; Berkshire County in Massachusetts; and Bergen County in New Jersey, as well as automatic teller machines. TrustCo Bank Corp NY was founded in 1902 and is headquartered in Glenville, New York.","employees":740,"website":"https://www.trustcobank.com","country":"United States","city":"Glenville","officers":[{"name":"Mr. Robert Joseph McCormick","title":"President, CEO & Chairman of the Board"},{"name":"Mr. Michael M. Ozimek","title":"Executive VP & CFO"},{"name":"Mr. Robert Michael Leonard","title":"Executive VP & COO"}]},"sector_medians":{"fpe":10.55,"tpe":12.85,"ps":3.439,"pfcf":12.0,"peg":1.33,"pb":1.598,"ev_ebitda":10.91,"rev_growth":0.094,"eps_growth":0.141,"eps_growth_fwd":0.1342,"eps_growth_next":0.1041,"div_yield":0.0221,"roe":0.1285,"roa":0.01563,"de":54.12,"gross_margin":0.2252,"op_margin":0.3579,"profit_margin":0.2565,"current_ratio":1.519},"valuation":[{"k":"fpe","label":"Forward P/E","v":20.0,"sector":10.55,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":15.43,"sector":12.85,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":4.931,"sector":3.439,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":12.0,"verdict":"—"},{"k":"peg","label":"PEG","v":0.63,"sector":1.33,"verdict"