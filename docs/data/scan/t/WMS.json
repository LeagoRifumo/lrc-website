 drains, catch basins, grates, access boxes, and accessories engineered to capture, convey, and disperse stormwater. It offers its products for non-residential, residential, agriculture, and infrastructure applications through a network of distribution centers. Advanced Drainage Systems, Inc. was incorporated in 1966 and is headquartered in Hilliard, Ohio.","employees":6425,"website":"https://www.adspipe.com","country":"United States","city":"Hilliard","officers":[{"name":"Mr. Donald Scott Barbour","title":"CEO, President & Director"},{"name":"Mr. Scott A. Cottrill","title":"Executive VP, CFO, Secretary & Treasurer"},{"name":"Mr. Kevin C. Talley","title":"Executive VP & Chief Administrative Officer"}]},"sector_medians":{"fpe":17.94,"tpe":26.67,"ps":2.183,"pfcf":27.09,"peg":1.39,"pb":3.569,"ev_ebitda":15.27,"rev_growth":0.1115,"eps_growth":0.205,"eps_growth_fwd":0.156,"eps_growth_next":0.1459,"div_yield":0.0067,"roe":0.1485,"roa":0.05825,"de":66.55,"gross_margin":0.3184,"op_margin":0.1215,"profit_margin":0.07337,"current_ratio":1.672},"valuation":[{"k":"fpe","label":"Forward P/E","v":18.43,"sector":17.94,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":23.07,"sector":26.67,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":3.168,"sector":2.183,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":31.18,"sector":27.09,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":1.24,"sector":1.39,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":5.387,"sector":3.569,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":97.19,"sector":66.55,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.206,"sector":0.1115,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.188,"sector":0.205,"verdict":"In line"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0032,"sector":0.156,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v