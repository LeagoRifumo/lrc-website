 support payments between key stakeholders. The company serves owners, general contractors, and specialty contractors operating in the residential and non-residential segments of the construction industry. The company sells its products online through computers, smartphones, tablets, web browser, and mobile application available for iOS and Android platforms. Procore Technologies, Inc. was formerly known as Butterfly Lane, Inc and changed its name to Procore Technologies, Inc. in May 2002. The company was incorporated in 2002 and is headquartered in Carpinteria, California.","employees":4421,"website":"https://www.procore.com","country":"United States","city":"Carpinteria","officers":[{"name":"Mr. Craig F. Courtemanche Jr.","title":"Founder & Chairman"},{"name":"Dr. Ajei S. Gopal Ph.D.","title":"President, CEO & Director"},{"name":"Mr. Steven S. Davis","title":"President of Product & Technology"}]},"sector_medians":{"fpe":17.75,"tpe":31.18,"ps":4.533,"pfcf":26.99,"peg":1.15,"pb":4.787,"ev_ebitda":19.58,"rev_growth":0.1835,"eps_growth":0.3615,"eps_growth_fwd":0.2378,"eps_growth_next":0.1867,"div_yield":0,"roe":0.1242,"roa":0.04768,"de":30.66,"gross_margin":0.529,"op_margin":0.128,"profit_margin":0.0934,"current_ratio":1.814},"valuation":[{"k":"fpe","label":"Forward P/E","v":26.05,"sector":17.75,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":31.18,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":6.748,"sector":4.533,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":31.5,"sector":26.99,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":null,"sector":1.15,"verdict":"—"},{"k":"pb","label":"Price / Book","v":7.505,"sector":4.787,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":5.282,"sector":30.66,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.158,"sector":0.1835,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.3615,"verdict":"—"},{"