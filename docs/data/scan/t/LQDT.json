99 and is headquartered in Bethesda, Maryland.","employees":818,"website":"https://liquidityservices.com","country":"United States","city":"Bethesda","officers":[{"name":"Mr. William Paul Angrick III","title":"Co-founder, Chairman of the Board of Directors & CEO"},{"name":"Mr. Jaime  Mateus-Tique","title":"Co-Founder & Director"},{"name":"Mr. Jorge A. Celaya","title":"Executive VP & CFO"}]},"sector_medians":{"fpe":14.48,"tpe":18.56,"ps":1.228,"pfcf":19.7,"peg":1.13,"pb":2.98,"ev_ebitda":11.61,"rev_growth":0.056,"eps_growth":0.141,"eps_growth_fwd":0.1068,"eps_growth_next":0.125,"div_yield":0.0073,"roe":0.1572,"roa":0.06132,"de":101.4,"gross_margin":0.3819,"op_margin":0.09437,"profit_margin":0.0572,"current_ratio":1.452},"valuation":[{"k":"fpe","label":"Forward P/E","v":24.35,"sector":14.48,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":43.92,"sector":18.56,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":2.867,"sector":1.228,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":17.14,"sector":19.7,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":1.02,"sector":1.13,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":5.95,"sector":2.98,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":5.869,"sector":101.4,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.081,"sector":0.056,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.391,"sector":0.141,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2891,"sector":0.1068,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1152,"sector":0.125,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0.4763,"sector":0.3819,"verdict":"In line"},{"k":"op_margin","label":"Operating margin","v":0.1084,"sector":0.09437,"verdict":"In line"},{"k":"profit_margin","label":"Net margin","v":0.06793,"sector":0.0572,"verdict":"In line"},{"k":"roe"