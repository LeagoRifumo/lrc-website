ustry; high pressure and ultra-high-pressure valves used in the oil and natural gas industry; and environmental monitoring and remediation equipment that is used to conduct ground water sampling, ground water remediation, and for landfill liquid and gas management. Graco Inc. was incorporated in 1926 and is headquartered in Minneapolis, Minnesota.","employees":4400,"website":"https://www.graco.com","country":"United States","city":"Minneapolis","officers":[{"name":"Mr. Mark W. Sheahan J.D.","title":"President, CEO & Director"},{"name":"Ms. Angela F. Wordell","title":"Executive VP & Chief Operations and Supply Chain Officer"},{"name":"Ms. Ronita  Banerjee","title":"Executive VP & Chief Human Resources Officer"}]},"sector_medians":{"fpe":17.91,"tpe":25.6,"ps":2.127,"pfcf":27.13,"peg":1.41,"pb":3.619,"ev_ebitda":14.59,"rev_growth":0.119,"eps_growth":0.176,"eps_growth_fwd":0.1619,"eps_growth_next":0.1433,"div_yield":0.0071,"roe":0.1451,"roa":0.05694,"de":67.22,"gross_margin":0.3203,"op_margin":0.1163,"profit_margin":0.07298,"current_ratio":1.741},"valuation":[{"k":"fpe","label":"Forward P/E","v":20.99,"sector":17.91,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":23.42,"sector":25.6,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":5.04,"sector":2.127,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":27.16,"sector":27.13,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":2.19,"sector":1.41,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":4.714,"sector":3.619,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":6.667,"sector":67.22,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.079,"sector":0.119,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.085,"sector":0.176,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0953,"sector":0.1619,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v"