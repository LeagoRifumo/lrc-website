cluding kitchen and bath dealers; wholesalers oriented toward builders or professional remodelers; industrial and locksmith distributors; do-it-yourself remodeling-oriented home centers; showrooms; e-commerce; and other retail outlets. Fortune Brands Innovations, Inc. was incorporated in 1988 and is headquartered in Deerfield, Illinois.","employees":10000,"website":"https://www.fbin.com","country":"United States","city":"Deerfield","officers":[{"name":"Ms. Kristin E. Papesh","title":"Executive VP & Chief HR Officer"},{"name":"Mr. Dong Gu  Lee","title":"Executive VP, Chief Digital & Innovation Officer"},{"name":"Mr. David V. Barry","title":"Executive VP & President of Moen"}]},"sector_medians":{"fpe":18.2,"tpe":26.2,"ps":2.178,"pfcf":28.05,"peg":1.44,"pb":3.574,"ev_ebitda":15.02,"rev_growth":0.118,"eps_growth":0.173,"eps_growth_fwd":0.1561,"eps_growth_next":0.1435,"div_yield":0.0069,"roe":0.1453,"roa":0.05787,"de":67.05,"gross_margin":0.3185,"op_margin":0.1262,"profit_margin":0.07405,"current_ratio":1.701},"valuation":[{"k":"fpe","label":"Forward P/E","v":13.64,"sector":18.2,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":36.33,"sector":26.2,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":1.222,"sector":2.178,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":17.94,"sector":28.05,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.72,"sector":1.44,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":2.325,"sector":3.574,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":121.3,"sector":67.05,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.041,"sector":0.118,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.173,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0752,"sector":0.1561,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":-0.0106,"sector":0.1435,"verdict":"Weak"}