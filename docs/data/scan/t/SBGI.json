 syndicators, local news, sports, and other original programming. The company was founded in 1971 and is headquartered in Hunt Valley, Maryland.","employees":7100,"website":"https://sbgi.net","country":"United States","city":"Hunt Valley","officers":[{"name":"Mr. David D. Smith","title":"Executive Chairman of the Board"},{"name":"Mr. Christopher S. Ripley","title":"President & CEO"},{"name":"Mr. Narinder K. Sahai","title":"Executive VP & CFO"}]},"sector_medians":{"fpe":11.84,"tpe":19.34,"ps":2.047,"pfcf":12.05,"peg":0.99,"pb":2.201,"ev_ebitda":13.03,"rev_growth":0.083,"eps_growth":-0.02,"eps_growth_fwd":0.1475,"eps_growth_next":0.1456,"div_yield":0,"roe":0.09516,"roa":0.04078,"de":59.88,"gross_margin":0.5655,"op_margin":0.1254,"profit_margin":0.08615,"current_ratio":1.257},"valuation":[{"k":"fpe","label":"Forward P/E","v":-1,"sector":11.84,"verdict":"Loss-making"},{"k":"tpe","label":"TTM P/E","v":10.12,"sector":19.34,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.3147,"sector":2.047,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":4.308,"sector":12.05,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.37,"sector":0.99,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":2.23,"sector":2.201,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":1379.0,"sector":59.88,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.071,"sector":0.083,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":-0.02,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":1.21,"sector":0.1475,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":-5.912,"sector":0.1456,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.4542,"sector":0.5655,"verdict":"In line"},{"k":"op_margin","label":"Operating margin","v":0.06548,"sector":0.1254,"verdict":"Weak"},{"k":"profit_margin","label":"Net margin","v":0.01597,