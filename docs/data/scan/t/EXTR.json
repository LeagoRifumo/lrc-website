 original equipment manufacturers, strategic relationships, distributors, resellers, and field sales. The company serves mid-market and enterprise customers, and services providers. Extreme Networks, Inc., was incorporated in 1996 and is headquartered in Morrisville, North Carolina.","employees":2894,"website":"https://www.extremenetworks.com","country":"United States","city":"Morrisville","officers":[{"name":"Mr. Edward B. Meyercord III","title":"President, CEO & Executive Director"},{"name":"Mr. Kevin  Rhodes","title":"Executive VP of Finance & CFO"},{"name":"Ms. Katayoun  Motiey J.D.","title":"EVP, Chief Legal, Administrative & Sustainability Officer, Corporate Secretary and General Counsel"}]},"sector_medians":{"fpe":17.36,"tpe":29.57,"ps":4.323,"pfcf":25.98,"peg":1.09,"pb":4.666,"ev_ebitda":19.21,"rev_growth":0.185,"eps_growth":0.3665,"eps_growth_fwd":0.2411,"eps_growth_next":0.1798,"div_yield":0,"roe":0.125,"roa":0.04945,"de":32.75,"gross_margin":0.5312,"op_margin":0.1357,"profit_margin":0.09441,"current_ratio":1.873},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":17.36,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":65.64,"sector":29.57,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":2.555,"sector":4.323,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":23.16,"sector":25.98,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":0.86,"sector":1.09,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":38.44,"sector":4.666,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":259.4,"sector":32.75,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.099,"sector":0.185,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":2.0,"sector":0.3665,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2907,"sector":0.2411,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1431,"sector":0.1798,"ve