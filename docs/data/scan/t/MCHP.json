es to foundries, integrated device manufacturers, and design partners for use in the manufacture of microcontroller products, gate arrays, RF, analog, and neuromorphic compute products. Additionally, the company offers engineering services; wafer foundry, assembly, and test subcontracting manufacturing services; and timing systems, application-specific integrated circuits, and products for aerospace applications. The company was incorporated in 1989 and is headquartered in Chandler, Arizona.","employees":17900,"website":"https://www.microchip.com","country":"United States","city":"Chandler","officers":[{"name":"Mr. Stephen  Sanghi","title":"CEO, President & Chair of the Board"},{"name":"Mr. James Eric Bjornholt","title":"Senior Corporate Vice President & CFO"},{"name":"Mr. Mathew B. Bunker","title":"Senior Corporate Vice President of Operations"}]},"sector_medians":{"fpe":17.95,"tpe":32.6,"ps":6.454,"pfcf":32.35,"peg":0.98,"pb":7.747,"rev_growth":0.2175,"eps_growth":0.464,"eps_growth_fwd":0.2596,"eps_growth_next":0.1939,"div_yield":0.00115,"roe":0.2326,"roa":0.07978,"de":48.45,"gross_margin":0.586,"op_margin":0.2256,"profit_margin":0.1916,"current_ratio":1.562},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":17.95,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":111.0,"sector":32.6,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":7.998,"sector":6.454,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":30.02,"sector":32.35,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":0.22,"sector":0.98,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":6.351,"sector":7.747,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":83.69,"sector":48.45,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.38,"sector":0.2175,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.464,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)"