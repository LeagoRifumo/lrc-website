ction antennas, as well as design products for manpacks, aircraft, unmanned aerial vehicles, seagoing vessels, ground-mobile vehicles, space-based systems, and fixed applications. Further, the company designs and develops GEO, LEO, and MEO satellites, payload, antenna technologies, and other small satellite platforms; develops commercial communication satellite product, orchestration of sovereign and multi-orbit solutions, and direct-to-device; and licenses intellectual property. Viasat, Inc. was incorporated in 1986 and is headquartered in Carlsbad, California.","employees":7000,"website":"https://www.viasat.com","country":"United States","city":"Carlsbad","officers":[{"name":"Mr. Mark D. Dankberg","title":"Co-Founder, Chairman & CEO"},{"name":"Mr. Garrett L. Chase","title":"Senior VP & CFO"},{"name":"Mr. Girish  Chandran","title":"Corporate Chief Technology Officer & Senior VP of Engineering"}]},"sector_medians":{"fpe":17.48,"tpe":30.05,"ps":4.43,"pfcf":25.99,"peg":1.11,"pb":4.647,"ev_ebitda":18.95,"rev_growth":0.191,"eps_growth":0.356,"eps_growth_fwd":0.2432,"eps_growth_next":0.1809,"div_yield":0,"roe":0.1241,"roa":0.04945,"de":32.8,"gross_margin":0.5312,"op_margin":0.1174,"profit_margin":0.09364,"current_ratio":1.863},"valuation":[{"k":"fpe","label":"Forward P/E","v":-1,"sector":17.48,"verdict":"Loss-making"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":30.05,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":2.163,"sector":4.43,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":47.53,"sector":25.99,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":0.26,"sector":1.11,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":2.239,"sector":4.647,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":150.9,"sector":32.8,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.034,"sector":0.191,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.356,"verdict":"—"},{"