fice, restaurants, and other business; and wireless communications service. The Pandora and Off-platform segment operates music, comedy, and podcast streaming platform, which offers personalized experience for listener through mobile devices, vehicle speakers, and connected devices; and provides advertising services. The company was incorporated in 2013 and is headquartered in New York, New York.","employees":5119,"website":"https://www.siriusxm.com","country":"United States","city":"New York","officers":[{"name":"Ms. Jennifer C. Witz","title":"CEO & Director"},{"name":"Mr. Scott A. Greenstein","title":"President & Chief Content Officer"},{"name":"Mr. Zachary James Coughlin","title":"CFO & Executive VP"}]},"sector_medians":{"fpe":12.51,"tpe":19.35,"ps":2.16,"pfcf":13.63,"peg":1.09,"pb":2.208,"ev_ebitda":13.54,"rev_growth":0.0805,"eps_growth":0.053,"eps_growth_fwd":0.1456,"eps_growth_next":0.1477,"div_yield":0,"roe":0.0878,"roa":0.04007,"de":64.06,"gross_margin":0.5713,"op_margin":0.1332,"profit_margin":0.06819,"current_ratio":1.257},"valuation":[{"k":"fpe","label":"Forward P/E","v":8.555,"sector":12.51,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":11.3,"sector":19.35,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.108,"sector":2.16,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":8.036,"sector":13.63,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.09,"sector":1.09,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":0.8002,"sector":2.208,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":81.11,"sector":64.06,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.01,"sector":0.0805,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.237,"sector":0.053,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0783,"sector":0.1456,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1025