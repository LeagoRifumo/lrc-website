 electric wall-hung, gas tankless, combi-boiler, and heat pump and solar water heaters. The company offers its products under the A. O. Smith, State, Lochinvar, Hague, Water-Right, Master Water, Atlantic Filter, Impact, and Water Tec brands. It distributes its products through independent wholesale plumbing distributors, as well as to retail channels consisting of hardware and home center chains, and manufacturer representative firms, as well as offers Aquasana branded products directly to consumers through e-commerce channels; and A. O. Smith branded water treatment products through dealer network and Amazon. A. O. Smith Corporation was founded in 1874 and is headquartered in Milwaukee, Wisconsin.","employees":11500,"website":"https://www.aosmith.com","country":"United States","city":"Milwaukee","officers":[{"name":"Mr. Stephen M. Shafer","title":"President, CEO & Chairman"},{"name":"Mr. Ming  Cheng Ph.D.","title":"Senior VP & CTO"},{"name":"Mr. Christopher T. Howe","title":"Senior VP & Chief Digital Information Officer"}]},"sector_medians":{"fpe":20.36,"tpe":27.47,"ps":3.42,"pfcf":30.39,"peg":1.56,"pb":6.084,"rev_growth":0.097,"eps_growth":0.13,"eps_growth_fwd":0.1265,"eps_growth_next":0.1335,"div_yield":0.0115,"roe":0.204,"roa":0.07231,"de":70.14,"gross_margin":0.3678,"op_margin":0.1746,"profit_margin":0.1184,"current_ratio":1.328},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.29,"sector":20.36,"score":1,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":17.17,"sector":27.47,"score":1,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":2.202,"sector":3.42,"score":1,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":17.29,"sector":30.39,"score":1,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.48,"sector":1.56,"score":null,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":4.549,"sector":6.084,"score":null,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":36.77,"sector":70.14,"score":1,"ver