AT-2 Earth observation satellite; and is involved in the operation of MDA CHORUS, an Earth observation mission. It serves governments and space agencies, commercial space companies, and defense and aerospace prime contractors in the space industry. The company was formerly known as MDA Ltd. and changed its name to MDA Space Ltd. in May 2024. MDA Space Ltd. was incorporated in 1969 and is headquartered in Brampton, Canada.","employees":4000,"website":"https://mda.space","country":"Canada","city":"Brampton","officers":[{"name":"Mr. Michael  Greenley M.sc. Pmp","title":"CEO & Director"},{"name":"Mr. Guillaume  Lavoie","title":"Chief Financial Officer"},{"name":"Ms. Stephanie  McDonald","title":"Chief People, Culture & Transformation Officer"}]},"sector_medians":{"fpe":18.04,"tpe":25.65,"ps":2.129,"pfcf":27.29,"peg":1.42,"pb":3.604,"ev_ebitda":14.61,"rev_growth":0.119,"eps_growth":0.1745,"eps_growth_fwd":0.156,"eps_growth_next":0.1437,"div_yield":0.007,"roe":0.1435,"roa":0.05694,"de":67.83,"gross_margin":0.319,"op_margin":0.1176,"profit_margin":0.0714,"current_ratio":1.724},"valuation":[{"k":"fpe","label":"Forward P/E","v":22.45,"sector":18.04,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":52.71,"sector":25.65,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":null,"sector":2.129,"verdict":"—"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":27.29,"verdict":"—"},{"k":"peg","label":"PEG","v":null,"sector":1.42,"verdict":"—"},{"k":"pb","label":"Price / Book","v":2.202,"sector":3.604,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":31.46,"sector":67.83,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.215,"sector":0.119,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.095,"sector":0.1745,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0157,"sector":0.156,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":