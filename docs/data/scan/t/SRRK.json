euromuscular diseases. Scholar Rock Holding Corporation was founded in 2012 and is headquartered in Cambridge, Massachusetts.","employees":289,"website":"https://www.scholarrock.com","country":"United States","city":"Cambridge","officers":[{"name":"Mr. David L. Hallal","title":"CEO & Chairman of the Board"},{"name":"Mr. Vikas  Sinha C.A., CPA, M.B.A.","title":"CFO & Treasurer"},{"name":"Mr. Robert Keith Woods","title":"Chief Operating Officer"}]},"sector_medians":{"fpe":18.94,"tpe":29.89,"ps":4.234,"pfcf":27.7,"peg":1.36,"pb":4.405,"ev_ebitda":16.87,"rev_growth":0.098,"eps_growth":0.154,"eps_growth_fwd":0.09245,"eps_growth_next":0.1086,"div_yield":0,"roe":0.02656,"roa":0.02401,"de":42.77,"gross_margin":0.515,"op_margin":0.04562,"profit_margin":0,"current_ratio":2.993},"valuation":[{"k":"fpe","label":"Forward P/E","v":-1,"sector":18.94,"verdict":"Loss-making"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":29.89,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":9418.0,"sector":4.234,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":27.7,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":null,"sector":1.36,"verdict":"—"},{"k":"pb","label":"Price / Book","v":31.81,"sector":4.405,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":120.3,"sector":42.77,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":null,"sector":0.098,"verdict":"—"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.154,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1316,"sector":0.09245,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1235,"sector":0.1086,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0,"sector":0.515,"verdict":"Weak"},{"k":"op_margin","label":"Operating margin","v":-717.3,"sector":0.04562,"verdict":"Weak"},{"k":"profit_margin","label":"Net margin","v":0,"sector":0,"verdict":"—"},{"k":"roe","lab