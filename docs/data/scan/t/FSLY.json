shing, and high tech to financial services industries. The company was formerly known as SkyCache, Inc. and changed its name to Fastly, Inc. in May 2012. Fastly, Inc. was incorporated in 2011 and is headquartered in San Francisco, California.","employees":1140,"website":"https://www.fastly.com","country":"United States","city":"San Francisco","officers":[{"name":"Mr. Charles  Compton","title":"CEO & Director"},{"name":"Mr. Artur  Bergman","title":"Founder, CTO & Director"},{"name":"Mr. Richard H. Wong","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":18.26,"tpe":31.4,"ps":4.764,"pfcf":26.86,"peg":1.15,"pb":4.974,"ev_ebitda":20.02,"rev_growth":0.17,"eps_growth":0.345,"eps_growth_fwd":0.2306,"eps_growth_next":0.1867,"div_yield":0,"roe":0.1243,"roa":0.04866,"de":29.26,"gross_margin":0.5169,"op_margin":0.1199,"profit_margin":0.08708,"current_ratio":1.825},"valuation":[{"k":"fpe","label":"Forward P/E","v":42.62,"sector":18.26,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":31.4,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":6.345,"sector":4.764,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":50.13,"sector":26.86,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":0.22,"sector":1.15,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":4.394,"sector":4.974,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":40.2,"sector":29.26,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.233,"sector":0.17,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.345,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":3.041,"sector":0.2306,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.2226,"sector":0.1867,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0.6147,"sector":0.5169,"verdict":"In line"},{"k":"op_margin","label":"Operating margin","v":-0.07873