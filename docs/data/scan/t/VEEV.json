 Quality Cloud, which is used by the life sciences and consumer products industries; and Veeva Business Consulting services. Further, it provides professional and support services, including implementation and deployment planning, and project management; requirements analysis, solution design, and configuration; systems environment management and deployment; services focused on advancing or transforming business and operating processes; technical consulting services on data migration and systems integrations; training; and ongoing managed services, such as outsourced systems administration. The company was formerly known as Verticals onDemand, Inc. and changed its name to Veeva Systems Inc. in April 2009. Veeva Systems Inc. was incorporated in 2007 and is headquartered in Pleasanton, California.","employees":7928,"website":"https://www.veeva.com","country":"United States","city":"Pleasanton","officers":[{"name":"Mr. Peter P. Gassner","title":"Founder, CEO & Director"},{"name":"Ms. Eleni Nitsa Zuppas","title":"President & Chief of Staff"},{"name":"Mr. Brian  Van Wagener","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":17.94,"tpe":29.9,"ps":3.694,"pfcf":27.47,"peg":1.37,"pb":3.644,"rev_growth":0.075,"eps_growth":0.171,"eps_growth_fwd":0.0972,"eps_growth_next":0.1015,"div_yield":0.0044,"roe":0.1442,"roa":0.06567,"de":68.79,"gross_margin":0.5566,"op_margin":0.1825,"profit_margin":0.098,"current_ratio":1.558},"valuation":[{"k":"fpe","label":"Forward P/E","v":31.51,"sector":17.94,"score":-1,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":52.96,"sector":29.9,"score":-1,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":15.12,"sector":3.694,"score":-1,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":41.59,"sector":27.47,"score":-1,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.25,"sector":1.37,"score":null,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":7.035,"sector":3.644,"score":null,"verdict":"Overval