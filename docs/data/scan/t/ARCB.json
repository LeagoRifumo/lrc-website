ean, and ground services. The company was formerly known as Arkansas Best Corporation and changed its name to ArcBest Corporation in May 2014. The company was founded in 1923 and is headquartered in Fort Smith, Arkansas.","employees":14000,"website":"https://arcb.com","country":"United States","city":"Fort Smith","officers":[{"name":"Mr. Seth K. Runser","title":"President, CEO & Director"},{"name":"Mr. J. Matthew Beasley","title":"Chief Financial Officer"},{"name":"Mr. Dennis L. Anderson II","title":"Chief Innovation Officer"}]},"sector_medians":{"fpe":17.93,"tpe":26.47,"ps":2.216,"pfcf":27.32,"peg":1.4,"pb":3.567,"ev_ebitda":15.2,"rev_growth":0.1115,"eps_growth":0.205,"eps_growth_fwd":0.156,"eps_growth_next":0.1459,"div_yield":0.0067,"roe":0.1485,"roa":0.05825,"de":66.55,"gross_margin":0.3184,"op_margin":0.1215,"profit_margin":0.07337,"current_ratio":1.672},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":17.93,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":183.2,"sector":26.47,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":0.6721,"sector":2.216,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":19.05,"sector":27.32,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.5,"sector":1.4,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":2.229,"sector":3.567,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":36.27,"sector":66.55,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.159,"sector":0.1115,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.205,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.9033,"sector":0.156,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.3578,"sector":0.1459,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.08097,"sector":0.3184,"verdict":"Weak"},{"k":"op_margin","label":"Operating margin","v":0.05429,"sector":0.121