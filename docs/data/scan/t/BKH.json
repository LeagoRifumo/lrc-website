s to residential utility customers; Tech Services, which include construction and maintenance of customer-owned gas infrastructure facilities, as well as electrical system construction services; and HomeServe, which are additional home repair service plans for natural gas residential customers. In addition, the company produces electric power through wind, natural gas, and coal-fired generating plants, as well as coal at its coal mine located near Gillette, Wyoming. Black Hills Corporation was incorporated in 1941 and is headquartered in Rapid City, South Dakota.","employees":2795,"website":"https://ir.blackhillscorp.com","country":"United States","city":"Rapid City","officers":[{"name":"Mr. Linden R. Evans J.D.","title":"President, CEO & Director"},{"name":"Ms. Kimberly F. Nooney","title":"Senior VP & CFO"},{"name":"Mr. Don L. Redden","title":"Senior VP and Chief Information & Transformation Officer"}]},"sector_medians":{"fpe":17.51,"tpe":21.36,"ps":2.884,"pfcf":26.33,"peg":2.3,"pb":1.915,"ev_ebitda":12.79,"rev_growth":0.048,"eps_growth":0.1165,"eps_growth_fwd":0.0725,"eps_growth_next":0.07765,"div_yield":0.0321,"roe":0.09439,"roa":0.02964,"de":146.8,"gross_margin":0.4409,"op_margin":0.2214,"profit_margin":0.1251,"current_ratio":0.802},"valuation":[{"k":"fpe","label":"Forward P/E","v":17.63,"sector":17.51,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":20.52,"sector":21.36,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":2.702,"sector":2.884,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":26.33,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":1.83,"sector":2.3,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.575,"sector":1.915,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":111.7,"sector":146.8,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.031,"sector":0.048,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.316,