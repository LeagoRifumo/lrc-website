m of electronic payment networks. It sells and distributes its services primarily through direct sales force. The company serves financial institutions, merchants, corporations, and government agencies. EVERTEC, Inc. was founded in 1988 and is headquartered in San Juan, Puerto Rico.","employees":5327,"website":"https://www.evertecinc.com","country":"United States","city":"San Juan","officers":[{"name":"Mr. Morgan M. Schuessler Jr.","title":"President, CEO & Director"},{"name":"Ms. Karla M. Cruz-Jusino","title":"Executive VP, CFO & Treasurer"},{"name":"Mr. Joaquin A. Castrillo-Salgado CPA","title":"Senior Executive VP & COO"}]},"sector_medians":{"fpe":16.74,"tpe":28.56,"ps":4.285,"pfcf":24.55,"peg":1.15,"pb":4.492,"ev_ebitda":18.29,"rev_growth":0.183,"eps_growth":0.344,"eps_growth_fwd":0.2366,"eps_growth_next":0.1841,"div_yield":0,"roe":0.1251,"roa":0.04865,"de":32.8,"gross_margin":0.5312,"op_margin":0.1357,"profit_margin":0.09441,"current_ratio":1.879},"valuation":[{"k":"fpe","label":"Forward P/E","v":7.677,"sector":16.74,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":22.38,"sector":28.56,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.914,"sector":4.285,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":11.07,"sector":24.55,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":null,"sector":1.15,"verdict":"—"},{"k":"pb","label":"Price / Book","v":3.102,"sector":4.492,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":179.0,"sector":32.8,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.238,"sector":0.183,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.039,"sector":0.344,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1075,"sector":0.2366,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1022,"sector":0.1841,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.5305,"sect