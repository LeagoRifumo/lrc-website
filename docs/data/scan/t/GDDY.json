ale system that allows customers to manage in-store inventory and product catalogs and accept payments; payment acceptance solutions; and online store capabilities. The Core segment offers domain products, including primary registrations, domain aftermarket platform, and domain name add-ons, as well as GoDaddy Registry, a provider of domain name registry services; and hosting and security services comprising shared website hosting and virtual private servers, as well as security products with a suite of tools designed to help secure customers' online presence; and SSL certificates. The company serves small businesses, individuals, organizations, developers, designers, and domain investors. GoDaddy Inc. was founded in 1997 and is headquartered in Tempe, Arizona.","employees":5845,"website":"https://www.godaddy.com","country":"United States","city":"Tempe","officers":[{"name":"Mr. Amanpal Singh Bhutani","title":"CEO & Director"},{"name":"Mr. Mark  McCaffrey","title":"Chief Financial Officer"},{"name":"Mr. Roger  Chen","title":"Chief Operating Officer"}]},"sector_medians":{"fpe":17.85,"tpe":31.02,"ps":4.569,"pfcf":26.24,"peg":1.16,"pb":4.856,"ev_ebitda":19.25,"rev_growth":0.1835,"eps_growth":0.3615,"eps_growth_fwd":0.2338,"eps_growth_next":0.1906,"div_yield":0,"roe":0.1245,"roa":0.04768,"de":32.58,"gross_margin":0.5372,"op_margin":0.1249,"profit_margin":0.09218,"current_ratio":1.81},"valuation":[{"k":"fpe","label":"Forward P/E","v":10.59,"sector":17.85,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":15.76,"sector":31.02,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":2.909,"sector":4.569,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":12.32,"sector":26.24,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.64,"sector":1.16,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":73.46,"sector":4.856,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":57334.0,"sector":32.58,"verdict":"High debt"},{"k":"rev_g