dd-ons, as well as GoDaddy Registry, a provider of domain name registry services; and hosting and security services comprising shared website hosting and virtual private servers, as well as security products with a suite of tools designed to help secure customers' online presence; and SSL certificates. The company serves small businesses, individuals, organizations, developers, designers, and domain investors. GoDaddy Inc. was founded in 1997 and is headquartered in Tempe, Arizona.","employees":5845,"website":"https://www.godaddy.com","country":"United States","city":"Tempe","officers":[{"name":"Mr. Amanpal Singh Bhutani","title":"CEO & Director"},{"name":"Mr. Mark  McCaffrey","title":"Chief Financial Officer"},{"name":"Mr. Roger  Chen","title":"Chief Operating Officer"}]},"sector_medians":{"fpe":17.74,"tpe":32.75,"ps":6.532,"pfcf":32.16,"peg":1.01,"pb":7.694,"rev_growth":0.2175,"eps_growth":0.464,"eps_growth_fwd":0.2596,"eps_growth_next":0.1955,"div_yield":0.0011,"roe":0.2326,"roa":0.07978,"de":48.45,"gross_margin":0.586,"op_margin":0.2256,"profit_margin":0.1916,"current_ratio":1.562},"valuation":[{"k":"fpe","label":"Forward P/E","v":9.552,"sector":17.74,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":15.68,"sector":32.75,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":2.614,"sector":6.532,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":11.07,"sector":32.16,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.6,"sector":1.01,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1988.0,"sector":7.694,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":57334.0,"sector":48.45,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.066,"sector":0.2175,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.298,"sector":0.464,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1997,"sector":0.2596,"verdict":"In line"},{"k":"eps_growth_