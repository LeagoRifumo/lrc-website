ntory and product catalogs and accept payments; payment acceptance solutions; and online store capabilities. The Core segment offers domain products, including primary registrations, domain aftermarket platform, and domain name add-ons, as well as GoDaddy Registry, a provider of domain name registry services; and hosting and security services comprising shared website hosting and virtual private servers, as well as security products with a suite of tools designed to help secure customers' online presence; and SSL certificates. The company serves small businesses, individuals, organizations, developers, designers, and domain investors. GoDaddy Inc. was founded in 1997 and is headquartered in Tempe, Arizona.","employees":5845,"website":"https://www.godaddy.com","country":"United States","city":"Tempe","officers":[{"name":"Mr. Amanpal Singh Bhutani","title":"CEO & Director"},{"name":"Mr. Mark  McCaffrey","title":"Chief Financial Officer"},{"name":"Mr. Roger  Chen","title":"Chief Operating Officer"}]},"sector_medians":{"fpe":17.86,"tpe":31.06,"ps":4.627,"pfcf":26.47,"peg":1.145,"pb":4.805,"ev_ebitda":19.14,"rev_growth":0.178,"eps_growth":0.367,"eps_growth_fwd":0.2373,"eps_growth_next":0.1868,"div_yield":0,"roe":0.1214,"roa":0.04733,"de":31.61,"gross_margin":0.5318,"op_margin":0.1268,"profit_margin":0.09291,"current_ratio":1.82},"valuation":[{"k":"fpe","label":"Forward P/E","v":10.53,"sector":17.86,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":15.61,"sector":31.06,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":2.893,"sector":4.627,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":12.35,"sector":26.47,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.63,"sector":1.145,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":null,"sector":4.805,"verdict":"—"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":31.61,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.06,"sector":0.178,"verdict":"Weak"},{"k