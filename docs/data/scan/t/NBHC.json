aho. It also operates ATMs. The company was formerly known as NBH Holdings Corp. and changed its name to National Bank Holdings Corporation in March 2012. The company was incorporated in 2009 and is headquartered in Greenwood Village, Colorado.","employees":1250,"website":"https://www.nationalbankholdings.com","country":"United States","city":"Greenwood Village","officers":[{"name":"Mr. G. Timothy Laney","title":"Founder, Chairman & CEO"},{"name":"Mr. Aldis  Birkans C.F.A.","title":"President"},{"name":"Ms. Nicole L. Van Denabeele","title":"Executive VP & CFO"}]},"sector_medians":{"fpe":10.51,"tpe":12.61,"ps":3.433,"pfcf":11.7,"peg":1.31,"pb":1.596,"ev_ebitda":10.74,"rev_growth":0.106,"eps_growth":0.16,"eps_growth_fwd":0.1329,"eps_growth_next":0.1099,"div_yield":0.02175,"roe":0.1268,"roa":0.01564,"de":54.45,"gross_margin":0.2391,"op_margin":0.3554,"profit_margin":0.2541,"current_ratio":1.509},"valuation":[{"k":"fpe","label":"Forward P/E","v":9.669,"sector":10.51,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":16.04,"sector":12.61,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":3.735,"sector":3.433,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":11.7,"verdict":"—"},{"k":"peg","label":"PEG","v":1.57,"sector":1.31,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":1.04,"sector":1.596,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":54.45,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.221,"sector":0.106,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.341,"sector":0.16,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0408,"sector":0.1329,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.345,"sector":0.1099,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0,"sector":0.2391,"verdict":"Weak"},{"k":"op_margin","label":"Operating margin