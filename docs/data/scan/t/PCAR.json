 companies, as well as independent owners/operators and other businesses; and truck inventory financing services to independent dealers. In addition, this segment offers loans and leases directly to customers for the acquisition of trucks and related equipment; and operates its own full-service lease outlets. The company manufactures and markets industrial winches under the Braden, Carco, and Gearmatic nameplates. PACCAR Inc was founded in 1905 and is headquartered in Bellevue, Washington.","employees":25900,"website":"https://www.paccar.com","country":"United States","city":"Bellevue","officers":[{"name":"Mr. R. Preston Feight","title":"CEO & Director"},{"name":"Mr. Kevin D. Baney","title":"President"},{"name":"Mr. Brice J. Poplawski","title":"Senior VP & CFO"}]},"sector_medians":{"fpe":17.66,"tpe":25.85,"ps":2.151,"pfcf":27.25,"peg":1.43,"pb":3.602,"ev_ebitda":14.62,"rev_growth":0.118,"eps_growth":0.1755,"eps_growth_fwd":0.156,"eps_growth_next":0.1428,"div_yield":0.0067,"roe":0.1475,"roa":0.05825,"de":67.05,"gross_margin":0.319,"op_margin":0.1262,"profit_margin":0.07405,"current_ratio":1.668},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.8,"sector":17.66,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":19.45,"sector":25.85,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.845,"sector":2.151,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":2.248,"sector":27.25,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.73,"sector":1.43,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":2.563,"sector":3.602,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":79.12,"sector":67.05,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.19,"sector":0.118,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.436,"sector":0.1755,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1748,"sector":0.156,"verdict":"In line"},{"k":"