mer display terminals, self-checkout hardware, kiosks, kitchen display systems, printers, cash drawers, keyboards, handheld scanners and payment terminals, and ordering kiosks. The company was formerly known as NCR Corporation and changed its name to NCR Voyix Corporation in October 2023. The company was incorporated in 1884 and is headquartered in Atlanta, Georgia.","employees":13500,"website":"https://ncrvoyix.com","country":"United States","city":"Atlanta","officers":[{"name":"Mr. James G. Kelly","title":"President, CEO & Director"},{"name":"Mr. Brian J. Webb-Walsh","title":"Executive VP & CFO"},{"name":"Ms. Kelli E. Sterrett J.D.","title":"Executive VP, General Counsel & Secretary"}]},"sector_medians":{"fpe":17.73,"tpe":31.01,"ps":4.582,"pfcf":26.55,"peg":1.16,"pb":4.831,"ev_ebitda":19.21,"rev_growth":0.1835,"eps_growth":0.3615,"eps_growth_fwd":0.2307,"eps_growth_next":0.1906,"div_yield":0,"roe":0.1245,"roa":0.04768,"de":32.58,"gross_margin":0.5372,"op_margin":0.1249,"profit_margin":0.09218,"current_ratio":1.81},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":17.73,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":30.23,"sector":31.01,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":0.4578,"sector":4.582,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":5.386,"sector":26.55,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":2.68,"sector":1.16,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.253,"sector":4.831,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":115.8,"sector":32.58,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.208,"sector":0.1835,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.3615,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0178,"sector":0.2307,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1201,"sector":0.1906,"verdict":"Wea