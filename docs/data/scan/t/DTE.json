s; and power generation, steam production, chilled water production, and wastewater treatment services, as well as compressed air supply to industrial customers. This segment also owns and operates 2 renewable generating plants with a capacity of 70 MWs; and 22 gas recovery sites. Its Energy Trading segment engages in power, natural gas, and environmental marketing and trading; structured transactions; and the optimization of contracted natural gas pipeline transportation and storage positions. The company was founded in 1849 and is based in Detroit, Michigan.","employees":9592,"website":"https://www.dteenergy.com","country":"United States","city":"Detroit","officers":[{"name":"Mr. Gerardo  Norcia","title":"Executive Chairman"},{"name":"Ms. Joi M. Harris","title":"President, CEO & Director"},{"name":"Mr. Trevor F. Lauer","title":"Vice Chairman & Group President"}]},"sector_medians":{"fpe":17.43,"tpe":21.38,"ps":2.872,"pfcf":267.9,"peg":2.18,"pb":2.165,"rev_growth":0.042,"eps_growth":0.086,"eps_growth_fwd":0.0725,"eps_growth_next":0.0753,"div_yield":0.0313,"roe":0.09857,"roa":0.03025,"de":162.2,"gross_margin":0.4635,"op_margin":0.2325,"profit_margin":0.1378,"current_ratio":0.8},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.86,"sector":17.43,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":20.9,"sector":21.38,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.667,"sector":2.872,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":267.9,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":1.7,"sector":2.18,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":2.259,"sector":2.165,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":229.1,"sector":162.2,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.015,"sector":0.042,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.224,"sector":0.086,"verdict":"Strong"},{"k":"eps_growth_fwd","label":