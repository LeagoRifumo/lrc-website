saic expression disorders; PRAX-090 for targeting SYNGAP1 loss-of-function; and PRAX-100 that targets SCN2A LoF mutations. It has a cooperation and license agreement with RogCon Inc.; research collaboration, option, and license agreement with Ionis Pharmaceuticals, Inc.; and research collaboration and license agreement to develop an iontophoretic transdermal patch for the delivery of ulixacaltamide. The company was formerly known as EpiPM Therapeutics, Inc. and changed its name to Praxis Precision Medicines, Inc. in October 2016. Praxis Precision Medicines, Inc. was incorporated in 2015 and is headquartered in Boston, Massachusetts.","employees":168,"website":"https://praxismedicines.com","country":"United States","city":"Boston","officers":[{"name":"Mr. Marcio Silva De'Souza M.B.A.","title":"President, CEO & Director"},{"name":"Mr. Timothy Edwin Kelly","title":"CFO & Treasurer"},{"name":"Mr. Alex  Nemiroff J.D.","title":"General Counsel & Secretary"}]},"sector_medians":{"fpe":19.17,"tpe":29.98,"ps":4.488,"pfcf":28.95,"peg":1.365,"pb":4.556,"ev_ebitda":16.93,"rev_growth":0.1,"eps_growth":0.1735,"eps_growth_fwd":0.09465,"eps_growth_next":0.1197,"div_yield":0,"roe":0.01872,"roa":0.02349,"de":41.94,"gross_margin":0.4961,"op_margin":0.03472,"profit_margin":0,"current_ratio":3.1},"valuation":[{"k":"fpe","label":"Forward P/E","v":-1,"sector":19.17,"verdict":"Loss-making"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":29.98,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":null,"sector":4.488,"verdict":"—"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":28.95,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":null,"sector":1.365,"verdict":"—"},{"k":"pb","label":"Price / Book","v":6.008,"sector":4.556,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":0.081,"sector":41.94,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":null,"sector":0.1,"verdict":"—"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sect