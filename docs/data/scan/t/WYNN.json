y casino, a poker room, and a race and sports book; a luxury hotel tower with suites, villas, swimming pools, private cabanas, full-service spas and salons, and a wedding chapel; food and beverage outlets; meeting and convention space; retail space; a golf course; nightclubs; a beach club; and theaters. Its Encore Boston Harbor segment operates casino space, private and high-limit gaming areas, and a sports book; a luxury hotel tower with suites, a spa, and a salon; food and beverage outlets; a nightclub; retail space; meeting and convention space; a waterfront park; floral displays; and water shuttle services. Wynn Resorts, Limited was incorporated in 2002 and is based in Las Vegas, Nevada.","employees":28500,"website":"https://www.wynnresorts.com","country":"United States","city":"Las Vegas","officers":[{"name":"Mr. Craig Scott Billings","title":"CEO & Director"},{"name":"Ms. Jacqui  Krum","title":"Executive VP, General Counsel & Secretary"},{"name":"Mr. Craig Jeffrey Fullalove","title":"CFO and Principal Financial & Accounting Officer"}]},"sector_medians":{"fpe":14.69,"tpe":19.29,"ps":1.222,"pfcf":19.3,"peg":1.18,"pb":2.91,"ev_ebitda":11.83,"rev_growth":0.055,"eps_growth":0.149,"eps_growth_fwd":0.1026,"eps_growth_next":0.1198,"div_yield":0.0074,"roe":0.1516,"roa":0.06133,"de":102.4,"gross_margin":0.3788,"op_margin":0.0968,"profit_margin":0.0578,"current_ratio":1.418},"valuation":[{"k":"fpe","label":"Forward P/E","v":19.35,"sector":14.69,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":23.45,"sector":19.29,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.176,"sector":1.222,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":22.62,"sector":19.3,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":0.76,"sector":1.18,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":null,"sector":2.91,"verdict":"—"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":102.4,"verdict":"—"},{"k":"rev_growth","label":"Revenue grow