nd owns tankers. The CO2 segment produces, transports, and markets CO2 to recovery and production crude oil from mature oil fields; owns interests in/or operates oil fields and gasoline processing plants; and operates a crude oil pipeline system in West Texas, as well as owns and operates RNG and LNG facilities. The company was formerly known as Kinder Morgan Holdco LLC and changed its name to Kinder Morgan, Inc. in February 2011. Kinder Morgan, Inc. was founded in 1997 and is headquartered in Houston, Texas.","employees":11028,"website":"https://www.kindermorgan.com","country":"United States","city":"Houston","officers":[{"name":"Mr. Richard D. Kinder","title":"Executive Chairman of the Board"},{"name":"Ms. Kimberly Allen Dang","title":"CEO & Director"},{"name":"Mr. Dax A. Sanders CPA","title":"President"}]},"sector_medians":{"fpe":12.14,"tpe":14.81,"ps":2.16,"pfcf":16.45,"peg":1.35,"pb":2.063,"ev_ebitda":7.789,"rev_growth":0.286,"eps_growth":0.952,"eps_growth_fwd":0.4909,"eps_growth_next":0.0449,"div_yield":0.0189,"roe":0.1359,"roa":0.05638,"de":55.01,"gross_margin":0.4427,"op_margin":0.2513,"profit_margin":0.1023,"current_ratio":1.462},"valuation":[{"k":"fpe","label":"Forward P/E","v":21.92,"sector":12.14,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":20.91,"sector":14.81,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":4.113,"sector":2.16,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":70.16,"sector":16.45,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":2.95,"sector":1.35,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":2.388,"sector":2.063,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":101.7,"sector":55.01,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.093,"sector":0.286,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.216,"sector":0.952,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2057,"secto