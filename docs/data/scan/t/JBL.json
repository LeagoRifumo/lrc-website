cap, networking and storage, automotive and transportation, connected devices, healthcare and packaging, and mobility industries. Jabil Inc. was formerly known as Jabil Circuit, Inc. and changed its name to Jabil Inc. in June 2017. The company was founded in 1966 and is based in Saint Petersburg, Florida.","employees":140000,"website":"https://www.jabil.com","country":"United States","city":"Saint Petersburg","officers":[{"name":"Mr. Michael  Dastoor","title":"CEO & Director"},{"name":"Mr. Andrew D. Priestley","title":"Executive VP & Chief Operations Officer"},{"name":"Mr. Steven D. Borges","title":"Executive Vice President of Global Business Units"}]},"sector_medians":{"fpe":17.88,"tpe":32.87,"ps":6.509,"pfcf":32.17,"peg":1.01,"pb":7.665,"ev_ebitda":21.94,"rev_growth":0.2175,"eps_growth":0.464,"eps_growth_fwd":0.2596,"eps_growth_next":0.1955,"div_yield":0.00105,"roe":0.2326,"roa":0.07978,"de":48.45,"gross_margin":0.586,"op_margin":0.2256,"profit_margin":0.1916,"current_ratio":1.562},"valuation":[{"k":"fpe","label":"Forward P/E","v":12.78,"sector":17.88,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":29.06,"sector":32.87,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":0.8114,"sector":6.509,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":22.74,"sector":32.17,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.82,"sector":1.01,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":18.35,"sector":7.665,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":268.3,"sector":48.45,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.286,"sector":0.2175,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.888,"sector":0.464,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.3515,"sector":0.2596,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.253,"sector":0.1955,"verdict":"Strong"},{"k":"g