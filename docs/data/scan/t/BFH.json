, Bread Financial, Bread Cashback, Bread Rewards, Bread Pay, and Bread Savings brands. The company was formerly known as Alliance Data Systems Corporation and changed its name to Bread Financial Holdings, Inc. in March 2022. Bread Financial Holdings, Inc. was incorporated in 1995 and is headquartered in Columbus, Ohio.","employees":6000,"website":"https://www.breadfinancial.com","country":"United States","city":"Columbus","officers":[{"name":"Mr. Ralph J. Andretta","title":"President, CEO & Director"},{"name":"Mr. Perry S. Beberman","title":"Executive VP & CFO"},{"name":"Ms. Allegra S. Driscoll","title":"Executive VP & CTO"}]},"sector_medians":{"fpe":10.38,"tpe":12.63,"ps":3.425,"pfcf":12.44,"peg":1.33,"pb":1.592,"ev_ebitda":10.63,"rev_growth":0.1,"eps_growth":0.143,"eps_growth_fwd":0.1322,"eps_growth_next":0.1086,"div_yield":0.0216,"roe":0.1279,"roa":0.01586,"de":55.3,"gross_margin":0.2391,"op_margin":0.3554,"profit_margin":0.2559,"current_ratio":1.509},"valuation":[{"k":"fpe","label":"Forward P/E","v":7.439,"sector":10.38,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":8.083,"sector":12.63,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.453,"sector":3.425,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":12.44,"verdict":"—"},{"k":"peg","label":"PEG","v":2.3,"sector":1.33,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.139,"sector":1.592,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":55.3,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.036,"sector":0.1,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.035,"sector":0.143,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0645,"sector":0.1322,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.071,"sector":0.1086,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0,"sector":0.2391,"verdict"