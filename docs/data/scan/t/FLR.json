l remediation, and decommissioning for nuclear remediation at governmental facilities, as well as services to commercial nuclear clients. It also delivers solutions for nuclear security and operation, nuclear waste management, and laboratory management; and operation and maintenance, logistics, EPC, and life support solutions for mission-critical facilities across U.S. military service organizations. The company was founded in 1912 and is headquartered in Irving, Texas.","employees":22995,"website":"https://www.fluor.com","country":"United States","city":"Irving","officers":[{"name":"Mr. James R. Breuer","title":"CEO & Director"},{"name":"Mr. John C. Regan","title":"Executive VP & CFO"},{"name":"Mr. Kevin B Hammonds","title":"Chief Legal Officer & Corporate Secretary"}]},"sector_medians":{"fpe":17.91,"tpe":25.6,"ps":2.127,"pfcf":27.13,"peg":1.41,"pb":3.619,"ev_ebitda":14.59,"rev_growth":0.119,"eps_growth":0.176,"eps_growth_fwd":0.1619,"eps_growth_next":0.1433,"div_yield":0.0071,"roe":0.1451,"roa":0.05694,"de":67.22,"gross_margin":0.3203,"op_margin":0.1163,"profit_margin":0.07298,"current_ratio":1.741},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.01,"sector":17.91,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":25.6,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":0.3926,"sector":2.127,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":27.13,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":1.1,"sector":1.41,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":2.452,"sector":3.619,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":39.2,"sector":67.22,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.105,"sector":0.119,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.176,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2391,"sector":0.1619,"verdict":"Strong"},{"k":"eps_g