ectional and turbines drilling; drilling fluid systems and related technologies; wireline logging; slickline services, descaling, wax and sand cleanout, plug setting, gas lift valve changeout, fishing and other complex well applications; and well testing services to measure solids, gas, and oil and water produced from well, as well as drilling tools and machine shop services. This segment also provides oilfield solutions for thru-tubing intervention; tubular running services; and a range of wellhead products, flow control equipment, and frac equipment. National Energy Services Reunited Corp. was incorporated in 2017 and is headquartered in Houston, Texas.","employees":7352,"website":"https://www.nesr.com","country":"United States","city":"Houston","officers":[{"name":"Mr. Sherif  Foda","title":"Executive Chairman & CEO"},{"name":"Mr. Stefan  Angeli","title":"Chief Financial Officer"},{"name":"Chokri  Ben Amor","title":"Director"}]},"sector_medians":{"fpe":12.14,"tpe":15.03,"ps":2.181,"pfcf":17.22,"peg":1.34,"pb":2.188,"ev_ebitda":7.858,"rev_growth":0.268,"eps_growth":0.8195,"eps_growth_fwd":0.4909,"eps_growth_next":0.03715,"div_yield":0.019,"roe":0.1285,"roa":0.05512,"de":55.83,"gross_margin":0.4427,"op_margin":0.2391,"profit_margin":0.1013,"current_ratio":1.437},"valuation":[{"k":"fpe","label":"Forward P/E","v":8.358,"sector":12.14,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":23.29,"sector":15.03,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":1.335,"sector":2.181,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":15.71,"sector":17.22,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":null,"sector":1.34,"verdict":"—"},{"k":"pb","label":"Price / Book","v":2.074,"sector":2.188,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":29.26,"sector":55.83,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.591,"sector":0.268,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/