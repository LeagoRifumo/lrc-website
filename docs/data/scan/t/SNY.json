io, Inc. for the commercialization of teplizumab; and antibody collaboration with Regeneron Pharmaceuticals, Inc. to develop antibodies, such as Dupixent (dupilumab) as treatment for diseases driven by type 2 inflammation. The company was formerly known as Sanofi-Aventis and changed its name to Sanofi in May 2011. Sanofi was incorporated in 1994 and is headquartered in Paris, France.","employees":74846,"website":"https://www.sanofi.com","country":"France","city":"Paris","officers":[{"name":"Ms. Belen  Garijo Lopez M.D.","title":"CEO & Director"},{"name":"Mr. François-Xavier  Roger","title":"Executive VP & CFO"},{"name":"Dr. Michael  Quigley Ph.D.","title":"Chief Scientific Officer & Head of Research"}]},"sector_medians":{"fpe":19.33,"tpe":31.08,"ps":4.153,"pfcf":28.96,"peg":1.35,"pb":4.555,"ev_ebitda":17.2,"rev_growth":0.094,"eps_growth":0.147,"eps_growth_fwd":0.0883,"eps_growth_next":0.1182,"div_yield":0,"roe":0.01671,"roa":0.02341,"de":43.27,"gross_margin":0.5196,"op_margin":0.05617,"profit_margin":0,"current_ratio":3.001},"valuation":[{"k":"fpe","label":"Forward P/E","v":8.793,"sector":19.33,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":23.31,"sector":31.08,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.965,"sector":4.153,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":12.4,"sector":28.96,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":null,"sector":1.35,"verdict":"—"},{"k":"pb","label":"Price / Book","v":1.375,"sector":4.555,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":27.09,"sector":43.27,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.157,"sector":0.094,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.094,"sector":0.147,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0775,"sector":0.0883,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0585,"sector":0.1182,"v