iplex reciprocating pumps and systems. It sells its products to wholesale and retail distributors, specialty distributors, and industrial and petroleum equipment distributors, as well as to oil and utility companies, and original equipment manufacturers. The company was founded in 1944 and is headquartered in Fort Wayne, Indiana.","employees":6500,"website":"https://www.franklin-electric.com","country":"United States","city":"Fort Wayne","officers":[{"name":"Mr. Joseph A. Ruzynski","title":"CEO & Director"},{"name":"Ms. Jennifer A. Wolfenbarger","title":"VP & CFO"},{"name":"Mr. Jonathan M. Grandon","title":"VP, Chief Administrative Officer, General Counsel & Corporate Secretary"}]},"sector_medians":{"fpe":17.65,"tpe":25.99,"ps":2.167,"pfcf":26.66,"peg":1.42,"pb":3.505,"ev_ebitda":14.96,"rev_growth":0.11,"eps_growth":0.176,"eps_growth_fwd":0.1478,"eps_growth_next":0.1459,"div_yield":0.0066,"roe":0.149,"roa":0.05825,"de":66.95,"gross_margin":0.3185,"op_margin":0.1262,"profit_margin":0.0723,"current_ratio":1.665},"valuation":[{"k":"fpe","label":"Forward P/E","v":18.54,"sector":17.65,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":21.72,"sector":25.99,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.932,"sector":2.167,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":28.6,"sector":26.66,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":1.54,"sector":1.42,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":3.228,"sector":3.505,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":21.84,"sector":66.95,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.06,"sector":0.11,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.114,"sector":0.176,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1262,"sector":0.1478,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.118,"sector":0.1459,