":6.56,"est":4.556,"surp":0.4399}],"div_pay":"2026-09-03","rec_trend":{"strongBuy":2,"buy":7,"hold":1,"sell":0,"strongSell":0},"analyst_actions":[{"date":"2026-10-12","firm":"TD Cowen","action":"main","from":"Buy","to":"Buy"}]},"profile":{"sector":"Industrials","industry":"Rental & Leasing Services","summary":"AerCap Holdings N.V. engages in the lease, financing, sale, and management of commercial flight equipment in the United States, China, and internationally. The company engages in aircraft and engine asset management services, such as remarketing aircraft and engines for lease or sale; collecting rental and supplemental maintenance rent payments, monitoring aircraft maintenance, monitoring and enforcing contract compliance, and accepting delivery and redelivery of aircraft and engines; conducting ongoing lessee financial performance reviews. Its aircraft and engine asset management services also include periodically inspecting the leased aircraft and engines; coordinating technical modifications to aircraft to meet new lessee requirements; conducting restructuring negotiations in connection with lease defaults; repossessing aircraft and engines; arranging and monitoring insurance coverage; registering and de-registering aircraft; arranging for aircraft and engine valuations; and providing market research services. In addition, the company provides corporate administrative services comprising accounting, and corporate secretarial services consisting of the preparation of budgets and financial statements; and cash management services, including treasury services, such as the financing, refinancing, hedging, and ongoing cash management of companies. Further, it offers airframe and engine parts and supply chain solutions to airlines; maintenance, repair, and overhaul service providers; and aircraft parts distributors. The company has a portfolio of owned, managed, or on order aircraft, consisting of 3,500 aircraft, engines, and helicopters. AerCap Holdings N.V. was founded in 1995 and is headquartered in Dublin, Ireland.","employees":668,"website":"https://www.aercap.com","country":"Ireland","city":"Dublin","officers":[{"name":"Mr. Aengus  Kelly A.C.A.","title":"CEO & Executive Director"},{"name":"Mr. Peter L. Juhas J.D.","title":"Chief Financial Officer"},{"name":"Mr. Peter  Anderson","title":"Chief Commercial Officer"}]},"sector_medians":{"fpe":17.68,"tpe":26.14,"ps":2.142,"pfcf":26.66,"peg":1.4,"pb":3.514,"ev_ebitda":14.94,"rev_growth":0.11,"eps_growth":0.176,"eps_growth_fwd":0.1447,"eps_growth_next":0.146,"div_yield":0.0066,"roe":0.149,"roa":0.05825,"de":66.95,"gross_margin":0.3185,"op_margin":0.1262,"profit_margin":0.0723,"current_ratio":1.665},"valuation":[{"k":"fpe","label":"Forward P/E","v":8.591,"sector":17.68,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":7.668,"sector":26.14,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":2.749,"sector":2.142,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":26.66,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":0.8,"sector":1.4,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.315,"sector":3.514,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":232.7,"sector":66.95,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.149,"sector":0.11,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.353,"sector":0.176,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2409,"sector":0.1447,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":-0.0448,"sector":0.146,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.6282,"sector":0.3185,"verdict":"Strong"},{"k":"op_margin","label":"Operating margin","v":0.575,"sector":0.1262,"verdict":"Strong"},{"k":"profit_margin","label":"Net margin","v":0.3785,"sector":0.0723,"verdict":"Strong"},{"k":"roe","label":"Return on equity","v":0.1866,"s