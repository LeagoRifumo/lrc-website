pany was founded in 1955 and is headquartered in Walnut Creek, California.","employees":6000,"website":"https://www.central.com","country":"United States","city":"Walnut Creek","officers":[{"name":"Mr. William E. Brown","title":"Founder & Chairman"},{"name":"Mr. Nicholas  Lahanas","title":"CEO & Director"},{"name":"Mr. Bradley G. Smith","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":15.08,"tpe":20.29,"ps":1.19,"pfcf":19.19,"peg":1.65,"pb":2.571,"ev_ebitda":10.94,"rev_growth":0.037,"eps_growth":0.133,"eps_growth_fwd":0.06595,"eps_growth_next":0.07315,"div_yield":0.01995,"roe":0.1239,"roa":0.05641,"de":80.72,"gross_margin":0.3532,"op_margin":0.1108,"profit_margin":0.04107,"current_ratio":1.299},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.24,"sector":15.08,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":17.43,"sector":20.29,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":0.9553,"sector":1.19,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":8.606,"sector":19.19,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":2.01,"sector":1.65,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":1.686,"sector":2.571,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":80.63,"sector":80.72,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":-0.082,"sector":0.037,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.046,"sector":0.133,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.089,"sector":0.06595,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0391,"sector":0.07315,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.3257,"sector":0.3532,"verdict":"In line"},{"k":"op_margin","label":"Operating margin","v":0.08323,"sector":0.1108,"verdict":"In line"},{"k":"profit_margin","label":"Net margin","v":0.05393,"sector":0.04107,"verdict":"In line"},{"k":"roe","lab