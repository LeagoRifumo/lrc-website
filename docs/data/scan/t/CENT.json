etailers, national and regional retail chains, eCommerce and online retailers, grocery stores, nurseries, and mass merchants. Central Garden & Pet Company was founded in 1955 and is headquartered in Walnut Creek, California.","employees":6000,"website":"https://www.central.com","country":"United States","city":"Walnut Creek","officers":[{"name":"Mr. William E. Brown","title":"Founder & Chairman"},{"name":"Mr. Nicholas  Lahanas","title":"CEO & Director"},{"name":"Mr. Bradley G. Smith","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":14.86,"tpe":20.12,"ps":1.126,"pfcf":17.78,"peg":1.66,"pb":2.497,"ev_ebitda":10.61,"rev_growth":0.04,"eps_growth":0.1415,"eps_growth_fwd":0.0663,"eps_growth_next":0.0737,"div_yield":0.0205,"roe":0.1239,"roa":0.05633,"de":80.63,"gross_margin":0.3572,"op_margin":0.1108,"profit_margin":0.04469,"current_ratio":1.287},"valuation":[{"k":"fpe","label":"Forward P/E","v":13.35,"sector":14.86,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":15.28,"sector":20.12,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.8372,"sector":1.126,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":7.542,"sector":17.78,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":2.01,"sector":1.66,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":1.478,"sector":2.497,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":80.63,"sector":80.63,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":-0.082,"sector":0.04,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.046,"sector":0.1415,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0298,"sector":0.0663,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":-0.0021,"sector":0.0737,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.3257,"sector":0.3572,"verdict":"In line"},{"k":"op_margin","label":"Operating margin","v":0.08323,"