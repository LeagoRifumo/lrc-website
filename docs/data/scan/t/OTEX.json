rs, including Accenture plc, Capgemini Technology Services SAS, Deloitte Consulting LLP, Hewlett Packard Enterprises, and Tata Consultancy Services. The company serves global 10,000 organizations, enterprise companies, public sector agencies, mid-market companies, SMBS, and direct consumers. The company has a strategic partnership with Cohere to develops and provides agentic AI to governments and regulated industries. Open Text Corporation was incorporated in 1991 and is headquartered in Waterloo, Canada.","employees":19500,"website":"https://www.opentext.com","country":"Canada","city":"Waterloo","officers":[{"name":"Mr. Paul Thomas Jenkins CD, OC","title":"Executive Chair"},{"name":"Mr. Ayman  Antoun","title":"CEO & Director"},{"name":"Mr. Cosmin  Balota","title":"Senior VP & Chief Accounting Officer"}]},"sector_medians":{"fpe":17.12,"tpe":29.56,"ps":4.327,"pfcf":26.23,"peg":1.085,"pb":4.643,"ev_ebitda":19.01,"rev_growth":0.1845,"eps_growth":0.356,"eps_growth_fwd":0.2432,"eps_growth_next":0.1828,"div_yield":0,"roe":0.1249,"roa":0.04908,"de":32.04,"gross_margin":0.5312,"op_margin":0.1351,"profit_margin":0.09355,"current_ratio":1.879},"valuation":[{"k":"fpe","label":"Forward P/E","v":5.829,"sector":17.12,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":9.373,"sector":29.56,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.148,"sector":4.327,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":3.916,"sector":26.23,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.02,"sector":1.085,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":1.425,"sector":4.643,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":145.2,"sector":32.04,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.04,"sector":0.1845,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.107,"sector":0.356,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.1111,"s