rosol, an anticholinergic indicated for the maintenance treatment of bronchospasm associated with chronic obstructive pulmonary disease. Further, the company provides active pharmaceutical ingredient (API) products, such as Recombinant Human Insulin and porcine insulin API. The company was founded in 1996 and is headquartered in Rancho Cucamonga, California.","employees":1976,"website":"https://www.amphastar.com","country":"United States","city":"Rancho Cucamonga","officers":[{"name":"Dr. Ziping  Luo Ph.D.","title":"Chairman of the Board, Chief Scientist & COO"},{"name":"Dr. Yongfeng  Zhang Ph.D.","title":"Co-Founder, President, CEO, Chief Scientific Officer & Director"},{"name":"Mr. William J. Peters M.B.A.","title":"CFO, Executive VP of Finance, Treasurer & Director"}]},"sector_medians":{"fpe":19.17,"tpe":30.5,"ps":4.503,"pfcf":28.94,"peg":1.34,"pb":4.598,"ev_ebitda":16.86,"rev_growth":0.1,"eps_growth":0.1735,"eps_growth_fwd":0.09355,"eps_growth_next":0.1223,"div_yield":0,"roe":0.01872,"roa":0.02349,"de":41.94,"gross_margin":0.4961,"op_margin":0.03472,"profit_margin":0,"current_ratio":3.1},"valuation":[{"k":"fpe","label":"Forward P/E","v":8.434,"sector":19.17,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":15.83,"sector":30.5,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.559,"sector":4.503,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":4.946,"sector":28.94,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":null,"sector":1.34,"verdict":"—"},{"k":"pb","label":"Price / Book","v":1.481,"sector":4.598,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":89.61,"sector":41.94,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.054,"sector":0.1,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.047,"sector":0.1735,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0887,"sector":0.09355,"verdict":"Weak"},{"k":"eps_growth_next","la