abeth, Feltex, Godfrey Hirst, IVC Home, Karastan, Kerama Marazzi, Marazzi, Moduleo, Mohawk, Pergo, Quick-Step, Unilin, Vitromex, GH Commercial, Hycraft, Lentex Flooring, Leoline, Redbook, EmilGroup, KAI, Ragno, Aladdin Commercial, Durkan, Foss, IVC Resilient Design, Mohawk Group, Mohawk Home, and Portico. It offers its products to home centers, company-owned service centers and stores, floor covering retailers, ceramic tile specialists, e-commerce retailers, residential builders, independent distributors, commercial contractors, and commercial end users. The company was incorporated in 1988 and is headquartered in Calhoun, Georgia.","employees":40500,"website":"https://www.mohawkind.com","country":"United States","city":"Calhoun","officers":[{"name":"Mr. Paul F. De Cock","title":"CEO, President, COO, Interim President of Flooring Rest of World segment & Director"},{"name":"Mr. Mauro  Vandini","title":"President of Global Ceramic Segment"},{"name":"Mr. Ken  Walma","title":"President of Flooring North America segment"}]},"sector_medians":{"fpe":15.06,"tpe":19.68,"ps":1.268,"pfcf":19.87,"peg":1.145,"pb":3.01,"ev_ebitda":11.98,"rev_growth":0.0555,"eps_growth":0.1675,"eps_growth_fwd":0.1112,"eps_growth_next":0.1243,"div_yield":0.0077,"roe":0.1531,"roa":0.06093,"de":107.2,"gross_margin":0.38,"op_margin":0.09692,"profit_margin":0.05859,"current_ratio":1.437},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.29,"sector":15.06,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":17.46,"sector":19.68,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":0.7708,"sector":1.268,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":8.262,"sector":19.87,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.64,"sector":1.145,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.047,"sector":3.01,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":26.6,"sector":107.2,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue gro