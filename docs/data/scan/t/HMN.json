insurance, property insurance, liability insurance, 403(b) retirement plans, mutual funds, life insurance, student loan solutions, credit monitoring, and financial wellness workshops. It distributes its products and services through agents, brokers, benefit specialists, direct and digital channels. The company was founded in 1945 and is headquartered in Springfield, Illinois.","employees":1800,"website":"https://www.horacemann.com","country":"United States","city":"Springfield","officers":[{"name":"Ms. Marita  Zuraitis","title":"President, CEO & Director"},{"name":"Mr. Ryan Edward Greenier","title":"Executive VP & CFO"},{"name":"Mr. Donald Martin Carley","title":"Executive VP, General Counsel, Chief Administrative Officer & Corporate Secretary"}]},"sector_medians":{"fpe":10.56,"tpe":12.67,"ps":3.483,"pfcf":12.28,"peg":1.33,"pb":1.595,"ev_ebitda":10.38,"rev_growth":0.089,"eps_growth":0.1285,"eps_growth_fwd":0.1351,"eps_growth_next":0.1043,"div_yield":0.0226,"roe":0.1287,"roa":0.01568,"de":54.8,"gross_margin":0.2385,"op_margin":0.3641,"profit_margin":0.2563,"current_ratio":1.517},"valuation":[{"k":"fpe","label":"Forward P/E","v":9.914,"sector":10.56,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":11.74,"sector":12.67,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.233,"sector":3.483,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":12.28,"verdict":"—"},{"k":"peg","label":"PEG","v":1.16,"sector":1.33,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":1.515,"sector":1.595,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":41.84,"sector":54.8,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.002,"sector":0.089,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.007,"sector":0.1285,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0318,"sector":0.1351,"verdict":"Weak"},{"k":"eps_growth_next","label":"EP