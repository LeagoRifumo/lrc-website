 receipt printers, networking hardware, cash drawers, payment terminals, servers, stands, bar-code scanners, and an assortment of accessories, as well as provide installation and implementation services. The company was formerly known as Lightspeed POS Inc. and changed its name to Lightspeed Commerce Inc. in August 2021. Lightspeed Commerce Inc. was incorporated in 2005 and is headquartered in Montreal, Canada.","employees":3400,"website":"https://www.lightspeedhq.com","country":"Canada","city":"Montreal","officers":[{"name":"Ms. Manon  Brouillette","title":"Executive Chairwoman of the Board"},{"name":"Mr. Dax  Dasilva","title":"Founder, CEO & Director"},{"name":"Ms. Asha Hotchandani Bakshani C.F.A.","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":18.12,"tpe":31.43,"ps":4.812,"pfcf":27.73,"peg":1.145,"pb":5.056,"ev_ebitda":19.99,"rev_growth":0.177,"eps_growth":0.339,"eps_growth_fwd":0.2264,"eps_growth_next":0.1929,"div_yield":0,"roe":0.1195,"roa":0.04674,"de":32.62,"gross_margin":0.5331,"op_margin":0.1128,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":11.67,"sector":18.12,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":31.43,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":1.138,"sector":4.812,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":32.15,"sector":27.73,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":null,"sector":1.145,"verdict":"—"},{"k":"pb","label":"Price / Book","v":1.02,"sector":5.056,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":1.435,"sector":32.62,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.058,"sector":0.177,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.339,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.42,"sector":0.2264,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)