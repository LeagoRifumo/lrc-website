 gliders with electric and combustion engines; and provides other research and development initiatives related to sustainable aviation solutions. The Finance segment offers financing services to purchase new and pre-owned aviation aircraft and Bell helicopters. Textron Inc. was founded in 1923 and is headquartered in Providence, Rhode Island.","employees":34000,"website":"https://www.textron.com","country":"United States","city":"Providence","officers":[{"name":"Mr. Scott C. Donnelly","title":"Executive Chairman"},{"name":"Mr. David  Rosenberg","title":"Executive VP & CFO"},{"name":"Mr. E. Robert Lupone","title":"Executive VP, General Counsel, Secretary & Chief Compliance Officer"}]},"sector_medians":{"fpe":20.72,"tpe":27.72,"ps":3.424,"pfcf":30.39,"peg":1.56,"pb":6.084,"rev_growth":0.097,"eps_growth":0.13,"eps_growth_fwd":0.1265,"eps_growth_next":0.1335,"div_yield":0.0115,"roe":0.204,"roa":0.07231,"de":70.14,"gross_margin":0.3678,"op_margin":0.1746,"profit_margin":0.1184,"current_ratio":1.328},"valuation":[{"k":"fpe","label":"Forward P/E","v":10.64,"sector":20.72,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":14.47,"sector":27.72,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.8733,"sector":3.424,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":29.51,"sector":30.39,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":0.9,"sector":1.56,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.64,"sector":6.084,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":52.28,"sector":70.14,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.03,"sector":0.097,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.052,"sector":0.13,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0599,"sector":0.1265,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1173,"sector":0.1335,"verdict":"In line"},{"k":"g