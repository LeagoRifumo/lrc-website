 co-packaged optics, linear pluggable optics chipsets, data center interconnect, active electrical cable DSPs and peripheral component interconnect express retimer solutions; fibre channel products comprising host bus adapters and controllers for server and storage system connectivity; storage controllers for hard disk drives and solid-state-drives; host system interfaces, including serial advanced technology attachment and serial attached SCSI, peripheral component interconnect express, compute express link switches, non-volatile memory express (NVMe), and NVMe over fabrics; and develops ultra accelerator linkTM switches and ethernet for scale-up networking switches. The company serves data centers, communications, and other markets. It offers its products through direct customers and distributors. Marvell Technology, Inc. was incorporated in 1995 and is headquartered in Wilmington, Delaware.","employees":7480,"website":"https://www.marvell.com","country":"United States","city":"Wilmington","officers":[{"name":"Mr. Matthew J. Murphy","title":"CEO & Chairman"},{"name":"Mr. Christopher R. Koopmans","title":"President & COO"},{"name":"Mr. Daniel J. Durn","title":"CFO, Executive VP & Principal Financial Officer"}]},"sector_medians":{"fpe":17.73,"tpe":31.01,"ps":4.582,"pfcf":26.55,"peg":1.16,"pb":4.831,"ev_ebitda":19.21,"rev_growth":0.1835,"eps_growth":0.3615,"eps_growth_fwd":0.2307,"eps_growth_next":0.1906,"div_yield":0,"roe":0.1245,"roa":0.04768,"de":32.58,"gross_margin":0.5372,"op_margin":0.1249,"profit_margin":0.09218,"current_ratio":1.81},"valuation":[{"k":"fpe","label":"Forward P/E","v":26.88,"sector":17.73,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":64.8,"sector":31.01,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":18.71,"sector":4.582,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":73.42,"sector":26.55,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":0.54,"sector":1.16,"verdict":"Undervalued"},{"k":"pb","label":"Pric