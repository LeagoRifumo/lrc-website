ent labels to retail and wholesale distributors; and various distribution centers and ventures, as well as retail outlets, online physical retailers, streaming services, and download services. Its catalog includes songwriters and composers; and various genres, including pop, rock, jazz, classical, country, R&B, hip-hop, rap, reggae, Latin, folk, alternative, blues, gospel, and other Christian music. The company was founded in 1929 and is headquartered in New York, New York.","employees":5500,"website":"https://www.wmg.com","country":"United States","city":"New York","officers":[{"name":"Mr. Robert  Kyncl","title":"President, CEO & Director"},{"name":"Mr. Valentin  Blavatnik","title":"Managing Director of Warner Recorded Music, North America and UK & Corporate Deve. and Director"},{"name":"Ms. Carletta  Higginson","title":"Executive VP & Chief Digital Officer"}]},"sector_medians":{"fpe":12.51,"tpe":19.35,"ps":2.16,"pfcf":13.63,"peg":1.09,"pb":2.208,"ev_ebitda":13.54,"rev_growth":0.0805,"eps_growth":0.053,"eps_growth_fwd":0.1456,"eps_growth_next":0.1477,"div_yield":0,"roe":0.0878,"roa":0.04007,"de":64.06,"gross_margin":0.5713,"op_margin":0.1332,"profit_margin":0.06819,"current_ratio":1.257},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.0,"sector":12.51,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":23.6,"sector":19.35,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":2.114,"sector":2.16,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":40.39,"sector":13.63,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":0.53,"sector":1.09,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":18.07,"sector":2.208,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":452.9,"sector":64.06,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.104,"sector":0.0805,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.053,"verdict":"—"},{"k":"eps_growth_fwd","