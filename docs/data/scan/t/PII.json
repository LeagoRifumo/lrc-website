rome accessories, as well as light duty hauling and passenger vehicles. The company sells its products through dealers and distributors, as well as online. The company was formerly known as Polaris Industries Inc. Polaris Inc. was founded in 1945 and is headquartered in Medina, Minnesota.","employees":14500,"website":"https://www.polaris.com","country":"United States","city":"Medina","officers":[{"name":"Mr. Michael Todd Speetzen","title":"CEO & Director"},{"name":"Mr. Robert Paul Mack","title":"Executive Vice President & Chief Financial Officer"},{"name":"Mr. James P. Williams","title":"Senior VP & Chief Human Resources Officer"}]},"sector_medians":{"fpe":14.77,"tpe":19.46,"ps":1.261,"pfcf":19.95,"peg":1.14,"pb":3.033,"ev_ebitda":11.75,"rev_growth":0.062,"eps_growth":0.1705,"eps_growth_fwd":0.1089,"eps_growth_next":0.1259,"div_yield":0.0078,"roe":0.1545,"roa":0.06132,"de":110.4,"gross_margin":0.38,"op_margin":0.09577,"profit_margin":0.0572,"current_ratio":1.434},"valuation":[{"k":"fpe","label":"Forward P/E","v":18.98,"sector":14.77,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":19.46,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":0.4447,"sector":1.261,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":6.901,"sector":19.95,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":3.34,"sector":1.14,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":4.111,"sector":3.033,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":191.8,"sector":110.4,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.106,"sector":0.062,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.1705,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":351.1,"sector":0.1089,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":-0.0931,"sector":0.1259,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","