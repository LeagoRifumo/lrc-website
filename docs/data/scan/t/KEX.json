ld service equipment, including pressure pumping units, as well as manufacturers electric power generation equipment, specialized electrical distribution and control equipment, and high capacity energy storage/battery systems. It serves various companies in the United States government, and pleasure crafts. The company was formerly known as Kirby Exploration Company, Inc. and changed its name to Kirby Corporation in 1990. Kirby Corporation was founded in 1921 and is headquartered in Houston, Texas.","employees":5233,"website":"https://kirbycorp.com","country":"United States","city":"Houston","officers":[{"name":"Mr. David W. Grzebinski C.F.A.","title":"CEO & Director"},{"name":"Mr. Christian G. O'Neil","title":"President & COO"},{"name":"Mr. Raj  Kumar","title":"Executive VP & CFO"}]},"sector_medians":{"fpe":17.93,"tpe":26.47,"ps":2.216,"pfcf":27.32,"peg":1.4,"pb":3.567,"ev_ebitda":15.2,"rev_growth":0.1115,"eps_growth":0.205,"eps_growth_fwd":0.156,"eps_growth_next":0.1459,"div_yield":0.0067,"roe":0.1485,"roa":0.05825,"de":66.55,"gross_margin":0.3184,"op_margin":0.1215,"profit_margin":0.07337,"current_ratio":1.672},"valuation":[{"k":"fpe","label":"Forward P/E","v":17.05,"sector":17.93,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":21.01,"sector":26.47,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":null,"sector":2.216,"verdict":"—"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":27.32,"verdict":"—"},{"k":"peg","label":"PEG","v":2.63,"sector":1.4,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":2.252,"sector":3.567,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":35.62,"sector":66.55,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.122,"sector":0.1115,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.267,"sector":0.205,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.142,"sector":0.156,"verdict":"In line"},{"k":"eps