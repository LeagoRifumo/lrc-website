curity conduit lending, and power and project financing; and commercial real estate lending services consisting of term and construction/land development financing for commercial and residential purposes. In addition, it offers retail banking services comprising residential mortgages lending, home equity lines of credit, personal lines of credit, installment consumer loans, depository account services, consumer cards, and personal trust services; and wealth management services consisting of investment management, fiduciary and estate, and advanced business succession and estate planning services. The company was formerly known as ZB, National Association and changed its name to Zions Bancorporation, National Association in September 2018. Zions Bancorporation, National Association was founded in 1873 and is headquartered in Salt Lake City, Utah.","employees":8996,"website":"https://www.zionsbancorporation.com","country":"United States","city":"Salt Lake City","officers":[{"name":"Mr. Harris Henry Simmons","title":"Chairman & CEO"},{"name":"Mr. Scott J. McLean","title":"President, COO & Director"},{"name":"Mr. Robert Ryan Richards","title":"Executive VP & CFO"}]},"sector_medians":{"fpe":10.51,"tpe":12.61,"ps":3.433,"pfcf":11.7,"peg":1.31,"pb":1.596,"ev_ebitda":10.74,"rev_growth":0.106,"eps_growth":0.16,"eps_growth_fwd":0.1329,"eps_growth_next":0.1099,"div_yield":0.02175,"roe":0.1268,"roa":0.01564,"de":54.45,"gross_margin":0.2391,"op_margin":0.3554,"profit_margin":0.2541,"current_ratio":1.509},"valuation":[{"k":"fpe","label":"Forward P/E","v":9.395,"sector":10.51,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":8.005,"sector":12.61,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":2.53,"sector":3.433,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":11.7,"verdict":"—"},{"k":"peg","label":"PEG","v":3.52,"sector":1.31,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.242,"sector":1.596,"verdict":"Undervalue