ucking, specialized hauling, flat-bed and project, less-than-truckload (LCL), and expedited freight services; LCL consolidation and freight forwarding services; warehousing, trans-loading, value-added packaging and distribution services; purchase order management, booking services, and non-vessel operating common carrier freight forwarding services. It serves the U.S. military, freight forwarders and non-vessel owning common carriers, retailers and consumer goods manufacturers, and other customers. The company was formerly known as Alexander & Baldwin Holdings, Inc. and changed its name to Matson, Inc. in June 2012. Matson, Inc. was founded in 1882 and is headquartered in Honolulu, Hawaii.","employees":4170,"website":"https://www.matson.com","country":"United States","city":"Honolulu","officers":[{"name":"Mr. Matthew J. Cox","title":"Chairman & CEO"},{"name":"Mr. Joel M. Wine","title":"Executive VP & CFO"},{"name":"Mr. Peter T. Heilmann","title":"Executive VP, Chief Administrative Officer & General Counsel"}]},"sector_medians":{"fpe":17.91,"tpe":25.6,"ps":2.127,"pfcf":27.13,"peg":1.41,"pb":3.619,"ev_ebitda":14.59,"rev_growth":0.119,"eps_growth":0.176,"eps_growth_fwd":0.1619,"eps_growth_next":0.1433,"div_yield":0.0071,"roe":0.1451,"roa":0.05694,"de":67.22,"gross_margin":0.3203,"op_margin":0.1163,"profit_margin":0.07298,"current_ratio":1.741},"valuation":[{"k":"fpe","label":"Forward P/E","v":11.25,"sector":17.91,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":12.0,"sector":25.6,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.689,"sector":2.127,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":34.34,"sector":27.13,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":2.01,"sector":1.41,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":2.13,"sector":3.619,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":23.86,"sector":67.22,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.265,"sect