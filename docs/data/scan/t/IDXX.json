erpretation of fluorescent-based water tests; and veterinary software and services for independent veterinary clinics and corporate groups. In addition, the company offers diagnostic tests, services, and related instrumentation to manage the health status of livestock and poultry; human medical diagnostic products and services; and VetConnect PLUS, a cloud-based technology that enables veterinarians to access and analyze patients, as well as operates VetLab Station. It markets its products through marketing, customer service, sales, and technical service groups, as well as through independent distributors and other resellers. IDEXX Laboratories, Inc. was incorporated in 1983 and is headquartered in Westbrook, Maine.","employees":11000,"website":"https://www.idexx.com","country":"United States","city":"Westbrook","officers":[{"name":"Mr. Jonathan J. Mazelsky","title":"Executive Chairman"},{"name":"Mr. Andrew  Emerson","title":"Executive VP, CFO & Treasurer"},{"name":"Mr. Michael J. Lane","title":"Executive VP and GM Global Reference Laboratories, Diagnostic Solutions & Information Technology"}]},"sector_medians":{"fpe":19.33,"tpe":31.08,"ps":4.153,"pfcf":28.96,"peg":1.35,"pb":4.555,"ev_ebitda":17.2,"rev_growth":0.094,"eps_growth":0.147,"eps_growth_fwd":0.0883,"eps_growth_next":0.1182,"div_yield":0,"roe":0.01671,"roa":0.02341,"de":43.27,"gross_margin":0.5196,"op_margin":0.05617,"profit_margin":0,"current_ratio":3.001},"valuation":[{"k":"fpe","label":"Forward P/E","v":39.89,"sector":19.33,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":45.23,"sector":31.08,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":11.33,"sector":4.153,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":49.66,"sector":28.96,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":3.68,"sector":1.35,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":28.27,"sector":4.555,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":52.05,"sector":43.27,"ver