applications under the Sensient Food Colors, Sensient Pharmaceutical, Sensient Beauty, and Sensient Specialty Markets brand names. The Asia Pacific segment markets its products in the Pacific Rim and India under the Sensient name. In addition, the company produces and distributes chili powder, paprika, chili pepper, and parsley products. Sensient Technologies Corporation was incorporated in 1882 and is headquartered in Milwaukee, Wisconsin.","employees":4070,"website":"https://www.sensient.com","country":"United States","city":"Milwaukee","officers":[{"name":"Mr. Paul  Manning","title":"Chairman, CEO, President & Member of Scientific Advisory Committee"},{"name":"Mr. Tobin  Tornehl","title":"VP & CFO"},{"name":"Mr. John J. Manning J.D.","title":"Senior VP, General Counsel & Secretary"}]},"sector_medians":{"fpe":12.2,"tpe":17.97,"ps":2.227,"pfcf":22.67,"peg":1.74,"pb":2.251,"ev_ebitda":9.234,"rev_growth":0.1635,"eps_growth":0.296,"eps_growth_fwd":0.3698,"eps_growth_next":0.1366,"div_yield":0.009,"roe":0.1295,"roa":0.06907,"de":43.23,"gross_margin":0.3315,"op_margin":0.1485,"profit_margin":0.07766,"current_ratio":2.28},"valuation":[{"k":"fpe","label":"Forward P/E","v":23.5,"sector":12.2,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":29.21,"sector":17.97,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":2.825,"sector":2.227,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":22.67,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":1.74,"sector":1.74,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":3.817,"sector":2.251,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":61.43,"sector":43.23,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.106,"sector":0.1635,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.299,"sector":0.296,"verdict":"In line"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2047,"sector":0.3698,"verdict":