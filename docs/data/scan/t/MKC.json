olutions segment offers seasoning blends, spices, herbs, condiments, coating systems, and compound flavors to multinational food manufacturers and foodservice customers. It serves foodservice customers directly and indirectly through distributors. The company was founded in 1889 and is headquartered in Hunt Valley, Maryland.","employees":14100,"website":"https://www.mccormickcorporation.com","country":"United States","city":"Hunt Valley","officers":[{"name":"Mr. Brendan M. Foley","title":"President, CEO & Chairman"},{"name":"Mr. Marcos Mendes Gabriel","title":"Executive VP & CFO"},{"name":"Mr. Jeffery D. Schwartz","title":"VP, General Counsel & Corporate Secretary"}]},"sector_medians":{"fpe":14.34,"tpe":21.52,"ps":1.215,"pfcf":17.24,"peg":1.45,"pb":2.529,"ev_ebitda":10.95,"rev_growth":0.043,"eps_growth":0.09,"eps_growth_fwd":0.06965,"eps_growth_next":0.0682,"div_yield":0.0216,"roe":0.1334,"roa":0.05646,"de":81.13,"gross_margin":0.3618,"op_margin":0.111,"profit_margin":0.04107,"current_ratio":1.282},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.74,"sector":14.34,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":8.586,"sector":21.52,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.662,"sector":1.215,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":17.22,"sector":17.24,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":3.14,"sector":1.45,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.824,"sector":2.529,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":66.14,"sector":81.13,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.174,"sector":0.043,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.571,"sector":0.09,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0299,"sector":0.06965,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0426,"sector":0.0682,"verdict":"Weak"},{