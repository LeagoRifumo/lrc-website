s the automotive, communications, enterprise computing, consumer electronics, and industrial markets. Arteris, Inc. was founded in 2003 and is headquartered in Campbell, California.","employees":373,"website":"https://www.arteris.com","country":"United States","city":"Campbell","officers":[{"name":"Mr. Karel Charles Janac","title":"Chairman, CEO & President"},{"name":"Dr. Laurent R. Moll","title":"Executive VP of Engineering & COO"},{"name":"Mr. Saurabh  Sinha","title":"Executive VP & CFO"}]},"sector_medians":{"fpe":17.23,"tpe":29.42,"ps":4.345,"pfcf":25.83,"peg":1.1,"pb":4.645,"ev_ebitda":18.74,"rev_growth":0.1935,"eps_growth":0.377,"eps_growth_fwd":0.2545,"eps_growth_next":0.1771,"div_yield":0,"roe":0.1242,"roa":0.05009,"de":32.04,"gross_margin":0.5374,"op_margin":0.1175,"profit_margin":0.09496,"current_ratio":1.852},"valuation":[{"k":"fpe","label":"Forward P/E","v":157.4,"sector":17.23,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":29.42,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":10.33,"sector":4.345,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":32.04,"sector":25.83,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":null,"sector":1.1,"verdict":"—"},{"k":"pb","label":"Price / Book","v":14.59,"sector":4.645,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":13.93,"sector":32.04,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.481,"sector":0.1935,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.377,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.5714,"sector":0.2545,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":1.869,"sector":0.1771,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.8691,"sector":0.5374,"verdict":"Strong"},{"k":"op_margin","label":"Operating margin","v":-0.4062,"sector":0.1175,"verdict":"Weak"},{"k":"profit_margin",