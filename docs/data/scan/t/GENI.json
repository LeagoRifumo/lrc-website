ntegrated bet slip, real-time team and player statistics, personalized, and augmented viewing modes; and FanHub, an advertising solution that helps in creation, delivery, and optimization of digital marketing campaigns, including data-driven personalized ad creative and programmatic media buying. The company was formerly known as Genius Sports Group Limited and changed its name to Genius Sports Limited in April 2021. Genius Sports Limited was founded in 2001 and is headquartered in London, the United Kingdom.","employees":2000,"website":"https://www.geniussports.com","country":"United Kingdom","city":"London","officers":[{"name":"Mr. Mark Adrian Locke","title":"Co-Founder & CEO"},{"name":"Mr. Bryan David Castellani","title":"CFO & Director"},{"name":"Mr. Matt  Fleckenstein","title":"Chief Product & Technology Officer"}]},"sector_medians":{"fpe":11.5,"tpe":18.27,"ps":2.108,"pfcf":11.89,"peg":0.995,"pb":2.281,"ev_ebitda":13.44,"rev_growth":0.079,"eps_growth":0.0245,"eps_growth_fwd":0.1472,"eps_growth_next":0.1506,"div_yield":0,"roe":0.09043,"roa":0.04078,"de":62.07,"gross_margin":0.5683,"op_margin":0.1295,"profit_margin":0.07708,"current_ratio":1.267},"valuation":[{"k":"fpe","label":"Forward P/E","v":6.415,"sector":11.5,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":18.27,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":2.303,"sector":2.108,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":11.31,"sector":11.89,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":null,"sector":0.995,"verdict":"—"},{"k":"pb","label":"Price / Book","v":2.66,"sector":2.281,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":120.0,"sector":62.07,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.647,"sector":0.079,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.0245,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":2.679,"