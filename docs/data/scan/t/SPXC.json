asurement segment offers underground pipe and cable locators, inspection and rehabilitation equipment, robotic systems under the Radiodetection, Pearpoint, Schonstedt, Dielectric, Cues, ULC Robotics, and Sensors & Software brands; transportation systems under the Genfare brand; communication technologies under the TCI, ECS, and KTS brands; and aids to navigation products under the Flash Technology, ITL, Sabik Marine, Sealite, and Avlite brands. The company markets its products through consumers, independent manufacturing representatives, third-party distributors, and retailers. The company was formerly known as SPX Corporation and changed its name to SPX Technologies, Inc. in August 2022. SPX Technologies, Inc. is headquartered in Charlotte, North Carolina.","employees":4700,"website":"https://www.spx.com","country":"United States","city":"Charlotte","officers":[{"name":"Mr. Eugene Joseph Lowe III","title":"President, CEO & Director"},{"name":"Mr. Mark A. Carano","title":"VP & CFO"},{"name":"Mr. John William Swann III","title":"Executive Officer"}]},"sector_medians":{"fpe":17.75,"tpe":26.36,"ps":2.156,"pfcf":26.62,"peg":1.4,"pb":3.514,"ev_ebitda":14.88,"rev_growth":0.11,"eps_growth":0.176,"eps_growth_fwd":0.1441,"eps_growth_next":0.1459,"div_yield":0.0066,"roe":0.149,"roa":0.05825,"de":66.95,"gross_margin":0.3185,"op_margin":0.1262,"profit_margin":0.0723,"current_ratio":1.665},"valuation":[{"k":"fpe","label":"Forward P/E","v":17.13,"sector":17.75,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":29.11,"sector":26.36,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":3.339,"sector":2.156,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":35.33,"sector":26.62,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":0.91,"sector":1.4,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":3.52,"sector":3.514,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":26.18,"sector":66.95,"verdict":"Low debt"},{"k":"rev_grow