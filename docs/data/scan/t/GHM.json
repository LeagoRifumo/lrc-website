ctor; advanced mixing systems, including bladeless centrifugal mixers, accessories, services, and consumables; and spare parts for its equipment. It serves customers in the United States, Asia, Canada, the Middle East, South America, and internationally. Graham Corporation was founded in 1936 and is headquartered in Batavia, New York.","employees":732,"website":"https://grahamcorp.com","country":"United States","city":"Batavia","officers":[{"name":"Mr. Matthew J. Malone","title":"President, CEO & Director"},{"name":"Mr. Christopher J. Thome CPA","title":"Chief Accounting Officer, VP of Finance, CFO & Corporate Secretary"},{"name":"Mr. Michael E. Dixon","title":"VP & GM of Barber-Nichols"}]},"sector_medians":{"fpe":18.0,"tpe":25.61,"ps":2.127,"pfcf":27.19,"peg":1.4,"pb":3.62,"ev_ebitda":14.76,"rev_growth":0.119,"eps_growth":0.176,"eps_growth_fwd":0.1641,"eps_growth_next":0.1439,"div_yield":0.0071,"roe":0.1451,"roa":0.05694,"de":67.22,"gross_margin":0.3203,"op_margin":0.1163,"profit_margin":0.07298,"current_ratio":1.741},"valuation":[{"k":"fpe","label":"Forward P/E","v":36.29,"sector":18.0,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":74.48,"sector":25.61,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":3.697,"sector":2.127,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":34.45,"sector":27.19,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":2.5,"sector":1.4,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":4.938,"sector":3.62,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":3.241,"sector":67.22,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.057,"sector":0.119,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.393,"sector":0.176,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.3274,"sector":0.1641,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.2368,"sector":0.1439,"verdict