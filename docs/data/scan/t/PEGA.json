eographies, etc.; Pega GenAI Blueprint to rapidly prototype and accelerate the development and deployment of applications; Pega Cloud that allows clients to develop, test, and deploy applications;  Pega Catalyst, which helps clients to transform and prototype their customer journeys; Pega Academy, which offers enablement content for Pega product implementations, such as instructor-led and online training to its employees, clients, and partners; and global service assurance and client support services. It primarily markets its software and services to financial services, healthcare, communications and media, government, insurance, manufacturing and high tech, and consumer industries through a direct sales force, as well as partnerships with technology providers and application developers. Pegasystems Inc. was incorporated in 1983 and is headquartered in Waltham, Massachusetts.","employees":5598,"website":"https://www.pega.com","country":"United States","city":"Waltham","officers":[{"name":"Mr. Alan  Trefler","title":"Founder, CEO & Chairman of the Board"},{"name":"Mr. Kenneth R. Stillwell Jr.","title":"COO & CFO"},{"name":"Mr. Leon  Trefler","title":"Chief of Clients & Markets"}]},"sector_medians":{"fpe":18.26,"tpe":31.4,"ps":4.764,"pfcf":26.86,"peg":1.15,"pb":4.974,"ev_ebitda":20.02,"rev_growth":0.17,"eps_growth":0.345,"eps_growth_fwd":0.2306,"eps_growth_next":0.1867,"div_yield":0,"roe":0.1243,"roa":0.04866,"de":29.26,"gross_margin":0.5169,"op_margin":0.1199,"profit_margin":0.08708,"current_ratio":1.825},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.88,"sector":18.26,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":21.8,"sector":31.4,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":3.306,"sector":4.764,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":11.61,"sector":26.86,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":2.99,"sector":1.15,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":10.52,"sector":4.9