sfer and ACH services, brokerage services, and alternative investment products, such as annuities and mutual funds, trust and asset management services; letters of credit and home equity lines of credit; and online, mobile, and telephone banking platforms. The company was formerly known as SouthState Corporation and changed its name to SouthState Bank Corporation in September 2025. SouthState Bank Corporation was founded in 1933 and is headquartered in Winter Haven, Florida.","employees":6000,"website":"https://www.southstatebank.com","country":"United States","city":"Winter Haven","officers":[{"name":"Mr. John C. Corbett","title":"CEO & Chairman"},{"name":"Mr. Richard  Murray IV","title":"President & Chief Banking Officer"},{"name":"Mr. William E. Matthews V","title":"Senior Executive VP & CFO"}]},"sector_medians":{"fpe":10.61,"tpe":12.89,"ps":3.433,"pfcf":12.03,"peg":1.3,"pb":1.609,"ev_ebitda":10.69,"rev_growth":0.109,"eps_growth":0.153,"eps_growth_fwd":0.1337,"eps_growth_next":0.1104,"div_yield":0.0215,"roe":0.1283,"roa":0.01521,"de":54.95,"gross_margin":0.2245,"op_margin":0.3601,"profit_margin":0.2534,"current_ratio":1.509},"valuation":[{"k":"fpe","label":"Forward P/E","v":10.23,"sector":10.61,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":11.25,"sector":12.89,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":3.871,"sector":3.433,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":12.03,"verdict":"—"},{"k":"peg","label":"PEG","v":1.45,"sector":1.3,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":1.13,"sector":1.609,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":54.95,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":-0.041,"sector":0.109,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.05,"sector":0.153,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0162,"sector":0.1337,"verdict"