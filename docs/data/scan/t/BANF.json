s. It serves non-metropolitan trade centers and cities in the metropolitan statistical areas of Oklahoma. The company was formerly known as United Community Corporation and changed its name to BancFirst Corporation in November 1988. BancFirst Corporation was incorporated in 1984 and is headquartered in Oklahoma City, Oklahoma.","employees":2260,"website":"https://www.bancfirst.bank","country":"United States","city":"Oklahoma City","officers":[{"name":"Mr. David R. Harlow","title":"President, CEO & Director"},{"name":"Ms. Hannah  Andrus","title":"Executive VP, CFO, Treasurer & Principal Accounting Officer"},{"name":"Mr. John K. Slay Jr.","title":"Executive VP & Chief Credit Officer of BancFirst"}]},"sector_medians":{"fpe":10.72,"tpe":12.55,"ps":3.456,"pfcf":11.44,"peg":1.32,"pb":1.611,"ev_ebitda":11.23,"rev_growth":0.088,"eps_growth":0.114,"eps_growth_fwd":0.1346,"eps_growth_next":0.1037,"div_yield":0.02165,"roe":0.1288,"roa":0.01564,"de":53.95,"gross_margin":0.243,"op_margin":0.3491,"profit_margin":0.2565,"current_ratio":1.519},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.52,"sector":10.72,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":15.76,"sector":12.55,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":5.494,"sector":3.456,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":11.44,"verdict":"—"},{"k":"peg","label":"PEG","v":2.09,"sector":1.32,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.998,"sector":1.611,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":53.95,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.077,"sector":0.088,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.065,"sector":0.114,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0816,"sector":0.1346,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0633,"sector":0.1037,"verdict":"