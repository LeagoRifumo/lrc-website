ich offers free access to basic information through publicly available APIs and paid access to content and data for consumer-facing enterprise use. In addition, it provides content licensing and consumer-interactive tools. Further, the company offers its products directly through its sales force; indirectly through partners; and online through its website and business app, as well as non-advertising partner arrangements. It has partnership with DOORDASH to provide consumers with a service to place food orders for pickup and delivery. The company was formerly known as Yelp! Inc. and changed its name to Yelp Inc. in November 2005. Yelp Inc. was incorporated in 2004 and is based in San Francisco, California.","employees":5168,"website":"https://www.yelp.com","country":"United States","city":"San Francisco","officers":[{"name":"Mr. Jeremy  Stoppelman","title":"Co-Founder, CEO & Director"},{"name":"Mr. David A. Schwarzbach","title":"Chief Financial Officer"},{"name":"Mr. Joseph R. Nachman","title":"Chief Operating Officer"}]},"sector_medians":{"fpe":12.0,"tpe":16.98,"ps":2.068,"pfcf":12.01,"peg":1.005,"pb":2.373,"ev_ebitda":12.54,"rev_growth":0.0905,"eps_growth":0.068,"eps_growth_fwd":0.1456,"eps_growth_next":0.1345,"div_yield":0,"roe":0.09388,"roa":0.04097,"de":59.99,"gross_margin":0.5601,"op_margin":0.1305,"profit_margin":0.07559,"current_ratio":1.317},"valuation":[{"k":"fpe","label":"Forward P/E","v":5.61,"sector":12.0,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":9.761,"sector":16.98,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.7573,"sector":2.068,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":4.155,"sector":12.01,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.57,"sector":1.005,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.654,"sector":2.373,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":14.37,"sector":59.99,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","