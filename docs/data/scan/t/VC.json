d domain controller; SmartCore Runtime, a middleware enabling communication between domains and apps to be shown on any display; and SmartCore Studio, a PC-based configuration tool to generate hypervisor configurations. Further, it offers CognitoAI, an in-house, automotive-grade A.I. software platform; Battery Management Systems, configurable battery management systems; High-Voltage Power Electronics, an integrated and scalable power electronics units; and engineering and software development services. It operates in the United States, Mexico, Portugal, Slovakia, Tunisia, rest of Europe, China, India, Japan, rest of the Asia Pacific, and South America. Visteon Corporation was incorporated in 2000 and is headquartered in Van Buren, Michigan.","employees":10500,"website":"https://www.visteon.com","country":"United States","city":"Van Buren","officers":[{"name":"Mr. Sachin S. Lawande","title":"President, CEO & Director"},{"name":"Mr. Jerome J. Rouquet","title":"Senior VP & CFO"},{"name":"Mr. Brett D. Pynnonen J.D.","title":"Senior VP & Chief Legal Officer"}]},"sector_medians":{"fpe":14.65,"tpe":19.21,"ps":1.252,"pfcf":18.23,"peg":1.15,"pb":2.925,"ev_ebitda":11.78,"rev_growth":0.057,"eps_growth":0.174,"eps_growth_fwd":0.1136,"eps_growth_next":0.1239,"div_yield":0.00755,"roe":0.1543,"roa":0.06135,"de":109.2,"gross_margin":0.3804,"op_margin":0.09768,"profit_margin":0.05785,"current_ratio":1.444},"valuation":[{"k":"fpe","label":"Forward P/E","v":7.396,"sector":14.65,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":19.98,"sector":19.21,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":0.4728,"sector":1.252,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":50.32,"sector":18.23,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.01,"sector":1.15,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":1.282,"sector":2.925,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":30.66,"sector":109.2,"verdict":"Low debt"}