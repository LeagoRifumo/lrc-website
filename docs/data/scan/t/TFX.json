s used in laparoscopic surgical procedures, percutaneous surgical systems, powered bariatric staplers, and other surgical instruments under the Weck, MiniLap, Pleur-Evac, Deknatel, KMedic, Pilling, and Titan SGS brands. It serves hospitals, healthcare providers, and medical device manufacturers. The company also sells its products online. Teleflex Incorporated was incorporated in 1943 and is headquartered in Wayne, Pennsylvania.","employees":15500,"website":"https://www.teleflex.com","country":"United States","city":"Wayne","officers":[{"name":"Mr. John R. Deren","title":"Executive VP & CFO"},{"name":"Mr. Daniel V. Logue J.D.","title":"Corporate VP, General Counsel & Secretary"},{"name":"Mr. Cameron P. Hicks","title":"Corporate Vice President of Human Resources & Communications"}]},"sector_medians":{"fpe":18.6,"tpe":30.73,"ps":4.259,"pfcf":27.92,"peg":1.36,"pb":4.405,"ev_ebitda":17.1,"rev_growth":0.0975,"eps_growth":0.1735,"eps_growth_fwd":0.09425,"eps_growth_next":0.1209,"div_yield":0,"roe":0.01671,"roa":0.02187,"de":44.07,"gross_margin":0.4971,"op_margin":0.03985,"profit_margin":0,"current_ratio":3.18},"valuation":[{"k":"fpe","label":"Forward P/E","v":12.77,"sector":18.6,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":30.73,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":2.627,"sector":4.259,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":32.99,"sector":27.92,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":0.16,"sector":1.36,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":2.039,"sector":4.405,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":101.1,"sector":44.07,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.289,"sector":0.0975,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.173,"sector":0.1735,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.014,"sector":0.09425,"verdict":"Weak"},