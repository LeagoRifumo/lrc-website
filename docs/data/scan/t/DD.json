ess solutions used in OEM and operational applications, such as automotive, aerospace, printing, and packaging. Additionally, the company offers Vespel shapes and parts, MOLYKOTE specialty lubricants, BETAFORCE and BETASEAL structural adhesives, and Cyrel flexographic printing plates. The company was formerly known as DowDuPont Inc. and changed its name to DuPont de Nemours, Inc. in June 2019. DuPont de Nemours, Inc. was incorporated in 2015 and is headquartered in Wilmington, Delaware.","employees":15000,"website":"https://www.dupont.com","country":"United States","city":"Wilmington","officers":[{"name":"Ms. Lori D. Koch","title":"CEO & Director"},{"name":"Ms. Antonella B. Franzen","title":"Senior VP & CFO"},{"name":"Mr. Erik T. Hoover J.D.","title":"Senior VP & General Counsel"}]},"sector_medians":{"fpe":12.19,"tpe":18.84,"ps":2.345,"pfcf":23.07,"peg":1.72,"pb":2.364,"ev_ebitda":9.287,"rev_growth":0.165,"eps_growth":0.461,"eps_growth_fwd":0.3332,"eps_growth_next":0.1502,"div_yield":0.0088,"roe":0.1206,"roa":0.06766,"de":44.82,"gross_margin":0.3339,"op_margin":0.1746,"profit_margin":0.06777,"current_ratio":2.083},"valuation":[{"k":"fpe","label":"Forward P/E","v":17.23,"sector":12.19,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":37.01,"sector":18.84,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":2.66,"sector":2.345,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":10.13,"sector":23.07,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.72,"sector":1.72,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":1.35,"sector":2.364,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":22.9,"sector":44.82,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.04,"sector":0.165,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":1.496,"sector":0.461,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.4399,"sector":0.3332,"verdict":"S