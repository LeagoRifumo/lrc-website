er representative organizations to fire protection and security product distributors, electrical wholesale houses, and original equipment manufacturers of fire protection systems. Further, the company is involved in the research and development of nanofiber chemical sensing products; and market and sale of eSight smart glasses to consumers with visual impairment or eye conditions, as well as of identity authentication and access control products that utilizes biometrics technology. It operates in the United States, China, Germany, Japan, Mexico, South Korea, and internationally. Gentex Corporation was incorporated in 1974 and is headquartered in Zeeland, Michigan.","employees":6398,"website":"https://www.gentex.com","country":"United States","city":"Zeeland","officers":[{"name":"Mr. Steven R. Downing","title":"President, CEO & Director"},{"name":"Mr. Kevin C. Nash C.M.A.","title":"VP of Finance, CFO, Treasurer & Chief Accounting Officer"},{"name":"Mr. Neil  Boehm","title":"COO & CTO"}]},"sector_medians":{"fpe":14.31,"tpe":18.84,"ps":1.207,"pfcf":20.05,"peg":1.13,"pb":2.866,"ev_ebitda":11.58,"rev_growth":0.058,"eps_growth":0.167,"eps_growth_fwd":0.1094,"eps_growth_next":0.1263,"div_yield":0.0077,"roe":0.1518,"roa":0.06079,"de":109.9,"gross_margin":0.3789,"op_margin":0.09691,"profit_margin":0.05663,"current_ratio":1.447},"valuation":[{"k":"fpe","label":"Forward P/E","v":9.398,"sector":14.31,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":10.73,"sector":18.84,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.615,"sector":1.207,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":20.05,"verdict":"—"},{"k":"peg","label":"PEG","v":0.56,"sector":1.13,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.702,"sector":2.866,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":109.9,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":-0.011,"sector":0.058,"verdict":"Weak"},{"k":"ep