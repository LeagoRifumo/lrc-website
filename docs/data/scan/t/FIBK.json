erves individuals, businesses, municipalities, and other entities in various industries, including agriculture, construction, education, governmental services, healthcare, hospitality, housing, professional services, real estate development, retail, technology, tourism, and wholesale trade. First Interstate BancSystem, Inc. was formerly known as First Interstate Bancsystem Of Montana, Inc. and changed its name to First Interstate BancSystem, Inc. in June 1993. The company was founded in 1879 and is headquartered in Billings, Montana.","employees":3376,"website":"https://www.fibk.com","country":"United States","city":"Billings","officers":[{"name":"Mr. James A. Reuter","title":"President, CEO & Director"},{"name":"Mr. David P. Della Camera C.F.A.","title":"Executive VP & CFO"},{"name":"Ms. Lori A. Meyer","title":"Executive VP & Chief Information Officer"}]},"sector_medians":{"fpe":10.71,"tpe":12.48,"ps":3.441,"pfcf":11.44,"peg":1.32,"pb":1.61,"ev_ebitda":11.14,"rev_growth":0.088,"eps_growth":0.114,"eps_growth_fwd":0.1346,"eps_growth_next":0.1037,"div_yield":0.02165,"roe":0.1288,"roa":0.01564,"de":53.95,"gross_margin":0.243,"op_margin":0.3491,"profit_margin":0.2565,"current_ratio":1.519},"valuation":[{"k":"fpe","label":"Forward P/E","v":12.79,"sector":10.71,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":11.74,"sector":12.48,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":3.319,"sector":3.441,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":11.44,"verdict":"—"},{"k":"peg","label":"PEG","v":1.16,"sector":1.32,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":1.113,"sector":1.61,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":53.95,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":-0.046,"sector":0.088,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.058,"sector":0.114,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS gr