d internationally. The company was formerly known as Lawson Products, Inc. and has changed to Distribution Solutions Group, Inc. 2022. Distribution Solutions Group, Inc. was incorporated in 1952 and is headquartered in Fort Worth, Texas.","employees":4300,"website":"https://distributionsolutionsgroup.com","country":"United States","city":"Fort Worth","officers":[{"name":"Mr. John Bryan King C.F.A.","title":"President, CEO & Chairman"},{"name":"Mr. Barry  Litwin","title":"Chief Executive Officer of Test Equity"},{"name":"Mr. Cesar A. Lanuza","title":"President & CEO of Lawson Products"}]},"sector_medians":{"fpe":17.94,"tpe":26.67,"ps":2.183,"pfcf":27.09,"peg":1.39,"pb":3.569,"ev_ebitda":15.27,"rev_growth":0.1115,"eps_growth":0.205,"eps_growth_fwd":0.156,"eps_growth_next":0.1459,"div_yield":0.0067,"roe":0.1485,"roa":0.05825,"de":66.55,"gross_margin":0.3184,"op_margin":0.1215,"profit_margin":0.07337,"current_ratio":1.672},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":17.94,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":184.1,"sector":26.67,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":0.788,"sector":2.183,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":42.09,"sector":27.09,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":2.69,"sector":1.39,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":2.47,"sector":3.569,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":129.1,"sector":66.55,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.11,"sector":0.1115,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.669,"sector":0.205,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2339,"sector":0.156,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1471,"sector":0.1459,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0.327,"sector":0.3184,"verdict":"In line"},{