roducts to grocery stores, mass merchants, warehouse clubs, discount chains, dollar stores, drug stores, home improvement stores, military outlets, and eCommerce retailers. Reynolds Consumer Products Inc. was founded in 1947 and is headquartered in Lake Forest, Illinois. Reynolds Consumer Products Inc. is a subsidiary of Packaging Finance Limited.","employees":6000,"website":"https://www.reynoldsconsumerproducts.com","country":"United States","city":"Lake Forest","officers":[{"name":"Mr. Scott E. Huckins","title":"President, CEO & Director"},{"name":"Mr. Nathan D. Lowe","title":"Chief Financial Officer"},{"name":"Ms. Jill  Barnett J.D.","title":"Chief Legal Officer & Corporate Secretary"}]},"sector_medians":{"fpe":14.87,"tpe":19.57,"ps":1.234,"pfcf":19.46,"peg":1.18,"pb":2.942,"ev_ebitda":11.96,"rev_growth":0.055,"eps_growth":0.149,"eps_growth_fwd":0.1026,"eps_growth_next":0.1198,"div_yield":0.0074,"roe":0.1516,"roa":0.06133,"de":102.4,"gross_margin":0.3788,"op_margin":0.0968,"profit_margin":0.0578,"current_ratio":1.418},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.53,"sector":14.87,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":16.16,"sector":19.57,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.374,"sector":1.234,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":23.66,"sector":19.46,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":null,"sector":1.18,"verdict":"—"},{"k":"pb","label":"Price / Book","v":2.238,"sector":2.942,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":70.33,"sector":102.4,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.014,"sector":0.055,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.268,"sector":0.149,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0174,"sector":0.1026,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0558,"sector":0.1198,