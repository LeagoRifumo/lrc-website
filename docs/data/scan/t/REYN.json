gion. This segment also includes the specialty business providing Fresh-Lock and Slide-Rite resealable closure systems. Reynolds Consumer Products Inc. was founded in 1947 and is headquartered in Lake Forest, Illinois. Reynolds Consumer Products Inc. operates as a subsidiary of Packaging Finance Limited.","employees":6000,"website":"https://www.reynoldsconsumerproducts.com","country":"United States","city":"Lake Forest","officers":[{"name":"Mr. Scott E. Huckins","title":"President, CEO & Director"},{"name":"Mr. Nathan D. Lowe","title":"Chief Financial Officer"},{"name":"Ms. Jill  Barnett J.D.","title":"Chief Legal Officer & Corporate Secretary"}]},"sector_medians":{"fpe":14.89,"tpe":19.01,"ps":1.209,"pfcf":19.08,"peg":1.19,"pb":2.759,"ev_ebitda":11.67,"rev_growth":0.0525,"eps_growth":0.134,"eps_growth_fwd":0.1001,"eps_growth_next":0.118,"div_yield":0.0071,"roe":0.1521,"roa":0.05898,"de":101.6,"gross_margin":0.3774,"op_margin":0.09487,"profit_margin":0.05776,"current_ratio":1.425},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.73,"sector":14.89,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":16.39,"sector":19.01,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.392,"sector":1.209,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":23.96,"sector":19.08,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":null,"sector":1.19,"verdict":"—"},{"k":"pb","label":"Price / Book","v":2.267,"sector":2.759,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":70.33,"sector":101.6,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.014,"sector":0.0525,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.268,"sector":0.134,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0174,"sector":0.1001,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0558,"sector":0.118,"verdict":"Weak"},{"k":"gross_margin","labe