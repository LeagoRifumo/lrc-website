{"q":"2026-03-31","act":2.242,"est":2.17,"surp":0.0332},{"q":"2026-06-30","act":0.8199,"est":0.96,"surp":-0.1459},{"q":"2026-09-30","act":0.4262,"est":0.88,"surp":-0.5157}],"div_pay":"2026-09-28","rec_trend":{"strongBuy":1,"buy":4,"hold":0,"sell":0,"strongSell":0},"analyst_actions":[]},"profile":{"sector":"Financial Services","industry":"Capital Markets","summary":"Gold.com, Inc., together with its subsidiaries, operates as a precious metals company. It operates through three segments: Wholesale Sales & Ancillary Services, Direct-to-Consumer, and Secured Lending. The Wholesale Sales & Ancillary Services segment sells gold, silver, platinum, and palladium in the form of bars, plates, powders, wafers, grains, ingots, and coins under the A-Mark brand. This segment also offers complementary services, such as receiving, handling, inventorying, processing, packing, and shipping of precious metals and custom coins on a secure basis; and designs and produces minted silver products. The Direct-to-Consumer segment sells and delivers gold, silver, platinum, palladium, and copper products directly to customers and the investor community through television, radio, and the internet, as well as through customer service outreach; rarities and numismatic collections; and numismatic and bullion products. It operates various websites targeting specific niches within the precious metals retail market. The Secured Lending segment originates and acquires commercial loans secured by bullion, numismatic coins, and graded sports cards. The company serves customers, including financial institutions, bullion retailers, industrial manufacturers and fabricators, sovereign mints, refiners, coin and metal dealers, investors, collectors, and e-commerce and other retail customers. It operates in the United States, Europe, Canada, the Asia Pacific, Africa, Australia, and South America. The company was formerly known as A-Mark Precious Metals, Inc. and changed its name to Gold.com, Inc. in December 2025. The company was founded in 1965 and is headquartered in Costa Mesa, California.","employees":1303,"website":"https://www.gold.com","country":"United States","city":"Costa Mesa","officers":[{"name":"Mr. Gregory N. Roberts","title":"CEO & Director"},{"name":"Mr. Thor G. Gjerdrum","title":"President"},{"name":"Mr. Brian  Aquilino","title":"Chief Operating Officer"}]},"sector_medians":{"fpe":10.56,"tpe":12.5,"ps":3.456,"pfcf":12.26,"peg":1.32,"pb":1.595,"ev_ebitda":10.43,"rev_growth":0.089,"eps_growth":0.1285,"eps_growth_fwd":0.1351,"eps_growth_next":0.1043,"div_yield":0.0217,"roe":0.1287,"roa":0.01568,"de":54.8,"gross_margin":0.2385,"op_margin":0.3641,"profit_margin":0.2563,"current_ratio":1.517},"valuation":[{"k":"fpe","label":"Forward P/E","v":10.06,"sector":10.56,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":12.43,"sector":12.5,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":0.0428,"sector":3.456,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":2.67,"sector":12.26,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":null,"sector":1.32,"verdict":"—"},{"k":"pb","label":"Price / Book","v":1.248,"sector":1.595,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":96.09,"sector":54.8,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.992,"sector":0.089,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.013,"sector":0.1285,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0492,"sector":0.1351,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":null,"sector":0.1043,"verdict":"—"},{"k":"gross_margin","label":"Gross margin","v":0.01776,"sector":0.2385,"verdict":"Weak"},{"k":"op_margin","label":"Operating margin","v":0.00447,"sector":0.3641,"verdict":"Weak"},{"k":"profit_margin","label":"Net margin","v":0.00323,"sector":0.2563,"verdict":"Weak"},{"k":"roe","label":"Return on equity","v":0.108,"sec