forms, and insurance agents. The company was formerly known as Brooke (Holdco1) Inc. and changed its name to Jackson Financial Inc. in July 2020. Jackson Financial Inc. was incorporated in 2006 and is headquartered in Lansing, Michigan.","employees":3090,"website":"https://www.jackson.com","country":"United States","city":"Lansing","officers":[{"name":"Mr. Don Wayne Cummings","title":"CEO, President & Director"},{"name":"Ms. Carrie Lynn Chelko","title":"Executive VP & General Counsel"},{"name":"Ms. Laura Louene Prieskorn","title":"Advisor"}]},"sector_medians":{"fpe":10.56,"tpe":12.75,"ps":3.428,"pfcf":12.47,"peg":1.32,"pb":1.609,"ev_ebitda":10.74,"rev_growth":0.1,"eps_growth":0.152,"eps_growth_fwd":0.1326,"eps_growth_next":0.1087,"div_yield":0.0217,"roe":0.1279,"roa":0.01565,"de":53.89,"gross_margin":0.2437,"op_margin":0.326,"profit_margin":0.2552,"current_ratio":1.531},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":10.56,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":149.4,"sector":12.75,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":1.406,"sector":3.428,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":7.501,"sector":12.47,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":null,"sector":1.32,"verdict":"—"},{"k":"pb","label":"Price / Book","v":0.9833,"sector":1.609,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":54.61,"sector":53.89,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":null,"sector":0.1,"verdict":"—"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":2.916,"sector":0.152,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1952,"sector":0.1326,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1674,"sector":0.1087,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.488,"sector":0.2437,"verdict":"Strong"},{"k":"op_margin","label":"Operating margin","v":-8.101,"sector":0.326