 Cricut, Inc. was formerly known as Provo Craft & Novelty, Inc. and changed its name to Cricut, Inc. in March 2018. The company was incorporated in 1969 and is headquartered in South Jordan, Utah.","employees":700,"website":"https://www.cricut.com","country":"United States","city":"South Jordan","officers":[{"name":"Mr. Ashish  Arora","title":"CEO, President & Director"},{"name":"Mr. Kimball  Shill","title":"Chief Financial Officer"},{"name":"Mr. Matt  Tuttle","title":"Senior VP, General Counsel & Corporate Secretary"}]},"sector_medians":{"fpe":17.43,"tpe":29.46,"ps":4.426,"pfcf":26.1,"peg":1.11,"pb":4.666,"ev_ebitda":18.99,"rev_growth":0.191,"eps_growth":0.356,"eps_growth_fwd":0.2432,"eps_growth_next":0.1802,"div_yield":0,"roe":0.1241,"roa":0.04945,"de":32.8,"gross_margin":0.5312,"op_margin":0.1174,"profit_margin":0.09364,"current_ratio":1.863},"valuation":[{"k":"fpe","label":"Forward P/E","v":29.69,"sector":17.43,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":19.32,"sector":29.46,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":2.501,"sector":4.426,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":23.44,"sector":26.1,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":null,"sector":1.11,"verdict":"—"},{"k":"pb","label":"Price / Book","v":4.432,"sector":4.666,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":2.363,"sector":32.8,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.107,"sector":0.191,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.345,"sector":0.356,"verdict":"In line"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2971,"sector":0.2432,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":-0.3693,"sector":0.1802,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.5738,"sector":0.5312,"verdict":"In line"},{"k":"op_margin","label":"Operating margin","v":0.1553,"sector":0.1174,"