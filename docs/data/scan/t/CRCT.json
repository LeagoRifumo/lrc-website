 Inc. and changed its name to Cricut, Inc. in March 2018. The company was incorporated in 1969 and is headquartered in South Jordan, Utah.","employees":700,"website":"https://www.cricut.com","country":"United States","city":"South Jordan","officers":[{"name":"Mr. Ashish  Arora","title":"CEO, President & Director"},{"name":"Mr. Kimball  Shill","title":"Chief Financial Officer"},{"name":"Mr. Matt  Tuttle","title":"Senior VP, General Counsel & Corporate Secretary"}]},"sector_medians":{"fpe":17.92,"tpe":31.96,"ps":4.757,"pfcf":27.69,"peg":1.155,"pb":5.077,"ev_ebitda":20.02,"rev_growth":0.177,"eps_growth":0.339,"eps_growth_fwd":0.2255,"eps_growth_next":0.1929,"div_yield":0,"roe":0.1195,"roa":0.04674,"de":32.62,"gross_margin":0.5331,"op_margin":0.1128,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":26.32,"sector":17.92,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":15.17,"sector":31.96,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.892,"sector":4.757,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":27.69,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":null,"sector":1.155,"verdict":"—"},{"k":"pb","label":"Price / Book","v":3.542,"sector":5.077,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":2.819,"sector":32.62,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.092,"sector":0.177,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.694,"sector":0.339,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0,"sector":0.2255,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":-0.3248,"sector":0.1929,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.5544,"sector":0.5331,"verdict":"In line"},{"k":"op_margin","label":"Operating margin","v":0.1889,"sector":0.1128,"verdict":"Strong"},{"k":"profit_margin","label":"Net margin","v":0