ne internal/external collaboration. The company offers Flow Production Tracking, a cloud-based production management software; Maya software that offers 3D modeling, animation, effects, rendering, and compositing solutions for film and video artists, game developers, and design visualization professionals; Media and Entertainment Collection that offers end-to-end creative tools for entertainment creation; and 3ds Max software, which provides 3D modeling, animation, and rendering solutions. It sells its products and services through a network of resellers and distributors. Autodesk, Inc. was incorporated in 1982 and is headquartered in San Francisco, California.","employees":14300,"website":"https://www.autodesk.com","country":"United States","city":"San Francisco","officers":[{"name":"Dr. Andrew  Anagnost Ph.D.","title":"President, CEO & Director"},{"name":"Mr. Janesh  Moorjani","title":"Executive VP & CFO"},{"name":"Mr. Steven M. Blum","title":"Executive VP & COO"}]},"sector_medians":{"fpe":15.4,"tpe":26.12,"ps":3.915,"pfcf":23.67,"peg":1.24,"pb":4.008,"ev_ebitda":17.25,"rev_growth":0.1915,"eps_growth":0.3665,"eps_growth_fwd":0.2522,"eps_growth_next":0.1747,"div_yield":0,"roe":0.1257,"roa":0.04981,"de":32.95,"gross_margin":0.5401,"op_margin":0.1184,"profit_margin":0.09529,"current_ratio":1.867},"valuation":[{"k":"fpe","label":"Forward P/E","v":16.54,"sector":15.4,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":29.18,"sector":26.12,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":6.348,"sector":3.915,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":15.66,"sector":23.67,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":5.81,"sector":1.24,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":14.62,"sector":4.008,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":109.5,"sector":32.95,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.161,"sector":0.1915,"verdict":"In line"},{"k":"ep