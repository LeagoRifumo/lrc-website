ernal collaboration. The company offers Flow Production Tracking, a cloud-based production management software; Maya software that offers 3D modeling, animation, effects, rendering, and compositing solutions for film and video artists, game developers, and design visualization professionals; Media and Entertainment Collection that offers end-to-end creative tools for entertainment creation; and 3ds Max software, which provides 3D modeling, animation, and rendering solutions. It sells its products and services through a network of resellers and distributors. Autodesk, Inc. was incorporated in 1982 and is headquartered in San Francisco, California.","employees":14300,"website":"https://www.autodesk.com","country":"United States","city":"San Francisco","officers":[{"name":"Dr. Andrew  Anagnost Ph.D.","title":"President, CEO & Director"},{"name":"Mr. Janesh  Moorjani","title":"Executive VP & CFO"},{"name":"Mr. Steven M. Blum","title":"Executive VP & COO"}]},"sector_medians":{"fpe":17.23,"tpe":29.42,"ps":4.345,"pfcf":25.83,"peg":1.1,"pb":4.645,"ev_ebitda":18.74,"rev_growth":0.1935,"eps_growth":0.377,"eps_growth_fwd":0.2545,"eps_growth_next":0.1771,"div_yield":0,"roe":0.1242,"roa":0.05009,"de":32.04,"gross_margin":0.5374,"op_margin":0.1175,"profit_margin":0.09496,"current_ratio":1.852},"valuation":[{"k":"fpe","label":"Forward P/E","v":18.62,"sector":17.23,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":33.64,"sector":29.42,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":7.094,"sector":4.345,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":17.5,"sector":25.83,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.87,"sector":1.1,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":16.34,"sector":4.645,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":109.5,"sector":32.04,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.161,"sector":0.1935,"verdict":"In line"},{"k":"eps_growth","label