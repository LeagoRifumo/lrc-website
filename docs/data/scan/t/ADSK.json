ers Flow Production Tracking, a cloud-based production management software; Maya software that offers 3D modeling, animation, effects, rendering, and compositing solutions for film and video artists, game developers, and design visualization professionals; Media and Entertainment Collection that offers end-to-end creative tools for entertainment creation; and 3ds Max software, which provides 3D modeling, animation, and rendering solutions. It sells its products and services through a network of resellers and distributors. Autodesk, Inc. was incorporated in 1982 and is headquartered in San Francisco, California.","employees":14300,"website":"https://www.autodesk.com","country":"United States","city":"San Francisco","officers":[{"name":"Dr. Andrew  Anagnost Ph.D.","title":"President, CEO & Director"},{"name":"Mr. Janesh  Moorjani","title":"Executive VP & CFO"},{"name":"Mr. Steven M. Blum","title":"Executive VP & COO"}]},"sector_medians":{"fpe":16.02,"tpe":27.09,"ps":4.093,"pfcf":24.68,"peg":1.18,"pb":4.154,"ev_ebitda":17.81,"rev_growth":0.1925,"eps_growth":0.3785,"eps_growth_fwd":0.2568,"eps_growth_next":0.1753,"div_yield":0,"roe":0.1233,"roa":0.04908,"de":32.71,"gross_margin":0.5346,"op_margin":0.1184,"profit_margin":0.09462,"current_ratio":1.863},"valuation":[{"k":"fpe","label":"Forward P/E","v":18.01,"sector":16.02,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":33.16,"sector":27.09,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":6.86,"sector":4.093,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":16.93,"sector":24.68,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.86,"sector":1.18,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":15.8,"sector":4.154,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":109.5,"sector":32.71,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.161,"sector":0.1925,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v"