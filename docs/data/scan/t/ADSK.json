oduct design and manufacturing collection tools; and Vault, a data management software for managing data in one central location, accelerate design processes, and streamline internal/external collaboration. The company offers Flow Production Tracking, a cloud-based production management software; Maya software that offers 3D modeling, animation, effects, rendering, and compositing solutions for film and video artists, game developers, and design visualization professionals; Media and Entertainment Collection that offers end-to-end creative tools for entertainment creation; and 3ds Max software, which provides 3D modeling, animation, and rendering solutions. It sells its products and services through a network of resellers and distributors. Autodesk, Inc. was incorporated in 1982 and is headquartered in San Francisco, California.","employees":14300,"website":"https://www.autodesk.com","country":"United States","city":"San Francisco","officers":[{"name":"Dr. Andrew  Anagnost Ph.D.","title":"President, CEO & Director"},{"name":"Mr. Janesh  Moorjani","title":"Executive VP & CFO"},{"name":"Mr. Steven M. Blum","title":"Executive VP & COO"}]},"sector_medians":{"fpe":17.88,"tpe":32.87,"ps":6.509,"pfcf":32.17,"peg":1.01,"pb":7.665,"ev_ebitda":21.94,"rev_growth":0.2175,"eps_growth":0.464,"eps_growth_fwd":0.2596,"eps_growth_next":0.1955,"div_yield":0.00105,"roe":0.2326,"roa":0.07978,"de":48.45,"gross_margin":0.586,"op_margin":0.2256,"profit_margin":0.1916,"current_ratio":1.562},"valuation":[{"k":"fpe","label":"Forward P/E","v":17.05,"sector":17.88,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":31.4,"sector":32.87,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":6.495,"sector":6.509,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":16.02,"sector":32.17,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.84,"sector":1.01,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":14.96,"sector":7.665,"verdict":"Overvalued"},{"k