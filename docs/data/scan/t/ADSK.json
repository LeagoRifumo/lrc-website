ed production management software; Maya software that offers 3D modeling, animation, effects, rendering, and compositing solutions for film and video artists, game developers, and design visualization professionals; Media and Entertainment Collection that offers end-to-end creative tools for entertainment creation; and 3ds Max software, which provides 3D modeling, animation, and rendering solutions. It sells its products and services through a network of resellers and distributors. Autodesk, Inc. was incorporated in 1982 and is headquartered in San Francisco, California.","employees":14300,"website":"https://www.autodesk.com","country":"United States","city":"San Francisco","officers":[{"name":"Dr. Andrew  Anagnost Ph.D.","title":"President, CEO & Director"},{"name":"Mr. Janesh  Moorjani","title":"Executive VP & CFO"},{"name":"Mr. Steven M. Blum","title":"Executive VP & COO"}]},"sector_medians":{"fpe":17.86,"tpe":31.06,"ps":4.627,"pfcf":26.47,"peg":1.145,"pb":4.805,"ev_ebitda":19.14,"rev_growth":0.178,"eps_growth":0.367,"eps_growth_fwd":0.2373,"eps_growth_next":0.1868,"div_yield":0,"roe":0.1214,"roa":0.04733,"de":31.61,"gross_margin":0.5318,"op_margin":0.1268,"profit_margin":0.09291,"current_ratio":1.82},"valuation":[{"k":"fpe","label":"Forward P/E","v":19.02,"sector":17.86,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":32.74,"sector":31.06,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":7.246,"sector":4.627,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":17.88,"sector":26.47,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.85,"sector":1.145,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":16.69,"sector":4.805,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":109.5,"sector":31.61,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.161,"sector":0.178,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.596,"sector":0.367,"verdict":"Strong"}