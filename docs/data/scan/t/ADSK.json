a management software for managing data in one central location, accelerate design processes, and streamline internal/external collaboration. The company offers Flow Production Tracking, a cloud-based production management software; Maya software that offers 3D modeling, animation, effects, rendering, and compositing solutions for film and video artists, game developers, and design visualization professionals; Media and Entertainment Collection that offers end-to-end creative tools for entertainment creation; and 3ds Max software, which provides 3D modeling, animation, and rendering solutions. It sells its products and services through a network of resellers and distributors. Autodesk, Inc. was incorporated in 1982 and is headquartered in San Francisco, California.","employees":14300,"website":"https://www.autodesk.com","country":"United States","city":"San Francisco","officers":[{"name":"Dr. Andrew  Anagnost Ph.D.","title":"President, CEO & Director"},{"name":"Mr. Janesh  Moorjani","title":"Executive VP & CFO"},{"name":"Mr. Steven M. Blum","title":"Executive VP & COO"}]},"sector_medians":{"fpe":18.05,"tpe":31.76,"ps":4.69,"pfcf":27.56,"peg":1.155,"pb":4.957,"ev_ebitda":20.23,"rev_growth":0.169,"eps_growth":0.352,"eps_growth_fwd":0.2214,"eps_growth_next":0.1917,"div_yield":0,"roe":0.1232,"roa":0.04714,"de":32.58,"gross_margin":0.5282,"op_margin":0.1189,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":17.18,"sector":18.05,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":31.64,"sector":31.76,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":6.536,"sector":4.69,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":16.13,"sector":27.56,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.84,"sector":1.155,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":15.05,"sector":4.957,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":109.5,"sector":32.58,"verdict":"Hig