pers, and design visualization professionals; Media and Entertainment Collection that offers end-to-end creative tools for entertainment creation; and 3ds Max software, which provides 3D modeling, animation, and rendering solutions. It sells its products and services through a network of resellers and distributors. Autodesk, Inc. was incorporated in 1982 and is headquartered in San Francisco, California.","employees":14300,"website":"https://www.autodesk.com","country":"United States","city":"San Francisco","officers":[{"name":"Dr. Andrew  Anagnost Ph.D.","title":"President, CEO & Director"},{"name":"Mr. Janesh  Moorjani","title":"Executive VP & CFO"},{"name":"Mr. Steven M. Blum","title":"Executive VP & COO"}]},"sector_medians":{"fpe":18.48,"tpe":32.63,"ps":6.546,"pfcf":32.36,"peg":0.98,"pb":7.834,"rev_growth":0.2175,"eps_growth":0.464,"eps_growth_fwd":0.2596,"eps_growth_next":0.1939,"div_yield":0.00115,"roe":0.2326,"roa":0.07978,"de":48.45,"gross_margin":0.586,"op_margin":0.2256,"profit_margin":0.1916,"current_ratio":1.562},"valuation":[{"k":"fpe","label":"Forward P/E","v":17.76,"sector":18.48,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":32.71,"sector":32.63,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":6.766,"sector":6.546,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":16.69,"sector":32.36,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.85,"sector":0.98,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":15.58,"sector":7.834,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":109.5,"sector":48.45,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.161,"sector":0.2175,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.596,"sector":0.464,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2092,"sector":0.2596,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.125