 pet owners. The company has collaborated with Blacksmith Medicines, Inc. to discover and develop novel antibiotics for animal health. Zoetis Inc. was incorporated in 2012 and is headquartered in Parsippany, New Jersey.","employees":14500,"website":"https://www.zoetis.com","country":"United States","city":"Parsippany","officers":[{"name":"Ms. Kristin C. Peck","title":"CEO & Director"},{"name":"Ms. Roxanne  Lagano","title":"Executive VP, General Counsel & Corporate Secretary"},{"name":"Mr. Wetteny N. Joseph C.P.A.","title":"Special Advisor to the CEO"}]},"sector_medians":{"fpe":18.9,"tpe":29.76,"ps":4.253,"pfcf":27.25,"peg":1.365,"pb":4.521,"ev_ebitda":16.91,"rev_growth":0.094,"eps_growth":0.1505,"eps_growth_fwd":0.0958,"eps_growth_next":0.1081,"div_yield":0,"roe":0.02656,"roa":0.02593,"de":42.28,"gross_margin":0.5132,"op_margin":0.04529,"profit_margin":0,"current_ratio":2.998},"valuation":[{"k":"fpe","label":"Forward P/E","v":13.14,"sector":18.9,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":14.11,"sector":29.76,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":3.587,"sector":4.253,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":16.59,"sector":27.25,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":3.92,"sector":1.365,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":10.34,"sector":4.521,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":280.3,"sector":42.28,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.013,"sector":0.094,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.118,"sector":0.1505,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0183,"sector":0.0958,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0136,"sector":0.1081,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.7165,"sector":0.5132,"verdict":"Strong"},{"k":"op_margin","label":"Operatin