f a test cell solution for device screening in AI and data center applications. Teradyne, Inc. was incorporated in 1960 and is headquartered in North Reading, Massachusetts.","employees":6600,"website":"https://www.teradyne.com","country":"United States","city":"North Reading","officers":[{"name":"Mr. Gregory Stephen Smith","title":"President, CEO & Director"},{"name":"Ms. Michelle L. Turner","title":"VP, CFO, Treasurer & Principal Accounting Officer"},{"name":"Mr. Ryan E. Driscoll","title":"Vice President, General Counsel & Secretary"}]},"sector_medians":{"fpe":17.85,"tpe":31.02,"ps":4.569,"pfcf":26.24,"peg":1.16,"pb":4.856,"ev_ebitda":19.25,"rev_growth":0.1835,"eps_growth":0.3615,"eps_growth_fwd":0.2338,"eps_growth_next":0.1906,"div_yield":0,"roe":0.1245,"roa":0.04768,"de":32.58,"gross_margin":0.5372,"op_margin":0.1249,"profit_margin":0.09218,"current_ratio":1.81},"valuation":[{"k":"fpe","label":"Forward P/E","v":23.06,"sector":17.85,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":31.54,"sector":31.02,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":8.578,"sector":4.569,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":71.17,"sector":26.24,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":0.54,"sector":1.16,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":11.63,"sector":4.856,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":3.669,"sector":32.58,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.698,"sector":0.1835,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":1.893,"sector":0.3615,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":1.385,"sector":0.2338,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.2601,"sector":0.1906,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.5931,"sector":0.5372,"verdict":"In line"},{"k":"op_margin","label":"Operating margin