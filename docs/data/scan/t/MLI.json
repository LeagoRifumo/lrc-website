ent provides valves, protection devices, and brass fittings; and coaxial heat exchangers and twisted tubes to wholesalers and OEMs in the HVAC and refrigeration markets. This segment also manufactures and distributes high-pressure components and accessories, as well as insulated HVAC flexible duct systems. Mueller Industries, Inc. was founded in 1917 and is headquartered in Collierville, Tennessee.","employees":4832,"website":"https://www.muellerindustries.com","country":"United States","city":"Collierville","officers":[{"name":"Mr. Gregory L. Christopher","title":"Chairman of the Board & CEO"},{"name":"Mr. Jeffrey A. Martin","title":"Executive VP, CFO & Treasurer"},{"name":"Mr. Christopher John Miritello","title":"Executive VP, General Counsel & Corporate Secretary"}]},"sector_medians":{"fpe":17.22,"tpe":24.6,"ps":2.037,"pfcf":26.28,"peg":1.39,"pb":3.473,"ev_ebitda":14.27,"rev_growth":0.1155,"eps_growth":0.164,"eps_growth_fwd":0.1469,"eps_growth_next":0.1445,"div_yield":0.00735,"roe":0.1452,"roa":0.05675,"de":67.98,"gross_margin":0.3175,"op_margin":0.1261,"profit_margin":0.07298,"current_ratio":1.727},"valuation":[{"k":"fpe","label":"Forward P/E","v":11.38,"sector":17.22,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":13.57,"sector":24.6,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":2.305,"sector":2.037,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":21.5,"sector":26.28,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":3.41,"sector":1.39,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":0.3284,"sector":3.473,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":0.749,"sector":67.98,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.316,"sector":0.1155,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.064,"sector":0.164,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.3089,"sector":0.1469,"verdict":"Strong"}