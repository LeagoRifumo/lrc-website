d probes, test cells, proprietary measurement software, and other test accessories; and offers calibration and product tests, feedthrough capacitors, high current power, telephone, data and control line filters, and high-altitude electromagnetic protection filters. It distributes its products through distributors, sales representatives, direct sales teams, and in-house sales personnel. The company was incorporated in 1990 and is based in Saint Louis, Missouri.","employees":3359,"website":"https://www.escotechnologies.com","country":"United States","city":"Saint Louis","officers":[{"name":"Mr. Bryan H. Sayler","title":"President, CEO & Director"},{"name":"Mr. Christopher L. Tucker","title":"Senior VP & CFO"},{"name":"Mr. David M. Schatz J.D.","title":"Senior VP, Secretary & General Counsel"}]},"sector_medians":{"fpe":18.05,"tpe":31.76,"ps":4.69,"pfcf":27.56,"peg":1.155,"pb":4.957,"ev_ebitda":20.23,"rev_growth":0.169,"eps_growth":0.352,"eps_growth_fwd":0.2214,"eps_growth_next":0.1917,"div_yield":0,"roe":0.1232,"roa":0.04714,"de":32.58,"gross_margin":0.5282,"op_margin":0.1189,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":26.05,"sector":18.05,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":44.57,"sector":31.76,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":4.816,"sector":4.69,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":26.57,"sector":27.56,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":1.67,"sector":1.155,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":3.843,"sector":4.957,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":9.315,"sector":32.58,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.144,"sector":0.169,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.248,"sector":0.352,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.3873,"sector":0.2214,"ve