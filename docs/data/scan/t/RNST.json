ed in 1904 and is based in Tupelo, Mississippi.","employees":3000,"website":"https://investors.renasant.com","country":"United States","city":"Tupelo","officers":[{"name":"Mr. Kevin D. Chapman","title":"President, CEO & Director"},{"name":"Mr. C. Mitchell Waycaster","title":"Executive Vice Chairman"},{"name":"Mr. James C. Mabry IV","title":"Executive VP & CFO"}]},"sector_medians":{"fpe":10.53,"tpe":12.77,"ps":3.425,"pfcf":12.43,"peg":1.32,"pb":1.618,"ev_ebitda":10.75,"rev_growth":0.1,"eps_growth":0.152,"eps_growth_fwd":0.1315,"eps_growth_next":0.1087,"div_yield":0.0217,"roe":0.1279,"roa":0.01565,"de":53.89,"gross_margin":0.2437,"op_margin":0.326,"profit_margin":0.2552,"current_ratio":1.531},"valuation":[{"k":"fpe","label":"Forward P/E","v":10.26,"sector":10.53,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":11.16,"sector":12.77,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":null,"sector":3.425,"verdict":"—"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":12.43,"verdict":"—"},{"k":"peg","label":"PEG","v":1.79,"sector":1.32,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":0.9495,"sector":1.618,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":53.89,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.002,"sector":0.1,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.365,"sector":0.152,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2255,"sector":0.1315,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.048,"sector":0.1087,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0,"sector":0.2437,"verdict":"Weak"},{"k":"op_margin","label":"Operating margin","v":0,"sector":0.326,"verdict":"Weak"},{"k":"profit_margin","label":"Net margin","v":0.3134,"sector":0.2552,"verdict":"In line"},{"k":"roe","label":"Return on equity","v":0.08703,"sector":0.1279,"verdict":"Weak"},{"k"