igence, machine learning, and insights for AML and fraud prevention for small and mid-sized organizations; cloud platforms provide financial services organizations with the agility required to adapt changing regulatory and threat landscapes; data intelligence solutions enable organizations to turn raw data into actionable intelligence to prevent and detect financial crimes; AI and analytics; intelligent investigations solutions; and self-service solutions. The company also develops NiCE Labs, a AI innovation initiatives for customer experience and related solutions. The company was formerly known as NICE-Systems Ltd. and changed its name to NICE Ltd. in June 2016. NICE Ltd. was incorporated in 1986 and is headquartered in Ra'anana, Israel.","employees":9626,"website":"https://www.nice.com","country":"Israel","city":"Ra'anana","officers":[{"name":"Mr. Scott E. Russell","title":"Chief Executive Officer"},{"name":"Ms. Beth  Gaspich","title":"Chief Financial Officer"},{"name":"Mr. Dan  Belanger","title":"President of NICE Americas"}]},"sector_medians":{"fpe":17.78,"tpe":30.1,"ps":4.465,"pfcf":26.31,"peg":1.11,"pb":4.663,"ev_ebitda":18.99,"rev_growth":0.191,"eps_growth":0.356,"eps_growth_fwd":0.2432,"eps_growth_next":0.1809,"div_yield":0,"roe":0.1241,"roa":0.04945,"de":32.8,"gross_margin":0.5312,"op_margin":0.1174,"profit_margin":0.09364,"current_ratio":1.863},"valuation":[{"k":"fpe","label":"Forward P/E","v":7.522,"sector":17.78,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":15.42,"sector":30.1,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.748,"sector":4.465,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":10.16,"sector":26.31,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.62,"sector":1.11,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":36.07,"sector":4.663,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":2.177,"sector":32.8,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth