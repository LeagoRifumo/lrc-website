igned chamber, gas distribution unit, and chuck; and Ultra Track, a 300mm process tool that delivers uniform air downflow, fast robot handling and configurable software to address specific customer requirements. It markets and sells its products under the SAPS, TEBO, ULTRA C, ULTRA Fn, Ultra ECP, Ultra ECP map, and Ultra ECP ap trademarks through direct sales force and third-party representatives. ACM Research, Inc. was incorporated in 1998 and is headquartered in Fremont, California.","employees":2513,"website":"https://www.acmr.com","country":"United States","city":"Fremont","officers":[{"name":"Dr. Hui  Wang Ph.D.","title":"Founder, Chairman, CEO & President"},{"name":"Mr. Mark A. McKechnie","title":"CFO, Executive VP, Secretary & Treasurer"},{"name":"Ms. Yi Lu  Feng","title":"Chief Financial Officer of ACM Research (Shanghai), Inc."}]},"sector_medians":{"fpe":17.65,"tpe":30.31,"ps":4.578,"pfcf":26.34,"peg":1.15,"pb":4.752,"ev_ebitda":19.18,"rev_growth":0.178,"eps_growth":0.367,"eps_growth_fwd":0.2373,"eps_growth_next":0.1867,"div_yield":0,"roe":0.1214,"roa":0.04733,"de":31.61,"gross_margin":0.5318,"op_margin":0.1268,"profit_margin":0.09291,"current_ratio":1.82},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.88,"sector":17.65,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":20.07,"sector":30.31,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":2.957,"sector":4.578,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":26.34,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":null,"sector":1.15,"verdict":"—"},{"k":"pb","label":"Price / Book","v":1.65,"sector":4.752,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":14.52,"sector":31.61,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.36,"sector":0.178,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":1.806,"sector":0.367,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, es