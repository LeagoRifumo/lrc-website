 through a direct sales force. The company was founded in 1963 and is headquartered in Newburyport, Massachusetts.","employees":4846,"website":"https://www.ufpt.com","country":"United States","city":"Newburyport","officers":[{"name":"Mr. Ronald J. Lataille","title":"CFO, Senior VP & Treasurer"},{"name":"Mr. Jason  Holt","title":"Senior Vice President"},{"name":"Mr. Ryan K. Stafford Esq.","title":"General Counsel & Senior VP of Human Resources"}]},"sector_medians":{"fpe":19.17,"tpe":29.98,"ps":4.488,"pfcf":28.95,"peg":1.365,"pb":4.556,"ev_ebitda":16.93,"rev_growth":0.1,"eps_growth":0.1735,"eps_growth_fwd":0.09465,"eps_growth_next":0.1197,"div_yield":0,"roe":0.01872,"roa":0.02349,"de":41.94,"gross_margin":0.4961,"op_margin":0.03472,"profit_margin":0,"current_ratio":3.1},"valuation":[{"k":"fpe","label":"Forward P/E","v":24.7,"sector":19.17,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":31.67,"sector":29.98,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":3.597,"sector":4.488,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":65.15,"sector":28.95,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":3.8,"sector":1.365,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":4.913,"sector":4.556,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":29.48,"sector":41.94,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.151,"sector":0.1,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.213,"sector":0.1735,"verdict":"In line"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0881,"sector":0.09465,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1179,"sector":0.1197,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0.285,"sector":0.4961,"verdict":"Weak"},{"k":"op_margin","label":"Operating margin","v":0.1619,"sector":0.03472,"verdict":"Strong"},{"k":"profit_margin","label":"Net margin","v":0.