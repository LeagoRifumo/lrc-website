ationary industrial equipment and machines, marine and offshore equipment, factory automation, food processing equipment, packaging operations, and downstream energy process systems. This segment also offers pumps, valves, fittings, hoses, process instrumentation, actuators, and filtration supplies; and advanced automation technologies for the design, engineering, assembly, integration, and distribution of machine vision, collaborative robots, mobile robots, radio-frequency identification, industrial networking, motion control, and machine learning technologies for OEMs, machine builders, integrators, and other industrial and technology sectors. The company was formerly known as Bearings, Inc. and changed its name to Applied Industrial Technologies, Inc. in 1997. The company was founded in 1923 and is headquartered in Cleveland, Ohio.","employees":6800,"website":"https://www.applied.com","country":"United States","city":"Cleveland","officers":[{"name":"Mr. Neil A. Schrimsher","title":"President, CEO & Director"},{"name":"Mr. David K. Wells","title":"VP, CFO & Treasurer"},{"name":"Mr. Kurt W. Loring","title":"VP & Chief Human Resource Officer"}]},"sector_medians":{"fpe":17.15,"tpe":24.27,"ps":2.021,"pfcf":25.57,"peg":1.39,"pb":3.332,"ev_ebitda":14.21,"rev_growth":0.118,"eps_growth":0.169,"eps_growth_fwd":0.1478,"eps_growth_next":0.1445,"div_yield":0.007,"roe":0.1452,"roa":0.05723,"de":67.59,"gross_margin":0.3181,"op_margin":0.1266,"profit_margin":0.07114,"current_ratio":1.706},"valuation":[{"k":"fpe","label":"Forward P/E","v":21.27,"sector":17.15,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":24.95,"sector":24.27,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":2.031,"sector":2.021,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":30.61,"sector":25.57,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":2.53,"sector":1.39,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":5.465,"sector":3.332,"verdict":"Overval