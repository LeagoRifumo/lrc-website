ion, it provides Custom Pak surgical procedure packs vitreoretinal products comprising constellation vision systems, procedure packs, lasers and hand-held microsurgical instruments, Grieshaber, MIVS instruments; scissors, forceps and micro-instruments, medical grade vitreous tamponades, and Hypervit probes; and refractive surgery products, including WaveLight and Contoura Vision used for LASIK refractive procedure. Further, the company offers daily disposable, reusable, and color-enhancing contact lenses; ocular health products, such as dry eye, ocular allergies, glaucoma, and contact lens care, as well as ocular vitamins and redness relievers. In addition it also develops and commercializes therapies for chronic eye diseases, focusing on encapsulated cell therapy platforms for ocular conditions. The company was formerly known as Alcon Universal S.A. and changed its name to Alcon Inc. in December 2001. Alcon Inc. was founded in 1945 and is headquartered in Geneva, Switzerland.","employees":25000,"website":"https://www.alcon.com","country":"Switzerland","city":"Geneva","officers":[{"name":"Mr. David J. Endicott","title":"CEO & Director"},{"name":"Mr. Timothy C. Stonesifer","title":"Senior VP & CFO"},{"name":"Mr. Ian  Bell","title":"Senior VP & COO"}]},"sector_medians":{"fpe":19.33,"tpe":31.08,"ps":4.153,"pfcf":28.96,"peg":1.35,"pb":4.555,"ev_ebitda":17.2,"rev_growth":0.094,"eps_growth":0.147,"eps_growth_fwd":0.0883,"eps_growth_next":0.1182,"div_yield":0,"roe":0.01671,"roa":0.02341,"de":43.27,"gross_margin":0.5196,"op_margin":0.05617,"profit_margin":0,"current_ratio":3.001},"valuation":[{"k":"fpe","label":"Forward P/E","v":19.46,"sector":19.33,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":58.07,"sector":31.08,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":3.41,"sector":4.153,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":29.1,"sector":28.96,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":1.26,"sector":1.35,"verdic