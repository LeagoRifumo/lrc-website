rtis Pharmaceuticals Corporation to develop PTC518 Huntington's disease program. It markets Upstaza, a gene therapy with the brand name Kebilidi in the United States. PTC Therapeutics, Inc. was incorporated in 1998 and is headquartered in Warren, New Jersey.","employees":991,"website":"https://www.ptcbio.com","country":"United States","city":"Warren","officers":[{"name":"Dr. Matthew B. Klein F.A.C.S., M.D., M.S.","title":"CEO & Director"},{"name":"Dr. Allan Steven Jacobson Ph.D.","title":"Co-Founder & Independent Director"},{"name":"Mr. Pierre  Gravier M.S.","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":19.11,"tpe":30.68,"ps":4.027,"pfcf":28.23,"peg":1.37,"pb":4.662,"ev_ebitda":16.89,"rev_growth":0.093,"eps_growth":0.155,"eps_growth_fwd":0.0901,"eps_growth_next":0.1182,"div_yield":0,"roe":0.02944,"roa":0.02544,"de":43.27,"gross_margin":0.5196,"op_margin":0.05279,"profit_margin":0,"current_ratio":2.981},"valuation":[{"k":"fpe","label":"Forward P/E","v":27.19,"sector":19.11,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":30.68,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":4.782,"sector":4.027,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":34.55,"sector":28.23,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":null,"sector":1.37,"verdict":"—"},{"k":"pb","label":"Price / Book","v":null,"sector":4.662,"verdict":"—"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":43.27,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.696,"sector":0.093,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.155,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.8773,"sector":0.0901,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":1.599,"sector":0.1182,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.5518,"sector":0.5196,"verdict":"In line"},{"k":"op_margin","label":"