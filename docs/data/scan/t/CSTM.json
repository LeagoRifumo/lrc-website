ons; and profiles for rail and general industrial applications. This segment also provides downstream technology and services, which include pre-machining, surface treatment, research and development, and technical support services. It sells its products directly or through distributors in France, Germany, the Czech Republic, the United Kingdom, Switzerland, and the United States, as well as South Korea, Japan and China. The company was incorporated in 2010 and is headquartered in Paris, France.","employees":11500,"website":"https://www.constellium.com","country":"France","city":"Paris","officers":[{"name":"Ms. Ingrid  Joerg","title":"CEO & Director"},{"name":"Mr. Jack  Guo","title":"EVP & Chief Financial Officer"},{"name":"Mr. Philip Ryan Jurkovic","title":"Senior VP & Chief Human Resources Officer"}]},"sector_medians":{"fpe":12.12,"tpe":18.77,"ps":2.349,"pfcf":23.87,"peg":1.72,"pb":2.383,"ev_ebitda":9.192,"rev_growth":0.165,"eps_growth":0.43,"eps_growth_fwd":0.3337,"eps_growth_next":0.1503,"div_yield":0.0087,"roe":0.1127,"roa":0.06788,"de":44.82,"gross_margin":0.3339,"op_margin":0.1746,"profit_margin":0.06777,"current_ratio":2.085},"valuation":[{"k":"fpe","label":"Forward P/E","v":8.23,"sector":12.12,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":5.859,"sector":18.77,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.3216,"sector":2.349,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":44.96,"sector":23.87,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":0.4,"sector":1.72,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":2.422,"sector":2.383,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":135.5,"sector":44.82,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.218,"sector":0.165,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.355,"sector":0.43,"verdict":"In line"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":1.339,"sec