arriers to enhance highway safety at locations such as toll booths, end terminals, road marking, freeway off-ramps, medians and roadside barrier ends, bridge supports, utility poles, and other fixed roadway hazards; specialty barriers; preformed tape and road safety accessory products, as well as rail products, such as signals and lights, structures, foundations, junction boxes, and signs. Lindsay Corporation was founded in 1955 and is headquartered in Omaha, Nebraska.","employees":1083,"website":"https://www.lindsay.com","country":"United States","city":"Omaha","officers":[{"name":"Mr. Randy A. Wood","title":"President, CEO & Director"},{"name":"Mr. Brian L. Ketcham","title":"Consultant"},{"name":"Mr. James Scott Marion","title":"President of Infrastructure Division"}]},"sector_medians":{"fpe":17.75,"tpe":26.36,"ps":2.156,"pfcf":26.62,"peg":1.4,"pb":3.514,"ev_ebitda":14.88,"rev_growth":0.11,"eps_growth":0.176,"eps_growth_fwd":0.1441,"eps_growth_next":0.1459,"div_yield":0.0066,"roe":0.149,"roa":0.05825,"de":66.95,"gross_margin":0.3185,"op_margin":0.1262,"profit_margin":0.0723,"current_ratio":1.665},"valuation":[{"k":"fpe","label":"Forward P/E","v":18.14,"sector":17.75,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":19.52,"sector":26.36,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.664,"sector":2.156,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":28.59,"sector":26.62,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":1.72,"sector":1.4,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":2.092,"sector":3.514,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":27.15,"sector":66.95,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.052,"sector":0.11,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.114,"sector":0.176,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0563,"sector":0.1441,"verdict":"Weak"},{"k":