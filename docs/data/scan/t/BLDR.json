ng, insulation, wallboard, ceilings, cabinets, and hardware; turn-key framing, shell construction, design assistance, and professional installation of products. In addition, it offers drafting, estimating, quoting, and virtual home design services to retailers, distributors, manufacturers, and homebuilders; dimensional lumber, plywood, and oriented strand board products used in on-site house framing. The company was formerly known as BSL Holdings, Inc. and changed its name to Builders FirstSource, Inc. in October 1999. Builders FirstSource, Inc. was incorporated in 1998 and is based in Irving, Texas.","employees":28000,"website":"https://www.bldr.com","country":"United States","city":"Irving","officers":[{"name":"Mr. Peter M. Jackson CPA","title":"President, CEO & Director"},{"name":"Mr. Pete R. Beckmann","title":"Executive VP & CFO"},{"name":"Mr. Stephen J. Herron","title":"Chief Operating Officer"}]},"sector_medians":{"fpe":17.46,"tpe":24.49,"ps":2.049,"pfcf":26.1,"peg":1.39,"pb":3.321,"ev_ebitda":14.39,"rev_growth":0.118,"eps_growth":0.169,"eps_growth_fwd":0.1478,"eps_growth_next":0.1445,"div_yield":0.007,"roe":0.1452,"roa":0.05723,"de":67.59,"gross_margin":0.3181,"op_margin":0.1266,"profit_margin":0.07114,"current_ratio":1.706},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":17.46,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":177.6,"sector":24.49,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":0.492,"sector":2.049,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":50.36,"sector":26.1,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":2.02,"sector":1.39,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.731,"sector":3.321,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":129.4,"sector":67.59,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.022,"sector":0.118,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.491,"sector":0.169,"verdict":