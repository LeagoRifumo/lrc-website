rature management solutions; anesthesia/pain management trays and components; and professional services. The company's customers include acute care hospitals, wholesalers, ambulatory clinics, and alternate site facilities, such as outpatient clinics, home health care providers, and long-term care facilities. ICU Medical, Inc. was founded in 1984 and is based in San Clemente, California.","employees":13000,"website":"https://www.icumed.com","country":"United States","city":"San Clemente","officers":[{"name":"Mr. Vivek  Jain","title":"CEO & Chairman of the Board"},{"name":"Mr. Daniel  Woolson","title":"President"},{"name":"Mr. Brian Michael Bonnell","title":"CFO & Treasurer"}]},"sector_medians":{"fpe":18.94,"tpe":29.89,"ps":4.234,"pfcf":27.7,"peg":1.36,"pb":4.405,"ev_ebitda":16.87,"rev_growth":0.098,"eps_growth":0.154,"eps_growth_fwd":0.09245,"eps_growth_next":0.1086,"div_yield":0,"roe":0.02656,"roa":0.02401,"de":42.77,"gross_margin":0.515,"op_margin":0.04562,"profit_margin":0,"current_ratio":2.993},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":18.94,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":74.4,"sector":29.89,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":2.037,"sector":4.234,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":20.7,"sector":27.7,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.09,"sector":1.36,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":2.029,"sector":4.405,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":55.09,"sector":42.77,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.044,"sector":0.098,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.154,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1513,"sector":0.09245,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0833,"sector":0.1086,"verdict":"In line"},{"k":"gross_margin