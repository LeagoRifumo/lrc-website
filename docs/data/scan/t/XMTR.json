 as NextLine Manufacturing Corp. and changed its name to Xometry, Inc. in June 2015. Xometry, Inc. was incorporated in 2013 and is headquartered in North Bethesda, Maryland.","employees":1174,"website":"https://www.xometry.com","country":"United States","city":"North Bethesda","officers":[{"name":"Mr. Sanjeev Singh Sahni","title":"President, CEO & Director"},{"name":"Mr. James  Miln C.M.A.","title":"CFO & Principal Accounting Officer"},{"name":"Mr. Vaidyanathan  Raghavan","title":"Chief Technology Officer"}]},"sector_medians":{"fpe":18.03,"tpe":26.48,"ps":2.156,"pfcf":27.5,"peg":1.42,"pb":3.598,"ev_ebitda":15.12,"rev_growth":0.1095,"eps_growth":0.1665,"eps_growth_fwd":0.1395,"eps_growth_next":0.1491,"div_yield":0.0067,"roe":0.1496,"roa":0.0593,"de":68.61,"gross_margin":0.3177,"op_margin":0.1237,"profit_margin":0.07061,"current_ratio":1.63},"valuation":[{"k":"fpe","label":"Forward P/E","v":76.02,"sector":18.03,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":26.48,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":6.896,"sector":2.156,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":27.5,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":null,"sector":1.42,"verdict":"—"},{"k":"pb","label":"Price / Book","v":9.312,"sector":3.598,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":56.99,"sector":68.61,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.411,"sector":0.1095,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.1665,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.8539,"sector":0.1395,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.8139,"sector":0.1491,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.3875,"sector":0.3177,"verdict":"In line"},{"k":"op_margin","label":"Operating margin","v":-0.02438,"sector":0.1237,"verdict":"Weak"},{