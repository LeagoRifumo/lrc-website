oducts, such as Mist and Aruba Central; and services comprising professional, maintenance, support services, management software, and education and training programs. Further, it offers investment solutions, including leasing, financing, IT consumption, utility programs, and asset management services, as well as supports financial solutions for on-premise flexible consumption models. The company serves commercial and large enterprise groups, as well as business and public sector enterprises. It sells its products through resellers, distribution partners, master area partners, original equipment manufacturers, independent software vendors, systems integrators, and advisory firms. The company was founded in 1939 and is headquartered in Spring, Texas.","employees":67000,"website":"https://www.hpe.com","country":"United States","city":"Spring","officers":[{"name":"Mr. Antonio Fabio Neri","title":"CEO, President & Director"},{"name":"Ms. Marie E. Myers","title":"Executive VP & CFO"},{"name":"Mr. John F. Schultz J.D.","title":"Executive VP and Chief Operating & Legal Officer"}]},"sector_medians":{"fpe":18.12,"tpe":31.43,"ps":4.812,"pfcf":27.73,"peg":1.145,"pb":5.056,"ev_ebitda":19.99,"rev_growth":0.177,"eps_growth":0.339,"eps_growth_fwd":0.2264,"eps_growth_next":0.1929,"div_yield":0,"roe":0.1195,"roa":0.04674,"de":32.62,"gross_margin":0.5331,"op_margin":0.1128,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":12.44,"sector":18.12,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":30.35,"sector":31.43,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.866,"sector":4.812,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":16.49,"sector":27.73,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.48,"sector":1.145,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":2.949,"sector":5.056,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":76.46,"sector":32.62,"verdict":"