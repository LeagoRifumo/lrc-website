 and Pro-Trade brand names. It markets its products primarily to residential and commercial landscape professionals who specializes in the design, installation, and maintenance of lawns, gardens, golf courses, and other outdoor spaces through branch network and direct distribution. SiteOne Landscape Supply, Inc. was founded in 2001 and is headquartered in Roswell, Georgia.","employees":7750,"website":"https://www.siteone.com","country":"United States","city":"Roswell","officers":[{"name":"Mr. Doug  Black","title":"President, Chairman of the Board & CEO"},{"name":"Ms. Shannon  Versaggi","title":"Executive Vice President of Marketing, Category Management, Digital & Pricing"},{"name":"Mr. Joseph  Ketter","title":"Executive Vice President of Human Resources"}]},"sector_medians":{"fpe":18.03,"tpe":26.48,"ps":2.156,"pfcf":27.5,"peg":1.42,"pb":3.598,"ev_ebitda":15.12,"rev_growth":0.1095,"eps_growth":0.1665,"eps_growth_fwd":0.1395,"eps_growth_next":0.1491,"div_yield":0.0067,"roe":0.1496,"roa":0.0593,"de":68.61,"gross_margin":0.3177,"op_margin":0.1237,"profit_margin":0.07061,"current_ratio":1.63},"valuation":[{"k":"fpe","label":"Forward P/E","v":20.82,"sector":18.03,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":27.85,"sector":26.48,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":0.942,"sector":2.156,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":23.82,"sector":27.5,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":null,"sector":1.42,"verdict":"—"},{"k":"pb","label":"Price / Book","v":2.671,"sector":3.598,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":66.85,"sector":68.61,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.047,"sector":0.1095,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.098,"sector":0.1665,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0427,"sector":0.1395,"verdict":"Weak"},{"k":"eps_growth_next","l