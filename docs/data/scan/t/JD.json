e properties to support third parties; and offers asset management services and integrated service platform; leasing of storage facilities and related management services, as well as engages in online retail business; technology-driven supply chain solutions; and logistics services. The company was formerly known as 360buy Jingdong Inc. and changed its name to JD.com, Inc. in January 2014. JD.com, Inc. was incorporated in 2006 and is headquartered in Beijing, the People's Republic of China.","employees":900000,"website":"https://www.jd.com","country":"China","city":"Beijing","officers":[{"name":"Mr. Qiangdong  Liu","title":"Founder & Chairman"},{"name":"Ms. Ran  Xu CPA","title":"CEO & Executive Director"},{"name":"Mr. Su  Shan","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":14.71,"tpe":19.23,"ps":1.222,"pfcf":19.3,"peg":1.18,"pb":2.909,"ev_ebitda":11.82,"rev_growth":0.055,"eps_growth":0.149,"eps_growth_fwd":0.1026,"eps_growth_next":0.1198,"div_yield":0.0074,"roe":0.1516,"roa":0.06133,"de":102.4,"gross_margin":0.3788,"op_margin":0.0968,"profit_margin":0.0578,"current_ratio":1.418},"valuation":[{"k":"fpe","label":"Forward P/E","v":6.854,"sector":14.71,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":19.22,"sector":19.23,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":null,"sector":1.222,"verdict":"—"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":19.3,"verdict":"—"},{"k":"peg","label":"PEG","v":0.56,"sector":1.18,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.126,"sector":2.909,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":37.29,"sector":102.4,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.029,"sector":0.055,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.213,"sector":0.149,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2068,"sector":0.1026,"verdict":"Strong"},{"k":"eps_growth_next","label":