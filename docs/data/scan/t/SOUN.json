t":-0.054,"surp":0.6296},{"q":"2026-09-30","act":-0.05,"est":-0.04333,"surp":-0.1539}],"div_pay":null,"rec_trend":{"strongBuy":0,"buy":5,"hold":1,"sell":0,"strongSell":0},"analyst_actions":[{"date":"2026-11-06","firm":"DA Davidson","action":"main","from":"Buy","to":"Buy"},{"date":"2026-11-06","firm":"Cantor Fitzgerald","action":"main","from":"Overweight","to":"Overweight"}]},"profile":{"sector":"Technology","industry":"Software - Application","summary":"SoundHound AI, Inc. provides independent voice artificial intelligence (AI) solutions that enables businesses across the automotive, TV, IoT, and customer service industries to deliver conversational experiences to customers in the United States, Korea, France, Japan, Germany, and internationally. The company offers Houndify platform, which provides a suite of Houndify tools to help brands build conversational voice assistants, such as Application Programming Interfaces (API) for text and voice queries, support for custom commands, extensive library of content domains, inclusive software development kit platforms, collaboration capabilities, diagnostic tools, and built-in analytics; SoundHound Chat AI, a voice assistant with integrated generative AI that integrates with knowledge domains, pulling real-time data, such as weather, sports, stocks, flight status, restaurants, and other data; and SoundHound Smart Answering, which offers customer establishments the option to build an easy to use custom AI-powered voice assistant. It also provides CaiNET software that uses machine learning to enhance how domains work together to handle complex queries; CaiLAN software that arbitrates responses, so users get answers from the right domain; Dynamic Interaction, a real-time multimodal customer service interface; Smart Ordering, which offers an easy-to-understand voice assistant for restaurants; automatic speech recognition; natural language understanding; wake words; custom domains; text-to-speech; Employee Assist; and edge and cloud connectivity, which includes embedded voice solutions. In addition, the company offers Amelia Platform, which builds AI agents for enterprises; Chat AI for Automotive; Dynamic Drive-Thru for GenAI; Voice Commerce, which connects drivers and merchants with Voice AI; Autonomics Platform; Custom Voice AI Solutions; Voice AI Platform; and SoundHound Music App. SoundHound AI, Inc. was founded in 2005 and is headquartered in Santa Clara, California.","employees":954,"website":"https://www.soundhound.com","country":"United States","city":"Santa Clara","officers":[{"name":"Dr. Keyvan  Mohajer","title":"Co-Founder, CEO, President & Director"},{"name":"Mr. James  Hom","title":"Co-Founder, Chief Product Officer & Director"},{"name":"Dr. Seyed Majid Emami","title":"Co-Founder, Chief Science Officer & Senior VP of Engineering"}]},"sector_medians":{"fpe":17.23,"tpe":29.42,"ps":4.345,"pfcf":25.83,"peg":1.1,"pb":4.645,"ev_ebitda":18.74,"rev_growth":0.1935,"eps_growth":0.377,"eps_growth_fwd":0.2545,"eps_growth_next":0.1771,"div_yield":0,"roe":0.1242,"roa":0.05009,"de":32.04,"gross_margin":0.5374,"op_margin":0.1175,"profit_margin":0.09496,"current_ratio":1.852},"valuation":[{"k":"fpe","label":"Forward P/E","v":-1,"sector":17.23,"verdict":"Loss-making"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":29.42,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":7.624,"sector":4.345,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":280.3,"sector":25.83,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":null,"sector":1.1,"verdict":"—"},{"k":"pb","label":"Price / Book","v":2.116,"sector":4.645,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":1.05,"sector":32.04,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.485,"sector":0.1935,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.377,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.3077,"sector":0.