hat help testers to analyze and store results and perform analysis. The company has a strategic collaboration with Hinalea Imaging Corp. to develop digital imaging solutions for food safety and quality inspection. Neogen Corporation was incorporated in 1981 and is headquartered in Lansing, Michigan.","employees":2636,"website":"https://www.neogen.com","country":"United States","city":"Lansing","officers":[{"name":"Mr. Mikhael  Nassif","title":"CEO, President & Director"},{"name":"Mr. R. Bryan Riggsbee CPA","title":"CFO & Senior Vice President"},{"name":"Ms. Jennifer Evans Stacey Esq., J.D.","title":"Senior VP, Chief Legal & Compliance Officer and Board Secretary"}]},"sector_medians":{"fpe":18.93,"tpe":29.94,"ps":4.243,"pfcf":28.07,"peg":1.36,"pb":4.477,"ev_ebitda":16.75,"rev_growth":0.1,"eps_growth":0.167,"eps_growth_fwd":0.0928,"eps_growth_next":0.1205,"div_yield":0,"roe":0.01454,"roa":0.02187,"de":41.94,"gross_margin":0.4983,"op_margin":0.04015,"profit_margin":0,"current_ratio":3.084},"valuation":[{"k":"fpe","label":"Forward P/E","v":27.71,"sector":18.93,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":29.94,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":3.079,"sector":4.243,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":69.92,"sector":28.07,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":0.66,"sector":1.36,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.305,"sector":4.477,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":37.11,"sector":41.94,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.065,"sector":0.1,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.167,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0417,"sector":0.0928,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.35,"sector":0.1205,"verdict":"Strong"},{"k":"gross_margin","label":"