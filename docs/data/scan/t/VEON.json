tion; KINOM, a digital entertainment platform; BeeMarket, an electronics and home appliance marketplace; Hambi Davo, a suite of digital health services; and OQ, a digital platform. The company distributes its products and services through a direct sales force, franchises, third-party retailers, distributors, supermarkets, stores, chains, online, offices, and other channels. The company was formerly known as VimpelCom Ltd. and changed its name to VEON Ltd. in March 2017. VEON Ltd. was founded in 1992 and is headquartered in Dubai, the United Arab Emirates.","employees":18938,"website":"https://www.veon.com","country":"United Arab Emirates","city":"Dubai","officers":[{"name":"Mr. Muhterem Kaan Terzioglu","title":"Group CEO & Director"},{"name":"Mr. Burak  Ozer","title":"Group Chief Financial Officer"},{"name":"Mr. Vitaly  Shmakov","title":"Chief Investment Officer"}]},"sector_medians":{"fpe":12.24,"tpe":16.72,"ps":2.081,"pfcf":12.15,"peg":0.99,"pb":2.29,"ev_ebitda":12.56,"rev_growth":0.083,"eps_growth":0.033,"eps_growth_fwd":0.1449,"eps_growth_next":0.1232,"div_yield":0,"roe":0.09872,"roa":0.04149,"de":61.74,"gross_margin":0.5655,"op_margin":0.1367,"profit_margin":0.07874,"current_ratio":1.317},"valuation":[{"k":"fpe","label":"Forward P/E","v":9.071,"sector":12.24,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":14.1,"sector":16.72,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.067,"sector":2.081,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":8.864,"sector":12.15,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":2.23,"sector":0.99,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":3.16,"sector":2.29,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":273.8,"sector":61.74,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.172,"sector":0.083,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.033,"verdict":"—"},{"k":"eps_growth_fwd","l