 camera deployments enterprise-level requirements; shooter detection systems; service provider portal, service dashboard, installation and support service provider solutions; and AI-powered enhancements to professional monitoring and false alarm reduction. Further, it provides business management services; sales, marketing, training services; and home builder program hardware and services. The company was founded in 2000 and is headquartered in Tysons, Virginia.","employees":2058,"website":"https://www.alarm.com","country":"United States","city":"Tysons","officers":[{"name":"Mr. Stephen S. Trundle","title":"CEO & Director"},{"name":"Mr. Kevin  Bradley","title":"Chief Financial Officer"},{"name":"Mr. Daniel  Ramos J.D.","title":"Corporate Secretary, Chief Legal & Compliance Officer and SVP of Corporate Operations"}]},"sector_medians":{"fpe":16.43,"tpe":28.08,"ps":4.255,"pfcf":24.38,"peg":1.1,"pb":4.515,"ev_ebitda":18.18,"rev_growth":0.183,"eps_growth":0.344,"eps_growth_fwd":0.2397,"eps_growth_next":0.1841,"div_yield":0,"roe":0.1251,"roa":0.04865,"de":32.8,"gross_margin":0.5312,"op_margin":0.1357,"profit_margin":0.09441,"current_ratio":1.879},"valuation":[{"k":"fpe","label":"Forward P/E","v":21.12,"sector":16.43,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":29.69,"sector":28.08,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":2.945,"sector":4.255,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":25.17,"sector":24.38,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":1.41,"sector":1.1,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":3.565,"sector":4.515,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":60.2,"sector":32.8,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.09,"sector":0.183,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.008,"sector":0.344,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1153,"s