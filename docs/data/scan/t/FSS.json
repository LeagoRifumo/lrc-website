deral Signal VAMA, and Victor brand names through wholesalers, distributors, independent manufacturer representatives, original equipment manufacturers, and direct sales force, as well as independent foreign distributors. In addition, the company manufactures custom liquid vacuum tank (\"LVT\") trucks. Federal Signal Corporation was founded in 1901 and is based in Downers Grove, Illinois.","employees":5800,"website":"https://www.federalsignal.com","country":"United States","city":"Downers Grove","officers":[{"name":"Ms. Jennifer L. Sherman","title":"President, CEO & Director"},{"name":"Mr. Ian A. Hudson CPA","title":"Senior VP & CFO"},{"name":"Mr. Mark D. Weber","title":"Senior VP & COO"}]},"sector_medians":{"fpe":17.93,"tpe":25.73,"ps":2.138,"pfcf":27.54,"peg":1.41,"pb":3.575,"ev_ebitda":14.97,"rev_growth":0.118,"eps_growth":0.174,"eps_growth_fwd":0.156,"eps_growth_next":0.1445,"div_yield":0.0067,"roe":0.1461,"roa":0.05806,"de":67.36,"gross_margin":0.3187,"op_margin":0.1262,"profit_margin":0.07423,"current_ratio":1.689},"valuation":[{"k":"fpe","label":"Forward P/E","v":20.13,"sector":17.93,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":24.22,"sector":25.73,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":2.831,"sector":2.138,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":33.27,"sector":27.54,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":1.5,"sector":1.41,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":4.57,"sector":3.575,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":28.64,"sector":67.36,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.181,"sector":0.118,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.162,"sector":0.174,"verdict":"In line"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.241,"sector":0.156,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1073,"sector