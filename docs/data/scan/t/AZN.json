aboration. The company was formerly known as Zeneca Group PLC and changed its name to AstraZeneca PLC in April 1999. AstraZeneca PLC was incorporated in 1992 and is based in Cambridge, the United Kingdom.","employees":96100,"website":"https://www.astrazeneca.com","country":"United Kingdom","city":"Cambridge","officers":[{"name":"Mr. Pascal Claude Roland Soriot D.V.M., M.B.A.","title":"CEO & Executive Director"},{"name":"Dr. Aradhana  Sarin M.D.","title":"CFO & Executive Director"},{"name":"Ms. Pam P. Cheng","title":"EVP of Global opt. & IT, Chief Sust. Officer and Member of External Sust.Adv. Board"}]},"sector_medians":{"fpe":19.65,"tpe":31.47,"ps":4.242,"pfcf":29.8,"peg":1.34,"pb":4.61,"ev_ebitda":17.24,"rev_growth":0.0975,"eps_growth":0.1415,"eps_growth_fwd":0.0882,"eps_growth_next":0.1179,"div_yield":0,"roe":0.0141,"roa":0.02244,"de":39.61,"gross_margin":0.4949,"op_margin":0.04041,"profit_margin":0,"current_ratio":3.054},"valuation":[{"k":"fpe","label":"Forward P/E","v":16.72,"sector":19.65,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":27.14,"sector":31.47,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":4.71,"sector":4.242,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":52.21,"sector":29.8,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.3,"sector":1.34,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":5.68,"sector":4.61,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":66.25,"sector":39.61,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.067,"sector":0.0975,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.235,"sector":0.1415,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":1.21,"sector":0.0882,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1182,"sector":0.1179,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0.8178,"sector":0.4949