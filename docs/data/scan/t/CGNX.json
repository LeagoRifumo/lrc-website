 such as industrial cameras, lenses, lighting, vision controllers, frame grabbers, and I/O cards. It sells its products to the automotive, logistics, packaging, consumer electronics, medical-related, semiconductor, and consumer products industries. The company was incorporated in 1981 and is headquartered in Natick, Massachusetts.","employees":2745,"website":"https://www.cognex.com","country":"United States","city":"Natick","officers":[{"name":"Mr. Matthew  Moschner","title":"President, CEO & Director"},{"name":"Mr. Dennis S. Fehr","title":"Senior VP of Finance & CFO"},{"name":"Mr. Carl W. Gerst III","title":"Executive Vice President of Global Sales & Products"}]},"sector_medians":{"fpe":18.28,"tpe":32.14,"ps":4.713,"pfcf":27.99,"peg":1.155,"pb":4.963,"ev_ebitda":20.13,"rev_growth":0.169,"eps_growth":0.352,"eps_growth_fwd":0.2214,"eps_growth_next":0.1917,"div_yield":0,"roe":0.1232,"roa":0.04714,"de":32.58,"gross_margin":0.5282,"op_margin":0.1189,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":28.8,"sector":18.28,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":55.98,"sector":32.14,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":8.994,"sector":4.713,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":50.05,"sector":27.99,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":2.71,"sector":1.155,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":6.01,"sector":4.963,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":4.448,"sector":32.58,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.169,"sector":0.169,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.792,"sector":0.352,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.6617,"sector":0.2214,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1928,"sector":0.1917,"verdict":"In line"},{"k":"