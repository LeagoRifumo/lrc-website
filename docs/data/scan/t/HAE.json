tologous blood recovery system for cardiovascular, orthopedic, trauma, transplant, vascular, obstetrical, and gynecological surgeries;vascular closure products comprise VASCADE 5F, VASCADE 6/7F, VASCADE MVP XL, and VASCADE MVP, a technology platform which offers catheter-based delivery system and leverages the natural clot-inducing properties of collagen; and transfusion management solutions. It sells its products through direct sales force and independent distributors. The company was founded in 1971 and is headquartered in Boston, Massachusetts.","employees":3009,"website":"https://www.haemonetics.com","country":"United States","city":"Boston","officers":[{"name":"Mr. Christopher A. Simon","title":"CEO, President & Director"},{"name":"Mr. James C. D'Arecca CPA","title":"CFO, Executive VP  & Financial Officer"},{"name":"Mr. Frank W. Chan Ph.D.","title":"Executive VP & COO"}]},"sector_medians":{"fpe":18.96,"tpe":29.96,"ps":4.265,"pfcf":28.26,"peg":1.34,"pb":4.643,"ev_ebitda":16.72,"rev_growth":0.1,"eps_growth":0.167,"eps_growth_fwd":0.0928,"eps_growth_next":0.1189,"div_yield":0,"roe":0.01454,"roa":0.02187,"de":41.94,"gross_margin":0.4983,"op_margin":0.04015,"profit_margin":0,"current_ratio":3.084},"valuation":[{"k":"fpe","label":"Forward P/E","v":20.48,"sector":18.96,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":58.0,"sector":29.96,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":3.982,"sector":4.265,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":17.21,"sector":28.26,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.9,"sector":1.34,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":6.427,"sector":4.643,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":140.3,"sector":41.94,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.056,"sector":0.1,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.029,"sector":0.167,"verdict":"Weak"},{"k":"eps_growth_