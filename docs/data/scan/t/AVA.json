ture fund investments, real estate investments, and other investments. The company was formerly known as Washington Water Power and changed its name to Avista Corporation in January 1999. Avista Corporation was incorporated in 1889 and is headquartered in Spokane, Washington.","employees":null,"website":"https://www.investor.avistacorp.com","country":"United States","city":"Spokane","officers":[{"name":"Ms. Heather Lynn Rosentrater","title":"President, CEO & Director"},{"name":"Mr. Kevin J. Christie","title":"SVP, CFO, Treasurer & Chief Strategy Officer"},{"name":"Mr. Gregory Curtis Hesler J.D.","title":"Senior VP of Energy Policy and Chief Legal & Ethics Officer"}]},"sector_medians":{"fpe":17.87,"tpe":21.03,"ps":2.903,"pfcf":20.09,"peg":2.335,"pb":1.954,"ev_ebitda":12.82,"rev_growth":0.068,"eps_growth":0.1505,"eps_growth_fwd":0.0735,"eps_growth_next":0.075,"div_yield":0.0315,"roe":0.09076,"roa":0.03048,"de":153.2,"gross_margin":0.4454,"op_margin":0.2391,"profit_margin":0.1268,"current_ratio":0.8115},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.66,"sector":17.87,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":13.5,"sector":21.03,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.769,"sector":2.903,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":20.09,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":2.27,"sector":2.335,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":1.211,"sector":1.954,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":118.9,"sector":153.2,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.045,"sector":0.068,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.597,"sector":0.1505,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1038,"sector":0.0735,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0625,"sector":0.075,"verdict":"In l