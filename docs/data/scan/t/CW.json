ion systems; energy absorbers, retractable hook cable systems, net-stanchion systems and mobile systems to support fixed land-based arresting systems; hardware, valves, fastening systems, specialized containment doors, airlock hatches, and spent fuel management products; reactor coolant pumps and control rod drive mechanisms for commercial nuclear power plants, as well as various nuclear reactor technologies. This segment furnishes severe-service valve technologies and services, heat exchanger repair, and piping test and isolation products, and offers ship repair and maintenance for the U.S. navy. Curtiss-Wright Corporation was incorporated in 1929 and is headquartered in Davidson, North Carolina.","employees":9200,"website":"https://www.curtisswright.com","country":"United States","city":"Davidson","officers":[{"name":"Ms. Lynn M. Bamford","title":"CEO & Chairman"},{"name":"Mr. Kevin M. Rayment","title":"Executive VP & COO"},{"name":"Mr. George P. McDonald","title":"Executive VP, General Counsel & Corporate Secretary"}]},"sector_medians":{"fpe":17.68,"tpe":26.14,"ps":2.142,"pfcf":26.66,"peg":1.4,"pb":3.514,"ev_ebitda":14.94,"rev_growth":0.11,"eps_growth":0.176,"eps_growth_fwd":0.1447,"eps_growth_next":0.146,"div_yield":0.0066,"roe":0.149,"roa":0.05825,"de":66.95,"gross_margin":0.3185,"op_margin":0.1262,"profit_margin":0.0723,"current_ratio":1.665},"valuation":[{"k":"fpe","label":"Forward P/E","v":27.86,"sector":17.68,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":33.08,"sector":26.14,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":4.851,"sector":2.142,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":32.05,"sector":26.66,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":2.0,"sector":1.4,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":6.398,"sector":3.514,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":41.48,"sector":66.95,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.0