 energy, industrial, and research equipment industries. The company was founded in 1991 and is headquartered in Hayward, California.","employees":6948,"website":"https://www.uct.com","country":"United States","city":"Hayward","officers":[{"name":"Mr. Jinsong  Xiao","title":"CEO & Director"},{"name":"Mr. Jeffrey L. Mckibben","title":"Chief Information Officer"},{"name":"Ms. Sheri L. Savage","title":"Finance Advisor"}]},"sector_medians":{"fpe":17.92,"tpe":31.96,"ps":4.757,"pfcf":27.69,"peg":1.155,"pb":5.077,"ev_ebitda":20.02,"rev_growth":0.177,"eps_growth":0.339,"eps_growth_fwd":0.2255,"eps_growth_next":0.1929,"div_yield":0,"roe":0.1195,"roa":0.04674,"de":32.62,"gross_margin":0.5331,"op_margin":0.1128,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":17.92,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":97.31,"sector":31.96,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":1.038,"sector":4.757,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":27.69,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":0.23,"sector":1.155,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":3.621,"sector":5.077,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":99.61,"sector":32.62,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.488,"sector":0.177,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.339,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":2.176,"sector":0.2255,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.9341,"sector":0.1929,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.1611,"sector":0.5331,"verdict":"Weak"},{"k":"op_margin","label":"Operating margin","v":0.07075,"sector":0.1128,"verdict":"Weak"},{"k":"profit_margin","label":"Net margin","v":0.01088,"sector":0.08604,"verdict":"Weak"},{"k":"r