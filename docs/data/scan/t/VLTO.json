, pharmaceutical, and industrials. The company was formerly known as DH EAS Holding Corp. and changed its name to Veralto Corporation in February 2023. Veralto Corporation was incorporated in 2022 and is headquartered in Waltham, Massachusetts.","employees":17000,"website":"https://www.veralto.com","country":"United States","city":"Waltham","officers":[{"name":"Ms. Jennifer L. Honeycutt","title":"President, CEO & Director"},{"name":"Mr. Sameer  Ralhan","title":"Senior VP & CFO"},{"name":"Ms. Lesley  Beneteau","title":"Senior VP & Chief Human Resources Officer"}]},"sector_medians":{"fpe":18.01,"tpe":26.17,"ps":2.153,"pfcf":27.56,"peg":1.41,"pb":3.624,"ev_ebitda":14.96,"rev_growth":0.118,"eps_growth":0.174,"eps_growth_fwd":0.156,"eps_growth_next":0.1445,"div_yield":0.00675,"roe":0.1461,"roa":0.05806,"de":67.36,"gross_margin":0.3187,"op_margin":0.1262,"profit_margin":0.07423,"current_ratio":1.689},"valuation":[{"k":"fpe","label":"Forward P/E","v":23.99,"sector":18.01,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":28.75,"sector":26.17,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":4.905,"sector":2.153,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":37.27,"sector":27.56,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":2.75,"sector":1.41,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":8.816,"sector":3.624,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":96.69,"sector":67.36,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.075,"sector":0.118,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.084,"sector":0.174,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1561,"sector":0.156,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0818,"sector":0.1445,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.5984,"sector":0.3187,"verdict":"Strong"},{"k":"op_margin","lab