 performance benchmarks and as the basis for investment products and other portfolio strategies. The company was incorporated in 1984 and is headquartered in Chicago, Illinois.","employees":10973,"website":"https://www.morningstar.com","country":"United States","city":"Chicago","officers":[{"name":"Mr. Joseph D. Mansueto","title":"Founder & Executive Chairman of the Board"},{"name":"Mr. Kunal  Kapoor C.F.A., CFA","title":"CEO & Director"},{"name":"Mr. Michael John Holt C.F.A.","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":10.78,"tpe":12.58,"ps":3.482,"pfcf":11.55,"peg":1.31,"pb":1.595,"ev_ebitda":11.14,"rev_growth":0.088,"eps_growth":0.1195,"eps_growth_fwd":0.1346,"eps_growth_next":0.1035,"div_yield":0.022,"roe":0.1288,"roa":0.01563,"de":54.51,"gross_margin":0.2344,"op_margin":0.3725,"profit_margin":0.2565,"current_ratio":1.507},"valuation":[{"k":"fpe","label":"Forward P/E","v":16.88,"sector":10.78,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":21.59,"sector":12.58,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":3.484,"sector":3.482,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":19.65,"sector":11.55,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":2.31,"sector":1.31,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":8.905,"sector":1.595,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":181.3,"sector":54.51,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.089,"sector":0.088,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.41,"sector":0.1195,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.3031,"sector":0.1346,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.135,"sector":0.1035,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.6307,"sector":0.2344,"verdict":"Strong"},{"k":"op_margin","label":"Operating margin","v":0.2491,"sector":0.3