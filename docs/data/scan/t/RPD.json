solution that provides visibility across on-premise and remote endpoints for security. Further, it offers offloads day-to-day, advisory, and professional services. The company was incorporated in 2000 and is headquartered in Boston, Massachusetts.","employees":2613,"website":"https://www.rapid7.com","country":"United States","city":"Boston","officers":[{"name":"Mr. Corey E. Thomas","title":"Executive Chairman"},{"name":"Mr. Wael  Mohamed","title":"CEO & Director"},{"name":"Mr. Rafeal Edgar Brown CPA","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":17.65,"tpe":30.31,"ps":4.578,"pfcf":26.34,"peg":1.15,"pb":4.752,"ev_ebitda":19.18,"rev_growth":0.178,"eps_growth":0.367,"eps_growth_fwd":0.2373,"eps_growth_next":0.1867,"div_yield":0,"roe":0.1214,"roa":0.04733,"de":31.61,"gross_margin":0.5318,"op_margin":0.1268,"profit_margin":0.09291,"current_ratio":1.82},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":17.65,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":48.11,"sector":30.31,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":1.183,"sector":4.578,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":7.599,"sector":26.34,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.77,"sector":1.15,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":5.14,"sector":4.752,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":488.9,"sector":31.61,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.015,"sector":0.178,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.304,"sector":0.367,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.1348,"sector":0.2373,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":-0.0053,"sector":0.1867,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.693,"sector":0.5318,"verdict":"Strong"},{"k":"op_margin","label":"Operating margin","v":0.02273,"sect