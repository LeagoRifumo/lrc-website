; and Stay, a cloud-native SaaS property management system. Its hospitality and leisure and experience enhancer solutions consist of Book, Express Kiosk and Express Mobile for check-in and check-out; Spa software; Golf; Sales and Catering; Service; Authorize; DataMagine; Reserve solution; Digital Marketing solution; Retail POS solution; Central Reservations; Loyalty and Promotions; Membership; Residence Management; and Guest App. Further, the company provides inventory and procurement ecosystem solutions, including the Eatec solution and Stratton Warren System. The company was formerly known as Pioneer-Standard Electronics, Inc. and changed its name to Agilysys, Inc. in 2003. Agilysys, Inc. was founded in 1932 and is headquartered in Alpharetta, Georgia.","employees":2413,"website":"https://www.agilysys.com","country":"United States","city":"Alpharetta","officers":[{"name":"Mr. Ramesh  Srinivasan","title":"CEO, President & Director"},{"name":"Mr. William David Wood III","title":"Senior VP & CFO"},{"name":"Mr. Sethuram  Shivashankar","title":"Senior VP and Chief Technology & Information Officer"}]},"sector_medians":{"fpe":18.28,"tpe":32.14,"ps":4.713,"pfcf":27.99,"peg":1.155,"pb":4.963,"ev_ebitda":20.13,"rev_growth":0.169,"eps_growth":0.352,"eps_growth_fwd":0.2214,"eps_growth_next":0.1917,"div_yield":0,"roe":0.1232,"roa":0.04714,"de":32.58,"gross_margin":0.5282,"op_margin":0.1189,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":35.16,"sector":18.28,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":73.76,"sector":32.14,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":9.489,"sector":4.713,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":52.98,"sector":27.99,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":2.77,"sector":1.155,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":9.113,"sector":4.963,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":4.813,"sector":