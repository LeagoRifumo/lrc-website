a cloud-native SaaS property management system. Its hospitality and leisure and experience enhancer solutions consist of Book, Express Kiosk and Express Mobile for check-in and check-out; Spa software; Golf; Sales and Catering; Service; Authorize; DataMagine; Reserve solution; Digital Marketing solution; Retail POS solution; Central Reservations; Loyalty and Promotions; Membership; Residence Management; and Guest App. Further, the company provides inventory and procurement ecosystem solutions, including the Eatec solution and Stratton Warren System. The company was formerly known as Pioneer-Standard Electronics, Inc. and changed its name to Agilysys, Inc. in 2003. Agilysys, Inc. was founded in 1932 and is headquartered in Alpharetta, Georgia.","employees":2413,"website":"https://www.agilysys.com","country":"United States","city":"Alpharetta","officers":[{"name":"Mr. Ramesh  Srinivasan","title":"CEO, President & Director"},{"name":"Mr. William David Wood III","title":"Senior VP & CFO"},{"name":"Mr. Sethuram  Shivashankar","title":"Senior VP and Chief Technology & Information Officer"}]},"sector_medians":{"fpe":18.12,"tpe":31.43,"ps":4.812,"pfcf":27.73,"peg":1.145,"pb":5.056,"ev_ebitda":19.99,"rev_growth":0.177,"eps_growth":0.339,"eps_growth_fwd":0.2264,"eps_growth_next":0.1929,"div_yield":0,"roe":0.1195,"roa":0.04674,"de":32.62,"gross_margin":0.5331,"op_margin":0.1128,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":35.18,"sector":18.12,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":73.8,"sector":31.43,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":9.493,"sector":4.812,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":53.0,"sector":27.73,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":2.59,"sector":1.145,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":9.117,"sector":5.056,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":4.813,"sector":32.62,"verdict