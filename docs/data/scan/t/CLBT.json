urp":0.2397},{"q":"2026-06-30","act":0.11,"est":0.1128,"surp":-0.0251}],"div_pay":null,"rec_trend":{"strongBuy":2,"buy":6,"hold":0,"sell":0,"strongSell":0},"analyst_actions":[{"date":"2026-09-15","firm":"DA Davidson","action":"main","from":"Buy","to":"Buy"}]},"profile":{"sector":"Technology","industry":"Software - Infrastructure","summary":"Cellebrite DI Ltd. develops software and services for legally sanctioned investigations in Europe, the Middle East, Africa, the Americas, and the Asia-Pacific. The company provides a platform of software solutions used to access, collect, review, extract, decode, decrypt, analyze, share and manage digital evidence across the investigative lifecycle for a range of investigations, such as child exploitation, homicide, anti-terror, border control, sexual crimes, organized crime, human trafficking, corporate security, and intellectual property theft, as well as financial crimes, including those involving cryptocurrency. It also offers Inseyets, digital forensics software that collects and reviews digital evidence from various digital sources when conducting legally sanctioned investigations; Guardian Forensics, an evidence management solution which enables customers to manage their digital forensics workflows, and to store, share and review digital evidence; Guardian Collaborate, a digital evidence sharing tool; and Guardian Investigate, a case management and AI-powered analytics solution. In addition, it provides Cellebrite Pathfinder, which reduces the time spent manually reviewing digital evidence and enables actionable insights into a range of crime types; Corellium Falcon for conducting mobile vulnerability research, exploit introspection, and malware analysis; and Corellium Viper for mobile application penetration testing capabilities. Further, the company offers professional services, such as training and certification services, and advanced services. It serves federal, state, and local agencies, as well as corporations and service providers. The company is headquartered in Petah Tikva, Israel.","employees":1285,"website":"https://www.cellebrite.com","country":"Israel","city":"Petah Tikva","officers":[{"name":"Mr. David  Barter","title":"Chief Financial Officer"},{"name":"Mr. Thomas E. Hogan","title":"Advisor"},{"name":"Mr. Marcus  Jewell","title":"Global Chief Revenue Officer"}]},"sector_medians":{"fpe":17.92,"tpe":31.96,"ps":4.757,"pfcf":27.69,"peg":1.155,"pb":5.077,"ev_ebitda":20.02,"rev_growth":0.177,"eps_growth":0.339,"eps_growth_fwd":0.2255,"eps_growth_next":0.1929,"div_yield":0,"roe":0.1195,"roa":0.04674,"de":32.62,"gross_margin":0.5331,"op_margin":0.1128,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":18.32,"sector":17.92,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":52.04,"sector":31.96,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":5.879,"sector":4.757,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":24.2,"sector":27.69,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":null,"sector":1.155,"verdict":"—"},{"k":"pb","label":"Price / Book","v":5.606,"sector":5.077,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":4.317,"sector":32.62,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.158,"sector":0.177,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.679,"sector":0.339,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0758,"sector":0.2255,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1906,"sector":0.1929,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0.8296,"sector":0.5331,"verdict":"Strong"},{"k":"op_margin","label":"Operating margin","v":0.05299,"sector":0.1128,"verdict":"Weak"},{"k":"profit_margin","label":"Net margin","v":0.1143,"sector":0.08604,"verdict":"Strong"},{"k":"roe","label":"Return on equity","v":0.1242,