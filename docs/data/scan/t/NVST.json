 under the Nobel Biocare, Alpha-Bio Tec, Implant Direct, Nobel Procera, Ormco, Spark, Orascoptic, Damon, Insignia, AOA brands. The Equipment & Consumables segment provides dental equipment and supplies, including digital imaging systems, software, and other visualization/magnification systems; endodontic systems and related products; restorative materials, rotary burs, impression materials, bonding agents, and cements; and infection prevention products. This segment offers its products under the Dexis, DTX Studio, Kerr, Metrex, Total Care, Pentron, Optibond, Harmonize, Sonicfill, Sybron Endo, and CaviWipes to dental offices, clinics, and hospitals. Envista Holdings Corporation was incorporated in 2018 and is headquartered in Brea, California.","employees":12000,"website":"https://envistaco.com","country":"United States","city":"Brea","officers":[{"name":"Mr. Paul A. Keel","title":"President, CEO & Chairman"},{"name":"Mr. Eric D. Hammes","title":"Senior VP & CFO"},{"name":"Mr. Mark E. Nance J.D.","title":"Senior VP, General Counsel & Secretary"}]},"sector_medians":{"fpe":18.93,"tpe":29.94,"ps":4.243,"pfcf":28.07,"peg":1.36,"pb":4.477,"ev_ebitda":16.75,"rev_growth":0.1,"eps_growth":0.167,"eps_growth_fwd":0.0928,"eps_growth_next":0.1205,"div_yield":0,"roe":0.01454,"roa":0.02187,"de":41.94,"gross_margin":0.4983,"op_margin":0.04015,"profit_margin":0,"current_ratio":3.084},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.2,"sector":18.93,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":39.3,"sector":29.94,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":1.326,"sector":4.243,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":14.14,"sector":28.07,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":null,"sector":1.36,"verdict":"—"},{"k":"pb","label":"Price / Book","v":1.231,"sector":4.477,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":51.62,"sector":41.94,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growt