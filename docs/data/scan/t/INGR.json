tener products comprising glucose syrups, high maltose syrup, high fructose corn syrup, dextrose, polyols, maltodextrin, glucose syrup solids, and non-genetically modified organism syrups for applications in food and beverage products, such as baked goods, snack foods, canned fruits, condiments, candy and other sweets, dairy products, ice cream, jams and jellies, prepared mixes, table syrups, and beverages. In addition, the company sells refined corn oil, corn gluten feed, and corn gluten meal; and other products. The company was formerly known as Corn Products International, Inc. and changed its name to Ingredion Incorporated in June 2012. Ingredion Incorporated was founded in 1906 and is headquartered in Westchester, Illinois.","employees":11000,"website":"https://www.ingredion.com","country":"United States","city":"Westchester","officers":[{"name":"Mr. James P. Zallie","title":"Chairman, President & CEO"},{"name":"Mr. Eric  Seip","title":"Senior VP of Global Operations & Chief Supply Chain Officer"},{"name":"Ms. Tanya M. Jaeger de Foras J.D.","title":"Senior VP, Chief Legal Officer, Corporate Secretary & Chief Compliance Officer"}]},"sector_medians":{"fpe":15.02,"tpe":20.15,"ps":1.101,"pfcf":17.55,"peg":1.56,"pb":2.548,"ev_ebitda":11.08,"rev_growth":0.042,"eps_growth":0.1345,"eps_growth_fwd":0.0694,"eps_growth_next":0.0731,"div_yield":0.0188,"roe":0.1246,"roa":0.05689,"de":81.66,"gross_margin":0.3532,"op_margin":0.1082,"profit_margin":0.04034,"current_ratio":1.291},"valuation":[{"k":"fpe","label":"Forward P/E","v":8.167,"sector":15.02,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":11.06,"sector":20.15,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.8044,"sector":1.101,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":16.3,"sector":17.55,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":1.12,"sector":1.56,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.257,"sector":2.548,"verdict":"Undervalued"},{"k":"