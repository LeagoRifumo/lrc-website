h hardware, shower accessories, and shower doors. This segment provides its products under the BEHR, KILZ, WHIZZ, LIBERTY, and FRANKLIN BRASS brands to home center and other retailers, mass and online retailers, other specialty retailers, and original equipment manufacturers and wholesalers. The company was incorporated in 1929 and is headquartered in Livonia, Michigan.","employees":18000,"website":"https://masco.com","country":"United States","city":"Livonia","officers":[{"name":"Mr. Jonathon J. Nudi","title":"President, CEO & Director"},{"name":"Mr. Richard J. Westenberg","title":"VP, CFO & Treasurer"},{"name":"Mr. Kenneth G. Cole J.D.","title":"VP, General Counsel & Secretary"}]},"sector_medians":{"fpe":17.75,"tpe":26.36,"ps":2.156,"pfcf":26.62,"peg":1.4,"pb":3.514,"ev_ebitda":14.88,"rev_growth":0.11,"eps_growth":0.176,"eps_growth_fwd":0.1441,"eps_growth_next":0.1459,"div_yield":0.0066,"roe":0.149,"roa":0.05825,"de":66.95,"gross_margin":0.3185,"op_margin":0.1262,"profit_margin":0.0723,"current_ratio":1.665},"valuation":[{"k":"fpe","label":"Forward P/E","v":16.35,"sector":17.75,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":17.32,"sector":26.36,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.945,"sector":2.156,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":16.52,"sector":26.62,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.72,"sector":1.4,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":null,"sector":3.514,"verdict":"—"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":66.95,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":-0.029,"sector":0.11,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.245,"sector":0.176,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1441,"sector":0.1441,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.015,"sector":0.1459,"verdict":"Weak"},{"k