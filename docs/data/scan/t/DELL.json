 arrangements and offers payment and consumption solutions and services, such utility, subscription, as-a-service, leases, and loans, as well as fixed-term leases and loans. It serves enterprises, governmental agencies and other public institutions, educational institutions, healthcare organizations, small and medium-sized businesses, and consumers. The company has a strategic alliance with Rafay Systems for the development of AI infrastructure solutions. The company was formerly known as Denali Holding Inc. and changed its name to Dell Technologies Inc. in March 2013. Dell Technologies Inc. was founded in 1984 and is headquartered in Round Rock, Texas.","employees":97000,"website":"https://www.dell.com","country":"United States","city":"Round Rock","officers":[{"name":"Mr. Michael Saul Dell","title":"Chairman & CEO"},{"name":"Mr. William F. Scannell","title":"President & Chief Customer Officer"},{"name":"Mr. David  Kennedy","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":18.11,"tpe":32.9,"ps":6.499,"pfcf":32.32,"peg":0.98,"pb":7.778,"rev_growth":0.2175,"eps_growth":0.464,"eps_growth_fwd":0.2596,"eps_growth_next":0.1939,"div_yield":0.0011,"roe":0.2326,"roa":0.07978,"de":48.45,"gross_margin":0.586,"op_margin":0.2256,"profit_margin":0.1916,"current_ratio":1.562},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.61,"sector":18.11,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":26.54,"sector":32.9,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.964,"sector":6.499,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":49.22,"sector":32.32,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":0.46,"sector":0.98,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":null,"sector":7.778,"verdict":"—"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":48.45,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.577,"sector":0.2175,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y