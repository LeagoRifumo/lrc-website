":6.55,"est":5.742,"surp":0.1407},{"q":"2026-07-31","act":5.1,"est":4.709,"surp":0.083}],"div_pay":"2026-11-09","rec_trend":{"strongBuy":5,"buy":11,"hold":9,"sell":0,"strongSell":0},"analyst_actions":[{"date":"2026-10-08","firm":"JP Morgan","action":"main","from":"Neutral","to":"Neutral"}]},"profile":{"sector":"Industrials","industry":"Farm & Heavy Construction Machinery","summary":"Deere & Company manufactures and distributes various equipment worldwide. It operates through four segments: Production and Precision Agriculture, Small Agriculture and Turf, Construction and Forestry, and Financial Services. The Production and Precision Agriculture segment provides track and row crop tractors, harvesters, cotton pickers and strippers, sugarcane harvesters and loaders, soil preparation, tillage, seeding, and crop care equipment; and application equipment, such as sprayers and nutrient management, soil preparation machinery, and related attachments and service parts. The Small Agriculture and Turf segment offers specialty, utility, and compact tractors; self-propelled forage harvesters and attachments; rotary mowers, hay and forage equipment, and utility vehicles; turf and utility equipment, including riding lawn, commercial mowing, and golf course equipment, and utility vehicles, as well as implements for mowing, tilling, snow and debris handling, aerating, residential, commercial, golf, and sports turf care applications. The Construction and Forestry segment provides backhoe loaders, crawler dozers and loaders, loaders, excavators, motor graders, articulated dump trucks, skid-steer loaders, milling machines, recyclers, slipform and asphalt pavers, surface miners, compactors, tandem, static rollers, mobile crushers and screens, mobile and stationary asphalt plants, and log harvesters; and road building and rehabilitation equipment. The Financial Services segment finances sales and leases agriculture and turf, and construction and forestry equipment. It also offers wholesale financing to dealers of the foregoing equipment; and extended equipment warranties. It has a strategic partnership with Tarter USA to develop and produce flex wing rotary cutters. It also has strategic partnership with Yamaha Motor Corporation, Usa to co-develop future side-by-side vehicles. The company was founded in 1837 and is headquartered in Moline, Illinois.","employees":73100,"website":"https://www.deere.com","country":"United States","city":"Moline","officers":[{"name":"Mr. John C. May II","title":"Chairman, President & CEO"},{"name":"Mr. Ryan D. Campbell","title":"President of Worldwide Construction, Forestry & Power Systems"},{"name":"Ms. Deanna M. Kovar","title":"President of Worldwide Ag & Turf Div, Production and Precision Ag and Americas and Australia"}]},"sector_medians":{"fpe":18.26,"tpe":26.27,"ps":2.184,"pfcf":28.38,"peg":1.435,"pb":3.631,"ev_ebitda":15.11,"rev_growth":0.1185,"eps_growth":0.175,"eps_growth_fwd":0.1588,"eps_growth_next":0.143,"div_yield":0.0068,"roe":0.1466,"roa":0.05844,"de":66.28,"gross_margin":0.3187,"op_margin":0.1262,"profit_margin":0.07423,"current_ratio":1.689},"valuation":[{"k":"fpe","label":"Forward P/E","v":29.34,"sector":18.26,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":37.15,"sector":26.27,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":3.762,"sector":2.184,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":39.93,"sector":28.38,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.57,"sector":1.435,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":6.442,"sector":3.631,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":230.3,"sector":66.28,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.049,"sector":0.1185,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.074,"sector":0.175,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0217,"sector":0.1588,"verdict":"Weak"},{"