s. The company sells its products through a network of food brokers, independent sales distributors, and a direct sales force. It serves snack bars and food stand locations in chain, department and mass merchandising stores, malls and shopping centers, fast food and casual dining restaurants, stadiums and sports arenas, leisure and theme parks, convenience stores, movie theatres, warehouse club stores, schools, colleges and other institutions, and independent retailers. The company was incorporated in 1971 and is headquartered in Mount Laurel, New Jersey.","employees":4600,"website":"https://www.jjsnack.com","country":"United States","city":"Mount Laurel","officers":[{"name":"Mr. Daniel J. Fachner","title":"President, CEO & Chairman"},{"name":"Mr. Shawn C. Munsell","title":"Senior VP & CFO"},{"name":"Mr. Stephen J. Every","title":"Executive Vice President of Operations"}]},"sector_medians":{"fpe":15.02,"tpe":20.15,"ps":1.101,"pfcf":17.55,"peg":1.56,"pb":2.548,"ev_ebitda":11.08,"rev_growth":0.042,"eps_growth":0.1345,"eps_growth_fwd":0.0694,"eps_growth_next":0.0731,"div_yield":0.0188,"roe":0.1246,"roa":0.05689,"de":81.66,"gross_margin":0.3532,"op_margin":0.1082,"profit_margin":0.04034,"current_ratio":1.291},"valuation":[{"k":"fpe","label":"Forward P/E","v":22.8,"sector":15.02,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":34.82,"sector":20.15,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":1.101,"sector":1.101,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":29.21,"sector":17.55,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":5.12,"sector":1.56,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.876,"sector":2.548,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":21.51,"sector":81.66,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.062,"sector":0.042,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.168,"sector":0.1345,"verdict":"Weak"},{"k":"e