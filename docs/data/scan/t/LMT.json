rk-enabled situational awareness; and integrates space and ground global systems to help its customers gather, analyze, and securely distribute critical intelligence data. It primarily serves the U.S. government and international customers, as well as foreign military sales contracted through the U.S. government. The company was formerly known as The Lockheed Corporation and changed its name to Lockheed Martin Corporation in March 1995. Lockheed Martin Corporation was founded in 1912 and is based in Bethesda, Maryland.","employees":123000,"website":"https://www.lockheedmartin.com","country":"United States","city":"Bethesda","officers":[{"name":"Mr. James D. Taiclet Jr.","title":"Chairman, President & CEO"},{"name":"Mr. Evan T. Scott","title":"Chief Financial Officer"},{"name":"Mr. Frank A. St. John","title":"Chief Operating Officer"}]},"sector_medians":{"fpe":20.36,"tpe":27.47,"ps":3.42,"pfcf":30.39,"peg":1.56,"pb":6.084,"rev_growth":0.097,"eps_growth":0.13,"eps_growth_fwd":0.1265,"eps_growth_next":0.1335,"div_yield":0.0115,"roe":0.204,"roa":0.07231,"de":70.14,"gross_margin":0.3678,"op_margin":0.1746,"profit_margin":0.1184,"current_ratio":1.328},"valuation":[{"k":"fpe","label":"Forward P/E","v":18.25,"sector":20.36,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":21.46,"sector":27.47,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.764,"sector":3.42,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":24.72,"sector":30.39,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":1.14,"sector":1.56,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":13.81,"sector":6.084,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":203.7,"sector":70.14,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.113,"sector":0.097,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.147,"sector":0.13,"verdict":"In line"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)"