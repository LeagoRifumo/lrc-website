urface measurements; MicroProf 200, a measuring device for contactless and non-destructive characterization of surfaces and films; and MicroProf 300, a SurfaceSens technology for quality assurance, development, and manufacturing. The company serves semiconductor manufacturers, outsourced semiconductor assembly and test, integrated device manufacturers, and wafer level packaging subcontractors. Camtek Ltd. was incorporated in 1987 and is headquartered in Migdal HaEmek, Israel.","employees":709,"website":"https://www.camtek.com","country":"Israel","city":"Migdal Haemek","officers":[{"name":"Mr. Lior  Aviram","title":"Executive Chairman of the Board"},{"name":"Mr. Rafi  Amit","title":"CEO & Director"},{"name":"Mr. Moshe  Eisenberg","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":17.87,"tpe":31.18,"ps":4.503,"pfcf":26.7,"peg":1.17,"pb":4.727,"ev_ebitda":19.34,"rev_growth":0.183,"eps_growth":0.357,"eps_growth_fwd":0.2351,"eps_growth_next":0.1868,"div_yield":0,"roe":0.1241,"roa":0.04714,"de":31.61,"gross_margin":0.5318,"op_margin":0.1282,"profit_margin":0.09291,"current_ratio":1.818},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":17.87,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":166.5,"sector":31.18,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":10.12,"sector":4.503,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":26.7,"verdict":"—"},{"k":"peg","label":"PEG","v":1.63,"sector":1.17,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":8.041,"sector":4.727,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":71.47,"sector":31.61,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.025,"sector":0.183,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.1,"sector":0.357,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1144,"sector":0.2351,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (n