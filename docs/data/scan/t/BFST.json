y-mail services. Business First Bancshares, Inc. was incorporated in 2006 and is headquartered in Baton Rouge, Louisiana.","employees":821,"website":"https://www.b1bank.com","country":"United States","city":"Baton Rouge","officers":[{"name":"Mr. David R. Melville III","title":"Chairman, President & CEO"},{"name":"Mr. Gregory  Robertson","title":"Executive VP, CFO & Treasurer"},{"name":"Mr. Keith  Mansfield","title":"Executive VP & COO"}]},"sector_medians":{"fpe":10.61,"tpe":12.89,"ps":3.433,"pfcf":12.03,"peg":1.3,"pb":1.609,"ev_ebitda":10.69,"rev_growth":0.109,"eps_growth":0.153,"eps_growth_fwd":0.1337,"eps_growth_next":0.1104,"div_yield":0.0215,"roe":0.1283,"roa":0.01521,"de":54.95,"gross_margin":0.2245,"op_margin":0.3601,"profit_margin":0.2534,"current_ratio":1.509},"valuation":[{"k":"fpe","label":"Forward P/E","v":9.617,"sector":10.61,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":11.42,"sector":12.89,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":2.967,"sector":3.433,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":12.03,"verdict":"—"},{"k":"peg","label":"PEG","v":null,"sector":1.3,"verdict":"—"},{"k":"pb","label":"Price / Book","v":1.114,"sector":1.609,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":54.95,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.173,"sector":0.109,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.025,"sector":0.153,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0728,"sector":0.1337,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0916,"sector":0.1104,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0,"sector":0.2245,"verdict":"Weak"},{"k":"op_margin","label":"Operating margin","v":0.3526,"sector":0.3601,"verdict":"In line"},{"k":"profit_margin","label":"Net margin","v":0.2724,"sector":0.2534,"verdict":"In 