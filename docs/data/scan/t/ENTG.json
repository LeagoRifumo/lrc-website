ry semiconductor device manufacturers, semiconductor equipment makers, gas and chemical manufacturing companies, and wafer grower companies; and outsourced semiconductor assembly and test facilities, flat panel display equipment makers, and manufacturers of hard disk drive components and devices. It serves manufacturers and suppliers in the solar and life science industries, electrical discharge machining customers, glass manufacturers, aerospace manufacturers, and manufacturers of biomedical implantation devices. Entegris, Inc. was founded in 1966 and is headquartered in Billerica, Massachusetts.","employees":7700,"website":"https://www.entegris.com","country":"United States","city":"Billerica","officers":[{"name":"Mr. David W. Reeder","title":"CEO, President & Director"},{"name":"Mr. Joseph  Colella J.D.","title":"Senior VP, General Counsel, Chief Compliance Officer & Secretary"},{"name":"Ms. Susan  Rice","title":"Senior Vice President of Global Human Resources & Corporate Communications"}]},"sector_medians":{"fpe":17.36,"tpe":29.57,"ps":4.323,"pfcf":25.98,"peg":1.09,"pb":4.666,"ev_ebitda":19.21,"rev_growth":0.185,"eps_growth":0.3665,"eps_growth_fwd":0.2411,"eps_growth_next":0.1798,"div_yield":0,"roe":0.125,"roa":0.04945,"de":32.75,"gross_margin":0.5312,"op_margin":0.1357,"profit_margin":0.09441,"current_ratio":1.873},"valuation":[{"k":"fpe","label":"Forward P/E","v":25.06,"sector":17.36,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":54.5,"sector":29.57,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":6.072,"sector":4.323,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":43.05,"sector":25.98,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":0.98,"sector":1.09,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":4.917,"sector":4.666,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":77.57,"sector":32.75,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.246,"sector":0.185,"verdi