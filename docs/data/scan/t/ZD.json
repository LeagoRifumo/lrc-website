keting and delivery solutions, search engine optimization tools, and voice and text communication services under the Campaigner, iContact, SMTP, Kickbox, Full Contact, MOZ Pro, MOZ Local, Stat Analytics, eVoice, and Line2 brands. The company was formerly known as j2 Global, Inc. and changed its name to Ziff Davis, Inc. in October 2021. The company was incorporated in 2014 and is headquartered in New York, New York.","employees":3900,"website":"https://www.ziffdavis.com","country":"United States","city":"New York","officers":[{"name":"Mr. Vivek R. Shah","title":"CEO, President & Director"},{"name":"Mr. Bret  Richter","title":"Chief Financial Officer"},{"name":"Ms. Lori A. Tansley","title":"Chief Accounting Officer"}]},"sector_medians":{"fpe":12.15,"tpe":18.9,"ps":2.151,"pfcf":14.01,"peg":1.09,"pb":2.222,"ev_ebitda":13.49,"rev_growth":0.0805,"eps_growth":0.053,"eps_growth_fwd":0.1456,"eps_growth_next":0.1477,"div_yield":0,"roe":0.0878,"roa":0.04007,"de":64.06,"gross_margin":0.5713,"op_margin":0.1332,"profit_margin":0.06819,"current_ratio":1.257},"valuation":[{"k":"fpe","label":"Forward P/E","v":9.253,"sector":12.15,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":18.9,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":1.32,"sector":2.151,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":3.586,"sector":14.01,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.52,"sector":1.09,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":0.8652,"sector":2.222,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":39.98,"sector":64.06,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.027,"sector":0.0805,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":26.32,"sector":0.053,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.2239,"sector":0.1456,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":