ancial and estate planning, and retirement plan services, as well as automated-teller-machine, interactive-teller-machine, mobile banking, interactive voice response systems, and credit and debit card services. The company was founded in 1957 and is headquartered in Charleston, West Virginia.","employees":926,"website":"https://www.bankatcity.com","country":"United States","city":"Charleston","officers":[{"name":"Mr. Charles R. Hageboeck Ph.D.","title":"President, CEO & Director"},{"name":"Mr. David L. Bumgarner CPA","title":"Senior Executive VP & CFO"},{"name":"Mr. Jeffrey Dale Legge","title":"Executive VP of Operations, Chief Administrative Officer & Chief Information Officer"}]},"sector_medians":{"fpe":10.53,"tpe":12.77,"ps":3.425,"pfcf":12.43,"peg":1.32,"pb":1.618,"ev_ebitda":10.75,"rev_growth":0.1,"eps_growth":0.152,"eps_growth_fwd":0.1315,"eps_growth_next":0.1087,"div_yield":0.0217,"roe":0.1279,"roa":0.01565,"de":53.89,"gross_margin":0.2437,"op_margin":0.326,"profit_margin":0.2552,"current_ratio":1.531},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.81,"sector":10.53,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":15.7,"sector":12.77,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":6.259,"sector":3.425,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":12.43,"verdict":"—"},{"k":"peg","label":"PEG","v":1.91,"sector":1.32,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":2.588,"sector":1.618,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":53.89,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.029,"sector":0.1,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.008,"sector":0.152,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.049,"sector":0.1315,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0366,"sector":0.1087,"verdict":"Weak"},{"k":"gross_margin"