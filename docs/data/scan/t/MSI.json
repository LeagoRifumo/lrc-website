are and Services segment offers public safety and enterprise command center, unified communications applications, mobile video equipment, and video software solutions; repair, technical support, and maintenance services; and monitoring, software updates, and cybersecurity services to government, public safety, and commercial communications networks. It serves hospitality; manufacturing; military and defence; police; air transportation; fire and rescue; stadium; emergency medical services; mining; oil and gas; transportation and logistics; utilities; education; retail; and healthcare industries. The company was formerly known as Motorola, Inc. and changed its name to Motorola Solutions, Inc. in January 2011. Motorola Solutions, Inc. was founded in 1928 and is headquartered in Chicago, Illinois.","employees":23000,"website":"https://www.motorolasolutions.com","country":"United States","city":"Chicago","officers":[{"name":"Mr. Gregory Q. Brown","title":"Chairman & CEO"},{"name":"Mr. Jason J. Winkler","title":"Executive VP & CFO"},{"name":"Mr. John P. Molloy","title":"Executive VP & COO"}]},"sector_medians":{"fpe":17.44,"tpe":29.99,"ps":4.427,"pfcf":26.07,"peg":1.11,"pb":4.648,"ev_ebitda":18.98,"rev_growth":0.191,"eps_growth":0.356,"eps_growth_fwd":0.2432,"eps_growth_next":0.1809,"div_yield":0,"roe":0.1241,"roa":0.04945,"de":32.8,"gross_margin":0.5312,"op_margin":0.1174,"profit_margin":0.09364,"current_ratio":1.863},"valuation":[{"k":"fpe","label":"Forward P/E","v":27.31,"sector":17.44,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":42.95,"sector":29.99,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":6.998,"sector":4.427,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":46.27,"sector":26.07,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":2.34,"sector":1.11,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":28.77,"sector":4.648,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":345.6,"sector":32.8,"verdict"