t":1.39,"est":1.3,"surp":0.0692},{"q":"2026-03-31","act":1.26,"est":1.29,"surp":-0.0233},{"q":"2026-06-30","act":1.76,"est":1.59,"surp":0.1069}],"div_pay":null,"rec_trend":{"strongBuy":0,"buy":1,"hold":1,"sell":0,"strongSell":0},"analyst_actions":[]},"profile":{"sector":"Industrials","industry":"Industrial Distribution","summary":"DXP Enterprises, Inc., together with its subsidiaries, engages in distributing maintenance, repair, and operating (MRO) products, equipment, and services in the United States, Canada, and internationally. The company operates in three segments: Service Centers, Supply Chain Services, and Innovative Pumping Solutions. The Service Centers segment offers MRO products, equipment, and integrated services, including technical expertise and logistics capabilities. It also provides a range of MRO products in the rotating equipment, bearing, power transmission, hose, fluid power, metal working, fastener, industrial supply, safety products, and safety services categories. This segment serves customers in the oil and gas, general industrial, manufacturing, chemical, food and beverage, refining, water and wastewater, fabrication and construction, and other industries. Its Supply Chain Services segment manages procurement and inventory optimization and management, store-room management, transaction consolidation and control, vendor oversight and procurement cost optimization, productivity improvement, and customized reporting services. The company's programs include SmartAgreement, a procurement solution for various MRO categories; SmartBuy, an on-site or centralized MRO procurement solution; SmartSource, an on-site procurement and storeroom management solution; SmartStore, an e-Catalog solution; SmartVend, an industrial dispensing solution; and SmartServ, an integrated service pump solution. The Innovative Pumping Solutions segment fabricates and assembles custom-made pump packages; remanufactures pumps; and manufactures branded private label pumps. The company was formerly known as INDEX INC and changed its name to DXP Enterprises, Inc. in May 1997. DXP Enterprises, Inc. was founded in 1908 and is based in Houston, Texas.","employees":3286,"website":"https://www.dxpe.com","country":"United States","city":"Houston","officers":[{"name":"Mr. David R. Little","title":"Chairman of the Board, President & CEO"},{"name":"Mr. Kent  Yee","title":"Senior VP, CFO, Secretary & Director"},{"name":"Mr. Nicholas  Little","title":"Senior VP & COO"}]},"sector_medians":{"fpe":17.94,"tpe":26.67,"ps":2.183,"pfcf":27.09,"peg":1.39,"pb":3.569,"ev_ebitda":15.27,"rev_growth":0.1115,"eps_growth":0.205,"eps_growth_fwd":0.156,"eps_growth_next":0.1459,"div_yield":0.0067,"roe":0.1485,"roa":0.05825,"de":66.55,"gross_margin":0.3184,"op_margin":0.1215,"profit_margin":0.07337,"current_ratio":1.672},"valuation":[{"k":"fpe","label":"Forward P/E","v":23.09,"sector":17.94,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":31.14,"sector":26.67,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.283,"sector":2.183,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":37.05,"sector":27.09,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":0.55,"sector":1.39,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":5.072,"sector":3.569,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":166.3,"sector":66.55,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.156,"sector":0.1115,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.23,"sector":0.205,"verdict":"In line"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1919,"sector":0.156,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1858,"sector":0.1459,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.3176,"sector":0.3184,"verdict":"In line"},{"k":"op_margin","label":"Operating margin","v":0.09626,"sector":0.1215,"verdict":"In l