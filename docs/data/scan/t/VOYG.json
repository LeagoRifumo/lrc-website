 It serves defense, national security, and space industries. The company was formerly known as Voyager Space Holdings, Inc. and changed its name to Voyager Technologies, Inc. in February 2025. Voyager Technologies, Inc. was incorporated in 2019 and is headquartered in Denver, Colorado.","employees":800,"website":"https://voyagertechnologies.com","country":"United States","city":"Denver","officers":[{"name":"Mr. Dylan E. Taylor MBA","title":"Co-Founder, Chairman & CEO"},{"name":"Mr. Matthew James Kuta","title":"Co-Founder, President & Director"},{"name":"Mr. Filipe G. de Sousa","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":17.93,"tpe":25.73,"ps":2.138,"pfcf":27.54,"peg":1.41,"pb":3.575,"ev_ebitda":14.97,"rev_growth":0.118,"eps_growth":0.174,"eps_growth_fwd":0.156,"eps_growth_next":0.1445,"div_yield":0.0067,"roe":0.1461,"roa":0.05806,"de":67.36,"gross_margin":0.3187,"op_margin":0.1262,"profit_margin":0.07423,"current_ratio":1.689},"valuation":[{"k":"fpe","label":"Forward P/E","v":-1,"sector":17.93,"verdict":"Loss-making"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":25.73,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":6.447,"sector":2.138,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":27.54,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":null,"sector":1.41,"verdict":"—"},{"k":"pb","label":"Price / Book","v":4.504,"sector":3.575,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":239.2,"sector":67.36,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":1.241,"sector":0.118,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.174,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.4488,"sector":0.156,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.502,"sector":0.1445,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.1036,"sector":0.3187,"verdict":"