idewire Data Studio, Guidewire Canvas, Guidewire Compare, Guidewire industry Intel, and Guidewire Explore, an cloud-native applications; Guidewire Cyence, a cyber-risk economic modeling product; Guidewire DataHub, an operational data store; and Guidewire InfoCenter, a business intelligence warehouse for P&C insurers. The company was incorporated in 2001 and is headquartered in San Mateo, California.","employees":4174,"website":"https://www.guidewire.com","country":"United States","city":"San Mateo","officers":[{"name":"Mr. Michael George Rosenbaum","title":"CEO & Director"},{"name":"Mr. Jeffrey Elliott Cooper","title":"Chief Financial Officer"},{"name":"Mr. David F. Peterson","title":"Senior VP, Principal Accounting Officer & Chief Accounting Officer"}]},"sector_medians":{"fpe":17.73,"tpe":31.01,"ps":4.582,"pfcf":26.55,"peg":1.16,"pb":4.831,"ev_ebitda":19.21,"rev_growth":0.1835,"eps_growth":0.3615,"eps_growth_fwd":0.2307,"eps_growth_next":0.1906,"div_yield":0,"roe":0.1245,"roa":0.04768,"de":32.58,"gross_margin":0.5372,"op_margin":0.1249,"profit_margin":0.09218,"current_ratio":1.81},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":17.73,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":98.95,"sector":31.01,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":8.924,"sector":4.582,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":38.38,"sector":26.55,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.04,"sector":1.16,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":11.03,"sector":4.831,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":59.9,"sector":32.58,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.153,"sector":0.1835,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.382,"sector":0.3615,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2186,"sector":0.2307,"verdict":"In line"},{"k":"eps_growth_next","label":