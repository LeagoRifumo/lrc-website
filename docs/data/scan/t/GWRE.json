wire Data Studio, Guidewire Canvas, Guidewire Compare, Guidewire industry Intel, and Guidewire Explore, an cloud-native applications; Guidewire Cyence, a cyber-risk economic modeling product; Guidewire DataHub, an operational data store; and Guidewire InfoCenter, a business intelligence warehouse for P&C insurers. The company was incorporated in 2001 and is headquartered in San Mateo, California.","employees":4174,"website":"https://www.guidewire.com","country":"United States","city":"San Mateo","officers":[{"name":"Mr. Michael George Rosenbaum","title":"CEO & Director"},{"name":"Mr. Jeffrey Elliott Cooper","title":"Chief Financial Officer"},{"name":"Mr. David F. Peterson","title":"Senior VP, Principal Accounting Officer & Chief Accounting Officer"}]},"sector_medians":{"fpe":18.12,"tpe":31.43,"ps":4.812,"pfcf":27.73,"peg":1.145,"pb":5.056,"ev_ebitda":19.99,"rev_growth":0.177,"eps_growth":0.339,"eps_growth_fwd":0.2264,"eps_growth_next":0.1929,"div_yield":0,"roe":0.1195,"roa":0.04674,"de":32.62,"gross_margin":0.5331,"op_margin":0.1128,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":18.12,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":98.2,"sector":31.43,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":8.896,"sector":4.812,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":38.26,"sector":27.73,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.09,"sector":1.145,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":11.0,"sector":5.056,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":59.9,"sector":32.62,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.153,"sector":0.177,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.382,"sector":0.339,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2186,"sector":0.2264,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS g