ury, derivative and other trading, corporate and bank-owned life insurance, tax credit investment, other corporate investment, and business exit services. The company serves central banks and sovereigns, financial institutions, asset managers, insurance companies, corporations, local authorities and high net-worth individuals, and family offices. The Bank of New York Mellon Corporation was founded in 1784 and is headquartered in New York, New York.","employees":46600,"website":"https://www.bny.com","country":"United States","city":"New York","officers":[{"name":"Mr. Robin Antony Vince","title":"President, CEO & Chairman of the Board"},{"name":"Mr. Dermot William McDonogh","title":"Senior Executive VP & CFO"},{"name":"Mr. Jose Manuel Minaya","title":"Senior EVP and Global Head of BNY Investments & Wealth"}]},"sector_medians":{"fpe":12.53,"tpe":14.16,"ps":3.208,"pfcf":16.7,"peg":1.305,"pb":2.392,"ev_ebitda":11.14,"rev_growth":0.101,"eps_growth":0.1435,"eps_growth_fwd":0.1451,"eps_growth_next":0.1006,"div_yield":0.0177,"roe":0.1492,"roa":0.02526,"de":55.67,"gross_margin":0.3779,"op_margin":0.3191,"profit_margin":0.2302,"current_ratio":1.043},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.16,"sector":12.53,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":16.34,"sector":14.16,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":4.514,"sector":3.208,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":16.7,"verdict":"—"},{"k":"peg","label":"PEG","v":1.08,"sector":1.305,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":2.526,"sector":2.392,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":55.67,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.115,"sector":0.101,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.245,"sector":0.1435,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2569,"sector":