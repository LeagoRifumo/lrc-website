":-2.497},{"q":"2026-03-31","act":0.02334,"est":0.02,"surp":0.167},{"q":"2026-06-30","act":0.14,"est":0.1235,"surp":0.1337},{"q":"2026-09-30","act":0.18,"est":0.1813,"surp":-0.0072}],"div_pay":null,"rec_trend":{"strongBuy":1,"buy":3,"hold":2,"sell":0,"strongSell":0},"analyst_actions":[]},"profile":{"sector":"Industrials","industry":"Specialty Business Services","summary":"TIC Solutions, Inc. provides critical asset integrity services in North America. The company offers testing, inspection, certification, and compliance (TICC) services, including various nondestructive testing (NDT) techniques, such as radiography, ultrasonic testing, magnetic particle inspection, penetrant testing, and visual inspection. Its NDT activities include inspection and evaluation of industrial equipment through various technology-enabled methods to ensure asset integrity, prevent costly outages, failures, and accidents, and meet regulatory requirements without damaging the asset or component. It also provides market rope access technician solutions, including inspection and testing, as well as insulation, coatings and blasting, welding, pipe fitting, hoisting and rigging, and electrical services. In addition, its TICC services include support from consulting engineers with destructive testing, support failure investigation, material selection, corrosion engineering, welding engineering, fracture mechanics, destructive testing, and chemical analysis. Further, it offers geospatial services, such as data collection, data analytics, and software solutions that support asset management and infrastructure planning. The company serves a range of industrial markets, such as chemical, pipeline, refinery, power generation, oilsands, automotive, aerospace, mining, manufacturing, renewable energy, and pulp and paper. TIC Solutions, Inc. was formerly known as Acuren Corporation and changed its name to TIC Solutions, Inc. in October 2025. The company was founded in 1974 and is headquartered in Hollywood, Florida.","employees":11084,"website":"https://www.ticsolutions.com","country":"United States","city":"Hollywood","officers":[{"name":"Sir Martin Ellis Franklin","title":"Executive Co-Chairman"},{"name":"Mr. Robert A.E. Franklin","title":"Executive Chairman"},{"name":"Mr. Benjamin  Heraud","title":"CEO & Director"}]},"sector_medians":{"fpe":17.91,"tpe":25.6,"ps":2.127,"pfcf":27.13,"peg":1.41,"pb":3.619,"ev_ebitda":14.59,"rev_growth":0.119,"eps_growth":0.176,"eps_growth_fwd":0.1619,"eps_growth_next":0.1433,"div_yield":0.0071,"roe":0.1451,"roa":0.05694,"de":67.22,"gross_margin":0.3203,"op_margin":0.1163,"profit_margin":0.07298,"current_ratio":1.741},"valuation":[{"k":"fpe","label":"Forward P/E","v":18.03,"sector":17.91,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":25.6,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":1.054,"sector":2.127,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":13.71,"sector":27.13,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":null,"sector":1.41,"verdict":"—"},{"k":"pb","label":"Price / Book","v":1.114,"sector":3.619,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":80.94,"sector":67.22,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.35,"sector":0.119,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.176,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":3.098,"sector":0.1619,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.2867,"sector":0.1433,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.3471,"sector":0.3203,"verdict":"In line"},{"k":"op_margin","label":"Operating margin","v":0.01288,"sector":0.1163,"verdict":"Weak"},{"k":"profit_margin","label":"Net margin","v":-0.05099,"sector":0.07298,"verdict":"Weak"},{"k":"roe","label":"Return on equity","v":-0.05578,"sector":0.1451,"verdict":"Weak"},{"k":"roa","label