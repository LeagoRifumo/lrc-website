 Company was founded in 1869 and is headquartered in Camden, New Jersey.","employees":13500,"website":"https://www.thecampbellscompany.com","country":"United States","city":"Camden","officers":[{"name":"Mr. Mick J. Beekhuizen","title":"CEO, President & Director"},{"name":"Mr. Todd E. Cunfer","title":"Executive VP & Chief Financial Officer"},{"name":"Ms. Diane Johnson May","title":"Executive VP & Chief People and Culture Officer"}]},"sector_medians":{"fpe":14.34,"tpe":21.52,"ps":1.215,"pfcf":17.24,"peg":1.45,"pb":2.529,"ev_ebitda":10.95,"rev_growth":0.043,"eps_growth":0.09,"eps_growth_fwd":0.06965,"eps_growth_next":0.0682,"div_yield":0.0216,"roe":0.1334,"roa":0.05646,"de":81.13,"gross_margin":0.3618,"op_margin":0.111,"profit_margin":0.04107,"current_ratio":1.282},"valuation":[{"k":"fpe","label":"Forward P/E","v":11.26,"sector":14.34,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":15.79,"sector":21.52,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.633,"sector":1.215,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":9.72,"sector":17.24,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.54,"sector":1.45,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.601,"sector":2.529,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":179.3,"sector":81.13,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.079,"sector":0.043,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.09,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.2187,"sector":0.06965,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0834,"sector":0.0682,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0.2854,"sector":0.3618,"verdict":"In line"},{"k":"op_margin","label":"Operating margin","v":0.102,"sector":0.111,"verdict":"In line"},{"k":"profit_margin","label":"Net margin","v":0.04136,"sector":0