d turnkey solutions for the mechanical and electric-drive, compression, and power-generation applications; aftermarket support and uptime gas technology services; non-destructive testing technologies, software, and services; pre-commissioning and maintenance services; flow control and safety solutions; mechanical and electromechanical gear transmission systems; Cordant, a software solution to optimize assets, processes, and energy use; Bently Nevada, a sensing and protection hardware for rack-based vibrating monitoring equipment and sensors; and climate technology solutions. It serves industrial, upstream, midstream, downstream, onshore, offshore, and small-to-large scale customers. The company was formerly known as Baker Hughes, a GE company and changed its name to Baker Hughes Company in October 2019. The company was incorporated in 2016 and is based in Houston, Texas.","employees":54000,"website":"https://www.bakerhughes.com","country":"United States","city":"Houston","officers":[{"name":"Mr. Lorenzo  Simonelli","title":"Chairman, President & CEO"},{"name":"Mr. Ahmed  Moghal","title":"Executive VP & CFO"},{"name":"Ms. Georgia M. Magno","title":"Chief Legal Officer"}]},"sector_medians":{"fpe":11.94,"tpe":15.14,"ps":2.161,"pfcf":16.26,"peg":1.325,"pb":2.115,"ev_ebitda":7.982,"rev_growth":0.278,"eps_growth":0.801,"eps_growth_fwd":0.5115,"eps_growth_next":0.0398,"div_yield":0.019,"roe":0.1337,"roa":0.05517,"de":55.83,"gross_margin":0.4427,"op_margin":0.2457,"profit_margin":0.1021,"current_ratio":1.443},"valuation":[{"k":"fpe","label":"Forward P/E","v":19.02,"sector":11.94,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":17.96,"sector":15.14,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.999,"sector":2.161,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":12.55,"sector":16.26,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.6,"sector":1.325,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":2.925,"sector":