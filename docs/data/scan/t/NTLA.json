 company was formerly known as AZRN, Inc. and changed its name to Intellia Therapeutics, Inc. in July 2014. Intellia Therapeutics, Inc. was incorporated in 2014 and is headquartered in Cambridge, Massachusetts.","employees":377,"website":"https://www.intelliatx.com","country":"United States","city":"Cambridge","officers":[{"name":"Dr. John M. Leonard M.D.","title":"President, CEO & Director"},{"name":"Mr. Edward J. Dulac III","title":"Executive VP, CFO & Treasurer"},{"name":"Dr. Birgit  Schultes Ph.D.","title":"Executive VP & Chief Scientific Officer"}]},"sector_medians":{"fpe":19.45,"tpe":31.47,"ps":4.12,"pfcf":29.12,"peg":1.35,"pb":4.561,"ev_ebitda":17.26,"rev_growth":0.094,"eps_growth":0.147,"eps_growth_fwd":0.0883,"eps_growth_next":0.1182,"div_yield":0,"roe":0.01671,"roa":0.02341,"de":43.27,"gross_margin":0.5196,"op_margin":0.05617,"profit_margin":0,"current_ratio":3.001},"valuation":[{"k":"fpe","label":"Forward P/E","v":-1,"sector":19.45,"verdict":"Loss-making"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":31.47,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":26.21,"sector":4.12,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":29.12,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":null,"sector":1.35,"verdict":"—"},{"k":"pb","label":"Price / Book","v":2.142,"sector":4.561,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":10.09,"sector":43.27,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.462,"sector":0.094,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.147,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1748,"sector":0.0883,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1843,"sector":0.1182,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0,"sector":0.5196,"verdict":"Weak"},{"k":"op_margin","label":"Operating margin","v":-14.72,"sector":0.