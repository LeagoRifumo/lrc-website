 contract farmers. This segment also sells livestock feed and grains; and provides transportation and other ancillary services. The Other segment engages in the bioscience operations uses raw materials from hogs that process to manufacture heparin products, including an active pharmaceutical ingredient that mitigates the risk of blood clots; and produces fresh pork products in Mexico. The company was founded in 1936 and is headquartered in Smithfield, Virginia. Smithfield Foods, Inc. is a subsidiary of SFDS UK Holdings Limited.","employees":33500,"website":"https://www.smithfieldfoods.com","country":"United States","city":"Smithfield","officers":[{"name":"Mr. Charles Shane Smith","title":"President, CEO & Director"},{"name":"Mr. Mark L.  Hall","title":"Chief Financial Officer"},{"name":"Mr. Steven J. France","title":"President of Packaged Meats"}]},"sector_medians":{"fpe":15.29,"tpe":20.43,"ps":1.184,"pfcf":18.28,"peg":1.575,"pb":2.677,"ev_ebitda":10.92,"rev_growth":0.0445,"eps_growth":0.143,"eps_growth_fwd":0.0694,"eps_growth_next":0.07255,"div_yield":0.01735,"roe":0.13,"roa":0.05646,"de":81.15,"gross_margin":0.3532,"op_margin":0.1057,"profit_margin":0.03892,"current_ratio":1.278},"valuation":[{"k":"fpe","label":"Forward P/E","v":10.78,"sector":15.29,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":8.583,"sector":20.43,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.509,"sector":1.184,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":11.42,"sector":18.28,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":null,"sector":1.575,"verdict":"—"},{"k":"pb","label":"Price / Book","v":1.1,"sector":2.677,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":32.8,"sector":81.15,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.083,"sector":0.0445,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.641,"sector":0.143,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growt