d in Verdun, Canada.","employees":38683,"website":"https://www.bce.ca","country":"Canada","city":"Verdun","officers":[{"name":"Mr. Mirko  Bibic","title":"CEO, President & Director"},{"name":"Mr. Curtis  Millen","title":"Executive VP & CFO"},{"name":"Mr. John  Watson","title":"Group President of Business Markets, AI & Ateko"}]},"sector_medians":{"fpe":11.88,"tpe":18.03,"ps":2.018,"pfcf":11.97,"peg":1.0,"pb":2.235,"ev_ebitda":12.39,"rev_growth":0.0825,"eps_growth":0.025,"eps_growth_fwd":0.1449,"eps_growth_next":0.1232,"div_yield":0,"roe":0.09388,"roa":0.04168,"de":61.74,"gross_margin":0.5713,"op_margin":0.1382,"profit_margin":0.07503,"current_ratio":1.318},"valuation":[{"k":"fpe","label":"Forward P/E","v":11.14,"sector":11.88,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":11.51,"sector":18.03,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":null,"sector":2.018,"verdict":"—"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":11.97,"verdict":"—"},{"k":"peg","label":"PEG","v":0.22,"sector":1.0,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.334,"sector":2.235,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":169.6,"sector":61.74,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.022,"sector":0.0825,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.861,"sector":0.025,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0619,"sector":0.1449,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0219,"sector":0.1232,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.4492,"sector":0.5713,"verdict":"In line"},{"k":"op_margin","label":"Operating margin","v":0.2389,"sector":0.1382,"verdict":"Strong"},{"k":"profit_margin","label":"Net margin","v":0.1023,"sector":0.07503,"verdict":"Strong"},{"k":"roe","label":"Return on equity","v":0.1113,"sector":0.09388,"verdict":"In line"},{"k":"roa","la