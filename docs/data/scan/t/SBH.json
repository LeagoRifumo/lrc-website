 company distributes its products through full-service/exclusive distributors and open-line distributors. Sally Beauty Holdings, Inc. was founded in 1964 and is headquartered in Plano, Texas.","employees":11000,"website":"https://www.sallybeautyholdings.com","country":"United States","city":"Plano","officers":[{"name":"Ms. Denise A. Paulonis","title":"President, CEO & Director"},{"name":"Mr. Scott C Sherman J.D.","title":"Senior VP and Chief Legal & Human Resources Officer"},{"name":"Mr. Mark Gregory Spinks","title":"President of Beauty Systems Group LLC"}]},"sector_medians":{"fpe":14.67,"tpe":19.24,"ps":1.232,"pfcf":19.39,"peg":1.18,"pb":2.921,"ev_ebitda":12.04,"rev_growth":0.054,"eps_growth":0.145,"eps_growth_fwd":0.1026,"eps_growth_next":0.118,"div_yield":0.0072,"roe":0.1516,"roa":0.05988,"de":102.4,"gross_margin":0.3788,"op_margin":0.09618,"profit_margin":0.0578,"current_ratio":1.418},"valuation":[{"k":"fpe","label":"Forward P/E","v":7.591,"sector":14.67,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":9.282,"sector":19.24,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.4563,"sector":1.232,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":10.47,"sector":19.39,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.76,"sector":1.18,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.933,"sector":2.921,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":170.4,"sector":102.4,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.006,"sector":0.054,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.208,"sector":0.145,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0904,"sector":0.1026,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0891,"sector":0.118,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0.5205,"sector":0.3788,"verdict":"Strong"},{"k":"op_margin","