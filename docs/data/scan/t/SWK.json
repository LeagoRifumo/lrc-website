 manufacturing, electronics, construction, aerospace, and other industries. Stanley Black & Decker, Inc. has a strategic partnership with I4F Licensing Nv. The company was formerly known as The Stanley Works and changed its name to Stanley Black & Decker, Inc. in March 2010. The company was founded in 1843 and is headquartered in New Britain, Connecticut.","employees":41000,"website":"https://www.stanleyblackanddecker.com","country":"United States","city":"New Britain","officers":[{"name":"Mr. Christopher John Nelson","title":"President, CEO & Director"},{"name":"Mr. Patrick D. Hallinan","title":"Executive VP, CFO & Chief Administrative Officer"},{"name":"Ms. Deborah K. Wintner","title":"Senior VP & Chief Human Resources Officer"}]},"sector_medians":{"fpe":17.65,"tpe":25.99,"ps":2.167,"pfcf":26.66,"peg":1.42,"pb":3.505,"ev_ebitda":14.96,"rev_growth":0.11,"eps_growth":0.176,"eps_growth_fwd":0.1478,"eps_growth_next":0.1459,"div_yield":0.0066,"roe":0.149,"roa":0.05825,"de":66.95,"gross_margin":0.3185,"op_margin":0.1262,"profit_margin":0.0723,"current_ratio":1.665},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.91,"sector":17.65,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":24.54,"sector":25.99,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":0.9941,"sector":2.167,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":10.68,"sector":26.66,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.39,"sector":1.42,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":1.692,"sector":3.505,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":58.17,"sector":66.95,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.004,"sector":0.11,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":2.478,"sector":0.176,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1993,"sector":0.1478,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS gro