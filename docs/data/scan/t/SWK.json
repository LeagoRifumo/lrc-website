-party distributors to the automotive, manufacturing, electronics, construction, aerospace, and other industries. Stanley Black & Decker, Inc. has a strategic partnership with I4F Licensing Nv. The company was formerly known as The Stanley Works and changed its name to Stanley Black & Decker, Inc. in March 2010. The company was founded in 1843 and is headquartered in New Britain, Connecticut.","employees":41000,"website":"https://www.stanleyblackanddecker.com","country":"United States","city":"New Britain","officers":[{"name":"Mr. Christopher John Nelson","title":"President, CEO & Director"},{"name":"Mr. Patrick D. Hallinan","title":"Executive VP, CFO & Chief Administrative Officer"},{"name":"Ms. Deborah K. Wintner","title":"Senior VP & Chief Human Resources Officer"}]},"sector_medians":{"fpe":18.26,"tpe":26.27,"ps":2.184,"pfcf":28.38,"peg":1.435,"pb":3.631,"ev_ebitda":15.11,"rev_growth":0.1185,"eps_growth":0.175,"eps_growth_fwd":0.1588,"eps_growth_next":0.143,"div_yield":0.0068,"roe":0.1466,"roa":0.05844,"de":66.28,"gross_margin":0.3187,"op_margin":0.1262,"profit_margin":0.07423,"current_ratio":1.689},"valuation":[{"k":"fpe","label":"Forward P/E","v":17.02,"sector":18.26,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":26.25,"sector":26.27,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.064,"sector":2.184,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":11.43,"sector":28.38,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.39,"sector":1.435,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":1.811,"sector":3.631,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":58.17,"sector":66.28,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.004,"sector":0.1185,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":2.478,"sector":0.175,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1993,"sector":0.1588,"verdict":"Stro