 power supplies; software products; analyzers; wireless products; network test and security; modular instruments; meters; network visibility; and other products, as well as KeysightCare support plans, calibration, repair, technology refresh, test as a service, network/security, consulting, financial alternatives, education, software testing, support, managed, device vulnerability analysis, support portal, and used equipment services. Keysight Technologies, Inc. was founded in 1939 and is headquartered in Santa Rosa, California.","employees":16600,"website":"https://www.keysight.com","country":"United States","city":"Santa Rosa","officers":[{"name":"Mr. Satish C. Dhanasekaran","title":"President, CEO & Director"},{"name":"Mr. Neil P. Dougherty","title":"Executive VP & CFO"},{"name":"Ms. Ingrid A. Estrada","title":"SVP and Chief of Supply Chain & Operations Officer"}]},"sector_medians":{"fpe":17.43,"tpe":29.46,"ps":4.426,"pfcf":26.1,"peg":1.11,"pb":4.666,"ev_ebitda":18.99,"rev_growth":0.191,"eps_growth":0.356,"eps_growth_fwd":0.2432,"eps_growth_next":0.1802,"div_yield":0,"roe":0.1241,"roa":0.04945,"de":32.8,"gross_margin":0.5312,"op_margin":0.1174,"profit_margin":0.09364,"current_ratio":1.863},"valuation":[{"k":"fpe","label":"Forward P/E","v":21.83,"sector":17.43,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":41.17,"sector":29.46,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":7.869,"sector":4.426,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":27.74,"sector":26.1,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":0.61,"sector":1.11,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":7.885,"sector":4.666,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":42.09,"sector":32.8,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.365,"sector":0.191,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":1.091,"sector":0.356,"verdict":"Strong"},{"k":"eps_growth_fwd