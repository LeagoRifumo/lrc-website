rol preferred and common equity. The fund also selectively considers third-party-led senior and subordinated debt financings and opportunistically considers the purchase of stressed and discounted debt positions. The fund prefers to be an agent and/or lead the transactions in which it invests. The fund also seeks board representation in its portfolio companies.","employees":null,"website":"https://arcc.ares.com","country":"United States","city":"Los Angeles","officers":[{"name":"Mr. Mitchell Scott Goldstein CPA","title":"Co-Chairman, Partner & Co-Head of Ares Credit Group"},{"name":"Mr. Michael Lewis Smith","title":"Co-Chairman of Board of Directors & Co-Head of Ares Credit Group"},{"name":"Mr. Michael J. Arougheti","title":"Executive VP & Director"}]},"sector_medians":{"fpe":10.78,"tpe":12.58,"ps":3.482,"pfcf":11.55,"peg":1.31,"pb":1.595,"ev_ebitda":11.14,"rev_growth":0.088,"eps_growth":0.1195,"eps_growth_fwd":0.1346,"eps_growth_next":0.1035,"div_yield":0.022,"roe":0.1288,"roa":0.01563,"de":54.51,"gross_margin":0.2344,"op_margin":0.3725,"profit_margin":0.2565,"current_ratio":1.507},"valuation":[{"k":"fpe","label":"Forward P/E","v":9.963,"sector":10.78,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":15.86,"sector":12.58,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":4.527,"sector":3.482,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":11.55,"verdict":"—"},{"k":"peg","label":"PEG","v":3.72,"sector":1.31,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.002,"sector":1.595,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":108.4,"sector":54.51,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.024,"sector":0.088,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.222,"sector":0.1195,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0639,"sector":0.1346,"verdict":"Weak"},{"k":"eps_growth_next","label":"E