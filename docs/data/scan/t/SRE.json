 interconnection to 230 third-party generation facilities totaling 63,670 MW; and distribution system included more than 4.1 million points of delivery and consisted of 127,398 circuit miles of overhead and underground lines. The Sempra Infrastructure segment develops, constructs, operates, and invests in energy infrastructure to help enable the access to cleaner energy in markets in the United States, Mexico, and internationally. The company was formerly known as Sempra Energy and changed its name to Sempra in May 2023. Sempra was incorporated in 1996 and is headquartered in San Diego, California.","employees":15938,"website":"https://www.sempra.com","country":"United States","city":"San Diego","officers":[{"name":"Mr. Jeffrey Walker Martin","title":"Chairman, President & CEO"},{"name":"Ms. Karen L. Sedgwick","title":"Executive VP & CFO"},{"name":"Ms. Diana L. Day","title":"Chief Legal Counsel & Corporate Secretary"}]},"sector_medians":{"fpe":17.82,"tpe":20.33,"ps":2.923,"pfcf":null,"peg":2.26,"pb":2.106,"ev_ebitda":12.81,"rev_growth":0.083,"eps_growth":0.131,"eps_growth_fwd":0.0755,"eps_growth_next":0.0697,"div_yield":0.0319,"roe":0.101,"roa":0.03116,"de":163.0,"gross_margin":0.4662,"op_margin":0.2783,"profit_margin":0.1399,"current_ratio":0.766},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.17,"sector":17.82,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":16.76,"sector":20.33,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":3.768,"sector":2.923,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":null,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":0.68,"sector":2.26,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.536,"sector":2.106,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":84.83,"sector":163.0,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.013,"sector":0.083,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":10.3