s for MNaaS solutions. Further, the company provides professional services, such as site planning, implementation management, application development, and customer training; data plan subscriptions; and enhanced technical support services, as well as Digi Wireless Design Services. Digi International Inc. was incorporated in 1985 and is headquartered in Hopkins, Minnesota.","employees":913,"website":"https://www.digi.com","country":"United States","city":"Hopkins","officers":[{"name":"Mr. Ronald E. Konezny","title":"President, CEO & Director"},{"name":"Mr. James J. Loch","title":"Executive VP, CFO & Treasurer"},{"name":"Mr. James E. Freeland","title":"Senior VP & Chief Information Officer"}]},"sector_medians":{"fpe":18.05,"tpe":31.79,"ps":4.581,"pfcf":26.85,"peg":1.17,"pb":4.856,"ev_ebitda":19.66,"rev_growth":0.183,"eps_growth":0.357,"eps_growth_fwd":0.2334,"eps_growth_next":0.1893,"div_yield":0,"roe":0.1241,"roa":0.04714,"de":32.1,"gross_margin":0.529,"op_margin":0.128,"profit_margin":0.09241,"current_ratio":1.818},"valuation":[{"k":"fpe","label":"Forward P/E","v":23.28,"sector":18.05,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":57.86,"sector":31.79,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":5.465,"sector":4.581,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":21.61,"sector":26.85,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":0.98,"sector":1.17,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":4.037,"sector":4.856,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":17.28,"sector":32.1,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.29,"sector":0.183,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.481,"sector":0.357,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2819,"sector":0.2334,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1634,"sector":0.