cluding polymers for use in hydraulic fracturing, stimulation, cementing, and well completions; and offers production chemical solutions for underperforming wells, corrosion and scale monitoring, chemical inventory management, well failure analysis, and lab services. It serves oil and gas producers. The company was formerly known as Select Energy Services, Inc. and changed its name to Select Water Solutions, Inc. in May 2023. Select Water Solutions, Inc. was founded in 2008 and is headquartered in Gainesville, Texas.","employees":3300,"website":"https://www.selectwater.com","country":"United States","city":"Gainesville","officers":[{"name":"Mr. John D. Schmitz","title":"President, CEO & Chairman"},{"name":"Mr. Christopher K. George","title":"Executive VP & CFO"},{"name":"Mr. Michael J. Lyons","title":"Executive VP, Chief Strategy Officer & CTO"}]},"sector_medians":{"fpe":11.08,"tpe":12.64,"ps":1.798,"pfcf":12.53,"peg":1.25,"pb":1.768,"ev_ebitda":6.898,"rev_growth":0.267,"eps_growth":0.768,"eps_growth_fwd":0.4799,"eps_growth_next":0.0448,"div_yield":0.0208,"roe":0.1395,"roa":0.06067,"de":53.85,"gross_margin":0.4586,"op_margin":0.1893,"profit_margin":0.1162,"current_ratio":1.389},"valuation":[{"k":"fpe","label":"Forward P/E","v":23.25,"sector":11.08,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":39.32,"sector":12.64,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":1.593,"sector":1.798,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":12.53,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":null,"sector":1.25,"verdict":"—"},{"k":"pb","label":"Price / Book","v":1.932,"sector":1.768,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":23.74,"sector":53.85,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.279,"sector":0.267,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":5.1,"sector":0.768,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth 