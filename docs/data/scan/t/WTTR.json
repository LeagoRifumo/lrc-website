ydraulic fracturing, stimulation, cementing, and well completions; and offers production chemical solutions for underperforming wells, corrosion and scale monitoring, chemical inventory management, well failure analysis, and lab services. It serves oil and gas producers. The company was formerly known as Select Energy Services, Inc. and changed its name to Select Water Solutions, Inc. in May 2023. Select Water Solutions, Inc. was founded in 2008 and is headquartered in Gainesville, Texas.","employees":3300,"website":"https://www.selectwater.com","country":"United States","city":"Gainesville","officers":[{"name":"Mr. John D. Schmitz","title":"President, CEO & Chairman"},{"name":"Mr. Christopher K. George","title":"Executive VP & CFO"},{"name":"Mr. Michael J. Lyons","title":"Executive VP, Chief Strategy Officer & CTO"}]},"sector_medians":{"fpe":11.94,"tpe":15.14,"ps":2.161,"pfcf":16.26,"peg":1.325,"pb":2.115,"ev_ebitda":7.982,"rev_growth":0.278,"eps_growth":0.801,"eps_growth_fwd":0.5115,"eps_growth_next":0.0398,"div_yield":0.019,"roe":0.1337,"roa":0.05517,"de":55.83,"gross_margin":0.4427,"op_margin":0.2457,"profit_margin":0.1021,"current_ratio":1.443},"valuation":[{"k":"fpe","label":"Forward P/E","v":36.31,"sector":11.94,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":71.82,"sector":15.14,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":2.003,"sector":2.161,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":16.26,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":null,"sector":1.325,"verdict":"—"},{"k":"pb","label":"Price / Book","v":2.431,"sector":2.115,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":25.67,"sector":55.83,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.087,"sector":0.278,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.62,"sector":0.801,"verdict":"In line"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1268