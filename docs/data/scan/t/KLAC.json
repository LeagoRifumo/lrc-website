ration in July 2019. KLA Corporation was incorporated in 1975 and is headquartered in Milpitas, California.","employees":17000,"website":"https://www.kla.com","country":"United States","city":"Milpitas","officers":[{"name":"Mr. Richard P. Wallace","title":"President, CEO & Executive Director"},{"name":"Mr. Bren D. Higgins","title":"Executive VP & CFO"},{"name":"Ms. Mary Beth Wilkinson","title":"Executive VP, Chief Legal Officer & Corporate Secretary"}]},"sector_medians":{"fpe":18.28,"tpe":32.14,"ps":4.713,"pfcf":27.99,"peg":1.155,"pb":4.963,"ev_ebitda":20.13,"rev_growth":0.169,"eps_growth":0.352,"eps_growth_fwd":0.2214,"eps_growth_next":0.1917,"div_yield":0,"roe":0.1232,"roa":0.04714,"de":32.58,"gross_margin":0.5282,"op_margin":0.1189,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":22.8,"sector":18.28,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":41.98,"sector":32.14,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":14.77,"sector":4.713,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":76.4,"sector":27.99,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.43,"sector":1.155,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":31.63,"sector":4.963,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":96.88,"sector":32.58,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.152,"sector":0.169,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.138,"sector":0.352,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.4533,"sector":0.2214,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.2335,"sector":0.1917,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0.613,"sector":0.5282,"verdict":"In line"},{"k":"op_margin","label":"Operating margin","v":0.4249,"sector":0.1189,"verdict":"Strong"},{"k":"profit_margin","label":"Net marg