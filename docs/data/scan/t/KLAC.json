nufacturing, benchtop metrology, surface characterization, material strength characterization, and electrical property measurement products. It also provides etch, plasma dicing, deposition and other wafer processing technologies and solutions; direct imaging, inspection, optical shaping, inkjet, and additive printing, as well as computer-aided manufacturing and engineering solutions; and components. In addition, the company offers service programs. It serves semiconductor, and semiconductor-related and electronic device manufacturers. The company operates in China, Taiwan, Korea, North America, Japan, Europe, Israel, and rest of Asia. The company was formerly known as KLA-Tencor Corporation and changed its name to KLA Corporation in July 2019. KLA Corporation was incorporated in 1975 and is headquartered in Milpitas, California.","employees":17000,"website":"https://www.kla.com","country":"United States","city":"Milpitas","officers":[{"name":"Mr. Richard P. Wallace","title":"President, CEO & Executive Director"},{"name":"Mr. Bren D. Higgins","title":"Executive VP & CFO"},{"name":"Ms. Mary Beth Wilkinson","title":"Executive VP, Chief Legal Officer & Corporate Secretary"}]},"sector_medians":{"fpe":17.85,"tpe":31.02,"ps":4.569,"pfcf":26.24,"peg":1.16,"pb":4.856,"ev_ebitda":19.25,"rev_growth":0.1835,"eps_growth":0.3615,"eps_growth_fwd":0.2338,"eps_growth_next":0.1906,"div_yield":0,"roe":0.1245,"roa":0.04768,"de":32.58,"gross_margin":0.5372,"op_margin":0.1249,"profit_margin":0.09218,"current_ratio":1.81},"valuation":[{"k":"fpe","label":"Forward P/E","v":22.45,"sector":17.85,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":39.58,"sector":31.02,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":14.21,"sector":4.569,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":71.78,"sector":26.24,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.51,"sector":1.16,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":31.59,"sector":4.856,"verd