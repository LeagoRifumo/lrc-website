ices. The Safety-Kleen Sustainability Solutions segment provides containerized waste, parts-washer, and vacuum services for automobile repair shops, car and truck dealers, metal fabricators, machine manufacturers, fleet maintenance shops, and other automotive, industrial, and retail customers; collects and transports for hazardous and non-hazardous containerized waste for recycling or disposal; machine cleaning and maintenance, and disposal and replenishment of clean solvent or aqueous fluids; and vacuum services to remove solids, residual oily water, and sludge and other fluids from customers' oil/water separators, sumps, and collection tanks, as well as removes and collects waste fluids found at large and small industrial locations, including metal fabricators, auto maintenance providers, and general manufacturers. This segment also manufactures, formulates, and packages lubricants and other products. Clean Harbors, Inc. was incorporated in 1980 and is headquartered in Norwell, Massachusetts.","employees":22155,"website":"https://www.cleanharbors.com","country":"United States","city":"Norwell","officers":[{"name":"Mr. Eric W. Gerstenberg","title":"Co-CEO, Co-President & Director"},{"name":"Mr. Eric J. Dugas CPA","title":"Executive VP & CFO"},{"name":"Mr. Brian P. Weber","title":"President of Safety-Kleen Sustainability Solutions"}]},"sector_medians":{"fpe":17.15,"tpe":24.27,"ps":2.021,"pfcf":25.57,"peg":1.39,"pb":3.332,"ev_ebitda":14.21,"rev_growth":0.118,"eps_growth":0.169,"eps_growth_fwd":0.1478,"eps_growth_next":0.1445,"div_yield":0.007,"roe":0.1452,"roa":0.05723,"de":67.59,"gross_margin":0.3181,"op_margin":0.1266,"profit_margin":0.07114,"current_ratio":1.706},"valuation":[{"k":"fpe","label":"Forward P/E","v":28.52,"sector":17.15,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":28.03,"sector":24.27,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":2.233,"sector":2.021,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":35.48,