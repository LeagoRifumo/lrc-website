uy":4,"buy":5,"hold":7,"sell":0,"strongSell":0},"analyst_actions":[{"date":"2026-10-30","firm":"Barclays","action":"main","from":"Overweight","to":"Overweight"},{"date":"2026-10-30","firm":"Susquehanna","action":"main","from":"Positive","to":"Positive"},{"date":"2026-10-02","firm":"Citigroup","action":"main","from":"Neutral","to":"Neutral"}]},"profile":{"sector":"Energy","industry":"Oil & Gas Drilling","summary":"Patterson-UTI Energy, Inc., through its subsidiaries, provides drilling and completion services to oil and natural gas exploration and production companies in the United States, Canada, Colombia, and internationally. It operates through three segments: Drilling Services, Completion Services, and Drilling Products. The Contract Drilling Services segment engages in the provision of contract and directional drilling, and measurement-while-drilling (MWD) services in onshore oil and natural gas basins; supply and rental of downhole performance motors, such as Mpact drilling motors, and Mpower MWD systems; electrical controls and automation to the energy, marine, and mining industries; rig fleet evaluation; and drilling technology service. This segment also provides software and services, such as MWD Survey Fault Detection, Isolation and Recovery (FDIR) services, a data analytics technology to analyze MWD survey data in real-time and identify the position of a well; HiFi Nav, which enhances FDIR by targeting improved vertical placement of the directional well within the reservoir; and HiFi Guidance that utilizes trajectory optimization to determine optimal steering recommendations and placement within the reservoir. The Completion Services segment offers services for hydraulic fracturing, wireline and pumping, completion support, equipment, materials, and cementing, as well as involved in the power solutions natural gas fueling, and last mile logistics and storage businesses. The Drilling Products segment engages in the design, manufacture, sale, and rental of matrix and steel-bodied polycrystalline diamond compact drill bits. It also rents oilfield tools; and offers specialized services for land-based oil and natural gas drilling, completion, and workover activities. The company was founded in 1978 and is headquartered in Houston, Texas.","employees":7900,"website":"https://www.patenergy.com","country":"United States","city":"Houston","officers":[{"name":"Mr. William Andrew Hendricks Jr.","title":"President, CEO & Director"},{"name":"Mr. C. Andrew Smith CPA","title":"Executive VP & CFO"},{"name":"Mr. James Michael Holcomb","title":"Executive VP & Chief Operating Officer"}]},"sector_medians":{"fpe":11.97,"tpe":14.94,"ps":2.156,"pfcf":16.37,"peg":1.35,"pb":2.042,"ev_ebitda":7.773,"rev_growth":0.286,"eps_growth":0.952,"eps_growth_fwd":0.4909,"eps_growth_next":0.04065,"div_yield":0.0189,"roe":0.1359,"roa":0.05638,"de":55.01,"gross_margin":0.4427,"op_margin":0.2513,"profit_margin":0.1023,"current_ratio":1.462},"valuation":[{"k":"fpe","label":"Forward P/E","v":37.55,"sector":11.97,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":14.94,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":1.037,"sector":2.156,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":14.25,"sector":16.37,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":0.73,"sector":1.35,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.626,"sector":2.042,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":41.06,"sector":55.01,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.141,"sector":0.286,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.952,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.9879,"sector":0.4909,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":147.8,"sector":0.04065,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.2407,"sec