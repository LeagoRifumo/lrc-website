ng of software used to collect data from various base sites, conduct location calculations, and transmit location data to various customers and law enforcement agencies; GPS/GPRS, a navigation and tracking devices installed in vehicles; and SMART, a portable transmitter installed in vehicles that sends a signal to the base site enabling the location of vehicles, equipment, or an individual. The company was incorporated in 1994 and is headquartered in Azor, Israel.","employees":2800,"website":"https://ituran.com","country":"Israel","city":"Azor","officers":[{"name":"Mr. Nir  Sheratzky","title":"Co-CEO & Director"},{"name":"Mr. Eyal  Sheratzky","title":"Co-CEO & Director"},{"name":"Mr. Izzy  Sheratzky","title":"Co-Founder, President & Director"}]},"sector_medians":{"fpe":17.87,"tpe":31.18,"ps":4.503,"pfcf":26.7,"peg":1.17,"pb":4.727,"ev_ebitda":19.34,"rev_growth":0.183,"eps_growth":0.357,"eps_growth_fwd":0.2351,"eps_growth_next":0.1868,"div_yield":0,"roe":0.1241,"roa":0.04714,"de":31.61,"gross_margin":0.5318,"op_margin":0.1282,"profit_margin":0.09291,"current_ratio":1.818},"valuation":[{"k":"fpe","label":"Forward P/E","v":13.78,"sector":17.87,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":16.21,"sector":31.18,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":2.634,"sector":4.503,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":16.62,"sector":26.7,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":3.41,"sector":1.17,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":4.727,"sector":4.727,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":1.843,"sector":31.61,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.207,"sector":0.183,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.296,"sector":0.357,"verdict":"In line"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2432,"sector":0.2351,"verdict":"In line"},{"k":"eps_growth_next","label