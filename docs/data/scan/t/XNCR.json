bevibart, a treatment for chronic hepatitis Delta; Zaltenibart to treat paroxysmal nocturnal hemoglobinuria and other alternative pathway disorders; Teropavimab and zinlirvimab to treat human immunodeficiency virus; Novartis, an antibody drug candidate that uses XmAb Fc technologies; and JNJ-1493 to treat B-cell malignancies. The company was incorporated in 1997 and is headquartered in Pasadena, California.","employees":260,"website":"https://www.xencor.com","country":"United States","city":"Pasadena","officers":[{"name":"Dr. Bassil I. Dahiyat Ph.D.","title":"Co-Founder, CEO, President & Director"},{"name":"Mr. Bart Jan Cornelissen","title":"Senior VP & CFO"},{"name":"Dr. John R. Desjarlais Ph.D.","title":"Executive VP of Research & Chief Scientific Officer"}]},"sector_medians":{"fpe":18.93,"tpe":29.94,"ps":4.243,"pfcf":28.07,"peg":1.36,"pb":4.477,"ev_ebitda":16.75,"rev_growth":0.1,"eps_growth":0.167,"eps_growth_fwd":0.0928,"eps_growth_next":0.1205,"div_yield":0,"roe":0.01454,"roa":0.02187,"de":41.94,"gross_margin":0.4983,"op_margin":0.04015,"profit_margin":0,"current_ratio":3.084},"valuation":[{"k":"fpe","label":"Forward P/E","v":-1,"sector":18.93,"verdict":"Loss-making"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":29.94,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":21.24,"sector":4.243,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":28.07,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":null,"sector":1.36,"verdict":"—"},{"k":"pb","label":"Price / Book","v":4.43,"sector":4.477,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":33.8,"sector":41.94,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.175,"sector":0.1,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.167,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-1.476,"sector":0.0928,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next ye