 for NSCLC; TECVAYLI and TALVEY for R/R MM; Kesimpta for Relapsing multiple sclerosis; and TEPEZZA for thyroid eye disease. Further, it is developing Amivantamab for recurrent/metastatic head and neck cancer, and advanced or metastatic colorectal cancer; Amlenetug for multiple system atrophy; Inclacumab for vaso-occulsive crises in sickle cell diseases; and Mim8 for hemophilia A. The company has a collaboration agreement with AbbVie Inc., Pfizer Inc., BioNTech SE, Johnson & Johnson, Medarex, Inc., Bristol Myers Squibb Corporation, Lundbeck A/S, Amgen Inc., Novo Nordisk A/S, and argenx. Genmab A/S was incorporated in 1998 and is headquartered in Copenhagen, Denmark.","employees":3119,"website":"https://www.genmab.com","country":"Denmark","city":"Copenhagen","officers":[{"name":"Dr. Jan G.J. van de Winkel Ph.D.","title":"Co-Founder, President & CEO"},{"name":"Mr. Anthony  Pagano CPA","title":"Executive VP & CFO"},{"name":"Mr. Rayne  Waller","title":"Executive VP & Chief Technical Operations Officer"}]},"sector_medians":{"fpe":18.96,"tpe":29.96,"ps":4.265,"pfcf":28.26,"peg":1.34,"pb":4.643,"ev_ebitda":16.72,"rev_growth":0.1,"eps_growth":0.167,"eps_growth_fwd":0.0928,"eps_growth_next":0.1189,"div_yield":0,"roe":0.01454,"roa":0.02187,"de":41.94,"gross_margin":0.4983,"op_margin":0.04015,"profit_margin":0,"current_ratio":3.084},"valuation":[{"k":"fpe","label":"Forward P/E","v":37.57,"sector":18.96,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":35.15,"sector":29.96,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":8.528,"sector":4.265,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":40.46,"sector":28.26,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":5.55,"sector":1.34,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":5.742,"sector":4.643,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":88.52,"sector":41.94,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.249,"sector":0.1,"verdi