 organization's intercompany transactions; and netting and settlement that enables open intercompany transactions, which integrate with treasury systems. Additionally, it offers implementation, optimization, live and web-based training, and support services. The company sells its solutions primarily through direct sales force to multinational corporations, large domestic enterprises, and mid-market companies across various industries. The company was incorporated in 2001 and is headquartered in Woodland Hills, California.","employees":1850,"website":"https://www.blackline.com","country":"United States","city":"Woodland Hills","officers":[{"name":"Mr. Owen M. Ryan CPA","title":"Chairman & CEO"},{"name":"Ms. Therese  Tucker","title":"Founder & Director"},{"name":"Mr. Patrick  Villanova","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":16.61,"tpe":28.37,"ps":4.322,"pfcf":24.86,"peg":1.14,"pb":4.298,"ev_ebitda":18.07,"rev_growth":0.179,"eps_growth":0.3785,"eps_growth_fwd":0.2364,"eps_growth_next":0.1867,"div_yield":0,"roe":0.1242,"roa":0.0481,"de":31.49,"gross_margin":0.5305,"op_margin":0.1226,"profit_margin":0.09004,"current_ratio":1.835},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":16.61,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":59.02,"sector":28.37,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":2.672,"sector":4.322,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":14.12,"sector":24.86,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":4.53,"sector":1.14,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":6.217,"sector":4.298,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":202.9,"sector":31.49,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.092,"sector":0.179,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":1.016,"sector":0.3785,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1693,"sec