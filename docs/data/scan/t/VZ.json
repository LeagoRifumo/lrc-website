ns services and products, including FWA and wireline broadband, advanced communication services, corporate networking, security and managed network, local and long-distance voice, and network access services to deliver various IoT services and products to businesses, government customers, and wireless and wireline carriers in the United States and internationally. The company distributes its products and services through direct channels, company-operated stores, digital and omnichannel platforms, indirect agents, business solution resellers, and national retailers. The company was formerly known as Bell Atlantic Corporation and changed its name to Verizon Communications Inc. in June 2000. Verizon Communications Inc. was incorporated in 1983 and is headquartered in New York, New York.","employees":93300,"website":"https://www.verizon.com","country":"United States","city":"New York","officers":[{"name":"Mr. Daniel H. Schulman","title":"Director & CEO"},{"name":"Mr. Anthony T. Skiadas CPA","title":"Executive VP & CFO"},{"name":"Ms. Vandana  Venkatesh","title":"Executive VP & Chief Legal Officer"}]},"sector_medians":{"fpe":12.42,"tpe":19.34,"ps":2.185,"pfcf":13.45,"peg":1.08,"pb":2.215,"ev_ebitda":13.56,"rev_growth":0.0805,"eps_growth":0.053,"eps_growth_fwd":0.1407,"eps_growth_next":0.1456,"div_yield":0,"roe":0.0878,"roa":0.04007,"de":64.06,"gross_margin":0.5713,"op_margin":0.1332,"profit_margin":0.06819,"current_ratio":1.257},"valuation":[{"k":"fpe","label":"Forward P/E","v":8.227,"sector":12.42,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":11.14,"sector":19.34,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.298,"sector":2.185,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":10.07,"sector":13.45,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.78,"sector":1.08,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.707,"sector":2.215,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":176.1,"secto