n-premises vulnerability management solution; and Tenable OT Security, a unified security solution for converged OT/IoT environments that provide threat detection, asset tracking, vulnerability management, and configuration control capabilities to protect OT environments, including industrial networks. In addition, it offers Nessus, a vulnerability assessment solution for cybersecurity industry and enterprise platform; and Nessus Expert, which enables users to programmatically detect cloud infrastructure misconfigurations and vulnerabilities in the design and build phase of the software development lifecycle. Tenable Holdings, Inc. was founded in 2002 and is headquartered in Columbia, Maryland.","employees":1995,"website":"https://www.tenable.com","country":"United States","city":"Columbia","officers":[{"name":"Mr. Stephen A. Vintz CPA","title":"Co-CEO & Director"},{"name":"Mr. Mark  Thurmond","title":"Co-CEO & Director"},{"name":"Mr. John C. Huffard Jr.","title":"Co-Founder & Director"}]},"sector_medians":{"fpe":16.61,"tpe":28.37,"ps":4.322,"pfcf":24.86,"peg":1.14,"pb":4.298,"ev_ebitda":18.07,"rev_growth":0.179,"eps_growth":0.3785,"eps_growth_fwd":0.2364,"eps_growth_next":0.1867,"div_yield":0,"roe":0.1242,"roa":0.0481,"de":31.49,"gross_margin":0.5305,"op_margin":0.1226,"profit_margin":0.09004,"current_ratio":1.835},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":16.61,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":339.3,"sector":28.37,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":4.322,"sector":4.322,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":17.29,"sector":24.86,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.73,"sector":1.14,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":null,"sector":4.298,"verdict":"—"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":31.49,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.095,"sector":0.179,"verdict":"Weak"},{"k":"eps_growth","lab