sidential applications; connected roof drain systems; and water quality products, including point-of-use and point-of-entry, closed loop, cooling tower, and other water applications for commercial, marine, and residential applications. It sells its products to plumbing, heating, and mechanical wholesale distributors and dealers; original equipment manufacturers; specialty product distributors; and do-it-yourself and retail chains, as well as wholesalers and private label accounts in the Americas, Europe, Asia-Pacific, Middle East, and Africa. Watts Water Technologies, Inc. was founded in 1874 and is headquartered in North Andover, Massachusetts.","employees":5700,"website":"https://www.watts.com","country":"United States","city":"North Andover","officers":[{"name":"Mr. Robert J. Pagano Jr., C.M.A., CPA","title":"Chairman, President & CEO"},{"name":"Ms. Diane M. McClintock CPA","title":"Chief Financial Officer"},{"name":"Mr. Andre  Dhawan","title":"Chief Operating Officer"}]},"sector_medians":{"fpe":17.22,"tpe":24.6,"ps":2.037,"pfcf":26.28,"peg":1.39,"pb":3.473,"ev_ebitda":14.27,"rev_growth":0.1155,"eps_growth":0.164,"eps_growth_fwd":0.1469,"eps_growth_next":0.1445,"div_yield":0.00735,"roe":0.1452,"roa":0.05675,"de":67.98,"gross_margin":0.3175,"op_margin":0.1261,"profit_margin":0.07298,"current_ratio":1.727},"valuation":[{"k":"fpe","label":"Forward P/E","v":24.76,"sector":17.22,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":26.03,"sector":24.6,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":4.155,"sector":2.037,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":41.43,"sector":26.28,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":3.14,"sector":1.39,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":5.004,"sector":3.473,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":8.429,"sector":67.98,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.19,"sector":0.1155,"verdict":"Strong"},{"k