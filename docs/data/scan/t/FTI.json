rp":0.1345},{"q":"2026-09-30","act":1.05,"est":0.8797,"surp":0.1936}],"div_pay":"2026-09-02","rec_trend":{"strongBuy":5,"buy":10,"hold":6,"sell":0,"strongSell":1},"analyst_actions":[{"date":"2026-10-15","firm":"Barclays","action":"main","from":"Overweight","to":"Overweight"},{"date":"2026-10-13","firm":"UBS","action":"init","from":"","to":"Buy"},{"date":"2026-09-15","firm":"Citigroup","action":"main","from":"Buy","to":"Buy"}]},"profile":{"sector":"Energy","industry":"Oil & Gas Equipment & Services","summary":"TechnipFMC plc engages in the oil and natural gas projects, technologies, systems, and services businesses in Europe, Central Asia, North America, Latin America, the Asia Pacific, Africa, the Middle East, and internationally. It operates through two segments, Subsea and Surface Technologies. The Subsea segment engages in design, engineering, procurement, manufacturing, fabrication, installation, and life of field services for subsea systems, subsea field infrastructure, and subsea pipeline systems used in oil and natural gas production and transportation. It provides subsea production systems; subsea processing systems; subsea umbilicals, risers and flowlines; vessels; drilling, installation, and intervention and plug and abandonment; maintenance, asset integrity, and production management; robotics; and subsea studio digital platform. The Surface Technologies segment designs, manufactures, and services products and systems used in land and shallow water exploration and production of oil and natural gas. This segment offers drilling; surface wellheads and production trees systems; iComplete, a pressure control system; fracturing tree systems, fracturing valve greasing systems, hydraulic or electric control units, service-less valves, fracturing manifold systems, and rigid and flexible flowlines; flexible pipes; safety and integrity systems, multiphase meter modules, in-line separation and processing systems, compact ball valves for manifolds, and standard pumps; well control and integrity systems; and skid solutions. It also offers planning, testing and installation, commissioning, operations, replacement and upgrade, maintenance, storage, preservation, intervention, integrity, decommissioning, and abandonment; and supplies flowline products and services. TechnipFMC plc was founded in 1884 and is headquartered in Newcastle upon Tyne, the United Kingdom.","employees":21975,"website":"https://www.technipfmc.com","country":"United Kingdom","city":"Newcastle upon Tyne","officers":[{"name":"Mr. Douglas J. Pferdehirt","title":"CEO & Executive Chairman"},{"name":"Mr. Alf T. Melin","title":"Executive VP & CFO"},{"name":"Mr. Justin J. Rounce","title":"Executive VP & CTO"}]},"sector_medians":{"fpe":11.97,"tpe":14.94,"ps":2.156,"pfcf":16.37,"peg":1.35,"pb":2.042,"ev_ebitda":7.773,"rev_growth":0.286,"eps_growth":0.952,"eps_growth_fwd":0.4909,"eps_growth_next":0.04065,"div_yield":0.0189,"roe":0.1359,"roa":0.05638,"de":55.01,"gross_margin":0.4427,"op_margin":0.2513,"profit_margin":0.1023,"current_ratio":1.462},"valuation":[{"k":"fpe","label":"Forward P/E","v":18.77,"sector":11.97,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":23.73,"sector":14.94,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":2.501,"sector":2.156,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":16.04,"sector":16.37,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":2.18,"sector":1.35,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":7.998,"sector":2.042,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":12.1,"sector":55.01,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.094,"sector":0.286,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.4,"sector":0.952,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2841,"sector":0.4909,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1533