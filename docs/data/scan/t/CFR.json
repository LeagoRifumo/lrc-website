rs of credit, export-import financing, and other related activities. Additionally, the company offers insurance and securities brokerage services; holding of securities for investment purposes; and investment management services for mutual funds, institutions, and individuals. It serves energy, manufacturing, services, construction, retail, telecommunications, healthcare, military, and transportation industries. Cullen/Frost Bankers, Inc. was founded in 1868 and is headquartered in San Antonio, Texas.","employees":6008,"website":"https://www.frostbank.com","country":"United States","city":"San Antonio","officers":[{"name":"Mr. Phillip D. Green J.D.","title":"Chairman of the Board & CEO"},{"name":"Mr. Paul H. Bracher","title":"President, Group Executive VP & Chief Banking Officer"},{"name":"Mr. Daniel J. Geddes","title":"Group Executive VP & CFO"}]},"sector_medians":{"fpe":10.48,"tpe":12.69,"ps":3.455,"pfcf":11.72,"peg":1.32,"pb":1.596,"ev_ebitda":10.67,"rev_growth":0.106,"eps_growth":0.16,"eps_growth_fwd":0.133,"eps_growth_next":0.1089,"div_yield":0.02175,"roe":0.1268,"roa":0.01564,"de":54.45,"gross_margin":0.2391,"op_margin":0.3554,"profit_margin":0.2541,"current_ratio":1.509},"valuation":[{"k":"fpe","label":"Forward P/E","v":13.05,"sector":10.48,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":14.78,"sector":12.69,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":4.309,"sector":3.455,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":11.72,"verdict":"—"},{"k":"peg","label":"PEG","v":2.9,"sector":1.32,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":2.179,"sector":1.596,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":54.45,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.061,"sector":0.106,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.128,"sector":0.16,"verdict":"In line"},{"k":"eps_growth_fwd","label":"EPS growth (this y