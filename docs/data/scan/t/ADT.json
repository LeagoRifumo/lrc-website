the residential and small business security and automation markets comprising owners and renters of single-family homes, apartments, and small businesses owners through customer referrals, door-to-door activities, lead generation partners, retail and e-commerce channels, network of field sales and service offices, third-party independent dealers, and authorized dealers. The company was formerly known as Prime Security Services Parent, Inc. and changed its name to ADT Inc. in September 2017. ADT Inc. was founded in 1874 and is headquartered in Boca Raton, Florida.","employees":12200,"website":"https://www.adt.com","country":"United States","city":"Boca Raton","officers":[{"name":"Mr. James David DeVries","title":"CEO, President & Chairman"},{"name":"Mr. Jeffrey A. Likosar","title":"CFO and President of Corporate Development & Transformation"},{"name":"Mr. Fawad Khalil Ahmad","title":"Executive VP and Chief Operating & Customer Officer"}]},"sector_medians":{"fpe":17.75,"tpe":26.36,"ps":2.156,"pfcf":26.62,"peg":1.4,"pb":3.514,"ev_ebitda":14.88,"rev_growth":0.11,"eps_growth":0.176,"eps_growth_fwd":0.1441,"eps_growth_next":0.1459,"div_yield":0.0066,"roe":0.149,"roa":0.05825,"de":66.95,"gross_margin":0.3185,"op_margin":0.1262,"profit_margin":0.0723,"current_ratio":1.665},"valuation":[{"k":"fpe","label":"Forward P/E","v":6.973,"sector":17.75,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":9.411,"sector":26.36,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.9717,"sector":2.156,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":4.191,"sector":26.62,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":null,"sector":1.4,"verdict":"—"},{"k":"pb","label":"Price / Book","v":1.449,"sector":3.514,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":223.9,"sector":66.95,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.02,"sector":0.11,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)",