sort-like environment in suburban and urban locations of metropolitan areas. Further, its digital platform provides live streaming fitness classes, remote goal-based personal training, nutrition and weight loss support, curated award-winning health, and fitness and wellness content. The company was formerly known as LTF Holdings, Inc. and changed its name to Life Time Group Holdings, Inc. in June 21, 2021. The company was founded in 1992 and is headquartered in Chanhassen, Minnesota.","employees":52000,"website":"https://www.lifetime.life","country":"United States","city":"Chanhassen","officers":[{"name":"Mr. Bahram  Akradi","title":"Founder, Chairman & CEO"},{"name":"Mr. Erik  Weaver","title":"EVP & CFO"},{"name":"Mr. Eric J. Buss","title":"Executive VP & Chief Administrative Officer"}]},"sector_medians":{"fpe":14.66,"tpe":19.25,"ps":1.261,"pfcf":19.69,"peg":1.14,"pb":3.001,"ev_ebitda":11.72,"rev_growth":0.062,"eps_growth":0.1705,"eps_growth_fwd":0.1094,"eps_growth_next":0.1254,"div_yield":0.0078,"roe":0.1545,"roa":0.06132,"de":110.4,"gross_margin":0.38,"op_margin":0.09577,"profit_margin":0.0572,"current_ratio":1.434},"valuation":[{"k":"fpe","label":"Forward P/E","v":21.98,"sector":14.66,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":24.34,"sector":19.25,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":3.12,"sector":1.261,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":19.69,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":null,"sector":1.14,"verdict":"—"},{"k":"pb","label":"Price / Book","v":3.003,"sector":3.001,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":129.5,"sector":110.4,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.137,"sector":0.062,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.406,"sector":0.1705,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2131,"sector":0.1094,"verdict":"Strong