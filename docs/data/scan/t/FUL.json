nd professional trade. The company sells its products directly to customers, as well as through distributors and retailers in North America, Latin America, Europe, India, the Middle East, Africa, and the Asia Pacific. H.B. Fuller Company was founded in 1887 and is headquartered in Saint Paul, Minnesota.","employees":7100,"website":"https://www.hbfuller.com","country":"United States","city":"Saint Paul","officers":[{"name":"Ms. Celeste Beeks Mastin","title":"President, CEO & Director"},{"name":"Mr. John J. Corkrean","title":"Executive VP & CFO"},{"name":"Mr. Muhammad Shahbaz Malik","title":"Senior Vice President of Building Adhesives Solutions"}]},"sector_medians":{"fpe":12.18,"tpe":17.99,"ps":2.242,"pfcf":22.81,"peg":1.74,"pb":2.257,"ev_ebitda":9.259,"rev_growth":0.1635,"eps_growth":0.296,"eps_growth_fwd":0.3698,"eps_growth_next":0.1366,"div_yield":0.009,"roe":0.1295,"roa":0.06907,"de":43.23,"gross_margin":0.3315,"op_margin":0.1485,"profit_margin":0.07766,"current_ratio":2.28},"valuation":[{"k":"fpe","label":"Forward P/E","v":9.723,"sector":12.18,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":13.95,"sector":17.99,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.7562,"sector":2.242,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":17.79,"sector":22.81,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":2.2,"sector":1.74,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.239,"sector":2.257,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":100.9,"sector":43.23,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.052,"sector":0.1635,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.18,"sector":0.296,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.144,"sector":0.3698,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0621,"sector":0.1366,"verdict":"Weak"},{"k":"gross_margin","label":