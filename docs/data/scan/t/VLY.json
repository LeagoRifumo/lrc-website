sts, investment management, custodial and escrow services, and estate administration to individuals; tax credit advisory services; brokerage services; property and casualty, life, health, and title insurance agency services; and health care equipment lending and other commercial equipment leasing services, as well as private banking and management services. Additionally, it offers niche financial services, including loan and deposit products for homeowners associations, cannabis-related business banking, and venture banking; online, mobile, and telephone banking services; credit cards; and automated teller machine services. Valley National Bancorp was founded in 1927 and is headquartered in Morristown, New Jersey.","employees":3675,"website":"https://www.valley.com","country":"United States","city":"Morristown","officers":[{"name":"Mr. Ira D. Robbins CPA","title":"President, CEO & Chairman"},{"name":"Mr. Travis P. Lan","title":"Senior Executive VP & CFO"},{"name":"Mr. Russell  Barrett","title":"Senior EVP & COO"}]},"sector_medians":{"fpe":10.82,"tpe":12.76,"ps":3.533,"pfcf":12.17,"peg":1.32,"pb":1.628,"ev_ebitda":10.81,"rev_growth":0.091,"eps_growth":0.138,"eps_growth_fwd":0.1351,"eps_growth_next":0.1043,"div_yield":0.02205,"roe":0.1287,"roa":0.01564,"de":54.12,"gross_margin":0.2367,"op_margin":0.3641,"profit_margin":0.2565,"current_ratio":1.513},"valuation":[{"k":"fpe","label":"Forward P/E","v":9.462,"sector":10.82,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":11.32,"sector":12.76,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":3.876,"sector":3.533,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":12.17,"verdict":"—"},{"k":"peg","label":"PEG","v":1.16,"sector":1.32,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":1.058,"sector":1.628,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":54.12,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.097,"sect