tor targeting ADC with a topoisomerase inhibitor payload. It has research collaborations and license agreements with Ipsen Pharma SAS; Takeda Pharmaceutical Company Ltd.; F. Hoffmann-La Roche Ltd.; Catalent, Inc.; Iconic Therapeutics, Inc.; Adagene Inc.; Invenra, Inc.; Genentech, Inc.; Bristol-Myers Squibb Company; and Daiichi Sankyo Company, Limited, as well as business development activities and other collaborations. The company was formerly known as Exelixis Pharmaceuticals, Inc. and changed its name to Exelixis, Inc. in February 2000. Exelixis, Inc. was incorporated in 1994 and is headquartered in Alameda, California.","employees":1077,"website":"https://www.exelixis.com","country":"United States","city":"Alameda","officers":[{"name":"Dr. Stelios  Papadopoulos Ph.D.","title":"Co-Founder & Independent Chair of the Board"},{"name":"Dr. Michael M. Morrissey Ph.D.","title":"CEO, President & Director"},{"name":"Mr. Christopher J. Senner","title":"Executive VP & CFO"}]},"sector_medians":{"fpe":18.93,"tpe":29.94,"ps":4.243,"pfcf":28.07,"peg":1.36,"pb":4.477,"ev_ebitda":16.75,"rev_growth":0.1,"eps_growth":0.167,"eps_growth_fwd":0.0928,"eps_growth_next":0.1205,"div_yield":0,"roe":0.01454,"roa":0.02187,"de":41.94,"gross_margin":0.4983,"op_margin":0.04015,"profit_margin":0,"current_ratio":3.084},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.29,"sector":18.93,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":20.62,"sector":29.94,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":6.647,"sector":4.243,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":21.89,"sector":28.07,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":2.56,"sector":1.36,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":8.822,"sector":4.477,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":8.999,"sector":41.94,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.106,"sector":0.1,"verdict":"In line"},{"k":"eps_growth","l