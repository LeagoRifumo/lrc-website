vation, and software and application development; people scanners, computed tomography carry-on baggage scanners, checked baggage scanners, and explosive trace detectors; mobile, non-intrusive ports and borders inspection systems; and open-architecture platform that transforms airport security by integrating disparate devices and technologies into a unified management system. The Defense Systems segment offers air and missile defense, maritime, aerospace, and cyber and threat systems; offers airborne training, intelligence, surveillance, and reconnaissance missions; and provides space-based electro-optic infrared systems, multi/hyperspectral, electronic warfare and signals intelligence, and communications payloads. Leidos Holdings, Inc. was founded in 1969 and is headquartered in Reston, Virginia.","employees":50000,"website":"https://www.leidos.com","country":"United States","city":"Reston","officers":[{"name":"Mr. Thomas A. Bell","title":"CEO & Director"},{"name":"Mr. Christopher R. Cage","title":"Executive VP & CFO"},{"name":"Mr. Daniel J. Antal","title":"Executive VP & General Counsel"}]},"sector_medians":{"fpe":17.85,"tpe":31.02,"ps":4.569,"pfcf":26.24,"peg":1.16,"pb":4.856,"ev_ebitda":19.25,"rev_growth":0.1835,"eps_growth":0.3615,"eps_growth_fwd":0.2338,"eps_growth_next":0.1906,"div_yield":0,"roe":0.1245,"roa":0.04768,"de":32.58,"gross_margin":0.5372,"op_margin":0.1249,"profit_margin":0.09218,"current_ratio":1.81},"valuation":[{"k":"fpe","label":"Forward P/E","v":11.4,"sector":17.85,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":13.17,"sector":31.02,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.02,"sector":4.569,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":15.68,"sector":26.24,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":2.46,"sector":1.16,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":3.396,"sector":4.856,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":123.3,"sector":32.