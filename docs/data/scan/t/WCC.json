nd wireless providers, broadband operators, and contractors. This segment's products include wires and cables, transformers, transmission and distribution hardware, switches, protective devices, connectors, lighting and connectivity products, conduits, fiber and power cables, pole line hardware, racks, cabinets, safety and MRO products, and wireless devices. It also offers fiber project management, high and medium voltage project design and support, pre-wired meters and capacitor banks, meter testing and advanced metering infrastructure installation, personal protective equipment, dielectric testing, and tool repair, as well as emergency response, storage yard, materials, and logistics management solutions. The company was founded in 1922 and is headquartered in Pittsburgh, Pennsylvania.","employees":21000,"website":"https://www.wesco.com","country":"United States","city":"Pittsburgh","officers":[{"name":"Mr. John J. Engel","title":"Chairman, President & CEO"},{"name":"Mr. Dirk W. Naylor","title":"Executive VP and GM of Communications & Security Solutions"},{"name":"Mr. James F. Cameron","title":"Executive VP and GM of Utility & Broadband Solutions Division (UBS)"}]},"sector_medians":{"fpe":18.04,"tpe":26.01,"ps":2.182,"pfcf":27.76,"peg":1.44,"pb":3.628,"ev_ebitda":15.02,"rev_growth":0.118,"eps_growth":0.173,"eps_growth_fwd":0.1561,"eps_growth_next":0.1445,"div_yield":0.0068,"roe":0.1453,"roa":0.05787,"de":67.05,"gross_margin":0.3185,"op_margin":0.1262,"profit_margin":0.07405,"current_ratio":1.701},"valuation":[{"k":"fpe","label":"Forward P/E","v":16.02,"sector":18.04,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":20.83,"sector":26.01,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":0.6572,"sector":2.182,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":44.37,"sector":27.76,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.44,"sector":1.44,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":3.146,"sector":3.