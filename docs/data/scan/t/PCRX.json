m enabling local administration of genetic medicines with the potential to treat large prevalent diseases like osteoarthritis. It has a development and commercialization, and supply agreement with Aratana Therapeutics, Inc. for NOCITA, a bupivacaine liposome injectable suspension product for use in animals. The company was formerly known as Pacira Pharmaceuticals, Inc. and changed its name to Pacira BioSciences, Inc. in April 2019. Pacira BioSciences, Inc. was incorporated in 2006 and is headquartered in Brisbane, California.","employees":825,"website":"https://www.pacira.com","country":"United States","city":"Brisbane","officers":[{"name":"Mr. Frank D. Lee","title":"CEO & Director"},{"name":"Mr. Shawn M. Cross","title":"Chief Financial Officer"},{"name":"Ms. Kristen  Williams Esq., J.D.","title":"Chief Administrative Officer & Secretary"}]},"sector_medians":{"fpe":19.16,"tpe":30.0,"ps":4.313,"pfcf":28.56,"peg":1.36,"pb":4.486,"ev_ebitda":16.71,"rev_growth":0.097,"eps_growth":0.154,"eps_growth_fwd":0.0934,"eps_growth_next":0.1096,"div_yield":0,"roe":0.02656,"roa":0.02473,"de":43.27,"gross_margin":0.4983,"op_margin":0.0549,"profit_margin":0,"current_ratio":2.993},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":19.16,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":39.2,"sector":30.0,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":1.958,"sector":4.313,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":7.724,"sector":28.56,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.99,"sector":1.36,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":2.042,"sector":4.486,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":47.77,"sector":43.27,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":-0.016,"sector":0.097,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":4.833,"sector":0.154,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v