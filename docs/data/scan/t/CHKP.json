urity implementation; and certification and educational training services on its products. Check Point Software Technologies Ltd. was incorporated in 1993 and is headquartered in Tel Aviv-Yafo, Israel.","employees":6825,"website":"https://www.checkpoint.com","country":"Israel","city":"Tel Aviv-Yafo","officers":[{"name":"Brig.Gen. Nadav  Zafrir","title":"CEO & Director"},{"name":"Ms. Nataly  Kremer","title":"Chief Product Officer and Head of R&D"},{"name":"Mr. Roi  Karo","title":"Chief Strategy Officer"}]},"sector_medians":{"fpe":18.07,"tpe":31.58,"ps":4.745,"pfcf":27.68,"peg":1.155,"pb":4.937,"ev_ebitda":20.43,"rev_growth":0.169,"eps_growth":0.352,"eps_growth_fwd":0.2214,"eps_growth_next":0.1917,"div_yield":0,"roe":0.1232,"roa":0.04714,"de":32.58,"gross_margin":0.5282,"op_margin":0.1189,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":13.76,"sector":18.07,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":16.36,"sector":31.58,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":5.733,"sector":4.745,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":22.62,"sector":27.68,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":1.42,"sector":1.155,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":5.835,"sector":4.937,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":72.15,"sector":32.58,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.013,"sector":0.169,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.016,"sector":0.352,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.1222,"sector":0.2214,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0806,"sector":0.1917,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.875,"sector":0.5282,"verdict":"Strong"},{"k":"op_margin","label":"Operating margin","v":0.2748,"sector":0.1189,"ve