ater hose connectors, and aluminum oil filter housings; and intake manifolds, exhaust manifolds, oil filters and coolers, exhaust gas recirculation coolers, driveshafts, UTV windshields, and complex electronics modules. The company markets its products under the DORMAN, DORMAN OE FIX, HELP!, Conduct-Tite, Dayton Parts, SuperATV, Keller Performance Products, Assault Industries, Gboost, and GDP brands through aftermarket retailers, dealers, and national, regional, and local wholesale distributors and specialty markets. Dorman Products, Inc. was founded in 1918 and is headquartered in Colmar, Pennsylvania.","employees":3871,"website":"https://www.dormanproducts.com","country":"United States","city":"Colmar","officers":[{"name":"Mr. Kevin M. Olsen C.P.A.","title":"Chairman, President & CEO"},{"name":"Mr. Steven L. Berman","title":"Founder & Director"},{"name":"Mr. Joseph P. Braun","title":"Chief Compliance Officer, Senior VP of General Counsel & Secretary"}]},"sector_medians":{"fpe":14.31,"tpe":18.84,"ps":1.207,"pfcf":20.05,"peg":1.13,"pb":2.866,"ev_ebitda":11.58,"rev_growth":0.058,"eps_growth":0.167,"eps_growth_fwd":0.1094,"eps_growth_next":0.1263,"div_yield":0.0077,"roe":0.1518,"roa":0.06079,"de":109.9,"gross_margin":0.3789,"op_margin":0.09691,"profit_margin":0.05663,"current_ratio":1.447},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.27,"sector":14.31,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":19.34,"sector":18.84,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.761,"sector":1.207,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":20.05,"verdict":"—"},{"k":"peg","label":"PEG","v":1.17,"sector":1.13,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":2.452,"sector":2.866,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":33.45,"sector":109.9,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.033,"sector":0.058,"verdict":"Weak"},{"k":"eps_growth","label"