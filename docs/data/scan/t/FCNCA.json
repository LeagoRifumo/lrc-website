shippers. Its railcar types include covered hopper cars used to ship grain and agricultural products, plastic pellets, sand, and cement; tank cars for energy products and chemicals; gondolas for coal, steel coil and mill service products; open-top hopper cars for coal and aggregates; boxcars for paper and auto parts; and centerbeams and flat cars for lumber. First Citizens BancShares, Inc. was founded in 1898 and is headquartered in Raleigh, North Carolina.","employees":17876,"website":"https://www.firstcitizens.com","country":"United States","city":"Raleigh","officers":[{"name":"Mr. Frank Brown Holding Jr.","title":"Chairman & CEO"},{"name":"Ms. Hope Holding Bryant","title":"Vice Chairwoman"},{"name":"Mr. Peter McDonald Bristow","title":"President & Director"}]},"sector_medians":{"fpe":10.38,"tpe":12.64,"ps":3.401,"pfcf":12.38,"peg":1.32,"pb":1.583,"ev_ebitda":10.59,"rev_growth":0.1,"eps_growth":0.1435,"eps_growth_fwd":0.1311,"eps_growth_next":0.107,"div_yield":0.0216,"roe":0.1281,"roa":0.01589,"de":55.49,"gross_margin":0.2386,"op_margin":0.3556,"profit_margin":0.2563,"current_ratio":1.503},"valuation":[{"k":"fpe","label":"Forward P/E","v":11.05,"sector":10.38,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":12.08,"sector":12.64,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":2.756,"sector":3.401,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":12.38,"verdict":"—"},{"k":"peg","label":"PEG","v":1.13,"sector":1.32,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":1.339,"sector":1.583,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":55.49,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.069,"sector":0.1,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.189,"sector":0.1435,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1477,"sector":0.1311,"verdict":"In line"},{"k":"eps_growth_next"