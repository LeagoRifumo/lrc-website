nd. The company serves its products and services to defense communications energy and resources, enterprise and industrial campus, private networks, public sector, and transportation industries. Nokia Oyj was founded in 1865 and is headquartered in Espoo, Finland.","employees":78005,"website":"https://www.nokia.com","country":"Finland","city":"Espoo","officers":[{"name":"Mr. Justin  Hotard","title":"President & CEO"},{"name":"Mr. Marco  Wiren M.Sc. (Econ.)","title":"Chief Financial Officer"},{"name":"Mr. Stephan  Prosi","title":"Vice President of Corporate Controlling & Accounting"}]},"sector_medians":{"fpe":18.28,"tpe":32.14,"ps":4.713,"pfcf":27.99,"peg":1.155,"pb":4.963,"ev_ebitda":20.13,"rev_growth":0.169,"eps_growth":0.352,"eps_growth_fwd":0.2214,"eps_growth_next":0.1917,"div_yield":0,"roe":0.1232,"roa":0.04714,"de":32.58,"gross_margin":0.5282,"op_margin":0.1189,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":18.28,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":55.56,"sector":32.14,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":2.144,"sector":4.713,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":34.63,"sector":27.99,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":0.65,"sector":1.155,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":2.109,"sector":4.963,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":15.81,"sector":32.58,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.097,"sector":0.169,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":2.221,"sector":0.352,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1987,"sector":0.2214,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1658,"sector":0.1917,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0.4543,"sector":0.5282,"verdict":"In line"},{"k