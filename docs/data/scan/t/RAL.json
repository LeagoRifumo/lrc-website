e and space, industrial manufacturing, and other industries. The company was formerly known as New Precision Technologies Company. Ralliant Corporation was incorporated in 2024 and is based in Raleigh, North Carolina.","employees":7000,"website":"https://ralliant.com","country":"United States","city":"Raleigh","officers":[{"name":"Ms. Tamara S. Newcombe","title":"President, CEO & Director"},{"name":"Mr. Neill P. Reynolds","title":"Senior VP & CFO"},{"name":"Mr. Amir A. Kazmi","title":"Senior VP and Chief Technology & Growth Officer ?"}]},"sector_medians":{"fpe":17.92,"tpe":31.96,"ps":4.757,"pfcf":27.69,"peg":1.155,"pb":5.077,"ev_ebitda":20.02,"rev_growth":0.177,"eps_growth":0.339,"eps_growth_fwd":0.2255,"eps_growth_next":0.1929,"div_yield":0,"roe":0.1195,"roa":0.04674,"de":32.62,"gross_margin":0.5331,"op_margin":0.1128,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":20.8,"sector":17.92,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":31.96,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":3.559,"sector":4.757,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":23.3,"sector":27.69,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":null,"sector":1.155,"verdict":"—"},{"k":"pb","label":"Price / Book","v":5.07,"sector":5.077,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":79.8,"sector":32.62,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.128,"sector":0.177,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.214,"sector":0.339,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.068,"sector":0.2255,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1764,"sector":0.1929,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0.5095,"sector":0.5331,"verdict":"In line"},{"k":"op_margin","label":"Operating margin","v":0.1448,"s