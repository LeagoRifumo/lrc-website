rkets. The company provides its products under the Greatbatch Medical and the Lake Region Medical brands. The company was formerly known as Greatbatch, Inc. and changed its name to Integer Holdings Corporation in July 2016. Integer Holdings Corporation was founded in 1970 and is headquartered in Plano, Texas.","employees":11000,"website":"https://www.integer.net","country":"United States","city":"Plano","officers":[{"name":"Mr. Payman  Khales","title":"CEO, President & Director"},{"name":"Mr. Diron  Smith","title":"Executive VP & CFO"},{"name":"Ms. Lindsay Krause Blackwood J.D.","title":"Senior VP, General Counsel, Chief Ethics & Compliance Officer and Corporate Secretary"}]},"sector_medians":{"fpe":18.6,"tpe":30.73,"ps":4.259,"pfcf":27.92,"peg":1.36,"pb":4.405,"ev_ebitda":17.1,"rev_growth":0.0975,"eps_growth":0.1735,"eps_growth_fwd":0.09425,"eps_growth_next":0.1209,"div_yield":0,"roe":0.01671,"roa":0.02187,"de":44.07,"gross_margin":0.4971,"op_margin":0.03985,"profit_margin":0,"current_ratio":3.18},"valuation":[{"k":"fpe","label":"Forward P/E","v":18.43,"sector":18.6,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":42.48,"sector":30.73,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":2.358,"sector":4.259,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":51.17,"sector":27.92,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":2.81,"sector":1.36,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":2.493,"sector":4.405,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":77.88,"sector":44.07,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.039,"sector":0.0975,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.613,"sector":0.1735,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0371,"sector":0.09425,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1145,"sector":0.1209,"verdict":"In line