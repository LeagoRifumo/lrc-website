ides apparel, such as hats, shirts, and sweatshirts, as well as ice substitutes and other YETI branded products. It sells its products through its direct-to-consumer channel, including websites, corporate sales programs, and retail stores, as well as through its wholesale channel. YETI Holdings, Inc. was founded in 2006 and is headquartered in Austin, Texas.","employees":1390,"website":"https://www.yeti.com","country":"United States","city":"Austin","officers":[{"name":"Mr. Matthew J. Reintjes","title":"President, CEO & Chairman"},{"name":"Mr. Martin H. Duff IV","title":"Senior VP, Chief Supply Chain & Operations Officer"},{"name":"Mr. Bryan C. Barksdale J.D.","title":"Senior VP, Chief Legal Officer & Secretary"}]},"sector_medians":{"fpe":14.82,"tpe":19.23,"ps":1.23,"pfcf":19.39,"peg":1.16,"pb":2.926,"ev_ebitda":12.04,"rev_growth":0.054,"eps_growth":0.145,"eps_growth_fwd":0.1026,"eps_growth_next":0.1176,"div_yield":0.0072,"roe":0.1516,"roa":0.05988,"de":102.4,"gross_margin":0.3788,"op_margin":0.09618,"profit_margin":0.0578,"current_ratio":1.418},"valuation":[{"k":"fpe","label":"Forward P/E","v":12.1,"sector":14.82,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":16.77,"sector":19.23,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.465,"sector":1.23,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":18.31,"sector":19.39,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":1.27,"sector":1.16,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":4.468,"sector":2.926,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":34.84,"sector":102.4,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.044,"sector":0.054,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.25,"sector":0.145,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1819,"sector":0.1026,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next ye