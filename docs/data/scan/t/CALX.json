 BEP's residential and business subscribers. It provides its products through its direct sales force and resellers. Calix, Inc. was incorporated in 1999 and is headquartered in San Jose, California.","employees":1921,"website":"https://www.calix.com","country":"United States","city":"San Jose","officers":[{"name":"Mr. Michael  Weening","title":"CEO, President & Director"},{"name":"Mr. Cory J. Sindelar CPA","title":"Chief Financial Officer"},{"name":"Mr. John  Durocher","title":"Chief Operations Officer"}]},"sector_medians":{"fpe":17.65,"tpe":30.31,"ps":4.578,"pfcf":26.34,"peg":1.15,"pb":4.752,"ev_ebitda":19.18,"rev_growth":0.178,"eps_growth":0.367,"eps_growth_fwd":0.2373,"eps_growth_next":0.1867,"div_yield":0,"roe":0.1214,"roa":0.04733,"de":31.61,"gross_margin":0.5318,"op_margin":0.1268,"profit_margin":0.09291,"current_ratio":1.82},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":17.65,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":48.33,"sector":30.31,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":1.841,"sector":4.578,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":43.97,"sector":26.34,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":3.34,"sector":1.15,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":3.018,"sector":4.752,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":2.037,"sector":31.61,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.137,"sector":0.178,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.273,"sector":0.367,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2753,"sector":0.2373,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.3322,"sector":0.1867,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.5556,"sector":0.5318,"verdict":"In line"},{"k":"op_margin","label":"Operating margin","v":0.05486,"sector":0.1268,"verdict":"Weak"}