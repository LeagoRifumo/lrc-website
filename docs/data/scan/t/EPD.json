ural gas. The Petrochemical & Refined Products Services segment operates propylene fractionation facilities, including propylene fractionation units and propane dehydrogenation facilities, and related marketing activities; butane isomerization complex and related deisobutanizer operations; and octane enhancement, isobutane dehydrogenation, and high purity isobutylene production facilities. It also operates refined products pipelines and terminals; and ethylene export terminals; and provides refined products marketing and marine transportation services. The company was founded in 1968 and is headquartered in Houston, Texas.","employees":null,"website":"https://www.enterpriseproducts.com","country":"United States","city":"Houston","officers":[{"name":"Mr. A. James Teague","title":"Co-CEO & Director of Enterprise Products Holdings LLC"},{"name":"Mr. W. Randall Fowler","title":"Co-CEO & Director of Enterprise Products Holdings LLC"},{"name":"Mr. Richard Daniel Boss","title":"Executive VP, Principal Accounting Officer & CFO of Enterprise Products Holdings LLC"}]},"sector_medians":{"fpe":12.12,"tpe":15.46,"ps":2.173,"pfcf":16.32,"peg":1.325,"pb":2.114,"ev_ebitda":7.771,"rev_growth":0.265,"eps_growth":0.801,"eps_growth_fwd":0.4536,"eps_growth_next":0.0528,"div_yield":0.01965,"roe":0.1359,"roa":0.05513,"de":52.78,"gross_margin":0.4567,"op_margin":0.2397,"profit_margin":0.1023,"current_ratio":1.455},"valuation":[{"k":"fpe","label":"Forward P/E","v":11.74,"sector":12.12,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":12.91,"sector":15.46,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.373,"sector":2.173,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":74.51,"sector":16.32,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.31,"sector":1.325,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":2.654,"sector":2.114,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":110.0,"sector":52.78,"verdict":"High deb