":{"strongBuy":3,"buy":7,"hold":12,"sell":1,"strongSell":0},"analyst_actions":[{"date":"2026-10-30","firm":"Truist Securities","action":"main","from":"Hold","to":"Hold"},{"date":"2026-10-08","firm":"JP Morgan","action":"main","from":"Neutral","to":"Neutral"},{"date":"2026-09-22","firm":"RBC Capital","action":"reit","from":"Outperform","to":"Outperform"}]},"profile":{"sector":"Energy","industry":"Oil & Gas Midstream","summary":"Enterprise Products Partners L.P. provides midstream energy services to producers and consumers of natural gas, natural gas liquids (NGLs), crude oil, petrochemicals, and refined products. It operates in four segments: NGL Pipelines & Services; Crude Oil Pipelines & Services; Natural Gas Pipelines & Services; and Petrochemical & Refined Products Services. The NGL Pipelines & Services segment offers natural gas processing and related NGL marketing activities. This segment operates natural gas processing facilities located in Colorado, Louisiana, Mississippi, New Mexico, Texas, and Wyoming; NGL pipelines; NGL fractionation facilities; NGL and related product storage facilities; and NGL marine terminals. The Crude Oil Pipelines & Services segment operates crude oil pipelines; and crude oil storage and marine terminals, which include a fleet of approximately 200 tractor-trailer tank trucks that are used to transport crude oil. It also engages in crude oil marketing activities. The Natural Gas Pipelines & Services segment operates natural gas pipeline systems to gather, treat, and transport natural gas. It leases underground salt dome natural gas storage facilities in Napoleonville, Louisiana; owns an underground salt dome storage cavern in Wharton County, Texas; and transports, stores, and markets natural gas. The Petrochemical & Refined Products Services segment operates propylene fractionation facilities, including propylene fractionation units and propane dehydrogenation facilities, and related marketing activities; butane isomerization complex and related deisobutanizer operations; and octane enhancement, isobutane dehydrogenation, and high purity isobutylene production facilities. It also operates refined products pipelines and terminals; and ethylene export terminals; and provides refined products marketing and marine transportation services. The company was founded in 1968 and is headquartered in Houston, Texas.","employees":null,"website":"https://www.enterpriseproducts.com","country":"United States","city":"Houston","officers":[{"name":"Mr. A. James Teague","title":"Co-CEO & Director of Enterprise Products Holdings LLC"},{"name":"Mr. W. Randall Fowler","title":"Co-CEO & Director of Enterprise Products Holdings LLC"},{"name":"Mr. Richard Daniel Boss","title":"Executive VP, Principal Accounting Officer & CFO of Enterprise Products Holdings LLC"}]},"sector_medians":{"fpe":12.14,"tpe":14.81,"ps":2.16,"pfcf":16.45,"peg":1.35,"pb":2.063,"ev_ebitda":7.789,"rev_growth":0.286,"eps_growth":0.952,"eps_growth_fwd":0.4909,"eps_growth_next":0.0449,"div_yield":0.0189,"roe":0.1359,"roa":0.05638,"de":55.01,"gross_margin":0.4427,"op_margin":0.2513,"profit_margin":0.1023,"current_ratio":1.462},"valuation":[{"k":"fpe","label":"Forward P/E","v":11.92,"sector":12.14,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":13.58,"sector":14.81,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.279,"sector":2.16,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":16.45,"verdict":"—"},{"k":"peg","label":"PEG","v":1.35,"sector":1.35,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":2.773,"sector":2.063,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":110.0,"sector":55.01,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.493,"sector":0.286,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.216,"sector":0.952,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1422,"sec