e cavern in Wharton County, Texas; and transports, stores, and markets natural gas. The Petrochemical & Refined Products Services segment operates propylene fractionation facilities, including propylene fractionation units and propane dehydrogenation facilities, and related marketing activities; butane isomerization complex and related deisobutanizer operations; and octane enhancement, isobutane dehydrogenation, and high purity isobutylene production facilities. It also operates refined products pipelines and terminals; and ethylene export terminals; and provides refined products marketing and marine transportation services. The company was founded in 1968 and is headquartered in Houston, Texas.","employees":null,"website":"https://www.enterpriseproducts.com","country":"United States","city":"Houston","officers":[{"name":"Mr. A. James Teague","title":"Co-CEO & Director of Enterprise Products Holdings LLC"},{"name":"Mr. W. Randall Fowler","title":"Co-CEO & Director of Enterprise Products Holdings LLC"},{"name":"Mr. Richard Daniel Boss","title":"Executive VP, Principal Accounting Officer & CFO of Enterprise Products Holdings LLC"}]},"sector_medians":{"fpe":11.94,"tpe":15.14,"ps":2.161,"pfcf":16.26,"peg":1.325,"pb":2.115,"ev_ebitda":7.982,"rev_growth":0.278,"eps_growth":0.801,"eps_growth_fwd":0.5115,"eps_growth_next":0.0398,"div_yield":0.019,"roe":0.1337,"roa":0.05517,"de":55.83,"gross_margin":0.4427,"op_margin":0.2457,"profit_margin":0.1021,"current_ratio":1.443},"valuation":[{"k":"fpe","label":"Forward P/E","v":11.9,"sector":11.94,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":13.09,"sector":15.14,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.395,"sector":2.161,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":75.7,"sector":16.26,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.31,"sector":1.325,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":2.696,"sector":2.115,"verdict":"Overvalued"},{"k":"de","l