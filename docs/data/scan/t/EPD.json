cts Services segment operates propylene fractionation facilities, including propylene fractionation units and propane dehydrogenation facilities, and related marketing activities; butane isomerization complex and related deisobutanizer operations; and octane enhancement, isobutane dehydrogenation, and high purity isobutylene production facilities. It also operates refined products pipelines and terminals; and ethylene export terminals; and provides refined products marketing and marine transportation services. The company was founded in 1968 and is headquartered in Houston, Texas.","employees":null,"website":"https://www.enterpriseproducts.com","country":"United States","city":"Houston","officers":[{"name":"Mr. A. James Teague","title":"Co-CEO & Director of Enterprise Products Holdings LLC"},{"name":"Mr. W. Randall Fowler","title":"Co-CEO & Director of Enterprise Products Holdings LLC"},{"name":"Mr. Richard Daniel Boss","title":"Executive VP, Principal Accounting Officer & CFO of Enterprise Products Holdings LLC"}]},"sector_medians":{"fpe":12.14,"tpe":15.03,"ps":2.181,"pfcf":17.22,"peg":1.34,"pb":2.188,"ev_ebitda":7.858,"rev_growth":0.268,"eps_growth":0.8195,"eps_growth_fwd":0.4909,"eps_growth_next":0.03715,"div_yield":0.019,"roe":0.1285,"roa":0.05512,"de":55.83,"gross_margin":0.4427,"op_margin":0.2391,"profit_margin":0.1013,"current_ratio":1.437},"valuation":[{"k":"fpe","label":"Forward P/E","v":12.2,"sector":12.14,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":13.56,"sector":15.03,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.442,"sector":2.181,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":78.28,"sector":17.22,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.35,"sector":1.34,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":2.839,"sector":2.188,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":110.0,"sector":55.83,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth"