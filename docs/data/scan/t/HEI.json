wer electronics; power conversion and interface products; interconnection devices; and underwater locator and emergency locator transmission beacons. This segment also offers traveling wave tube amplifiers and microwave power modules; memory products and specialty semiconductors; environment connectivity products and molded cable assemblies; RF and microwave products; communications and electronic intercept receivers and tuners; self-sealing auxiliary fuel systems; active antenna systems and airborne antennas; nuclear radiation detectors; power amplifiers; ceramic-to-metal feedthroughs and connectors; technical surveillance countermeasures equipment; RF receivers and sources; radiation assurance, embedded computing, and silicone solutions; test sockets and adapters; and electronic components and rotary joint assemblies. The company was incorporated in 1957 and is headquartered in Hollywood, Florida.","employees":11100,"website":"https://www.heico.com","country":"United States","city":"Hollywood","officers":[{"name":"Mr. Eric A. Mendelson","title":"Co-CEO, Co-President & Co-Chairman"},{"name":"Mr. Victor H. Mendelson","title":"Co-CEO, Co-President & Co-Chairman"},{"name":"Mr. Carlos L. Macau Jr.","title":"Executive VP, CFO & Treasurer"}]},"sector_medians":{"fpe":17.75,"tpe":26.36,"ps":2.156,"pfcf":26.62,"peg":1.4,"pb":3.514,"ev_ebitda":14.88,"rev_growth":0.11,"eps_growth":0.176,"eps_growth_fwd":0.1441,"eps_growth_next":0.1459,"div_yield":0.0066,"roe":0.149,"roa":0.05825,"de":66.95,"gross_margin":0.3185,"op_margin":0.1262,"profit_margin":0.0723,"current_ratio":1.665},"valuation":[{"k":"fpe","label":"Forward P/E","v":42.73,"sector":17.75,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":51.3,"sector":26.36,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":8.338,"sector":2.156,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":51.06,"sector":26.62,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":2.13,"sector":1.4,"verdict":"Overvalued"}