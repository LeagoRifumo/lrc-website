ums, commercial and industrial facilities, clean energy projects, manufacturing plants, processing facilities, water/waste-water treatment facilities, mining facilities, intelligent transportation systems, roadway lighting, signalization, and electric vehicle charging infrastructure. This segment serves general contractors, commercial and industrial facility owners, governmental agencies, and developers. MYR Group Inc. was founded in 1891 and is headquartered in Thornton, Colorado.","employees":9000,"website":"https://www.myrgroup.com","country":"United States","city":"Thornton","officers":[{"name":"Mr. Richard S. Swartz Jr.","title":"President, CEO & Director"},{"name":"Ms. Kelly Michelle Huntington C.F.A.","title":"Senior VP & CFO"},{"name":"Mr. William F. Fry J.D.","title":"Senior VP, Chief Legal Officer & Secretary"}]},"sector_medians":{"fpe":18.26,"tpe":26.27,"ps":2.184,"pfcf":28.38,"peg":1.435,"pb":3.631,"ev_ebitda":15.11,"rev_growth":0.1185,"eps_growth":0.175,"eps_growth_fwd":0.1588,"eps_growth_next":0.143,"div_yield":0.0068,"roe":0.1466,"roa":0.05844,"de":66.28,"gross_margin":0.3187,"op_margin":0.1262,"profit_margin":0.07423,"current_ratio":1.689},"valuation":[{"k":"fpe","label":"Forward P/E","v":18.74,"sector":18.26,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":23.22,"sector":26.27,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.029,"sector":2.184,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":90.67,"sector":28.38,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":3.41,"sector":1.435,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":5.42,"sector":3.631,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":34.33,"sector":66.28,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.325,"sector":0.1185,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.863,"sector":0.175,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year