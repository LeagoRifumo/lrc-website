 in 164,805 hectares and 505,788 hectares of concessions in Peru and Mexico; and 98,634 hectares and 28,453 hectares of exploration concessions in Argentina and Chile. Southern Copper Corporation was formerly known as Southern Peru Copper Corp. and changed its name to Southern Copper Corporation in July 1996. The company was incorporated in 1952 and is based in Phoenix, Arizona. Southern Copper Corporation operates as a subsidiary of Americas Mining Corporation.","employees":16617,"website":"https://www.southerncoppercorp.com","country":"United States","city":"Phoenix","officers":[{"name":"Engineer Leonardo  Contreras Lerdo de Tejada","title":"CEO & Non-Independent Director"},{"name":"Mr. Raul  Jacob Ruisanchez","title":"VP of Finance, Treasurer & CFO"},{"name":"Ms. Lina A. Vingerhoets Vilca","title":"Comptroller"}]},"sector_medians":{"fpe":12.25,"tpe":18.92,"ps":2.215,"pfcf":23.76,"peg":1.74,"pb":2.326,"ev_ebitda":9.059,"rev_growth":0.165,"eps_growth":0.385,"eps_growth_fwd":0.3407,"eps_growth_next":0.1518,"div_yield":0.0092,"roe":0.1288,"roa":0.06935,"de":43.23,"gross_margin":0.3343,"op_margin":0.1751,"profit_margin":0.07064,"current_ratio":2.085},"valuation":[{"k":"fpe","label":"Forward P/E","v":23.62,"sector":12.25,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":23.97,"sector":18.92,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":8.902,"sector":2.215,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":26.87,"sector":23.76,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":5.41,"sector":1.74,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":11.26,"sector":2.326,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":62.58,"sector":43.23,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.391,"sector":0.165,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.66,"sector":0.385,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v"