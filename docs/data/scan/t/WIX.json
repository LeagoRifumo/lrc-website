ix Stores; Wix Restaurants; Wix Events; Wix Fitness; Wix Hotels; Wix Music; Wix Showcase; Wix Video; Wix Blog and Wix Forms; Wix Groups; Wix Proposals; Wix Donations; Wix AI Website Builder; Wix AI Text Creator; Wix AI Image Generator; Wix Premium Subscriptions; Email Marketing Subscriptions; Paid Ad Campaigns; Domains; Google Workspace; Gift Cards; and Wix Commerce Solutions, a commerce platform for business owners. Wix.com Ltd. was incorporated in 2006 and is headquartered in Tel Aviv, Israel.","employees":4371,"website":"https://www.wix.com","country":"Israel","city":"Tel Aviv","officers":[{"name":"Mr. Avishai  Abrahami","title":"Co-Founder, Honorary Chairman & CEO"},{"name":"Mr. Nir  Zohar","title":"Co-Founder & President"},{"name":"Mr. Menashe Lior Shemesh","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":18.28,"tpe":32.14,"ps":4.713,"pfcf":27.99,"peg":1.155,"pb":4.963,"ev_ebitda":20.13,"rev_growth":0.169,"eps_growth":0.352,"eps_growth_fwd":0.2214,"eps_growth_next":0.1917,"div_yield":0,"roe":0.1232,"roa":0.04714,"de":32.58,"gross_margin":0.5282,"op_margin":0.1189,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":11.55,"sector":18.28,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":32.14,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":2.164,"sector":4.713,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":10.44,"sector":27.99,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.16,"sector":1.155,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":null,"sector":4.963,"verdict":"—"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":32.58,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.149,"sector":0.169,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.352,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.364,"sector":0.2214,"verdict":"Weak"},{"k"