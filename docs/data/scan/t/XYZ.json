y, a buy now, pay later platform. In addition, the company operates TIDAL, a platform for musicians and fans; TBD, an open developer platform focused on making the decentralized financial world accessible; Bitkey, a self-custody bitcoin wallet; and proto. The company was formerly known as Square, Inc. and changed its name to Block, Inc. in December 2021. Block, Inc. was incorporated in 2009 and is based in Oakland, California.","employees":10205,"website":"https://www.block.xyz","country":"United States","city":"Oakland","officers":[{"name":"Mr. Jack  Dorsey","title":"Co-Founder, Block Head & Chairman"},{"name":"Mr. James Morgan McKelvey Jr.","title":"Co-Founder & Director"},{"name":"Ms. Amrita  Ahuja","title":"Foundational Lead, COO, CFO & Treasurer"}]},"sector_medians":{"fpe":18.07,"tpe":31.58,"ps":4.745,"pfcf":27.68,"peg":1.155,"pb":4.937,"ev_ebitda":20.43,"rev_growth":0.169,"eps_growth":0.352,"eps_growth_fwd":0.2214,"eps_growth_next":0.1917,"div_yield":0,"roe":0.1232,"roa":0.04714,"de":32.58,"gross_margin":0.5282,"op_margin":0.1189,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":18.07,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":134.3,"sector":31.58,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":1.804,"sector":4.745,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":27.68,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":0.57,"sector":1.155,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":2.049,"sector":4.937,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":32.58,"sector":32.58,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.093,"sector":0.169,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.833,"sector":0.352,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.7084,"sector":0.2214,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS gr