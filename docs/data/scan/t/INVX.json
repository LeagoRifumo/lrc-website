ompany offers products utilized to support effective cement placement between the wellbore and casing. It sells and rents its products to international and national oil companies, independent exploration and production companies, and multinational service companies. Its products have applications in the onshore and offshore oil and natural gas wells, including well construction, well completion, and well production and intervention. The company was founded in 2016 and is headquartered in Humble, Texas.","employees":2160,"website":"https://www.innovex-inc.com","country":"United States","city":"Humble","officers":[{"name":"Mr. Adam B. Anderson","title":"CEO & Director"},{"name":"Mr. Kendal  Reed","title":"Chief Financial Officer"},{"name":"Mr. Mark  Reddout","title":"President of North America"}]},"sector_medians":{"fpe":12.0,"tpe":15.06,"ps":2.149,"pfcf":16.36,"peg":1.33,"pb":2.177,"ev_ebitda":7.967,"rev_growth":0.278,"eps_growth":0.801,"eps_growth_fwd":0.5115,"eps_growth_next":0.0375,"div_yield":0.019,"roe":0.1337,"roa":0.05517,"de":55.83,"gross_margin":0.4427,"op_margin":0.2457,"profit_margin":0.1021,"current_ratio":1.443},"valuation":[{"k":"fpe","label":"Forward P/E","v":16.19,"sector":12.0,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":34.12,"sector":15.06,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":2.129,"sector":2.149,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":12.2,"sector":16.36,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":null,"sector":1.33,"verdict":"—"},{"k":"pb","label":"Price / Book","v":1.976,"sector":2.177,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":7.043,"sector":55.83,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.092,"sector":0.278,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.636,"sector":0.801,"verdict":"In line"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.4536,"sector":0.5115,"verdict"