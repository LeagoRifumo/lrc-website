teriors and exteriors of cars, trucks, and vans. The company sells the vehicles to licensed vehicle dismantlers, rebuilders, repair licenses, used vehicle dealers, and exporters, as well as to the public. Copart, Inc. was incorporated in 1982 and is headquartered in Dallas, Texas.","employees":21000,"website":"https://www.copart.com","country":"United States","city":"Dallas","officers":[{"name":"Mr. Willis J. Johnson","title":"Founder & Chairman"},{"name":"Mr. A. Jayson Adair","title":"Executive Chairman & CEO"},{"name":"Ms. Leah C. Stearns","title":"Senior VP & CFO"}]},"sector_medians":{"fpe":17.65,"tpe":25.99,"ps":2.167,"pfcf":26.66,"peg":1.42,"pb":3.505,"ev_ebitda":14.96,"rev_growth":0.11,"eps_growth":0.176,"eps_growth_fwd":0.1478,"eps_growth_next":0.1459,"div_yield":0.0066,"roe":0.149,"roa":0.05825,"de":66.95,"gross_margin":0.3185,"op_margin":0.1262,"profit_margin":0.0723,"current_ratio":1.665},"valuation":[{"k":"fpe","label":"Forward P/E","v":16.0,"sector":17.65,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":18.68,"sector":25.99,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":5.749,"sector":2.167,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":30.31,"sector":26.66,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":2.9,"sector":1.42,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":2.949,"sector":3.505,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":0.97,"sector":66.95,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.024,"sector":0.11,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.15,"sector":0.176,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0484,"sector":0.1478,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1138,"sector":0.1459,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0.4529,"sector":0.3185,"verdict":"Strong"},{"k":"op_margi