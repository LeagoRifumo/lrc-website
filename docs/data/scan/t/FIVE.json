aster, Halloween, Summer, and Back to School. The company was formerly known as Cheap Holdings, Inc. and changed its name to Five Below, Inc. in August 2002. Five Below, Inc. was incorporated in 2002 and is headquartered in Philadelphia, Pennsylvania.","employees":7800,"website":"https://www.fivebelow.com","country":"United States","city":"Philadelphia","officers":[{"name":"Ms. Winifred Y. Park","title":"President, CEO & Director"},{"name":"Mr. Daniel J. Sullivan CPA","title":"CFO & Treasurer"},{"name":"Mr. Kenneth R. Bull","title":"Chief Operating Officer"}]},"sector_medians":{"fpe":15.26,"tpe":20.86,"ps":1.31,"pfcf":20.31,"peg":1.14,"pb":3.038,"ev_ebitda":12.42,"rev_growth":0.055,"eps_growth":0.175,"eps_growth_fwd":0.1136,"eps_growth_next":0.1233,"div_yield":0.0075,"roe":0.1518,"roa":0.06033,"de":107.2,"gross_margin":0.3795,"op_margin":0.09707,"profit_margin":0.05819,"current_ratio":1.434},"valuation":[{"k":"fpe","label":"Forward P/E","v":22.88,"sector":15.26,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":22.67,"sector":20.86,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":2.64,"sector":1.31,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":38.18,"sector":20.31,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":0.98,"sector":1.14,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":5.665,"sector":3.038,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":82.33,"sector":107.2,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.229,"sector":0.055,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":4.182,"sector":0.175,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.5366,"sector":0.1136,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0791,"sector":0.1233,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.3758,"sector":0.3795,"verdict":"In line"},{"k":"op_margin","l