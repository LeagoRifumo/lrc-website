tries. The company was formerly known as Melco Crown Entertainment Limited and changed its name to Melco Resorts & Entertainment Limited in April 2017. The company was founded in 2003 and is based in Central, Hong Kong. Melco Resorts & Entertainment Limited is a subsidiary of Melco Leisure and Entertainment Group Limited.","employees":22961,"website":"https://www.melco-resorts.com","country":"Hong Kong","city":"Central","officers":[{"name":"Mr. Yau Lung  Ho","title":"Founder, Chairman & CEO"},{"name":"Mr. Evan Andrew  Winkler","title":"President & Director"},{"name":"Mr. Geoffrey Stuart  Davis C.F.A.","title":"Executive VP & CFO"}]},"sector_medians":{"fpe":14.67,"tpe":19.24,"ps":1.232,"pfcf":19.39,"peg":1.18,"pb":2.921,"ev_ebitda":12.04,"rev_growth":0.054,"eps_growth":0.145,"eps_growth_fwd":0.1026,"eps_growth_next":0.118,"div_yield":0.0072,"roe":0.1516,"roa":0.05988,"de":102.4,"gross_margin":0.3788,"op_margin":0.09618,"profit_margin":0.0578,"current_ratio":1.418},"valuation":[{"k":"fpe","label":"Forward P/E","v":7.914,"sector":14.67,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":10.43,"sector":19.24,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.298,"sector":1.232,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":19.39,"verdict":"—"},{"k":"peg","label":"PEG","v":0.49,"sector":1.18,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":null,"sector":2.921,"verdict":"—"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":102.4,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":-0.104,"sector":0.054,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-1.0,"sector":0.145,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.5457,"sector":0.1026,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.6889,"sector":0.118,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.3739,"sector":0.3788