 and digital publishers. The company serves consumer packaged goods, financial services, telecommunications, technology, automotive, and healthcare industry verticals. The company was founded in 2008 and is headquartered in New York, New York.","employees":1231,"website":"https://www.doubleverify.com","country":"United States","city":"New York","officers":[{"name":"Mr. Mark S. Zagorski","title":"CEO & Director"},{"name":"Mr. Nicola T. Allais","title":"Chief Financial Officer"},{"name":"Mr. Andrew E. Grimmig J.D.","title":"Chief Legal Officer & Secretary"}]},"sector_medians":{"fpe":12.24,"tpe":16.72,"ps":2.081,"pfcf":12.15,"peg":0.99,"pb":2.29,"ev_ebitda":12.56,"rev_growth":0.083,"eps_growth":0.033,"eps_growth_fwd":0.1449,"eps_growth_next":0.1232,"div_yield":0,"roe":0.09872,"roa":0.04149,"de":61.74,"gross_margin":0.5655,"op_margin":0.1367,"profit_margin":0.07874,"current_ratio":1.317},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":12.24,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":34.77,"sector":16.72,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":2.695,"sector":2.081,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":11.54,"sector":12.15,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":0.54,"sector":0.99,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.869,"sector":2.29,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":9.561,"sector":61.74,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.09,"sector":0.083,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.667,"sector":0.033,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1472,"sector":0.1449,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1568,"sector":0.1232,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.8217,"sector":0.5655,"verdict":"Strong"},{"k":"op_margin","label":"Operati