g ID with CLEAR, a digital ID solution that allows users to add a US passport to Samsung Wallet and verify their identity. The company was founded in 2010 and is headquartered in New York, New York. Clear Secure, Inc. is a subsidiary of Alclear Investments, Llc.","employees":3301,"website":"https://www.clearme.com","country":"United States","city":"New York","officers":[{"name":"Ms. Caryn Gail Seidman-Becker","title":"Chairman & CEO"},{"name":"Mr. Dennis W. Liu","title":"Chief Accounting Officer"},{"name":"Mr. Jonathan  Schlegel","title":"Chief Security Officer"}]},"sector_medians":{"fpe":17.92,"tpe":31.96,"ps":4.757,"pfcf":27.69,"peg":1.155,"pb":5.077,"ev_ebitda":20.02,"rev_growth":0.177,"eps_growth":0.339,"eps_growth_fwd":0.2255,"eps_growth_next":0.1929,"div_yield":0,"roe":0.1195,"roa":0.04674,"de":32.62,"gross_margin":0.5331,"op_margin":0.1128,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":17.64,"sector":17.92,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":30.85,"sector":31.96,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":4.733,"sector":4.757,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":11.32,"sector":27.69,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":null,"sector":1.155,"verdict":"—"},{"k":"pb","label":"Price / Book","v":22.78,"sector":5.077,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":45.14,"sector":32.62,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.266,"sector":0.177,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.87,"sector":0.339,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.3724,"sector":0.2255,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.2406,"sector":0.1929,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0.6666,"sector":0.5331,"verdict":"Strong"},{"k":"op_margin","