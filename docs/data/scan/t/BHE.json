anced computing and communications, aerospace and defense, industrial, medical, and semiconductor capital equipment industries. The company markets its services and solutions primarily through a direct sales force. Benchmark Electronics, Inc. was founded in 1979 and is headquartered in Tempe, Arizona.","employees":11840,"website":"https://www.bench.com","country":"United States","city":"Tempe","officers":[{"name":"Mr. David A. Moezidis","title":"President, CEO & Director"},{"name":"Mr. Bryan R. Schumaker CPA","title":"Executive VP, CFO & Principal Accounting Officer"},{"name":"Mr. David A. Valkanoff","title":"Executive VP & COO"}]},"sector_medians":{"fpe":18.26,"tpe":31.4,"ps":4.764,"pfcf":26.86,"peg":1.15,"pb":4.974,"ev_ebitda":20.02,"rev_growth":0.17,"eps_growth":0.345,"eps_growth_fwd":0.2306,"eps_growth_next":0.1867,"div_yield":0,"roe":0.1243,"roa":0.04866,"de":29.26,"gross_margin":0.5169,"op_margin":0.1199,"profit_margin":0.08708,"current_ratio":1.825},"valuation":[{"k":"fpe","label":"Forward P/E","v":21.06,"sector":18.26,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":48.42,"sector":31.4,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":0.9011,"sector":4.764,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":18.62,"sector":26.86,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.91,"sector":1.15,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":2.275,"sector":4.974,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":26.14,"sector":29.26,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.177,"sector":0.17,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":19.37,"sector":0.345,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2264,"sector":0.2306,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1404,"sector":0.1867,"verdict":"In line"},{"k":"gross_margin","label":"Gross mar