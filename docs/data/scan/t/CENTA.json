endent distributors, big-box retailers, national and regional retail chains, eCommerce and online retailers, grocery stores, nurseries, and mass merchants. Central Garden & Pet Company was founded in 1955 and is headquartered in Walnut Creek, California.","employees":5200,"website":"https://www.central.com","country":"United States","city":"Walnut Creek","officers":[{"name":"Mr. William E. Brown","title":"Founder & Chairman"},{"name":"Mr. Nicholas  Lahanas","title":"CEO & Director"},{"name":"Mr. Bradley G. Smith","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":14.91,"tpe":20.44,"ps":1.146,"pfcf":17.91,"peg":1.0,"pb":2.517,"ev_ebitda":10.49,"rev_growth":0.038,"eps_growth":0.133,"eps_growth_fwd":0.0663,"eps_growth_next":0.07565,"div_yield":0.0203,"roe":0.1239,"roa":0.05633,"de":79.22,"gross_margin":0.3572,"op_margin":0.1108,"profit_margin":0.04469,"current_ratio":1.287},"valuation":[{"k":"fpe","label":"Forward P/E","v":10.96,"sector":14.91,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":12.54,"sector":20.44,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.7207,"sector":1.146,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":8.439,"sector":17.91,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":7.17,"sector":1.0,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.213,"sector":2.517,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":79.22,"sector":79.22,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":-0.207,"sector":0.038,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.133,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0358,"sector":0.0663,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1043,"sector":0.07565,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.3358,"sector":0.3572,"verdict":"In line"},{"k":"op_margin","label":"Operating