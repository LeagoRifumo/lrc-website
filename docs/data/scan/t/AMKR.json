rized mechanical and electromechanical devices; and advanced system-in-package modules used in radio frequency and front end modules, basebands, connectivity, fingerprint sensors, display and touch screen drivers, sensors and MEMS, and NAND memory and solid-state drives. Further, the company provides wafer, package, and system level test services, as well as burn-in test and test development services. It serves integrated device manufacturers, fabless semiconductor companies, original equipment manufacturers, and contract foundries. Amkor Technology, Inc. was founded in 1968 and is headquartered in Tempe, Arizona.","employees":30800,"website":"https://amkor.com","country":"United States","city":"Tempe","officers":[{"name":"Ms. Susan Y. Kim","title":"Chairman"},{"name":"Mr. Kevin K. Engel","title":"CEO, President & Director"},{"name":"Ms. Megan  Faust CPA","title":"Executive VP, CFO & Treasurer"}]},"sector_medians":{"fpe":17.73,"tpe":31.01,"ps":4.582,"pfcf":26.55,"peg":1.16,"pb":4.831,"ev_ebitda":19.21,"rev_growth":0.1835,"eps_growth":0.3615,"eps_growth_fwd":0.2307,"eps_growth_next":0.1906,"div_yield":0,"roe":0.1245,"roa":0.04768,"de":32.58,"gross_margin":0.5372,"op_margin":0.1249,"profit_margin":0.09218,"current_ratio":1.81},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.19,"sector":17.73,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":15.88,"sector":31.01,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.309,"sector":4.582,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":26.55,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":0.76,"sector":1.16,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":2.035,"sector":4.831,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":56.08,"sector":32.58,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.002,"sector":0.1835,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.49,"sector":0.3615,"ve