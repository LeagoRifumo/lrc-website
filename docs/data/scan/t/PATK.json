stems, appliances, and marine accessories; wiring, electrical, and plumbing products; fiber reinforced polyester products; and cement siding, raw and processed lumber, interior passage, roofing, laminate, and ceramic flooring, shower doors, furniture, fireplaces and surrounds, interior and exterior lighting products, and other products. This segment also offers transportation and logistics services. Patrick Industries, Inc. was incorporated in 1959 and is based in Elkhart, Indiana.","employees":10000,"website":"https://www.patrickind.com","country":"United States","city":"Elkhart","officers":[{"name":"Mr. Andy L. Nemeth","title":"CEO & Chairman of the Board"},{"name":"Mr. Jeffrey M. Rodino","title":"President"},{"name":"Mr. Hugo E. Gonzalez","title":"President of Powersports and Housing & Chief Operating Officer"}]},"sector_medians":{"fpe":14.77,"tpe":19.46,"ps":1.261,"pfcf":19.95,"peg":1.14,"pb":3.033,"ev_ebitda":11.75,"rev_growth":0.062,"eps_growth":0.1705,"eps_growth_fwd":0.1089,"eps_growth_next":0.1259,"div_yield":0.0078,"roe":0.1545,"roa":0.06132,"de":110.4,"gross_margin":0.38,"op_margin":0.09577,"profit_margin":0.0572,"current_ratio":1.434},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.8,"sector":14.77,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":17.9,"sector":19.46,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":0.6131,"sector":1.261,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":73.72,"sector":19.95,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":3.46,"sector":1.14,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":2.109,"sector":3.033,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":146.0,"sector":110.4,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.006,"sector":0.062,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.333,"sector":0.1705,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)",