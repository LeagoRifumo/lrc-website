he treatment-resistant narcolepsy; and CBS104 for refractory epilepsy. The company was formerly known as Harmony Biosciences II, Inc. and changed its name to Harmony Biosciences Holdings, Inc. in February 2020. Harmony Biosciences Holdings, Inc. was incorporated in 2017 and is headquartered in Plymouth Meeting, Pennsylvania.","employees":293,"website":"https://www.harmonybiosciences.com","country":"United States","city":"Plymouth Meeting","officers":[{"name":"Mr. Jeffrey S. Aronin","title":"Founder & Non-Executive Chairman"},{"name":"Dr. Jeffrey M. Dayno M.D.","title":"President, CEO & Director"},{"name":"Dr. Kumar  Budur M.D., M.S.","title":"Executive VP and Chief Medical & Scientific Officer"}]},"sector_medians":{"fpe":18.94,"tpe":30.13,"ps":4.427,"pfcf":28.89,"peg":1.335,"pb":4.543,"ev_ebitda":16.87,"rev_growth":0.102,"eps_growth":0.167,"eps_growth_fwd":0.0901,"eps_growth_next":0.1184,"div_yield":0,"roe":-0.00633,"roa":0.01963,"de":37.14,"gross_margin":0.5204,"op_margin":0.03842,"profit_margin":0,"current_ratio":3.161},"valuation":[{"k":"fpe","label":"Forward P/E","v":5.418,"sector":18.94,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":12.24,"sector":30.13,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":2.302,"sector":4.427,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":12.09,"sector":28.89,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":null,"sector":1.335,"verdict":"—"},{"k":"pb","label":"Price / Book","v":2.207,"sector":4.543,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":16.03,"sector":37.14,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.303,"sector":0.102,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.882,"sector":0.167,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.4505,"sector":0.0901,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.3414,"sector":0.1184,"v