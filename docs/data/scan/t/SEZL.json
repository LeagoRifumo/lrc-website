nt online or in-store; Sezzle Premium, a paid subscription service that allows its consumers to access large, non-integrated premium merchants; Sezzle Balance, a stored-value product that allows consumers to maintain funds in Sezzle account for use toward eligible purchases or make payments on the Sezzle Platform; and Sezzle Up, an opt-in feature of the Sezzle Platform. In addition, the company offers Long-Term Lending through collaboration with third-party lenders. Sezzle Inc. was incorporated in 2016 and is headquartered in Minneapolis, Minnesota.","employees":201,"website":"https://www.sezzle.com","country":"United States","city":"Minneapolis","officers":[{"name":"Mr. Charles G. Youakim","title":"Co-Founder, Executive Chairman & CEO"},{"name":"Mr. Paul Victor Paradis","title":"Co-Founder, President & Executive Director"},{"name":"Mr. Amin  Sabzivand","title":"Chief Operating Officer"}]},"sector_medians":{"fpe":10.68,"tpe":12.48,"ps":3.448,"pfcf":11.41,"peg":1.32,"pb":1.605,"ev_ebitda":11.12,"rev_growth":0.088,"eps_growth":0.114,"eps_growth_fwd":0.1346,"eps_growth_next":0.1037,"div_yield":0.0219,"roe":0.1288,"roa":0.01564,"de":53.95,"gross_margin":0.243,"op_margin":0.3491,"profit_margin":0.2565,"current_ratio":1.519},"valuation":[{"k":"fpe","label":"Forward P/E","v":21.46,"sector":10.68,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":29.8,"sector":12.48,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":8.984,"sector":3.448,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":56.84,"sector":11.41,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":0.09,"sector":1.32,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":18.82,"sector":1.605,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":37.01,"sector":53.95,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.426,"sector":0.088,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.84,"sector":0.114,"verdict":"Stron