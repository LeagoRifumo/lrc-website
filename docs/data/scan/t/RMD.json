bles home health and hospice agencies to optimize clinical, financial and administrative processes; MatrixCare EHR software as a service solutions used by skilled nursing and senior living providers, life plan communities, and home health and hospice sectors; and MEDIFOX DAN software solutions that is used by residential care providers, such as home health and nursing home providers. ResMed Inc. was founded in 1989 and is headquartered in San Diego, California.","employees":11370,"website":"https://www.resmed.com","country":"United States","city":"San Diego","officers":[{"name":"Mr. Michael J. Farrell BE, MBA, SM","title":"CEO & Chairman"},{"name":"Dr. Peter C. Farrell A.M., B.E., BE (Hons), Ph.D., ScD","title":"Founder, Chair Emeritus & Non-Executive Director"},{"name":"Mr. Aaron  Bloomer","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":17.62,"tpe":29.74,"ps":3.69,"pfcf":27.89,"peg":1.36,"pb":3.624,"rev_growth":0.075,"eps_growth":0.171,"eps_growth_fwd":0.0972,"eps_growth_next":0.1015,"div_yield":0.0044,"roe":0.1442,"roa":0.06567,"de":68.79,"gross_margin":0.5566,"op_margin":0.1825,"profit_margin":0.098,"current_ratio":1.558},"valuation":[{"k":"fpe","label":"Forward P/E","v":18.92,"sector":17.62,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":24.28,"sector":29.74,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":6.239,"sector":3.69,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":37.55,"sector":27.89,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.36,"sector":1.36,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":5.493,"sector":3.624,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":12.54,"sector":68.79,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.086,"sector":0.075,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.024,"sector":0.171,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0826