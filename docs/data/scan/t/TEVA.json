UDOCREM, NasenDuo, DICLOX FORTE, OLFEN Max, and FLEGAMINA brand names. The company has collaboration agreements with MedinCell S.A.; Sanofi; Alvotech; and Biolojic Design Ltd., as well as license agreement with MODAG GmbH. Teva Pharmaceutical Industries Limited was founded in 1901 and is based in Tel Aviv-Yafo, Israel.","employees":31173,"website":"https://www.tevapharm.com","country":"Israel","city":"Tel Aviv-Yafo","officers":[{"name":"Mr. Richard D. Francis","title":"President, CEO & Director"},{"name":"Mr. Eliyahu Sharon Kalif","title":"Executive VP & CFO"},{"name":"Dr. Eric A. Hughes M.D., Ph.D.","title":"Executive VP of Global R&D and Chief Medical Officer"}]},"sector_medians":{"fpe":19.17,"tpe":30.5,"ps":4.503,"pfcf":28.94,"peg":1.34,"pb":4.598,"ev_ebitda":16.86,"rev_growth":0.1,"eps_growth":0.1735,"eps_growth_fwd":0.09355,"eps_growth_next":0.1223,"div_yield":0,"roe":0.01872,"roa":0.02349,"de":41.94,"gross_margin":0.4961,"op_margin":0.03472,"profit_margin":0,"current_ratio":3.1},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":19.17,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":68.65,"sector":30.5,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":2.777,"sector":4.503,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":21.66,"sector":28.94,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.71,"sector":1.34,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":6.197,"sector":4.598,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":217.8,"sector":41.94,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.008,"sector":0.1,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.1735,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":null,"sector":0.09355,"verdict":"—"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.465,"sector":0.1223,"verdict":"Strong"},{"k":"gross_margin","label":"Gross marg