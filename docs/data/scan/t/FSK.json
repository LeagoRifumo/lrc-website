 negotiated over- the- counter market. For any investments that are not able to be sold within the secondary market, the firm seeks to exit such investments through repayment, an initial public offering of equity securities, merger, sale or recapitalization.","employees":null,"website":"https://www.fskkrcapitalcorp.com","country":"United States","city":"Philadelphia","officers":[{"name":"Mr. Michael  Forman","title":"Chairman & CEO"},{"name":"Mr. Daniel Ryan Pietrzak","title":"President, Chief Investment Officer & Director"},{"name":"Mr. Steven C. Lilly","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":10.51,"tpe":12.61,"ps":3.433,"pfcf":11.7,"peg":1.31,"pb":1.596,"ev_ebitda":10.74,"rev_growth":0.106,"eps_growth":0.16,"eps_growth_fwd":0.1329,"eps_growth_next":0.1099,"div_yield":0.02175,"roe":0.1268,"roa":0.01564,"de":54.45,"gross_margin":0.2391,"op_margin":0.3554,"profit_margin":0.2541,"current_ratio":1.509},"valuation":[{"k":"fpe","label":"Forward P/E","v":7.143,"sector":10.51,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":12.61,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":2.252,"sector":3.433,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":9.37,"sector":11.7,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":3.27,"sector":1.31,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":0.5856,"sector":1.596,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":122.8,"sector":54.45,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.271,"sector":0.106,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.16,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.3051,"sector":0.1329,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":-0.0762,"sector":0.1099,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":1.0,"sector":0.2391,"verdict":"Strong"},{"