 with Alnylam Pharmaceuticals, Inc. to develop, manufacture, and commercialize Leqvio (inclisiran) to reduce LDL cholesterol. Novartis AG has a strategic alliance with CAS for enhancing reaction data accessibility and supporting AI-enabled research. Novartis AG was incorporated in 1996 and is headquartered in Basel, Switzerland.","employees":75267,"website":"https://www.novartis.com","country":"Switzerland","city":"Basel","officers":[{"name":"Dr. Vasant  Narasimhan M.D.","title":"Chief Executive Officer"},{"name":"Mr. Victor  Bulto","title":"President of US"},{"name":"Dr. Patrick  Horber M.D.","title":"President of International"}]},"sector_medians":{"fpe":18.89,"tpe":30.04,"ps":4.318,"pfcf":28.14,"peg":1.36,"pb":4.619,"ev_ebitda":16.75,"rev_growth":0.1,"eps_growth":0.167,"eps_growth_fwd":0.0928,"eps_growth_next":0.1205,"div_yield":0,"roe":0.01454,"roa":0.02187,"de":41.94,"gross_margin":0.4983,"op_margin":0.04015,"profit_margin":0,"current_ratio":3.084},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.74,"sector":18.89,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":29.76,"sector":30.04,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":5.136,"sector":4.318,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":67.54,"sector":28.14,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":3.6,"sector":1.36,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":7.946,"sector":4.619,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":128.6,"sector":41.94,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.047,"sector":0.1,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.688,"sector":0.167,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0213,"sector":0.0928,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.072,"sector":0.1205,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.7