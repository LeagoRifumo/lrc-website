rts and transit terminals, as well as multi-family residential buildings. The company markets its architectural products and services through direct sales force, independent sales representatives, and distributors, and glazing subcontractors and general contractors; and retail chains. The company was incorporated in 1949 and is based in Minneapolis, Minnesota.","employees":4100,"website":"https://www.apog.com","country":"United States","city":"Minneapolis","officers":[{"name":"Mr. Donald A. Nolan","title":"CEO & Executive Chairman of the Board"},{"name":"Mr. Mark Richard Augdahl","title":"CFO & Executive VP"},{"name":"Mr. Troy R. Johnson","title":"President of the Architectural Metals Segment"}]},"sector_medians":{"fpe":17.91,"tpe":25.6,"ps":2.127,"pfcf":27.13,"peg":1.41,"pb":3.619,"ev_ebitda":14.59,"rev_growth":0.119,"eps_growth":0.176,"eps_growth_fwd":0.1619,"eps_growth_next":0.1433,"div_yield":0.0071,"roe":0.1451,"roa":0.05694,"de":67.22,"gross_margin":0.3203,"op_margin":0.1163,"profit_margin":0.07298,"current_ratio":1.741},"valuation":[{"k":"fpe","label":"Forward P/E","v":11.92,"sector":17.91,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":14.9,"sector":25.6,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.6837,"sector":2.127,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":14.01,"sector":27.13,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.01,"sector":1.41,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.873,"sector":3.619,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":73.23,"sector":67.22,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.092,"sector":0.119,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.027,"sector":0.176,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0331,"sector":0.1619,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1773,"sector