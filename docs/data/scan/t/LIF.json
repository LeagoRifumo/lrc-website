lers. Life360, Inc. was formerly known as LReady, Inc. and changed its name to Life360, Inc. in October 2011. The company was incorporated in 2007 and is based in San Mateo, California.","employees":547,"website":"https://intl.life360.com","country":"United States","city":"San Mateo","officers":[{"name":"Mr. Christopher  Hulls","title":"Co-Founder & Executive Chairman"},{"name":"Ms. Lauren  Antonoff","title":"CEO & Director"},{"name":"Mr. Alexander  Haro","title":"Co-founder & Non-Executive Director"}]},"sector_medians":{"fpe":17.73,"tpe":31.01,"ps":4.582,"pfcf":26.55,"peg":1.16,"pb":4.831,"ev_ebitda":19.21,"rev_growth":0.1835,"eps_growth":0.3615,"eps_growth_fwd":0.2307,"eps_growth_next":0.1906,"div_yield":0,"roe":0.1245,"roa":0.04768,"de":32.58,"gross_margin":0.5372,"op_margin":0.1249,"profit_margin":0.09218,"current_ratio":1.81},"valuation":[{"k":"fpe","label":"Forward P/E","v":25.06,"sector":17.73,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":26.01,"sector":31.01,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":6.379,"sector":4.582,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":48.89,"sector":26.55,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":null,"sector":1.16,"verdict":"—"},{"k":"pb","label":"Price / Book","v":5.928,"sector":4.831,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":50.8,"sector":32.58,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.378,"sector":0.1835,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.251,"sector":0.3615,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2379,"sector":0.2307,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.3021,"sector":0.1906,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.7759,"sector":0.5372,"verdict":"Strong"},{"k":"op_margin","label":"Operating margin","v":-0.00036,"sector":0.1249,"verdict":"W