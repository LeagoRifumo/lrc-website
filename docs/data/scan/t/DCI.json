rial processes; bioprocessing equipment that includes bioreactors and fermenters; and bioprocessing consumables, such as chromatography devices, reagents and filters, and polytetrafluoroethylene membrane-based products, as well as specialized air and gas filtration systems for applications, including hard disk drives, semi-conductor manufacturing and sensors, battery systems, and powertrain components to OEMs and various end-users. The company was founded in 1915 and is headquartered in Bloomington, Minnesota.","employees":15500,"website":"https://www.donaldson.com","country":"United States","city":"Bloomington","officers":[{"name":"Mr. Tod E. Carpenter","title":"Executive Chairman"},{"name":"Mr. Richard B. Lewis","title":"President, CEO & Director"},{"name":"Mr. Bradley J. Pogalz","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":17.94,"tpe":26.67,"ps":2.183,"pfcf":27.09,"peg":1.39,"pb":3.569,"ev_ebitda":15.27,"rev_growth":0.1115,"eps_growth":0.205,"eps_growth_fwd":0.156,"eps_growth_next":0.1459,"div_yield":0.0067,"roe":0.1485,"roa":0.05825,"de":66.55,"gross_margin":0.3184,"op_margin":0.1215,"profit_margin":0.07337,"current_ratio":1.672},"valuation":[{"k":"fpe","label":"Forward P/E","v":17.59,"sector":17.94,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":22.19,"sector":26.67,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":2.545,"sector":2.183,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":30.72,"sector":27.09,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":1.57,"sector":1.39,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":5.613,"sector":3.569,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":78.37,"sector":66.55,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.08,"sector":0.1115,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.14,"sector":0.205,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est