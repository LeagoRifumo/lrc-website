 Holdings Corp. and changed its name to Acushnet Holdings Corp. in March 2016. The company was founded in 1910 and is headquartered in Fairhaven, Massachusetts. Acushnet Holdings Corp. operates as a subsidiary of Misto Holdings Corp.","employees":7300,"website":"https://www.acushnetholdingscorp.com","country":"United States","city":"Fairhaven","officers":[{"name":"Mr. David E. Maher","title":"President, CEO & Director"},{"name":"Mr. Sean S. Sullivan","title":"Executive VP & CFO"},{"name":"Ms. Mary Louise Bohn","title":"President of Titleist Golf Balls"}]},"sector_medians":{"fpe":14.69,"tpe":19.16,"ps":1.227,"pfcf":19.36,"peg":1.18,"pb":2.919,"ev_ebitda":11.91,"rev_growth":0.055,"eps_growth":0.149,"eps_growth_fwd":0.1026,"eps_growth_next":0.1198,"div_yield":0.0074,"roe":0.1516,"roa":0.06133,"de":102.4,"gross_margin":0.3788,"op_margin":0.0968,"profit_margin":0.0578,"current_ratio":1.418},"valuation":[{"k":"fpe","label":"Forward P/E","v":19.64,"sector":14.69,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":22.0,"sector":19.16,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.733,"sector":1.227,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":20.79,"sector":19.36,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":3.61,"sector":1.18,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":5.397,"sector":2.919,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":101.6,"sector":102.4,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":-0.013,"sector":0.055,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.025,"sector":0.149,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2608,"sector":0.1026,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0073,"sector":0.1198,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.4775,"sector":0.3788,"verdict":"Strong"},{"k":"op_margin","label":"Ope