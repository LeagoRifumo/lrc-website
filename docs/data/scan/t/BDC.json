 Inc. was founded in 1902 and is headquartered in Saint Louis, Missouri.","employees":8000,"website":"https://www.belden.com","country":"United States","city":"Saint Louis","officers":[{"name":"Dr. Ashish  Chand","title":"President, CEO & Director"},{"name":"Mr. Jeremy E. Parks","title":"Executive VP & CFO"},{"name":"Mr. Brian Edward Anderson J.D.","title":"Executive VP and Chief Legal & Risk Officer"}]},"sector_medians":{"fpe":16.74,"tpe":28.56,"ps":4.285,"pfcf":24.55,"peg":1.15,"pb":4.492,"ev_ebitda":18.29,"rev_growth":0.183,"eps_growth":0.344,"eps_growth_fwd":0.2366,"eps_growth_next":0.1841,"div_yield":0,"roe":0.1251,"roa":0.04865,"de":32.8,"gross_margin":0.5312,"op_margin":0.1357,"profit_margin":0.09441,"current_ratio":1.879},"valuation":[{"k":"fpe","label":"Forward P/E","v":9.826,"sector":16.74,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":22.14,"sector":28.56,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.23,"sector":4.285,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":67.91,"sector":24.55,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.05,"sector":1.15,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":2.768,"sector":4.492,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":229.4,"sector":32.8,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.383,"sector":0.183,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.344,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1488,"sector":0.2366,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1575,"sector":0.1841,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0.3628,"sector":0.5312,"verdict":"Weak"},{"k":"op_margin","label":"Operating margin","v":0.01239,"sector":0.1357,"verdict":"Weak"},{"k":"profit_margin","label":"Net margin","v":0.05622,"sector":0.09441,"verdict":"Weak"},{"k":"roe",