nd EcoLogic brands; household pest control solutions under the Hot Shot and Black Flag brands; household surface cleaning, maintenance, and restoration products, including bottled liquids, mops, wipes, and markers under the Rejuvenate brand; and personal-use pesticides and insect repellent products under the Cutter and Repel brands. It sells its products through retailers, e-commerce and online retailers, wholesalers, and distributors. Spectrum Brands Holdings, Inc. was founded in 1906 and is based in Middleton, Wisconsin.","employees":null,"website":"https://www.spectrumbrands.com","country":"United States","city":"Middleton","officers":[{"name":"Mr. David M. Maura C.F.A.","title":"Executive Chairman & CEO"},{"name":"Mr. Faisal  Qadir","title":"Executive VP & CFO"},{"name":"Mr. Ehsan  Zargar","title":"Executive VP, General Counsel & Corporate Secretary"}]},"sector_medians":{"fpe":15.08,"tpe":20.29,"ps":1.19,"pfcf":19.19,"peg":1.65,"pb":2.571,"ev_ebitda":10.94,"rev_growth":0.037,"eps_growth":0.133,"eps_growth_fwd":0.06595,"eps_growth_next":0.07315,"div_yield":0.01995,"roe":0.1239,"roa":0.05641,"de":80.72,"gross_margin":0.3532,"op_margin":0.1108,"profit_margin":0.04107,"current_ratio":1.299},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.08,"sector":15.08,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":26.62,"sector":20.29,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":0.7082,"sector":1.19,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":31.46,"sector":19.19,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.36,"sector":1.65,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":1.08,"sector":2.571,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":38.71,"sector":80.72,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.028,"sector":0.037,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.513,"sector":0.133,"verdict":"Weak"},{"k":"eps_growth_fw