desk services and on-site product support; and warranties, maintenance, and technical support services. The company serves enterprise data centers, cloud computing, artificial intelligence, 5G, and edge computing markets through direct and indirect sales force, distributors, value-added resellers, system integrators, and original equipment manufacturers. Super Micro Computer, Inc. has a strategic alliance with NetApp, Inc. Super Micro Computer, Inc. was incorporated in 1993 and is headquartered in San Jose, California.","employees":7000,"website":"https://www.supermicro.com","country":"United States","city":"San Jose","officers":[{"name":"Mr. Charles  Liang","title":"Founder, Chairman of the Board, President & CEO"},{"name":"Ms. Chiu-Chu  Liu Liang","title":"Co-Founder, Senior VP & Director"}]},"sector_medians":{"fpe":18.12,"tpe":31.43,"ps":4.812,"pfcf":27.73,"peg":1.145,"pb":5.056,"ev_ebitda":19.99,"rev_growth":0.177,"eps_growth":0.339,"eps_growth_fwd":0.2264,"eps_growth_next":0.1929,"div_yield":0,"roe":0.1195,"roa":0.04674,"de":32.62,"gross_margin":0.5331,"op_margin":0.1128,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":6.162,"sector":18.12,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":10.56,"sector":31.43,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.5702,"sector":4.812,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":27.73,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":0.91,"sector":1.145,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":2.206,"sector":5.056,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":63.95,"sector":32.62,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.932,"sector":0.177,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":4.347,"sector":0.339,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.286,"sector":0.2264,