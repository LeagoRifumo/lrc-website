ded in 1967 and is based in New York, New York.","employees":15600,"website":"https://www.ralphlauren.com","country":"United States","city":"New York","officers":[{"name":"Mr. Ralph  Lauren","title":"Executive Chairman & Chief Creative Officer"},{"name":"Mr. Patrice Jean Louis Louvet","title":"President, CEO & Director"},{"name":"Mr. David  Lauren","title":"Vice Chairman, Chief Branding & Innovation Officer and Strategic Advisor to the CEO"}]},"sector_medians":{"fpe":16.64,"tpe":20.04,"ps":2.019,"pfcf":27.42,"peg":1.45,"pb":6.177,"rev_growth":0.0595,"eps_growth":0.108,"eps_growth_fwd":0.07215,"eps_growth_next":0.1048,"div_yield":0.0121,"roe":0.3103,"roa":0.08394,"de":110.6,"gross_margin":0.4278,"op_margin":0.1364,"profit_margin":0.09534,"current_ratio":1.117},"valuation":[{"k":"fpe","label":"Forward P/E","v":18.52,"sector":16.64,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":24.31,"sector":20.04,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":2.751,"sector":2.019,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":26.12,"sector":27.42,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":2.03,"sector":1.45,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":8.448,"sector":6.177,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":110.4,"sector":110.6,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.14,"sector":0.0595,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.216,"sector":0.108,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1366,"sector":0.07215,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1047,"sector":0.1048,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0.7027,"sector":0.4278,"verdict":"Strong"},{"k":"op_margin","label":"Operating margin","v":0.184,"sector":0.1364,"verdict":"Strong"},{"k":"profit_margin","label":"Net margin","v":0.1176,"sec