ed its name to Nicolet Bankshares, Inc. in March 2002. The company was incorporated in 2000 and is headquartered in Green Bay, Wisconsin.","employees":1482,"website":"https://www.nicoletbank.com","country":"United States","city":"Green Bay","officers":[{"name":"Mr. Michael E. Daniels","title":"Co-Founder, President, CEO, Chairman & Director"},{"name":"Mr. Robert B. Atwell","title":"Co-Founder"},{"name":"Mr. H. Phillip Moore Jr.","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":10.71,"tpe":12.49,"ps":3.468,"pfcf":11.56,"peg":1.32,"pb":1.592,"ev_ebitda":11.19,"rev_growth":0.088,"eps_growth":0.1125,"eps_growth_fwd":0.1351,"eps_growth_next":0.1037,"div_yield":0.0219,"roe":0.1287,"roa":0.01557,"de":54.09,"gross_margin":0.2344,"op_margin":0.3491,"profit_margin":0.2565,"current_ratio":1.523},"valuation":[{"k":"fpe","label":"Forward P/E","v":12.76,"sector":10.71,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":18.91,"sector":12.49,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":6.235,"sector":3.468,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":11.56,"verdict":"—"},{"k":"peg","label":"PEG","v":1.92,"sector":1.32,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.618,"sector":1.592,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":54.09,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.692,"sector":0.088,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.084,"sector":0.1125,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2403,"sector":0.1351,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1205,"sector":0.1037,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0,"sector":0.2344,"verdict":"Weak"},{"k":"op_margin","label":"Operating margin","v":0.5273,"sector":0.3491,"verdict":"Strong"},{"k":"profit_margin","label":"Net margin","v":0