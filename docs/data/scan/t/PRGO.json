ise chains; e-commerce stores; wholesalers; pharmacies; drug and grocery retailers; and para-pharmacies. The company was formerly known as Perrigo Company and changed its name to Perrigo Company plc in December 2013. Perrigo Company plc was founded in 1887 and is headquartered in Dublin, Ireland.","employees":8100,"website":"https://www.perrigo.com","country":"Ireland","city":"Dublin","officers":[{"name":"Mr. Albert Ange Manzone","title":"Interim President, Interim CEO & Director"},{"name":"Mr. Eduardo Guarita Bezerra","title":"Executive VP & CFO"},{"name":"Ms. Abbie  Lennox","title":"EVP & Chief Scientific Officer"}]},"sector_medians":{"fpe":19.05,"tpe":29.65,"ps":4.221,"pfcf":27.54,"peg":1.36,"pb":4.417,"ev_ebitda":16.86,"rev_growth":0.098,"eps_growth":0.154,"eps_growth_fwd":0.09245,"eps_growth_next":0.1086,"div_yield":0,"roe":0.02656,"roa":0.02401,"de":42.77,"gross_margin":0.515,"op_margin":0.04562,"profit_margin":0,"current_ratio":2.993},"valuation":[{"k":"fpe","label":"Forward P/E","v":7.089,"sector":19.05,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":29.65,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":0.5518,"sector":4.221,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":3.12,"sector":27.54,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.14,"sector":1.36,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":0.9248,"sector":4.417,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":141.9,"sector":42.77,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.052,"sector":0.098,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.154,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.1441,"sector":0.09245,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":-0.0247,"sector":0.1086,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.3264,"sector"