hold":0,"sell":0,"strongSell":0},"analyst_actions":[{"date":"2026-10-29","firm":"Wedbush","action":"main","from":"Outperform","to":"Outperform"},{"date":"2026-10-27","firm":"DA Davidson","action":"main","from":"Buy","to":"Buy"},{"date":"2026-10-15","firm":"Wedbush","action":"reit","from":"Outperform","to":"Outperform"}]},"profile":{"sector":"Technology","industry":"Software - Application","summary":"Diebold Nixdorf, Incorporated engages in the automating, digitizing, and transforming the way people bank and shop worldwide. It operates through two segments, Banking and Retail. The company offers automated teller machines, cash recyclers, dispensers, teller automation tools, and kiosk technologies. The Banking segment manufactures and sells branch automation solutions, including DN Series recyclers, ATMs, cash recycling technology, and the DN Teller Cash Recycler and Dual Tower Recycler, as well as provides multi-vendor service capabilities and DN Vynamic software for enhanced connectivity and analytics. It offers professional services such as systems integration, customization, project management, and consulting for integrated solutions. The Retail segment offers modular and integrated electronic point-of-sale (EPOS) systems, self-checkout solutions like DN Series EASY ONE and EASY MAX Kiosk, BEETLE POS systems, and a broad range of peripherals, including printers, scales, and mobile scanners. It also provides the DN Vynamic Retail Platform, which includes industry-specific solutions for fuel, convenience, specialty, fashion, and grocery; and platforms for digital receipts, rewards, data analysis, and compliance, as well as offers maintenance, support, global integration, remote device monitoring, and advisory services utilizing AI for predictive diagnostics and operational efficiencies. In addition, the company provides integrated core operations supporting security and efficient cash management, with offerings including installation, maintenance, managed services, automation, and data intelligence via the Allconnect data engine. The company was formerly known as Diebold, Incorporated and changed its name to Diebold Nixdorf, Incorporated in December 2016. Diebold Nixdorf, Incorporated was founded in 1859 and is headquartered in North Canton, Ohio.","employees":20000,"website":"https://www.dieboldnixdorf.com","country":"United States","city":"North Canton","officers":[{"name":"Mr. Octavio  Marquez","title":"President, CEO & Director"},{"name":"Mr. Thomas S. Timko","title":"Executive VP & CFO"},{"name":"Mr. Frank T. Baur","title":"Executive VP & COO"}]},"sector_medians":{"fpe":17.73,"tpe":31.01,"ps":4.582,"pfcf":26.55,"peg":1.16,"pb":4.831,"ev_ebitda":19.21,"rev_growth":0.1835,"eps_growth":0.3615,"eps_growth_fwd":0.2307,"eps_growth_next":0.1906,"div_yield":0,"roe":0.1245,"roa":0.04768,"de":32.58,"gross_margin":0.5372,"op_margin":0.1249,"profit_margin":0.09218,"current_ratio":1.81},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":17.73,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":25.5,"sector":31.01,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":0.4609,"sector":4.582,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":7.379,"sector":26.55,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":null,"sector":1.16,"verdict":"—"},{"k":"pb","label":"Price / Book","v":1.93,"sector":4.831,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":119.2,"sector":32.58,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.052,"sector":0.1835,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.829,"sector":0.3615,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.136,"sector":0.2307,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.3065,"sector":0.1906,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.2602,"sector":0.5372,"verdict":"Weak"},{"k":"op_margi