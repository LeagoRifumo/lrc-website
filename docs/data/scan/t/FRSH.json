des a unified employee service experience while ensuring the secure separation of departmental data; Device42 which provides IT discovery and dependency mapping solutions; and FireHydrant, a modern incident management platform that enables engineering and operations teams to manage the full incident lifecycle. In addition, it provides Freshworks platform, an AI-powered, enterprise-grade foundation that unifies customer experience and employee experience product lines. The company was formerly known as Freshdesk Inc. and changed its name to Freshworks Inc. in June 2017. Freshworks Inc. was incorporated in 2010 and is headquartered in San Mateo, California.","employees":4500,"website":"https://www.freshworks.com","country":"United States","city":"San Mateo","officers":[{"name":"Mr. Dennis M. Woodside J.D.","title":"CEO, President & Director"},{"name":"Mr. Tyler R. Sloat CPA","title":"CFO & COO"},{"name":"Ms. Philippa  Lawrence","title":"Chief Accounting Officer"}]},"sector_medians":{"fpe":16.54,"tpe":28.87,"ps":4.416,"pfcf":25.38,"peg":1.14,"pb":4.371,"ev_ebitda":17.83,"rev_growth":0.179,"eps_growth":0.3785,"eps_growth_fwd":0.2364,"eps_growth_next":0.1867,"div_yield":0,"roe":0.1242,"roa":0.0481,"de":31.49,"gross_margin":0.5305,"op_margin":0.1226,"profit_margin":0.09004,"current_ratio":1.835},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.87,"sector":16.54,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":18.34,"sector":28.87,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":3.691,"sector":4.416,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":13.5,"sector":25.38,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.57,"sector":1.14,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":3.763,"sector":4.371,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":3.541,"sector":31.49,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.141,"sector":0.179,"verdict":"In line"},{"k":"eps_g