a.com","country":"United States","city":"San Jose","officers":[{"name":"Mr. Jure  Sola","title":"Co-Founder, Executive Chairman & CEO"},{"name":"Mr. Jonathan P. Faust","title":"Executive VP & CFO"},{"name":"Mr. Charles Cudworth Mason Jr.","title":"Executive Vice President of Worldwide Sales"}]},"sector_medians":{"fpe":18.28,"tpe":32.14,"ps":4.713,"pfcf":27.99,"peg":1.155,"pb":4.963,"ev_ebitda":20.13,"rev_growth":0.169,"eps_growth":0.352,"eps_growth_fwd":0.2214,"eps_growth_next":0.1917,"div_yield":0,"roe":0.1232,"roa":0.04714,"de":32.58,"gross_margin":0.5282,"op_margin":0.1189,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":12.04,"sector":18.28,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":30.32,"sector":32.14,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":0.7118,"sector":4.713,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":27.99,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":0.55,"sector":1.155,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":3.549,"sector":4.963,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":88.16,"sector":32.58,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.697,"sector":0.169,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.683,"sector":0.352,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":1.004,"sector":0.2214,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1629,"sector":0.1917,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0.09015,"sector":0.5282,"verdict":"Weak"},{"k":"op_margin","label":"Operating margin","v":0.0704,"sector":0.1189,"verdict":"Weak"},{"k":"profit_margin","label":"Net margin","v":0.02414,"sector":0.08604,"verdict":"Weak"},{"k":"roe","label":"Return on equity","v":0.1249,"sector":0.1232,"verdict":"In line"},{"k":"roa","label":"Retur