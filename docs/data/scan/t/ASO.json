twear, and socks; work and western boots, shoes, and hunting footwear; boys and girls footwear; athletic footwear, such as running shoes, athletic lifestyle, and training shoes; and team and specialty sports footwear, and slides. The company sells its products under the Academy Sports + Outdoors, Magellan Outdoors, BCG, O'rageous, Game Winner, Outdoor Gourmet, Freely, R.O.W., Redfield, and H2OX brand names. Academy Sports and Outdoors, Inc. was founded in 1938 and is headquartered in Katy, Texas.","employees":22000,"website":"https://www.academy.com","country":"United States","city":"Katy","officers":[{"name":"Mr. Steven Paul Lawrence","title":"CEO & Director"},{"name":"Mr. Samuel J. Johnson","title":"President"},{"name":"Mr. Earl Carlton Ford IV","title":"Executive VP & CFO"}]},"sector_medians":{"fpe":14.23,"tpe":18.92,"ps":1.213,"pfcf":19.95,"peg":1.125,"pb":2.874,"ev_ebitda":11.6,"rev_growth":0.058,"eps_growth":0.167,"eps_growth_fwd":0.1068,"eps_growth_next":0.1284,"div_yield":0.0077,"roe":0.1518,"roa":0.06079,"de":109.9,"gross_margin":0.3789,"op_margin":0.09691,"profit_margin":0.05663,"current_ratio":1.447},"valuation":[{"k":"fpe","label":"Forward P/E","v":8.31,"sector":14.23,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":9.87,"sector":18.92,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.5853,"sector":1.213,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":21.36,"sector":19.95,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":0.6,"sector":1.125,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.676,"sector":2.874,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":90.38,"sector":109.9,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.03,"sector":0.058,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.173,"sector":0.167,"verdict":"In line"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1513,"sector":0.1068,"verdict":"St