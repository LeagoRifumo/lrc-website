ers locum tenens staffing, healthcare interim leadership staffing, executive search, and physician permanent placement solutions. Additionally, the company provides language services, vendor management systems, workforce optimization, and outsourced solutions. The company offers its services under the brands, including AMN Healthcare, Nursefinders, O'Grady Peyton International, Connetics, Medical Search International, DRW Healthcare Staffing, and B.E. Smith. AMN Healthcare Services, Inc. was founded in 1985 and is based in Dallas, Texas.","employees":2664,"website":"https://www.amnhealthcare.com","country":"United States","city":"Dallas","officers":[{"name":"Ms. Caroline Sullivan Grace","title":"President, CEO & Director"},{"name":"Mr. Brian M. Scott","title":"CFO & COO"},{"name":"Mr. Mark Christopher Hagan","title":"Chief Information & Digital Officer"}]},"sector_medians":{"fpe":18.87,"tpe":29.74,"ps":4.212,"pfcf":27.71,"peg":1.36,"pb":4.459,"ev_ebitda":16.89,"rev_growth":0.098,"eps_growth":0.154,"eps_growth_fwd":0.09245,"eps_growth_next":0.1098,"div_yield":0,"roe":0.02656,"roa":0.02401,"de":42.77,"gross_margin":0.515,"op_margin":0.04562,"profit_margin":0,"current_ratio":2.993},"valuation":[{"k":"fpe","label":"Forward P/E","v":39.79,"sector":18.87,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":13.66,"sector":29.74,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.4103,"sector":4.212,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":4.25,"sector":27.71,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.22,"sector":1.36,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":1.858,"sector":4.459,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":99.99,"sector":42.77,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.13,"sector":0.098,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.094,"sector":0.154,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"