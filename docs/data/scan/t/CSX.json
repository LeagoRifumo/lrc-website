inals transporting manufactured consumer goods in containers; and drayage services, including the pickup and delivery of intermodal shipments. It serves the automotive industry with distribution centers and storage locations, as well as connects non-rail served customers through transferring products, such as plastics and ethanol from rail to trucks. The company operates approximately 20,000 route mile rail network, which serves various population centers in 26 states east of the Mississippi River, the District of Columbia, and the Canadian provinces of Ontario and Quebec, as well as owns 3400 locomotives. It serves production and distribution facilities through track connections. CSX Corporation was incorporated in 1978 and is headquartered in Jacksonville, Florida.","employees":21900,"website":"https://www.csx.com","country":"United States","city":"Jacksonville","officers":[{"name":"Mr. Stephen F. Angel","title":"CEO, President & Director"},{"name":"Mr. Kevin S. Boone","title":"Executive VP & CFO"},{"name":"Mr. Michael A. Cory","title":"Executive Officer"}]},"sector_medians":{"fpe":20.42,"tpe":26.95,"ps":3.557,"pfcf":30.06,"peg":1.6,"pb":6.392,"ev_ebitda":17.15,"rev_growth":0.112,"eps_growth":0.158,"eps_growth_fwd":0.1329,"eps_growth_next":0.1204,"div_yield":0.01125,"roe":0.2064,"roa":0.07225,"de":74.13,"gross_margin":0.3662,"op_margin":0.1747,"profit_margin":0.1201,"current_ratio":1.339},"valuation":[{"k":"fpe","label":"Forward P/E","v":22.07,"sector":20.42,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":26.95,"sector":26.95,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":6.383,"sector":3.557,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":39.39,"sector":30.06,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.79,"sector":1.6,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":6.63,"sector":6.392,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":135.2,"sector":74.13,"verdict":"High debt