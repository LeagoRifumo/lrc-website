ct sales force, and through a network of distributors and sales representatives. The company was formerly known as Cubiq Microchip, Inc. and changed its name to Ambiq Micro, Inc. in October 2012. The company was incorporated in 2010 and is based in Austin, Texas.","employees":200,"website":"https://ambiq.com","country":"United States","city":"Austin","officers":[{"name":"Mr. Fumihide  Esaka","title":"CEO & Director"},{"name":"Dr. Scott McLean Hanson Ph.D.","title":"Co-Founder, CTO, Secretary & Director"},{"name":"Mr. Jeffrey G. Winzeler","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":16.61,"tpe":28.37,"ps":4.322,"pfcf":24.86,"peg":1.14,"pb":4.298,"ev_ebitda":18.07,"rev_growth":0.179,"eps_growth":0.3785,"eps_growth_fwd":0.2364,"eps_growth_next":0.1867,"div_yield":0,"roe":0.1242,"roa":0.0481,"de":31.49,"gross_margin":0.5305,"op_margin":0.1226,"profit_margin":0.09004,"current_ratio":1.835},"valuation":[{"k":"fpe","label":"Forward P/E","v":-1,"sector":16.61,"verdict":"Loss-making"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":28.37,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":8.683,"sector":4.322,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":24.86,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":null,"sector":1.14,"verdict":"—"},{"k":"pb","label":"Price / Book","v":2.097,"sector":4.298,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":1.133,"sector":31.49,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.897,"sector":0.179,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.3785,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.7948,"sector":0.2364,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.5968,"sector":0.1867,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.4362,"sector":0.5305,"verdict":"In line"},{"k":"op_margin","label":"Oper