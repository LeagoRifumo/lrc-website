ng Construction Company, Inc. and changed its name to Sterling Infrastructure, Inc. in June 2022. Sterling Infrastructure, Inc. was founded in 1955 and is headquartered in The Woodlands, Texas.","employees":6200,"website":"https://www.strlco.com","country":"United States","city":"The Woodlands","officers":[{"name":"Mr. Joseph A. Cutillo","title":"CEO, President & Director"},{"name":"Mr. Nicholas M. Grindstaff","title":"Chief Financial Officer"},{"name":"Mr. Daniel P. Govin","title":"Chief Operating Officer"}]},"sector_medians":{"fpe":17.94,"tpe":26.67,"ps":2.183,"pfcf":27.09,"peg":1.39,"pb":3.569,"ev_ebitda":15.27,"rev_growth":0.1115,"eps_growth":0.205,"eps_growth_fwd":0.156,"eps_growth_next":0.1459,"div_yield":0.0067,"roe":0.1485,"roa":0.05825,"de":66.55,"gross_margin":0.3184,"op_margin":0.1215,"profit_margin":0.07337,"current_ratio":1.672},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.52,"sector":17.94,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":22.49,"sector":26.67,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":3.562,"sector":2.183,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":35.06,"sector":27.09,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":0.45,"sector":1.39,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":11.08,"sector":3.569,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":24.22,"sector":66.55,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.901,"sector":0.1115,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":1.165,"sector":0.205,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.8408,"sector":0.156,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.29,"sector":0.1459,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.2381,"sector":0.3184,"verdict":"Weak"},{"k":"op_margin","label":"Operating margin","v":0.2006,"sector":0.1215