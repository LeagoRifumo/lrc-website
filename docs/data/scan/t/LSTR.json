 electronics, military equipment and general commodities industries. The Insurance segment provides risk and claims management services; and reinsures risks of its independent contractors. The company markets its services through a network of agents, third party capacity providers, and employees. Landstar System, Inc. was founded in 1988 and is headquartered in Jacksonville, Florida.","employees":1300,"website":"https://www.landstar.com","country":"United States","city":"Jacksonville","officers":[{"name":"Mr. Frank A. Lonegro","title":"President, CEO & Director"},{"name":"Mr. James P. Todd","title":"VP, Principal Accounting Officer & CFO"},{"name":"Mr. Matthew  Miller","title":"VP and Chief Safety & Operations Officer"}]},"sector_medians":{"fpe":17.93,"tpe":26.47,"ps":2.216,"pfcf":27.32,"peg":1.4,"pb":3.567,"ev_ebitda":15.2,"rev_growth":0.1115,"eps_growth":0.205,"eps_growth_fwd":0.156,"eps_growth_next":0.1459,"div_yield":0.0067,"roe":0.1485,"roa":0.05825,"de":66.55,"gross_margin":0.3184,"op_margin":0.1215,"profit_margin":0.07337,"current_ratio":1.672},"valuation":[{"k":"fpe","label":"Forward P/E","v":18.83,"sector":17.93,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":29.95,"sector":26.47,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":null,"sector":2.216,"verdict":"—"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":27.32,"verdict":"—"},{"k":"peg","label":"PEG","v":0.75,"sector":1.4,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":5.742,"sector":3.567,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":18.24,"sector":66.55,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.253,"sector":0.1115,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":1.533,"sector":0.205,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.4407,"sector":0.156,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.2945