d-party risk, supplier risk, trade credit, business intelligence sales and marketing, financial and regulatory reporting, balance sheet management, capital management, credit portfolio management, and model risk and governance solutions; Maxsight, a unified risk platform; lending suite, origination, and monitoring solutions; and property, casualty, and sustainable insurance underwriting solutions. The company serves the financial, banking, insurance, corporate, public, and asset management sectors. The company was formerly known as Dun and Bradstreet Company and changed its name to Moody's Corporation in September 2000. Moody's Corporation was founded in 1900 and is headquartered in New York, New York.","employees":15636,"website":"https://www.moodys.com","country":"United States","city":"New York","officers":[{"name":"Mr. Robert Scott Fauber","title":"President, CEO & Director"},{"name":"Ms. Noemie Clemence Heuland CPA","title":"Senior VP & CFO"},{"name":"Mr. Richard  Steele","title":"Senior VP & General Counsel"}]},"sector_medians":{"fpe":12.4,"tpe":14.19,"ps":3.238,"pfcf":18.03,"peg":1.3,"pb":2.369,"rev_growth":0.1,"eps_growth":0.143,"eps_growth_fwd":0.1492,"eps_growth_next":0.102,"div_yield":0.0175,"roe":0.1489,"roa":0.02489,"de":57.54,"gross_margin":0.3787,"op_margin":0.3126,"profit_margin":0.2299,"current_ratio":1.053},"valuation":[{"k":"fpe","label":"Forward P/E","v":25.87,"sector":12.4,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":28.9,"sector":14.19,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":10.2,"sector":3.238,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":32.89,"sector":18.03,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.69,"sector":1.3,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":25.56,"sector":2.369,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":223.3,"sector":57.54,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.008,"sector":0.1,"verdict":"W