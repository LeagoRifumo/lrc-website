education, and testing services, as well distributes software developed by third parties. It has strategic partnerships with dLocal. The company was formerly known as Transaction Systems Architects, Inc. and changed its name to ACI Worldwide, Inc. in July 2007. The company was founded in 1975 and is headquartered in Elkhorn, Nebraska.","employees":2930,"website":"https://www.aciworldwide.com","country":"United States","city":"Elkhorn","officers":[{"name":"Mr. Thomas Woodrow Warsop III","title":"CEO, President & Director"},{"name":"Mr. Robert W. Leibrock","title":"Chief Financial Officer"},{"name":"Mr. J. P. Krishnamoorthy","title":"Chief Innovation & Technology Officer"}]},"sector_medians":{"fpe":16.61,"tpe":28.37,"ps":4.322,"pfcf":24.86,"peg":1.14,"pb":4.298,"ev_ebitda":18.07,"rev_growth":0.179,"eps_growth":0.3785,"eps_growth_fwd":0.2364,"eps_growth_next":0.1867,"div_yield":0,"roe":0.1242,"roa":0.0481,"de":31.49,"gross_margin":0.5305,"op_margin":0.1226,"profit_margin":0.09004,"current_ratio":1.835},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.24,"sector":16.61,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":27.16,"sector":28.37,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":3.302,"sector":4.322,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":23.07,"sector":24.86,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":1.78,"sector":1.14,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":4.026,"sector":4.298,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":57.7,"sector":31.49,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.073,"sector":0.179,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":1.652,"sector":0.3785,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2712,"sector":0.2364,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0848,"sector":0.1867,"verdict"