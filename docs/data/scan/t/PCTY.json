rvices. It serves for-profit and non-profit organizations across industries, including business services, financial services, healthcare, manufacturing, restaurants, retail, technology, and others. The company markets and sells its products through sales representatives. Paylocity Holding Corporation was founded in 1997 and is headquartered in Schaumburg, Illinois.","employees":6900,"website":"https://www.paylocity.com","country":"United States","city":"Schaumburg","officers":[{"name":"Mr. Steven R. Beauchamp","title":"Executive Chairman of the Board"},{"name":"Mr. Toby J. Williams J.D.","title":"President, CEO & Director"},{"name":"Mr. Steven I. Sarowitz","title":"Founder & Director"}]},"sector_medians":{"fpe":18.05,"tpe":31.76,"ps":4.69,"pfcf":27.56,"peg":1.155,"pb":4.957,"ev_ebitda":20.23,"rev_growth":0.169,"eps_growth":0.352,"eps_growth_fwd":0.2214,"eps_growth_next":0.1917,"div_yield":0,"roe":0.1232,"roa":0.04714,"de":32.58,"gross_margin":0.5282,"op_margin":0.1189,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":17.28,"sector":18.05,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":34.01,"sector":31.76,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":4.924,"sector":4.69,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":24.24,"sector":27.56,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":1.43,"sector":1.155,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":7.292,"sector":4.957,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":10.89,"sector":32.58,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.11,"sector":0.169,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.276,"sector":0.352,"verdict":"In line"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0499,"sector":0.2214,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1097,"sector":0.1