nd proprietary manufacturing execution system software. The company serves general fabrication, oil and gas, power generation, process, automotive and transportation, and construction and infrastructure industries, as well as heavy fabrication, ship building, and maintenance and repair markets. It sells its products directly to users of welding products, including OEMs, manufacturers, and integrators, as well as through industrial distributors, retailers, and agents. Lincoln Electric Holdings, Inc. was founded in 1895 and is headquartered in Cleveland, Ohio.","employees":12000,"website":"https://www.lincolnelectric.com","country":"United States","city":"Cleveland","officers":[{"name":"Mr. Steven B. Hedlund","title":"President, CEO & Chairman"},{"name":"Mr. Gabriel  Bruno","title":"Executive VP, CFO & Treasurer"},{"name":"Ms. Jennifer I. Ansberry J.D.","title":"Executive VP, General Counsel & Secretary"}]},"sector_medians":{"fpe":17.66,"tpe":25.85,"ps":2.151,"pfcf":27.25,"peg":1.43,"pb":3.602,"ev_ebitda":14.62,"rev_growth":0.118,"eps_growth":0.1755,"eps_growth_fwd":0.156,"eps_growth_next":0.1428,"div_yield":0.0067,"roe":0.1475,"roa":0.05825,"de":67.05,"gross_margin":0.319,"op_margin":0.1262,"profit_margin":0.07405,"current_ratio":1.668},"valuation":[{"k":"fpe","label":"Forward P/E","v":21.59,"sector":17.66,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":26.55,"sector":25.85,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":3.231,"sector":2.151,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":37.53,"sector":27.25,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.5,"sector":1.43,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":9.646,"sector":3.602,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":77.7,"sector":67.05,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.151,"sector":0.118,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.19,"sector"