ger, as well as surgical productivity tools. It also manufactures and distributes a range of products which are used for reconstructive surgery, rehabilitation, pain management, and physical therapy. The company distributes its products through independent distributors, direct salespeople, and patients. The company was formerly known as Colfax Corporation. Enovis Corporation was founded in 1995 and is headquartered in Lewisville, Texas.","employees":7802,"website":"https://www.enovis.com","country":"United States","city":"Lewisville","officers":[{"name":"Mr. Damien  McDonald","title":"CEO & Director"},{"name":"Mr. Phillip Benjamin Berry","title":"Senior VP & CFO"},{"name":"Ms. Patricia A. Lang","title":"Advisor"}]},"sector_medians":{"fpe":19.11,"tpe":30.68,"ps":4.027,"pfcf":28.23,"peg":1.37,"pb":4.662,"ev_ebitda":16.89,"rev_growth":0.093,"eps_growth":0.155,"eps_growth_fwd":0.0901,"eps_growth_next":0.1182,"div_yield":0,"roe":0.02944,"roa":0.02544,"de":43.27,"gross_margin":0.5196,"op_margin":0.05279,"profit_margin":0,"current_ratio":2.981},"valuation":[{"k":"fpe","label":"Forward P/E","v":7.738,"sector":19.11,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":30.68,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":0.6889,"sector":4.027,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":9.161,"sector":28.23,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":3.45,"sector":1.37,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.064,"sector":4.662,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":88.14,"sector":43.27,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.018,"sector":0.093,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.155,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0992,"sector":0.0901,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":-0.0231,"