gs and metals; expansion joints and joint seals; fire and smoke curtains, and fire stopping solutions; perimeter protection; and pre-engineered and custom architectural building components under the Balco, BlazeSeal, Duraspan, Greco, IllumiTread, Jointspan, Metacaulk, Metablock, Metaflex, Quakespan, and Smoke Guard brands. The Specialized Reliability Solutions segment provides compounds, lubricants, and sealants; industrial maintenance and repair, anti-seize, contamination control, and desiccant breather filtration; lubricant management systems; operation solutions; andrail applicators, and friction modifiers under the AccuTrack, OilSafe, Air Sentry, BioRail, Deacon, Envirolube, Extreme, Gearmate, Hydrotex, Jet-Lube, Kopr-Kote, Matrix, and Whitmore brands. The company was incorporated in 2014 and is based in Dallas, Texas.","employees":2700,"website":"https://www.csw.com","country":"United States","city":"Dallas","officers":[{"name":"Mr. Joseph Brooks Armes J.D.","title":"Chairman, President & CEO"},{"name":"Mr. James E. Perry","title":"Executive VP & CFO"},{"name":"Mr. Luke E. Alverson J.D.","title":"Senior VP, General Counsel & Secretary"}]},"sector_medians":{"fpe":18.05,"tpe":25.66,"ps":2.126,"pfcf":27.21,"peg":1.42,"pb":3.602,"ev_ebitda":14.56,"rev_growth":0.119,"eps_growth":0.1745,"eps_growth_fwd":0.156,"eps_growth_next":0.1437,"div_yield":0.007,"roe":0.1435,"roa":0.05694,"de":67.83,"gross_margin":0.319,"op_margin":0.1176,"profit_margin":0.0714,"current_ratio":1.724},"valuation":[{"k":"fpe","label":"Forward P/E","v":20.64,"sector":18.05,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":36.04,"sector":25.66,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":3.646,"sector":2.126,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":43.03,"sector":27.21,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":2.53,"sector":1.42,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":4.089,"sector":3.602,"verdict":"Fairly valued"},{"k"