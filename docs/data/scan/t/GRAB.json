quiring service; Digibank Savings Account, a digital banking deposit account. Additionally, the company offers GX Bank debit cards; GXS FlexiCard, a fee-based credit card; and mapping services, autonomous vehicle services, and last-mile delivery infrastructure. Grab Holdings Limited was founded in 2012 and is headquartered in Singapore, Singapore.","employees":12012,"website":"https://www.grab.com/sg","country":"Singapore","city":"Singapore","officers":[{"name":"Mr. Ping Yeow  Tan","title":"Co-Founder, Chairman & CEO"},{"name":"Mr. Alexander Charles  Hungate","title":"President, COO & Director"},{"name":"Mr. Peter  Oey","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":17.85,"tpe":31.02,"ps":4.569,"pfcf":26.24,"peg":1.16,"pb":4.856,"ev_ebitda":19.25,"rev_growth":0.1835,"eps_growth":0.3615,"eps_growth_fwd":0.2338,"eps_growth_next":0.1906,"div_yield":0,"roe":0.1245,"roa":0.04768,"de":32.58,"gross_margin":0.5372,"op_margin":0.1249,"profit_margin":0.09218,"current_ratio":1.81},"valuation":[{"k":"fpe","label":"Forward P/E","v":19.61,"sector":17.85,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":24.64,"sector":31.02,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":2.972,"sector":4.569,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":22.06,"sector":26.24,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":0.58,"sector":1.16,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.634,"sector":4.856,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":28.22,"sector":32.58,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.219,"sector":0.1835,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.3615,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":1.002,"sector":0.2338,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0029,"sector":0.1906,"verdict":"Weak"},{"k":"gross_mar