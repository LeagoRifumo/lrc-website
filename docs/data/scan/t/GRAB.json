nd acquiring service; Digibank Savings Account, a digital banking deposit account. Additionally, the company offers GX Bank debit cards; GXS FlexiCard, a fee-based credit card; and mapping services, autonomous vehicle services, and last-mile delivery infrastructure. Grab Holdings Limited was founded in 2012 and is headquartered in Singapore, Singapore.","employees":12012,"website":"https://www.grab.com/sg","country":"Singapore","city":"Singapore","officers":[{"name":"Mr. Ping Yeow  Tan","title":"Co-Founder, Chairman & CEO"},{"name":"Mr. Alexander Charles  Hungate","title":"President, COO & Director"},{"name":"Mr. Peter  Oey","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":18.05,"tpe":31.79,"ps":4.581,"pfcf":26.85,"peg":1.17,"pb":4.856,"ev_ebitda":19.66,"rev_growth":0.183,"eps_growth":0.357,"eps_growth_fwd":0.2334,"eps_growth_next":0.1893,"div_yield":0,"roe":0.1241,"roa":0.04714,"de":32.1,"gross_margin":0.529,"op_margin":0.128,"profit_margin":0.09241,"current_ratio":1.818},"valuation":[{"k":"fpe","label":"Forward P/E","v":21.02,"sector":18.05,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":26.41,"sector":31.79,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":3.213,"sector":4.581,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":23.85,"sector":26.85,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":0.57,"sector":1.17,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.766,"sector":4.856,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":28.22,"sector":32.1,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.219,"sector":0.183,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.357,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":1.002,"sector":0.2334,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0029,"sector":0.1893,"verdict":"Weak"},{"k":"gross_mar