XS FlexiCard, a fee-based credit card; and mapping services, autonomous vehicle services, and last-mile delivery infrastructure. Grab Holdings Limited was founded in 2012 and is headquartered in Singapore, Singapore.","employees":12012,"website":"https://www.grab.com/sg","country":"Singapore","city":"Singapore","officers":[{"name":"Mr. Ping Yeow  Tan","title":"Co-Founder, Chairman & CEO"},{"name":"Mr. Alexander Charles  Hungate","title":"President, COO & Director"},{"name":"Mr. Peter  Oey","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":18.28,"tpe":32.14,"ps":4.713,"pfcf":27.99,"peg":1.155,"pb":4.963,"ev_ebitda":20.13,"rev_growth":0.169,"eps_growth":0.352,"eps_growth_fwd":0.2214,"eps_growth_next":0.1917,"div_yield":0,"roe":0.1232,"roa":0.04714,"de":32.58,"gross_margin":0.5282,"op_margin":0.1189,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":20.57,"sector":18.28,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":24.73,"sector":32.14,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":2.983,"sector":4.713,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":22.14,"sector":27.99,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.57,"sector":1.155,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.64,"sector":4.963,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":28.22,"sector":32.58,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.219,"sector":0.169,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.352,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.9611,"sector":0.2214,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":-0.0204,"sector":0.1917,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.4047,"sector":0.5282,"verdict":"In line"},{"k":"op_margin","label":"Operating margin","v":0.02104,"sec