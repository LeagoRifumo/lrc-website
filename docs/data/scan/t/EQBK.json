, the company offers treasury management services, including balance reporting, transfers between accounts, wire transfer initiation, automated clearing house origination, and stop payments. It operates in Arkansas, Kansas, Missouri, and Oklahoma. Equity Bancshares, Inc. was founded in 1985 and is headquartered in Wichita, Kansas.","employees":909,"website":"https://www.equitybank.com","country":"United States","city":"Wichita","officers":[{"name":"Mr. Brad S. Elliott","title":"Founder, Chairman & CEO"},{"name":"Mr. Chris M. Navratil","title":"Executive VP & CFO"},{"name":"Ms. Julie A. Huber","title":"Executive VP & COO"}]},"sector_medians":{"fpe":10.82,"tpe":12.76,"ps":3.533,"pfcf":12.17,"peg":1.32,"pb":1.628,"ev_ebitda":10.81,"rev_growth":0.091,"eps_growth":0.138,"eps_growth_fwd":0.1351,"eps_growth_next":0.1043,"div_yield":0.02205,"roe":0.1287,"roa":0.01564,"de":54.12,"gross_margin":0.2367,"op_margin":0.3641,"profit_margin":0.2565,"current_ratio":1.513},"valuation":[{"k":"fpe","label":"Forward P/E","v":9.176,"sector":10.82,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":10.82,"sector":12.76,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":3.291,"sector":3.533,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":12.17,"verdict":"—"},{"k":"peg","label":"PEG","v":1.69,"sector":1.32,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.261,"sector":1.628,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":54.12,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":5.97,"sector":0.091,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.138,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2415,"sector":0.1351,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0501,"sector":0.1043,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0,"sector":0.2367