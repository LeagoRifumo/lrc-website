pport to specific industry verticals; and back office services that support clients in non-customer facing areas. It serves technology and consumer electronics, retail, travel and e-commerce, communications and media, banking, financial services and insurance, healthcare, and other industries. The company was founded in 2004 and is based in Newark, California.","employees":455000,"website":"https://www.concentrix.com","country":"United States","city":"Newark","officers":[{"name":"Mr. Christopher A. Caldwell","title":"President, CEO & Director"},{"name":"Mr. Andre S. Valentine","title":"Executive VP & CFO"},{"name":"Ms. Jane C. Fogarty","title":"Executive Vice President of Legal"}]},"sector_medians":{"fpe":17.73,"tpe":31.01,"ps":4.582,"pfcf":26.55,"peg":1.16,"pb":4.831,"ev_ebitda":19.21,"rev_growth":0.1835,"eps_growth":0.3615,"eps_growth_fwd":0.2307,"eps_growth_next":0.1906,"div_yield":0,"roe":0.1245,"roa":0.04768,"de":32.58,"gross_margin":0.5372,"op_margin":0.1249,"profit_margin":0.09218,"current_ratio":1.81},"valuation":[{"k":"fpe","label":"Forward P/E","v":2.634,"sector":17.73,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":31.01,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":0.1847,"sector":4.582,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":2.284,"sector":26.55,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.37,"sector":1.16,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.038,"sector":4.831,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":298.6,"sector":32.58,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.012,"sector":0.1835,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.3615,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0148,"sector":0.2307,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0418,"sector":0.1906,"verdict":"We