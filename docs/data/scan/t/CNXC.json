ns to gather and analyze customer feedback; analytics and consulting solutions that synthesize data and provide professional insight to improve clients' customer experience strategies; specialized support to specific industry verticals; and back office services that support clients in non-customer facing areas. It serves technology and consumer electronics, retail, travel and e-commerce, communications and media, banking, financial services and insurance, healthcare, and other industries. The company was founded in 2004 and is based in Newark, California.","employees":455000,"website":"https://www.concentrix.com","country":"United States","city":"Newark","officers":[{"name":"Mr. Christopher A. Caldwell","title":"President, CEO & Director"},{"name":"Mr. Andre S. Valentine","title":"Executive VP & CFO"},{"name":"Ms. Jane C. Fogarty","title":"Executive Vice President of Legal"}]},"sector_medians":{"fpe":16.72,"tpe":28.36,"ps":4.155,"pfcf":24.8,"peg":1.085,"pb":4.471,"ev_ebitda":18.35,"rev_growth":0.1925,"eps_growth":0.3785,"eps_growth_fwd":0.2571,"eps_growth_next":0.1789,"div_yield":0,"roe":0.1241,"roa":0.04991,"de":32.75,"gross_margin":0.5418,"op_margin":0.118,"profit_margin":0.09451,"current_ratio":1.844},"valuation":[{"k":"fpe","label":"Forward P/E","v":2.66,"sector":16.72,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":28.36,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":0.1877,"sector":4.155,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":2.322,"sector":24.8,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.4,"sector":1.085,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.055,"sector":4.471,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":298.6,"sector":32.75,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.012,"sector":0.1925,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.3785,"verdict":"—"},{"k":"eps_gr