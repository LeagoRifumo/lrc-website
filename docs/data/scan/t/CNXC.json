upport to specific industry verticals; and back office services that support clients in non-customer facing areas. It serves technology and consumer electronics, retail, travel and e-commerce, communications and media, banking, financial services and insurance, healthcare, and other industries. The company was founded in 2004 and is based in Newark, California.","employees":455000,"website":"https://www.concentrix.com","country":"United States","city":"Newark","officers":[{"name":"Mr. Christopher A. Caldwell","title":"President, CEO & Director"},{"name":"Mr. Andre S. Valentine","title":"Executive VP & CFO"},{"name":"Ms. Jane C. Fogarty","title":"Executive Vice President of Legal"}]},"sector_medians":{"fpe":16.54,"tpe":28.87,"ps":4.416,"pfcf":25.38,"peg":1.14,"pb":4.371,"ev_ebitda":17.83,"rev_growth":0.179,"eps_growth":0.3785,"eps_growth_fwd":0.2364,"eps_growth_next":0.1867,"div_yield":0,"roe":0.1242,"roa":0.0481,"de":31.49,"gross_margin":0.5305,"op_margin":0.1226,"profit_margin":0.09004,"current_ratio":1.835},"valuation":[{"k":"fpe","label":"Forward P/E","v":2.767,"sector":16.54,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":28.87,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":0.189,"sector":4.416,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":2.337,"sector":25.38,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.35,"sector":1.14,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.062,"sector":4.371,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":298.6,"sector":31.49,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.012,"sector":0.179,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.3785,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0148,"sector":0.2364,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0418,"sector":0.1867,"verdict":"Weak