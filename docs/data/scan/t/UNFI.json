nd professional services. It serves grocery chains and retailers. United Natural Foods, Inc. was founded in 1976 and is headquartered in Providence, Rhode Island.","employees":23431,"website":"https://www.unfi.com","country":"United States","city":"Providence","officers":[{"name":"Mr. James Alexander Miller Douglas Jr.","title":"CEO & Director"},{"name":"Mr. Giorgio Matteo Tarditi","title":"President & COO"},{"name":"Mr. Michael S. Funk","title":"Co-Founder & Independent Director"}]},"sector_medians":{"fpe":14.45,"tpe":21.42,"ps":1.152,"pfcf":17.86,"peg":1.47,"pb":2.583,"ev_ebitda":11.06,"rev_growth":0.0445,"eps_growth":0.0985,"eps_growth_fwd":0.06965,"eps_growth_next":0.07085,"div_yield":0.0209,"roe":0.1317,"roa":0.05641,"de":81.13,"gross_margin":0.3618,"op_margin":0.1086,"profit_margin":0.0399,"current_ratio":1.277},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":14.45,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":36.06,"sector":21.42,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":0.09356,"sector":1.152,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":6.828,"sector":17.86,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.09,"sector":1.47,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.797,"sector":2.583,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":187.1,"sector":81.13,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.007,"sector":0.0445,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.0985,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2627,"sector":0.06965,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.2133,"sector":0.07085,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.1353,"sector":0.3618,"verdict":"Weak"},{"k":"op_margin","label":"Operating margin","v":0.00968,"sector":0.1086,"verdict":"Weak"},{"k":"profit_ma