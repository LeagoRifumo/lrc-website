er the OPUS, XCell, XCell ATF, TFDF, KrosFlo, SIUS, ProConnex, Spectra/Por, NGL-Impact, SoloVPE, FlowVPE, RPM, XO, Metenova MixOne, and AVIPure and FlowVPX brands. The company sells its products to life sciences, biopharmaceutical, and diagnostics companies; laboratory researchers; and contract manufacturing organizations. Repligen Corporation has a collaboration agreement with Navigo Proteins GmbH to develop multiple affinity ligands. The company was incorporated in 1981 and is headquartered in Waltham, Massachusetts.","employees":2000,"website":"https://www.repligen.com","country":"United States","city":"Waltham","officers":[{"name":"Mr. Olivier  Loeillot","title":"President, CEO & Director"},{"name":"Mr. Jason K. Garland","title":"CFO & Chief Compliance Officer"},{"name":"Mr. James R. Bylund","title":"Chief Operating Officer"}]},"sector_medians":{"fpe":18.93,"tpe":29.94,"ps":4.243,"pfcf":28.07,"peg":1.36,"pb":4.477,"ev_ebitda":16.75,"rev_growth":0.1,"eps_growth":0.167,"eps_growth_fwd":0.0928,"eps_growth_next":0.1205,"div_yield":0,"roe":0.01454,"roa":0.02187,"de":41.94,"gross_margin":0.4983,"op_margin":0.04015,"profit_margin":0,"current_ratio":3.084},"valuation":[{"k":"fpe","label":"Forward P/E","v":66.09,"sector":18.93,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":29.94,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":13.85,"sector":4.243,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":101.0,"sector":28.07,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.8,"sector":1.36,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":4.765,"sector":4.477,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":33.09,"sector":41.94,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.109,"sector":0.1,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.167,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.210