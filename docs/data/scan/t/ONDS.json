ublic safety, government, and other industrial applications. The company was formerly known as Ondas Holdings Inc. and changed its name to Ondas Inc. in January 2026. Ondas Inc. was incorporated in 2014 and is headquartered in West Palm Beach, Florida.","employees":459,"website":"https://www.ondas.com","country":"United States","city":"West Palm Beach","officers":[{"name":"Mr. Eric Ashley Brock CPA","title":"Chairman, CEO & President"},{"name":"Mr. Neil J. Laird","title":"CFO & Treasurer"},{"name":"Brig.Gen. Patrick  Huston","title":"COO, General Counsel, Member of the OAS Advisory Board & Secretary"}]},"sector_medians":{"fpe":17.92,"tpe":31.96,"ps":4.757,"pfcf":27.69,"peg":1.155,"pb":5.077,"ev_ebitda":20.02,"rev_growth":0.177,"eps_growth":0.339,"eps_growth_fwd":0.2255,"eps_growth_next":0.1929,"div_yield":0,"roe":0.1195,"roa":0.04674,"de":32.62,"gross_margin":0.5331,"op_margin":0.1128,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":-1,"sector":17.92,"verdict":"Loss-making"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":31.96,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":23.3,"sector":4.757,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":27.69,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":null,"sector":1.155,"verdict":"—"},{"k":"pb","label":"Price / Book","v":2.351,"sector":5.077,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":2.608,"sector":32.62,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":12.35,"sector":0.177,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.339,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.1634,"sector":0.2255,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.9048,"sector":0.1929,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.4372,"sector":0.5331,"verdict":"In line"},{