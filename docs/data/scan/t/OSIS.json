 support solutions; Pathfinder SL and Lifescreen Pro analysis tools; and Eclipse Pro Holter recorders. Additionally, the company offers Eclipse Mini Ambulatory ECG recorders; ambulatory blood pressure monitors; Spacelabs OnTrak ambulatory blood pressure systems; Sentinel, a cardiology information management system; and multivendor compatible accessories. OSI Systems, Inc. was incorporated in 1987 and is headquartered in Hawthorne, California.","employees":7806,"website":"https://www.osi-systems.com","country":"United States","city":"Hawthorne","officers":[{"name":"Mr. Ajay  Mehra","title":"President, CEO & Director"},{"name":"Mr. Alan I. Edrick","title":"Executive VP & CFO"},{"name":"Mr. Victor S. Sze","title":"Executive VP, General Counsel & Corporate Secretary"}]},"sector_medians":{"fpe":17.85,"tpe":31.02,"ps":4.569,"pfcf":26.24,"peg":1.16,"pb":4.856,"ev_ebitda":19.25,"rev_growth":0.1835,"eps_growth":0.3615,"eps_growth_fwd":0.2338,"eps_growth_next":0.1906,"div_yield":0,"roe":0.1245,"roa":0.04768,"de":32.58,"gross_margin":0.5372,"op_margin":0.1249,"profit_margin":0.09218,"current_ratio":1.81},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.56,"sector":17.85,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":21.45,"sector":31.02,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.756,"sector":4.569,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":14.99,"sector":26.24,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.47,"sector":1.16,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":3.811,"sector":4.856,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":126.0,"sector":32.58,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.041,"sector":0.1835,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.078,"sector":0.3615,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1046,"sector":0.2338,"verdict":"Weak"},{"k":"eps_