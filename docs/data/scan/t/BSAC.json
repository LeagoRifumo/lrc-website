mpanies, and other companies, as well as universities, government agencies, municipalities, regional governments, and construction and real estate companies. The company was incorporated in 1977 and is headquartered in Santiago, Chile. Banco Santander-Chile is a subsidiary of Banco Santander, S.A.","employees":8526,"website":"https://banco.santander.cl","country":"Chile","city":"Santiago","officers":[{"name":"Mr. Andrés Trautmann Buc","title":"CEO & Country Head"},{"name":"Ms. Patricia Perez Pallacan","title":"Chief Financial Officer"},{"name":"Mr. Eduardo  Herrera","title":"Executive Vice President of Technology & Operations"}]},"sector_medians":{"fpe":10.52,"tpe":12.48,"ps":3.453,"pfcf":12.0,"peg":1.3,"pb":1.586,"ev_ebitda":10.53,"rev_growth":0.088,"eps_growth":0.119,"eps_growth_fwd":0.1346,"eps_growth_next":0.1043,"div_yield":0.02255,"roe":0.1284,"roa":0.01568,"de":53.45,"gross_margin":0.2263,"op_margin":0.3704,"profit_margin":0.2565,"current_ratio":1.534},"valuation":[{"k":"fpe","label":"Forward P/E","v":10.84,"sector":10.52,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":12.48,"sector":12.48,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":null,"sector":3.453,"verdict":"—"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":12.0,"verdict":"—"},{"k":"peg","label":"PEG","v":2.35,"sector":1.3,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.327,"sector":1.586,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":53.45,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":-0.042,"sector":0.088,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.038,"sector":0.119,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0524,"sector":0.1346,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1426,"sector":0.1043,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0,"sector":0.2263,"ve