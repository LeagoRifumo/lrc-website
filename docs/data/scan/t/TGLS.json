tributors. It serves developers, general contractors or installers for hotels, office buildings, shopping centers, airports, universities, hospitals, and multifamily and residential buildings. The company was formerly known as Tecnoglass Inc. and changed its name to Tecnoglass Holdings Inc. in July 2026. Tecnoglass Holdings Inc. was founded in 1983 and is based in Miami, Florida.","employees":9601,"website":"https://www.tecnoglass.com","country":"United States","city":"Miami","officers":[{"name":"Mr. Jose Manuel Daes","title":"CEO & Director"},{"name":"Mr. Santiago  Giraldo","title":"CFO & Head of Investor Relations"},{"name":"Mr. Christian T. Daes","title":"COO & Director"}]},"sector_medians":{"fpe":12.2,"tpe":17.97,"ps":2.227,"pfcf":22.67,"peg":1.74,"pb":2.251,"ev_ebitda":9.234,"rev_growth":0.1635,"eps_growth":0.296,"eps_growth_fwd":0.3698,"eps_growth_next":0.1366,"div_yield":0.009,"roe":0.1295,"roa":0.06907,"de":43.23,"gross_margin":0.3315,"op_margin":0.1485,"profit_margin":0.07766,"current_ratio":2.28},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.0,"sector":12.2,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":20.55,"sector":17.97,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.848,"sector":2.227,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":22.67,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":0.63,"sector":1.74,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":2.494,"sector":2.251,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":36.01,"sector":43.23,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.192,"sector":0.1635,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.626,"sector":0.296,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.3128,"sector":0.3698,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.3756,"sector":0.1366,"verdi