0.2688}],"div_pay":null,"rec_trend":{"strongBuy":2,"buy":1,"hold":0,"sell":0,"strongSell":0},"analyst_actions":[{"date":"2026-10-30","firm":"Needham","action":"main","from":"Buy","to":"Buy"},{"date":"2026-09-21","firm":"Needham","action":"reit","from":"Buy","to":"Buy"}]},"profile":{"sector":"Technology","industry":"Software - Application","summary":"Donnelley Financial Solutions, Inc. provides compliance and regulatory software and services in the United States, Asia, Europe, Canada, and internationally. It operates through four segments: Capital Markets  Software Solutions (CM-SS); Capital Markets  Compliance and Communications Management (CM-CCM); Investment Companies  Software Solutions (IC-SS); and Investment Companies  Compliance and Communications Management (IC-CCM). The CM-SS segment provides Venue and ActiveDisclosure solutions to public and private companies to manage public and private transactional and compliance processes; collaborate; and tag, validate, and file SEC documents. The CM-CCM segment offers tech-enabled services and print and distribution solutions to public and private companies for deal solutions and SEC compliance requirements. The IC-SS segment provides clients with the Arc Suite platform that contains a comprehensive suite of cloud-based solutions, including ArcDigital, ArcReporting, ArcPro, and ArcRegulatory, as well as services that enable storage and management of compliance and regulatory information in a self-service and central repository for accessing, assembling, editing, translating, rendering, and submitting documents to regulators and investors. The IC-CCM segment offers tech-enabled solutions for creating, filing and distributing regulatory communications, and solutions for investor communications, as well as iXBRL-formatted filings pursuant for Investment Company Act through the SEC's EDGAR system. This segment provides turnkey proxy services, including discovery, planning and implementation, print and mail management, solicitation, tabulation services, stockholder meeting review, and expert support. The company was founded in 1983 and is headquartered in Lancaster, Pennsylvania.","employees":1750,"website":"https://www.dfinsolutions.com","country":"United States","city":"Lancaster","officers":[{"name":"Mr. Daniel N. Leib","title":"President, CEO & Director"},{"name":"Mr. David A. Gardella","title":"Executive VP & CFO"},{"name":"Mr. Robert Kirk Williams BA, J.D.","title":"Chief People & International Officer"}]},"sector_medians":{"fpe":17.73,"tpe":31.01,"ps":4.582,"pfcf":26.55,"peg":1.16,"pb":4.831,"ev_ebitda":19.21,"rev_growth":0.1835,"eps_growth":0.3615,"eps_growth_fwd":0.2307,"eps_growth_next":0.1906,"div_yield":0,"roe":0.1245,"roa":0.04768,"de":32.58,"gross_margin":0.5372,"op_margin":0.1249,"profit_margin":0.09218,"current_ratio":1.81},"valuation":[{"k":"fpe","label":"Forward P/E","v":11.79,"sector":17.73,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":16.89,"sector":31.01,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":2.002,"sector":4.582,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":9.993,"sector":26.55,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.97,"sector":1.16,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":3.853,"sector":4.831,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":32.71,"sector":32.58,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.055,"sector":0.1835,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.3615,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.528,"sector":0.2307,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1337,"sector":0.1906,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.6466,"sector":0.5372,"verdict":"In line"},{"k":"op_margin","label":"Operating margin","v":0.1773,"sector":0.1249,"verdict":"Strong"}