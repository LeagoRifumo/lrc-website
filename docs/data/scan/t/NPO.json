ex front-end wafer processing sub-systems; cleaning, coating, testing, refurbishment, and verification services for critical components and assemblies used in semiconductor manufacturing equipment; optical filters and proprietary thin-film coatings for applications in the industrial technology, life sciences, and semiconductor markets; optical filters and thin-film coatings for applications in the industrial technology, life sciences, and semiconductor markets; and edge-welded metal bellows for the semiconductor equipment industry and applications in the space, aerospace, and defense markets. The company was formerly known as EnPro Industries, Inc. and changed its name to Enpro Inc. in December 2023. Enpro Inc. was incorporated in 2002 and is headquartered in Charlotte, North Carolina.","employees":4000,"website":"https://www.enpro.com","country":"United States","city":"Charlotte","officers":[{"name":"Mr. Eric A. Vaillancourt","title":"President, CEO & Director"},{"name":"Mr. Joseph F. Bruderek Jr.","title":"CFO & Executive VP of Finance"},{"name":"Mr. Steven R. Bower CPA","title":"Senior VP, Controller & Chief Accounting Officer"}]},"sector_medians":{"fpe":17.16,"tpe":24.82,"ps":2.022,"pfcf":25.93,"peg":1.39,"pb":3.436,"ev_ebitda":14.18,"rev_growth":0.118,"eps_growth":0.169,"eps_growth_fwd":0.1469,"eps_growth_next":0.1445,"div_yield":0.00735,"roe":0.1452,"roa":0.05723,"de":67.59,"gross_margin":0.3181,"op_margin":0.1266,"profit_margin":0.07114,"current_ratio":1.706},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":17.16,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":87.5,"sector":24.82,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":4.229,"sector":2.022,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":38.32,"sector":25.93,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.7,"sector":1.39,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":3.346,"sector":3.436,"verdict":"Fairly valued"},{"k":"de","label":"Deb