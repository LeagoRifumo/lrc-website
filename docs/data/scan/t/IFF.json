, as well as engages in health, food biosciences, home and personal care, animal nutrition and grain processing businesses. The Scent segment creates fragrance compounds, and fragrance ingredients. International Flavors & Fragrances Inc. was incorporated in 1909 and is headquartered in New York, New York.","employees":21500,"website":"https://www.iff.com","country":"United States","city":"New York","officers":[{"name":"Mr. Jon Erik  Fyrwald","title":"CEO & Director"},{"name":"Mr. Michael  DeVeau","title":"Executive VP & CFO"},{"name":"Mr. Yuvraj  Arora","title":"President of Taste Division & Chief Commercial Officer"}]},"sector_medians":{"fpe":12.31,"tpe":18.56,"ps":2.223,"pfcf":23.76,"peg":1.74,"pb":2.331,"ev_ebitda":9.058,"rev_growth":0.165,"eps_growth":0.385,"eps_growth_fwd":0.3664,"eps_growth_next":0.1518,"div_yield":0.0092,"roe":0.1288,"roa":0.06935,"de":43.23,"gross_margin":0.3343,"op_margin":0.1751,"profit_margin":0.07064,"current_ratio":2.085},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":12.31,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":90.31,"sector":18.56,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":2.203,"sector":2.223,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":23.76,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":2.24,"sector":1.74,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.699,"sector":2.331,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":44.82,"sector":43.23,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.018,"sector":0.165,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.916,"sector":0.385,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.2351,"sector":0.3664,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.2221,"sector":0.1518,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.3658,"sector":