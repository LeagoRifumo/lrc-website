es; and home improvement and solar energy installation loans through contractors and installers. The Wealth and Asset Management segment provides various wealth management services, such as wealth planning, investment management, banking, insurance, trust, and estate services for individuals, companies, and not-for-profit organizations; retail brokerage services for individual clients; and advisory services for institutional clients. Fifth Third Bancorp was founded in 1858 and is headquartered in Cincinnati, Ohio.","employees":25069,"website":"https://www.53.com","country":"United States","city":"Cincinnati","officers":[{"name":"Mr. Timothy N. Spence","title":"Chairman, CEO & President"},{"name":"Mr. Bryan D. Preston","title":"Executive VP & CFO"},{"name":"Mr. James C. Leonard CPA","title":"Executive VP & COO"}]},"sector_medians":{"fpe":10.48,"tpe":12.69,"ps":3.455,"pfcf":11.72,"peg":1.32,"pb":1.596,"ev_ebitda":10.67,"rev_growth":0.106,"eps_growth":0.16,"eps_growth_fwd":0.133,"eps_growth_next":0.1089,"div_yield":0.02175,"roe":0.1268,"roa":0.01564,"de":54.45,"gross_margin":0.2391,"op_margin":0.3554,"profit_margin":0.2541,"current_ratio":1.509},"valuation":[{"k":"fpe","label":"Forward P/E","v":10.8,"sector":10.48,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":17.94,"sector":12.69,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":4.359,"sector":3.455,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":11.72,"verdict":"—"},{"k":"peg","label":"PEG","v":1.71,"sector":1.32,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.558,"sector":1.596,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":54.45,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.5,"sector":0.106,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.011,"sector":0.16,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1564,"sector":0.133,"ve