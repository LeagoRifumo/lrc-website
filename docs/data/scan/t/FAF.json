ms, such as heating and air conditioning systems, and certain appliances against failures that occur as the result of normal usage during the coverage period. This segment operates in various states and the District of Columbia. First American Financial Corporation was founded in 1889 and is based in Santa Ana, California.","employees":19102,"website":"https://www.firstam.com","country":"United States","city":"Santa Ana","officers":[{"name":"Mr. Dennis Joseph Gilmore","title":"Executive Chairman of the Board"},{"name":"Mr. Mark Edward Seaton","title":"CEO & Director"},{"name":"Mr. Matthew Feivish Wajner","title":"Executive VP & CFO"}]},"sector_medians":{"fpe":10.61,"tpe":12.66,"ps":3.433,"pfcf":11.64,"peg":1.31,"pb":1.605,"ev_ebitda":10.53,"rev_growth":0.106,"eps_growth":0.16,"eps_growth_fwd":0.1329,"eps_growth_next":0.1099,"div_yield":0.02175,"roe":0.1268,"roa":0.01564,"de":54.45,"gross_margin":0.2391,"op_margin":0.3554,"profit_margin":0.2541,"current_ratio":1.509},"valuation":[{"k":"fpe","label":"Forward P/E","v":8.935,"sector":10.61,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":8.918,"sector":12.66,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.8127,"sector":3.433,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":5.624,"sector":11.64,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":2.98,"sector":1.31,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.168,"sector":1.605,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":47.2,"sector":54.45,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.053,"sector":0.106,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.065,"sector":0.16,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1355,"sector":0.1329,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":-0.0027,"sector":0.1099,"verdict":"Weak"},{"k":"gross_margin","label":"Gross