 for opthamology; VK0214 for Rare Disease; and VK5211 for musculoskeletal disorder. The company was incorporated in 1987 and is based in Jupiter, Florida.","employees":47,"website":"https://www.ligand.com","country":"United States","city":"Jupiter","officers":[{"name":"Mr. Todd C. Davis Ph.D.","title":"CEO & Director"},{"name":"Mr. Octavio  Espinoza","title":"Chief Financial Officer"},{"name":"Mr. Andrew T. Reardon J.D.","title":"Chief Legal Officer & Secretary"}]},"sector_medians":{"fpe":19.17,"tpe":29.98,"ps":4.488,"pfcf":28.95,"peg":1.365,"pb":4.556,"ev_ebitda":16.93,"rev_growth":0.1,"eps_growth":0.1735,"eps_growth_fwd":0.09465,"eps_growth_next":0.1197,"div_yield":0,"roe":0.01872,"roa":0.02349,"de":41.94,"gross_margin":0.4961,"op_margin":0.03472,"profit_margin":0,"current_ratio":3.1},"valuation":[{"k":"fpe","label":"Forward P/E","v":26.54,"sector":19.17,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":33.44,"sector":29.98,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":21.77,"sector":4.488,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":45.27,"sector":28.95,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.53,"sector":1.365,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":6.533,"sector":4.556,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":116.9,"sector":41.94,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.337,"sector":0.1,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":8.25,"sector":0.1735,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1496,"sector":0.09465,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.2794,"sector":0.1197,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.812,"sector":0.4961,"verdict":"Strong"},{"k":"op_margin","label":"Operating margin","v":0.1349,"sector":0.03472,"verdict":"Strong"},{"k":"profit_margin","label":"N