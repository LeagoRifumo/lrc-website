ner sport cruisers, runabouts, and Heyday wake boats; Boston Whaler fiberglass offshore boats; Lund fiberglass fishing boats; Crestliner, Harris, Lowe, Lund, and Princecraft aluminum fishing; utility, pontoon, and deck boats; Navan premium exploration boats; and Thunder Jet and Lund heavy-gauge aluminum boats; and the freedom boat club, dealer services, and technology to the marine industry through dealers and distributors. Brunswick Corporation was founded in 1845 and is headquartered in Mettawa, Illinois.","employees":14000,"website":"https://www.brunswick.com","country":"United States","city":"Mettawa","officers":[{"name":"Mr. David M. Foulkes","title":"CEO & Chairman"},{"name":"Mr. Ryan M. Gwillim","title":"Executive VP, CFO & Chief Strategy Officer"},{"name":"Ms. Aine L. Denari","title":"Executive VP, President of Navico Group & Chief Technology Officer"}]},"sector_medians":{"fpe":14.98,"tpe":19.42,"ps":1.238,"pfcf":19.46,"peg":1.15,"pb":2.932,"ev_ebitda":11.85,"rev_growth":0.0545,"eps_growth":0.167,"eps_growth_fwd":0.1094,"eps_growth_next":0.1251,"div_yield":0.0077,"roe":0.1514,"roa":0.06079,"de":107.2,"gross_margin":0.3789,"op_margin":0.09692,"profit_margin":0.0585,"current_ratio":1.444},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.49,"sector":14.98,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":24.31,"sector":19.42,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":0.893,"sector":1.238,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":12.97,"sector":19.46,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.72,"sector":1.15,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":3.038,"sector":2.932,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":118.4,"sector":107.2,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.069,"sector":0.0545,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.167,"verdict":"—"},{"k":"eps_growth