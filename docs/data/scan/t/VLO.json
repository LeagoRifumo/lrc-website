 feed customers. The company was formerly known as Valero Refining and Marketing Company and changed its name to Valero Energy Corporation in August 1997. Valero Energy Corporation was founded in 1980 and is headquartered in San Antonio, Texas.","employees":9785,"website":"https://www.valero.com","country":"United States","city":"San Antonio","officers":[{"name":"Mr. R. Lane Riggs","title":"CEO, President & Chairman"},{"name":"Mr. Gary K. Simmons","title":"Executive VP & COO"},{"name":"Mr. Richard Joe Walsh","title":"Executive VP & General Counsel"}]},"sector_medians":{"fpe":12.14,"tpe":15.03,"ps":2.181,"pfcf":17.22,"peg":1.34,"pb":2.188,"ev_ebitda":7.858,"rev_growth":0.268,"eps_growth":0.8195,"eps_growth_fwd":0.4909,"eps_growth_next":0.03715,"div_yield":0.019,"roe":0.1285,"roa":0.05512,"de":55.83,"gross_margin":0.4427,"op_margin":0.2391,"profit_margin":0.1013,"current_ratio":1.437},"valuation":[{"k":"fpe","label":"Forward P/E","v":7.173,"sector":12.14,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":8.835,"sector":15.03,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.7317,"sector":2.181,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":17.22,"verdict":"—"},{"k":"peg","label":"PEG","v":1.46,"sector":1.34,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":4.429,"sector":2.188,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":40.15,"sector":55.83,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.519,"sector":0.268,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":5.768,"sector":0.8195,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":4.617,"sector":0.4909,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":-0.1004,"sector":0.03715,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.1951,"sector":0.4427,"verdict":"Weak"},{"k":"op_margin","label":"Operating 