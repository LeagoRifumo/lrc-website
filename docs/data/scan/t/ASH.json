diates segment produces 1,4 butanediol and related derivatives, including n-methylpyrrolidone. It offers its products to customers in a range of consumer and industrial markets, such as architectural coatings, construction, energy, food and beverage, personal care, and pharmaceutical. The company was formerly known as Ashland Global Holdings Inc. and changed its name to Ashland Inc. in August 2022. Ashland Inc. was founded in 1924 and is headquartered in Wilmington, Delaware.","employees":2800,"website":"https://www.ashland.com","country":"United States","city":"Wilmington","officers":[{"name":"Mr. Guillermo  Novo","title":"Chairman & CEO"},{"name":"Mr. William C. Whitaker C.F.A.","title":"Senior VP, CFO & Director of Investor Relations"},{"name":"Dr. Osama M. Musa Ph.D.","title":"Senior VP & CTO"}]},"sector_medians":{"fpe":12.2,"tpe":17.97,"ps":2.227,"pfcf":22.67,"peg":1.74,"pb":2.251,"ev_ebitda":9.234,"rev_growth":0.1635,"eps_growth":0.296,"eps_growth_fwd":0.3698,"eps_growth_next":0.1366,"div_yield":0.009,"roe":0.1295,"roa":0.06907,"de":43.23,"gross_margin":0.3315,"op_margin":0.1485,"profit_margin":0.07766,"current_ratio":2.28},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":12.2,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":136.9,"sector":17.97,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":1.85,"sector":2.227,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":10.59,"sector":22.67,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.23,"sector":1.74,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.874,"sector":2.251,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":79.65,"sector":43.23,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.044,"sector":0.1635,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.296,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2859,"sector":0.3698,"verdict