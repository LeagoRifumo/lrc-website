esses, high- and ultra-high-net-worth individuals and families, as well as investors, entrepreneurs, and companies and institutions, as well as multifamily, office, industrial, retail, healthcare, and hospitality sectors. The company was formerly known as RBS Citizens Financial Group, Inc. and changed its name to Citizens Financial Group, Inc. in April 2014. Citizens Financial Group, Inc. was founded in 1828 and is headquartered in Providence, Rhode Island.","employees":17609,"website":"https://www.citizensbank.com","country":"United States","city":"Providence","officers":[{"name":"Mr. Bruce Winfield Van Saun","title":"CEO & Chairman of the Board"},{"name":"Mr. Brendan  Coughlin","title":"President and Head of Consumer, Private Banking & Wealth"},{"name":"Mr. Aunoy  Banerjee","title":"Executive VP & CFO"}]},"sector_medians":{"fpe":10.53,"tpe":12.77,"ps":3.425,"pfcf":12.43,"peg":1.32,"pb":1.618,"ev_ebitda":10.75,"rev_growth":0.1,"eps_growth":0.152,"eps_growth_fwd":0.1315,"eps_growth_next":0.1087,"div_yield":0.0217,"roe":0.1279,"roa":0.01565,"de":53.89,"gross_margin":0.2437,"op_margin":0.326,"profit_margin":0.2552,"current_ratio":1.531},"valuation":[{"k":"fpe","label":"Forward P/E","v":10.19,"sector":10.53,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":13.35,"sector":12.77,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":3.316,"sector":3.425,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":12.43,"verdict":"—"},{"k":"peg","label":"PEG","v":1.65,"sector":1.32,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":1.213,"sector":1.618,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":53.89,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.119,"sector":0.1,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.343,"sector":0.152,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.3722,"sector":0.1315