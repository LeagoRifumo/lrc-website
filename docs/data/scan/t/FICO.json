ss use cases. In addition, the company offers analytic and decisioning software comprising FICO Decision Modeler, FICO Blaze Advisor, FICO Xpress Optimization, FICO Analytics Workbench, FICO Data Orchestrator, FICO DMP Streaming, FICO Business Outcome Simulator, and FICO Decision Optimizer; pre-configured solutions consisting of FICO Fraud Solutions, FICO Originations, FICO Customer Communication Service, FICO Strategy Director, and FICO TRIAD Customer Manager; and professional services software, including FICO Implementation Services and FICO Analytic Services. It markets its products and services primarily through its direct sales organization and indirect channels, as well as online. The company was formerly known as Fair Isaac & Company, Inc. and changed its name to Fair Isaac Corporation in July 1992. Fair Isaac Corporation was founded in 1956 and is headquartered in Bozeman, Montana.","employees":3876,"website":"https://www.fico.com","country":"United States","city":"Bozeman","officers":[{"name":"Mr. William J. Lansing J.D.","title":"President, CEO & Director"},{"name":"Mr. Steven P. Weber","title":"Executive VP & CFO"},{"name":"Mr. Mark Russell Scadina","title":"Executive VP, General Counsel & Corporate Secretary"}]},"sector_medians":{"fpe":18.12,"tpe":31.43,"ps":4.812,"pfcf":27.73,"peg":1.145,"pb":5.056,"ev_ebitda":19.99,"rev_growth":0.177,"eps_growth":0.339,"eps_growth_fwd":0.2264,"eps_growth_next":0.1929,"div_yield":0,"roe":0.1195,"roa":0.04674,"de":32.62,"gross_margin":0.5331,"op_margin":0.1128,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.01,"sector":18.12,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":20.22,"sector":31.43,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":6.399,"sector":4.812,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":19.78,"sector":27.73,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.76,"sector":1.145,"verdict":"Undervalued"},{"k"