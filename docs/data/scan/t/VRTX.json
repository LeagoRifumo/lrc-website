 discovery, development, and commercialization of novel therapeutics for rare endocrine diseases and endocrine-related tumors. The company sells its products primarily to specialty pharmacy and distributors, wholesalers, retail pharmacies, hospitals, and clinics. Vertex Pharmaceuticals Incorporated has a strategic collaboration with AbCellera Biologics Inc. to research, develop, manufacture, and commercialize multispecific T-cell engagers (TCEs) for autoimmune diseases and other conditions. Vertex Pharmaceuticals Incorporated was founded in 1989 and is headquartered in Boston, Massachusetts.","employees":6400,"website":"https://www.vrtx.com","country":"United States","city":"Boston","officers":[{"name":"Dr. Jeffrey Marc Leiden M.D., Ph.D.","title":"Executive Chairman"},{"name":"Dr. Reshma  Kewalramani FASN, M.D.","title":"CEO, President & Director"},{"name":"Mr. Charles F. Wagner Jr.","title":"Executive VP, COO & CFO"}]},"sector_medians":{"fpe":17.62,"tpe":29.74,"ps":3.69,"pfcf":27.89,"peg":1.36,"pb":3.624,"rev_growth":0.075,"eps_growth":0.171,"eps_growth_fwd":0.0972,"eps_growth_next":0.1015,"div_yield":0.0044,"roe":0.1442,"roa":0.06567,"de":68.79,"gross_margin":0.5566,"op_margin":0.1825,"profit_margin":0.098,"current_ratio":1.558},"valuation":[{"k":"fpe","label":"Forward P/E","v":25.52,"sector":17.62,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":29.74,"sector":29.74,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":10.49,"sector":3.69,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":50.25,"sector":27.89,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":2.02,"sector":1.36,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":6.519,"sector":3.624,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":9.767,"sector":68.79,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.125,"sector":0.075,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.08,"sector":0.171,"