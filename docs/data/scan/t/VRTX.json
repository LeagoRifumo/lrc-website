 clinical-stage pharmaceutical company, that focuses on the discovery, development, and commercialization of novel therapeutics for rare endocrine diseases and endocrine-related tumors. The company sells its products primarily to specialty pharmacy and distributors, wholesalers, retail pharmacies, hospitals, and clinics. Vertex Pharmaceuticals Incorporated has a strategic collaboration with AbCellera Biologics Inc. to research, develop, manufacture, and commercialize multispecific T-cell engagers (TCEs) for autoimmune diseases and other conditions. Vertex Pharmaceuticals Incorporated was founded in 1989 and is headquartered in Boston, Massachusetts.","employees":6400,"website":"https://www.vrtx.com","country":"United States","city":"Boston","officers":[{"name":"Dr. Jeffrey Marc Leiden M.D., Ph.D.","title":"Executive Chairman"},{"name":"Dr. Reshma  Kewalramani FASN, M.D.","title":"CEO, President & Director"},{"name":"Mr. Charles F. Wagner Jr.","title":"Executive VP, COO & CFO"}]},"sector_medians":{"fpe":18.89,"tpe":30.04,"ps":4.318,"pfcf":28.14,"peg":1.36,"pb":4.619,"ev_ebitda":16.75,"rev_growth":0.1,"eps_growth":0.167,"eps_growth_fwd":0.0928,"eps_growth_next":0.1205,"div_yield":0,"roe":0.01454,"roa":0.02187,"de":41.94,"gross_margin":0.4983,"op_margin":0.04015,"profit_margin":0,"current_ratio":3.084},"valuation":[{"k":"fpe","label":"Forward P/E","v":25.77,"sector":18.89,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":30.04,"sector":30.04,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":10.6,"sector":4.318,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":50.79,"sector":28.14,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":2.02,"sector":1.36,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":6.589,"sector":4.619,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":9.767,"sector":41.94,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.125,"sector":0.1,"verdict":"In line"},{"k":"eps_gr