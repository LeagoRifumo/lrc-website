sumer applications of printers, power washers, automatic doors, and vacuum cleaners; industrial off-highway, such as construction and agriculture; industrial on-highway commercial vehicles, including heavy-duty trucks and buses; energy and resources markets, such as oil, gas, and mining; and personal mobility, including scooters, motorcycles, bicycles, all-terrain vehicles, and snowmobiles. It sells its products under the Gates brand. It offers its products to aftermarket channel customers and original equipment manufacturers. Gates Industrial Corporation Ltd. was formerly known as Gates Industrial Corporation plc and changed its name to Gates Industrial Corporation Ltd. in July 2026. The company was founded in 1911 and is based in Denver, Colorado.","employees":13000,"website":"https://www.gates.com","country":"United States","city":"Denver","officers":[{"name":"Mr. Ivo  Jurek","title":"CEO & Director"},{"name":"Mr. L. Brooks Mallard C.F.A.","title":"Executive VP & CFO"},{"name":"Mr. Thomas G. Pitstick","title":"Senior VP & President of Americas"}]},"sector_medians":{"fpe":17.26,"tpe":24.34,"ps":2.045,"pfcf":26.08,"peg":1.36,"pb":3.457,"ev_ebitda":14.28,"rev_growth":0.1155,"eps_growth":0.164,"eps_growth_fwd":0.1478,"eps_growth_next":0.144,"div_yield":0.00735,"roe":0.1452,"roa":0.05675,"de":67.98,"gross_margin":0.3175,"op_margin":0.1261,"profit_margin":0.07298,"current_ratio":1.727},"valuation":[{"k":"fpe","label":"Forward P/E","v":12.43,"sector":17.26,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":16.39,"sector":24.34,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.704,"sector":2.045,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":15.26,"sector":26.08,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":null,"sector":1.36,"verdict":"—"},{"k":"pb","label":"Price / Book","v":1.701,"sector":3.457,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":59.53,"sector":67.98,"verdict":"In line"},{"k":"rev_growth","