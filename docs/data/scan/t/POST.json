handise customers, supercenters, club stores, natural/specialty stores, dollar stores, discounters, wholesalers, convenience stores, pet supply retailers, drug store customers, foodservice distributors, and national restaurant chains, as well as sells its products in the military, ecommerce, and foodservice channels. The company was founded in 1895 and is headquartered in Saint Louis, Missouri.","employees":13180,"website":"https://www.postholdings.com","country":"United States","city":"Saint Louis","officers":[{"name":"Mr. Robert V. Vitale","title":"Executive Chairman"},{"name":"Mr. Nicolas  Catoggio","title":"President & CEO"},{"name":"Ms. Diedre J. Gray","title":"Executive VP, General Counsel, Chief Administrative Officer & Corporate Secretary"}]},"sector_medians":{"fpe":14.25,"tpe":20.62,"ps":1.212,"pfcf":17.34,"peg":1.45,"pb":2.567,"ev_ebitda":10.82,"rev_growth":0.0445,"eps_growth":0.0985,"eps_growth_fwd":0.06965,"eps_growth_next":0.07045,"div_yield":0.0209,"roe":0.1317,"roa":0.05641,"de":81.13,"gross_margin":0.3618,"op_margin":0.1086,"profit_margin":0.0399,"current_ratio":1.277},"valuation":[{"k":"fpe","label":"Forward P/E","v":11.16,"sector":14.25,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":13.89,"sector":20.62,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":0.4195,"sector":1.212,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":8.942,"sector":17.34,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.17,"sector":1.45,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":1.146,"sector":2.567,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":247.1,"sector":81.13,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.018,"sector":0.0445,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.279,"sector":0.0985,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0585,"sector":0.06965,"verdict":"In line"},{"k":"eps_gr