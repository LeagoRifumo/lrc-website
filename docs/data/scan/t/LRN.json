tive students through the admission process, assessment management, administrative support, technology, and materials support services. The company provides its products and services through virtual schools, traditional school districts, and consumer. It serves public and private schools, school districts, and charter boards, as well as employers, government agencies, and consumers. The company was formerly known as K12 Inc. and changed its name to Stride, Inc. in December 2020. The company was incorporated in 1999 and is headquartered in Reston, Virginia.","employees":9200,"website":"https://stridelearning.com","country":"United States","city":"Reston","officers":[{"name":"Mr. Robert E. Knowling Jr.","title":"CEO & Director"},{"name":"Ms. Donna M. Blackman C.P.A.","title":"Executive VP & CFO"},{"name":"Mr. Greerson G. McMullen Sr., J.D.","title":"Executive VP, General Counsel & Secretary"}]},"sector_medians":{"fpe":15.08,"tpe":20.29,"ps":1.19,"pfcf":19.19,"peg":1.65,"pb":2.571,"ev_ebitda":10.94,"rev_growth":0.037,"eps_growth":0.133,"eps_growth_fwd":0.06595,"eps_growth_next":0.07315,"div_yield":0.01995,"roe":0.1239,"roa":0.05641,"de":80.72,"gross_margin":0.3532,"op_margin":0.1108,"profit_margin":0.04107,"current_ratio":1.299},"valuation":[{"k":"fpe","label":"Forward P/E","v":7.89,"sector":15.08,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":10.39,"sector":20.29,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.257,"sector":1.19,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":9.817,"sector":19.19,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.42,"sector":1.65,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.879,"sector":2.571,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":37.03,"sector":80.72,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.03,"sector":0.037,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.036,"sector":0.133,"v