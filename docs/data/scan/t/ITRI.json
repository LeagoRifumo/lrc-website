ng, and other analytics. The Resiliency Solutions segment offers software and services. The company offers implementation, project management, installation, consulting, and post-sale maintenance support services, as well as cloud and software-as-a-service; and extended or customer-specific warranties. It offers its products and services under the Itron brand. The company serves utility and smart city customers, and municipalities through its sales force, distributors, agents, partners, and meter manufacturer representatives. Itron, Inc. was incorporated in 1977 and is headquartered in Liberty Lake, Washington.","employees":4987,"website":"https://na.itron.com","country":"United States","city":"Liberty Lake","officers":[{"name":"Mr. Thomas L. Deitrich","title":"CEO, President & Director"},{"name":"Ms. Joan S. Hooper","title":"Senior VP & CFO"},{"name":"Mr. Donald L. Reeves III","title":"Senior Vice President of Outcomes"}]},"sector_medians":{"fpe":18.05,"tpe":31.79,"ps":4.581,"pfcf":26.85,"peg":1.17,"pb":4.856,"ev_ebitda":19.66,"rev_growth":0.183,"eps_growth":0.357,"eps_growth_fwd":0.2334,"eps_growth_next":0.1893,"div_yield":0,"roe":0.1241,"roa":0.04714,"de":32.1,"gross_margin":0.529,"op_margin":0.128,"profit_margin":0.09241,"current_ratio":1.818},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.45,"sector":18.05,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":16.22,"sector":31.79,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.889,"sector":4.581,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":13.21,"sector":26.85,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.73,"sector":1.17,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":2.579,"sector":4.856,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":94.1,"sector":32.1,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.03,"sector":0.183,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.14