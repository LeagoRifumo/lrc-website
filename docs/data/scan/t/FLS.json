grams, and field machining capabilities. It sells its products under the Valtek, Argus, Worcester, Limitorque, and Durco brands. The company serves oil and gas, power generation, chemical, water management and general industries, including pharmaceuticals, mining, food and beverage, steel, and pulp and paper industries. It distributes its products through direct sales, distributors, and sales representatives. Flowserve Corporation was founded in 1790 and is headquartered in Irving, Texas.","employees":16000,"website":"https://www.flowserve.com","country":"United States","city":"Irving","officers":[{"name":"Mr. Robert Scott Rowe","title":"President, CEO & Director"},{"name":"Ms. Susan Claire Hudson","title":"Senior VP, Chief Legal Officer & Corporate Secretary"},{"name":"Ms. Alice M. DeBiasio","title":"President of the Flow Control Division"}]},"sector_medians":{"fpe":17.8,"tpe":26.24,"ps":2.167,"pfcf":27.37,"peg":1.44,"pb":3.607,"ev_ebitda":14.76,"rev_growth":0.118,"eps_growth":0.1755,"eps_growth_fwd":0.1584,"eps_growth_next":0.1445,"div_yield":0.0067,"roe":0.1475,"roa":0.05825,"de":67.05,"gross_margin":0.319,"op_margin":0.1262,"profit_margin":0.07405,"current_ratio":1.668},"valuation":[{"k":"fpe","label":"Forward P/E","v":17.21,"sector":17.8,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":27.71,"sector":26.24,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":2.15,"sector":2.167,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":27.39,"sector":27.37,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":1.72,"sector":1.44,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":4.617,"sector":3.607,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":94.74,"sector":67.05,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.054,"sector":0.118,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.515,"sector":0.1755,"verdict":"Weak"},{"k":"eps_growth_fwd","label"