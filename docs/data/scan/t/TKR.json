ves a range of industries comprising solar energy, automation, construction, agriculture and turf, passenger rail, marine, aerospace, packaging and logistics, medical, and others under the Philadelphia Gear, Cone Drive, Rollon, Nadella, Groeneveld, BEKA, Diamond, Drives, Timken Belts, Spinea, Des-Case, Lagersmit, Lovejoy, CGI, and PT Tech brands. The Timken Company was founded in 1899 and is headquartered in North Canton, Ohio.","employees":19000,"website":"https://www.timken.com","country":"United States","city":"North Canton","officers":[{"name":"Dr. Lucian  Boldea Ph.D.","title":"CEO, President & Director"},{"name":"Mr. Michael A. Discenza","title":"Executive VP & CFO"},{"name":"Mr. Hansal N. Patel J.D.","title":"Executive VP of Corporate Development & General Counsel"}]},"sector_medians":{"fpe":18.04,"tpe":25.65,"ps":2.129,"pfcf":27.29,"peg":1.42,"pb":3.604,"ev_ebitda":14.61,"rev_growth":0.119,"eps_growth":0.1745,"eps_growth_fwd":0.156,"eps_growth_next":0.1437,"div_yield":0.007,"roe":0.1435,"roa":0.05694,"de":67.83,"gross_margin":0.319,"op_margin":0.1176,"profit_margin":0.0714,"current_ratio":1.724},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.04,"sector":18.04,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":27.4,"sector":25.65,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.579,"sector":2.129,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":18.17,"sector":27.29,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.23,"sector":1.42,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":2.39,"sector":3.604,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":61.27,"sector":67.83,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.047,"sector":0.119,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.354,"sector":0.1745,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2045,"sector":0.156,"verdict":"Strong"