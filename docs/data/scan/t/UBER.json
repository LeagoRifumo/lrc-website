nd offers on-demand platform to automate logistics end-to-end transactions for small-and medium-sized businesses to global enterprises. Uber Technologies, Inc. has strategic partnership with Mews to embed ride booking, real-time tracking and integrated billing directly into the Mews platform. The company was formerly known as Ubercab, Inc. and changed its name to Uber Technologies, Inc. in February 2011. Uber Technologies, Inc. was founded in 2009 and is headquartered in San Francisco, California.","employees":36600,"website":"https://www.uber.com","country":"United States","city":"San Francisco","officers":[{"name":"Mr. Dara  Khosrowshahi","title":"CEO & Director"},{"name":"Ms. Jill  Hazelbaker","title":"President & Chief Corporate Affairs Officer"},{"name":"Mr. Andrew G. Macdonald","title":"President & COO"}]},"sector_medians":{"fpe":18.05,"tpe":31.76,"ps":4.69,"pfcf":27.56,"peg":1.155,"pb":4.957,"ev_ebitda":20.23,"rev_growth":0.169,"eps_growth":0.352,"eps_growth_fwd":0.2214,"eps_growth_next":0.1917,"div_yield":0,"roe":0.1232,"roa":0.04714,"de":32.58,"gross_margin":0.5282,"op_margin":0.1189,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.88,"sector":18.05,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":14.39,"sector":31.76,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":2.425,"sector":4.69,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":18.49,"sector":27.56,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":5.75,"sector":1.155,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":4.897,"sector":4.957,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":51.87,"sector":32.58,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.122,"sector":0.169,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.855,"sector":0.352,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.36