atment of multiple growth disorders, such as achondroplasia and hypochondroplasia; and BMN 351, an oligonucleotide for the treatment of duchenne muscular dystrophy. It serves specialty pharmacies, hospitals, non-U.S. government agencies, distributors, and pharmaceutical wholesalers. The company has license and collaboration agreements with and Ares Trading S.A. The company was incorporated in 1996 and is based in San Rafael, California.","employees":3221,"website":"https://www.biomarin.com","country":"United States","city":"San Rafael","officers":[{"name":"Mr. Alexander  Hardy","title":"President, CEO & Director"},{"name":"Mr. Brian R. Mueller CPA","title":"CFO & Executive VP of Finance"},{"name":"Dr. C. Greg Guyer Ph.D.","title":"Executive VP & CTO"}]},"sector_medians":{"fpe":18.96,"tpe":29.96,"ps":4.265,"pfcf":28.26,"peg":1.34,"pb":4.643,"ev_ebitda":16.72,"rev_growth":0.1,"eps_growth":0.167,"eps_growth_fwd":0.0928,"eps_growth_next":0.1189,"div_yield":0,"roe":0.01454,"roa":0.02187,"de":41.94,"gross_margin":0.4983,"op_margin":0.04015,"profit_margin":0,"current_ratio":3.084},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":18.96,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":151.4,"sector":29.96,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":3.182,"sector":4.265,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":127.3,"sector":28.26,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":0.33,"sector":1.34,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":1.714,"sector":4.643,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":66.47,"sector":41.94,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.199,"sector":0.1,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.813,"sector":0.167,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1136,"sector":0.0928,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth 