 other peripherals. The company offers products through direct sales personnel and partnership agreements with various organizations. It serves retail, consumer goods, food and grocery, logistics service providers, industrial and wholesale, high technology and electronics, life sciences, and government industries. The company operates in the Americas, Europe, the Middle East, Africa, and the Asia Pacific. Manhattan Associates, Inc. was founded in 1990 and is headquartered in Atlanta, Georgia.","employees":4100,"website":"https://www.manh.com","country":"United States","city":"Atlanta","officers":[{"name":"Mr. Eric A. Clark","title":"President, CEO & Director"},{"name":"Mr. Bruce S. Richards J.D.","title":"Senior VP, Chief Legal Officer & Secretary"},{"name":"Mr. Robert G. Howell","title":"Executive VP & Chief Sales Officer"}]},"sector_medians":{"fpe":18.26,"tpe":31.4,"ps":4.764,"pfcf":26.86,"peg":1.15,"pb":4.974,"ev_ebitda":20.02,"rev_growth":0.17,"eps_growth":0.345,"eps_growth_fwd":0.2306,"eps_growth_next":0.1867,"div_yield":0,"roe":0.1243,"roa":0.04866,"de":29.26,"gross_margin":0.5169,"op_margin":0.1199,"profit_margin":0.08708,"current_ratio":1.825},"valuation":[{"k":"fpe","label":"Forward P/E","v":37.98,"sector":18.26,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":67.24,"sector":31.4,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":12.11,"sector":4.764,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":42.48,"sector":26.86,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":2.57,"sector":1.15,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":44.48,"sector":4.974,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":34.21,"sector":29.26,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.093,"sector":0.17,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.086,"sector":0.345,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.102