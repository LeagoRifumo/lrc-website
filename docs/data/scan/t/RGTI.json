r operating, administering, and monitoring the overall system; Rigetti Foundry Services that delivers superconducting quantum chips to advance and accelerate quantum information science and technology research and development; and professional services, such as algorithm development, benchmarking, quantum application programming, and software development. The company serves commercial enterprises, government organizations, and international government entities, as well as academia, defense laboratories, and national laboratories. Rigetti Computing, Inc. was founded in 2013 and is headquartered in Berkeley, California.","employees":162,"website":"https://www.rigetti.com","country":"United States","city":"Berkeley","officers":[{"name":"Dr. Subodh K. Kulkarni Ph.D.","title":"CEO, President & Director"},{"name":"Mr. Jeffrey A. Bertelsen","title":"Chief Financial Officer"},{"name":"Mr. David  Rivas","title":"Chief Operating Officer"}]},"sector_medians":{"fpe":17.47,"tpe":29.99,"ps":4.426,"pfcf":26.06,"peg":1.11,"pb":4.665,"ev_ebitda":19.01,"rev_growth":0.191,"eps_growth":0.356,"eps_growth_fwd":0.2432,"eps_growth_next":0.1809,"div_yield":0,"roe":0.1241,"roa":0.04945,"de":32.8,"gross_margin":0.5312,"op_margin":0.1174,"profit_margin":0.09364,"current_ratio":1.863},"valuation":[{"k":"fpe","label":"Forward P/E","v":-1,"sector":17.47,"verdict":"Loss-making"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":29.99,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":276.3,"sector":4.426,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":26.06,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":null,"sector":1.11,"verdict":"—"},{"k":"pb","label":"Price / Book","v":6.534,"sector":4.665,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":1.331,"sector":32.8,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.275,"sector":0.191,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":