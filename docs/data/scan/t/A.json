formation and workflow management; and OpenLab laboratory software, an open software platform that enables customers to capture, analyze, and share scientific data throughout the lab and across the enterprise. In addition, it provides automated sample preparation solutions, such as liquid handling, plate management, consumables, and scheduling software. The Applied Markets segment offers products in the areas of gas chromatography, mass spectrometry, spectroscopy, vacuum technology, and remarketed instruments. It markets its products through direct sales, distributors, resellers, manufacturer's representatives, and electronic commerce. Agilent Technologies, Inc. was incorporated in 1999 and is headquartered in Santa Clara, California.","employees":18200,"website":"https://www.agilent.com","country":"United States","city":"Santa Clara","officers":[{"name":"Mr. Padraig  McDonnell","title":"CEO, President & Director"},{"name":"Mr. Rodney  Gonsalves","title":"Vice President of Finance"},{"name":"Ms. Angelica A. Riemann","title":"Senior VP & President of Agilent CrossLab Group"}]},"sector_medians":{"fpe":19.11,"tpe":30.68,"ps":4.027,"pfcf":28.23,"peg":1.37,"pb":4.662,"ev_ebitda":16.89,"rev_growth":0.093,"eps_growth":0.155,"eps_growth_fwd":0.0901,"eps_growth_next":0.1182,"div_yield":0,"roe":0.02944,"roa":0.02544,"de":43.27,"gross_margin":0.5196,"op_margin":0.05279,"profit_margin":0,"current_ratio":2.981},"valuation":[{"k":"fpe","label":"Forward P/E","v":25.91,"sector":19.11,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":34.34,"sector":30.68,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":6.661,"sector":4.027,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":46.31,"sector":28.23,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.5,"sector":1.37,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":6.669,"sector":4.662,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":56.34,"sector":43.27,"verdict":"High d