f surface mount microwave components. Further, it provides thick-film ceramic substrates, custom designed application specific integrated circuits, and conventional PCBs; custom electronic assemblies; QTA services; and thermal management. The company serves original equipment manufacturers, electronic manufacturing services providers, original design manufacturers, distributors, and government agencies; and aerospace and defense, data center computing, automotive, medical, industrial, instrumentation, and networking markets. TTM Technologies, Inc. was incorporated in 1978 and is headquartered in Santa Ana, California.","employees":18200,"website":"https://www.ttm.com","country":"United States","city":"Santa Ana","officers":[{"name":"Dr. Edwin  Roks B.Sc., M.Sc., Ph.D.","title":"President, CEO & Director"},{"name":"Mr. Daniel L. Boehle CPA","title":"Executive VP & CFO"},{"name":"Mr. Douglas L. Soder","title":"Executive VP & President of Commercial Sector"}]},"sector_medians":{"fpe":18.07,"tpe":31.58,"ps":4.745,"pfcf":27.68,"peg":1.155,"pb":4.937,"ev_ebitda":20.43,"rev_growth":0.169,"eps_growth":0.352,"eps_growth_fwd":0.2214,"eps_growth_next":0.1917,"div_yield":0,"roe":0.1232,"roa":0.04714,"de":32.58,"gross_margin":0.5282,"op_margin":0.1189,"profit_margin":0.08604,"current_ratio":1.798},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":18.07,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":36.32,"sector":31.58,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":2.498,"sector":4.745,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":27.68,"verdict":"—"},{"k":"peg","label":"PEG","v":0.36,"sector":1.155,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":4.697,"sector":4.937,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":80.49,"sector":32.58,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.599,"sector":0.169,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth 