es, custom designed application specific integrated circuits, and conventional PCBs; custom electronic assemblies; QTA services; and thermal management. The company serves original equipment manufacturers, electronic manufacturing services providers, original design manufacturers, distributors, and government agencies; and aerospace and defense, data center computing, automotive, medical, industrial, instrumentation, and networking markets. TTM Technologies, Inc. was incorporated in 1978 and is headquartered in Santa Ana, California.","employees":18200,"website":"https://www.ttm.com","country":"United States","city":"Santa Ana","officers":[{"name":"Dr. Edwin  Roks B.Sc., M.Sc., Ph.D.","title":"President, CEO & Director"},{"name":"Mr. Daniel L. Boehle CPA","title":"Executive VP & CFO"},{"name":"Mr. Douglas L. Soder","title":"Executive VP & President of Commercial Sector"}]},"sector_medians":{"fpe":18.26,"tpe":31.4,"ps":4.764,"pfcf":26.86,"peg":1.15,"pb":4.974,"ev_ebitda":20.02,"rev_growth":0.17,"eps_growth":0.345,"eps_growth_fwd":0.2306,"eps_growth_next":0.1867,"div_yield":0,"roe":0.1243,"roa":0.04866,"de":29.26,"gross_margin":0.5169,"op_margin":0.1199,"profit_margin":0.08708,"current_ratio":1.825},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":18.26,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":34.71,"sector":31.4,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":2.388,"sector":4.764,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":26.86,"verdict":"—"},{"k":"peg","label":"PEG","v":0.36,"sector":1.15,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":4.49,"sector":4.974,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":80.49,"sector":29.26,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.599,"sector":0.17,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.58,"sector":0.345,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"E