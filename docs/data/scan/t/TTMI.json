ation friend; monopulse secondary surveillance radars, and air traffic control systems; wired and wireless communication systems; designs, produces, and tests specialized multi-chip RF modules and components; and manufactures off-the-shelf surface mount microwave components. Further, it provides thick-film ceramic substrates, custom designed application specific integrated circuits, and conventional PCBs; custom electronic assemblies; QTA services; and thermal management. The company serves original equipment manufacturers, electronic manufacturing services providers, original design manufacturers, distributors, and government agencies; and aerospace and defense, data center computing, automotive, medical, industrial, instrumentation, and networking markets. TTM Technologies, Inc. was incorporated in 1978 and is headquartered in Santa Ana, California.","employees":18200,"website":"https://www.ttm.com","country":"United States","city":"Santa Ana","officers":[{"name":"Dr. Edwin  Roks B.Sc., M.Sc., Ph.D.","title":"President, CEO & Director"},{"name":"Mr. Daniel L. Boehle CPA","title":"Executive VP & CFO"},{"name":"Mr. Daniel J. Weber","title":"Executive VP, Chief Legal Officer, General Counsel & Secretary"}]},"sector_medians":{"fpe":16.74,"tpe":28.56,"ps":4.285,"pfcf":24.55,"peg":1.15,"pb":4.492,"ev_ebitda":18.29,"rev_growth":0.183,"eps_growth":0.344,"eps_growth_fwd":0.2366,"eps_growth_next":0.1841,"div_yield":0,"roe":0.1251,"roa":0.04865,"de":32.8,"gross_margin":0.5312,"op_margin":0.1357,"profit_margin":0.09441,"current_ratio":1.879},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":16.74,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":26.14,"sector":28.56,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.796,"sector":4.285,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":251.5,"sector":24.55,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":0.36,"sector":1.15,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v"