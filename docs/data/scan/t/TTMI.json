nd manufactures off-the-shelf surface mount microwave components. Further, it provides thick-film ceramic substrates, custom designed application specific integrated circuits, and conventional PCBs; custom electronic assemblies; QTA services; and thermal management. The company serves original equipment manufacturers, electronic manufacturing services providers, original design manufacturers, distributors, and government agencies; and aerospace and defense, data center computing, automotive, medical, industrial, instrumentation, and networking markets. TTM Technologies, Inc. was incorporated in 1978 and is headquartered in Santa Ana, California.","employees":18200,"website":"https://www.ttm.com","country":"United States","city":"Santa Ana","officers":[{"name":"Dr. Edwin  Roks B.Sc., M.Sc., Ph.D.","title":"President, CEO & Director"},{"name":"Mr. Daniel L. Boehle CPA","title":"Executive VP & CFO"},{"name":"Mr. Douglas L. Soder","title":"Executive VP & President of Commercial Sector"}]},"sector_medians":{"fpe":17.85,"tpe":31.02,"ps":4.569,"pfcf":26.24,"peg":1.16,"pb":4.856,"ev_ebitda":19.25,"rev_growth":0.1835,"eps_growth":0.3615,"eps_growth_fwd":0.2338,"eps_growth_next":0.1906,"div_yield":0,"roe":0.1245,"roa":0.04768,"de":32.58,"gross_margin":0.5372,"op_margin":0.1249,"profit_margin":0.09218,"current_ratio":1.81},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":17.85,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":33.18,"sector":31.02,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":2.283,"sector":4.569,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":319.7,"sector":26.24,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":0.36,"sector":1.16,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":4.279,"sector":4.856,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":87.76,"sector":32.58,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.599,"sector":0.1835,"verdict":"Strong"},