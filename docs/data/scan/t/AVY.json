ns; and shelf-edge productivity and media solutions under the Vestcom brand names, as well as care, content, and country of origin compliance solutions. It serves home and personal care, apparel, general retail, e-commerce, logistics, food and grocery, pharmaceuticals, and automotive industries. The company was formerly known as Avery International Corporation and changed its name to Avery Dennison Corporation in 1990. The company was founded in 1935 and is headquartered in Mentor, Ohio.","employees":35000,"website":"https://www.averydennison.com","country":"United States","city":"Mentor","officers":[{"name":"Mr. Deon M. Stander","title":"President, CEO & Director"},{"name":"Mr. Gregory S. Lovins","title":"CFO, Senior VP & Principal Financial Officer"}]},"sector_medians":{"fpe":16.38,"tpe":19.6,"ps":2.026,"pfcf":27.52,"peg":1.445,"pb":6.119,"ev_ebitda":14.54,"rev_growth":0.0595,"eps_growth":0.108,"eps_growth_fwd":0.07215,"eps_growth_next":0.1049,"div_yield":0.01215,"roe":0.3103,"roa":0.08394,"de":110.6,"gross_margin":0.4278,"op_margin":0.1364,"profit_margin":0.09534,"current_ratio":1.117},"valuation":[{"k":"fpe","label":"Forward P/E","v":16.24,"sector":16.38,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":19.9,"sector":19.6,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.489,"sector":2.026,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":13.71,"sector":27.52,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.92,"sector":1.445,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":5.938,"sector":6.119,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":158.7,"sector":110.6,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.109,"sector":0.0595,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.108,"sector":0.108,"verdict":"In line"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0682,"sector":0.07215,"verdict":"In line"},{"k":