 users to control the AI and computer vision experiences for various edge applications, including client computing, industrial, and automotive applications; and sells video connectivity application specific standard products. Further, it provides standard IP and IP core licensing, patent monetization, and IP services. The company serves communications and computing, industrial and automotive, and consumer markets. Lattice Semiconductor Corporation was incorporated in 1983 and is headquartered in Hillsboro, Oregon.","employees":1174,"website":"https://www.latticesemi.com","country":"United States","city":"Hillsboro","officers":[{"name":"Dr. Fouad G. Tamer Ph.D.","title":"CEO, President & Director"},{"name":"Mr. Lorenzo A.  Flores","title":"Senior VP & CFO"},{"name":"Mr. Esam  Elashmawi","title":"Senior VP and Chief Strategy & Marketing Officer"}]},"sector_medians":{"fpe":17.73,"tpe":31.01,"ps":4.582,"pfcf":26.55,"peg":1.16,"pb":4.831,"ev_ebitda":19.21,"rev_growth":0.1835,"eps_growth":0.3615,"eps_growth_fwd":0.2307,"eps_growth_next":0.1906,"div_yield":0,"roe":0.1245,"roa":0.04768,"de":32.58,"gross_margin":0.5372,"op_margin":0.1249,"profit_margin":0.09218,"current_ratio":1.81},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":17.73,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":374.9,"sector":31.01,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":20.44,"sector":4.582,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":85.81,"sector":26.55,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":0.59,"sector":1.16,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":16.35,"sector":4.831,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":4.836,"sector":32.58,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.622,"sector":0.1835,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":6.0,"sector":0.3615,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this ye