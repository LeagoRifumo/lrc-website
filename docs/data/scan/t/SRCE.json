ft, and various vehicle types for fleet purposes. Additionally, it offers property, casualty, individual and group health, and life insurance products and services for individuals and businesses; and owns and manages available-for-sale investment securities. 1st Source Corporation was founded in 1863 and is headquartered in South Bend, Indiana.","employees":1190,"website":"https://www.1stsource.com","country":"United States","city":"South Bend","officers":[{"name":"Mr. Christopher J. Murphy III","title":"Executive Chairman"},{"name":"Ms. Andrea Gayle Short CPA","title":"President, CEO & Director"},{"name":"Mr. Brett A. Bauer","title":"Executive VP, CFO & Treasurer"}]},"sector_medians":{"fpe":10.38,"tpe":12.64,"ps":3.401,"pfcf":12.38,"peg":1.32,"pb":1.583,"ev_ebitda":10.59,"rev_growth":0.1,"eps_growth":0.1435,"eps_growth_fwd":0.1311,"eps_growth_next":0.107,"div_yield":0.0216,"roe":0.1281,"roa":0.01589,"de":55.49,"gross_margin":0.2386,"op_margin":0.3556,"profit_margin":0.2563,"current_ratio":1.503},"valuation":[{"k":"fpe","label":"Forward P/E","v":11.47,"sector":10.38,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":12.11,"sector":12.64,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":4.658,"sector":3.401,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":12.38,"verdict":"—"},{"k":"peg","label":"PEG","v":1.37,"sector":1.32,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":1.595,"sector":1.583,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":55.49,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.088,"sector":0.1,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.187,"sector":0.1435,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1274,"sector":0.1311,"verdict":"In line"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0035,"sector":0.107,"verdict":"Weak"},{"k":"gross_m