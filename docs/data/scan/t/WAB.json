ents; long-term parts arrangements; and way equipment maintenance services. Additionally, it provides railway and freight braking equipment and related components; brake shoes, discs, and pads; HVAC equipment; access and platform screen doors; pantographs; power converters and battery chargers; passenger information systems and closed-circuit television; signaling and railway electric relays; and doors, window assemblies, accessibility lifts, ramps, and electric charging solutions for buses. The company was founded in 1869 and is headquartered in Pittsburgh, Pennsylvania.","employees":31000,"website":"https://www.wabteccorp.com","country":"United States","city":"Pittsburgh","officers":[{"name":"Mr. Rafael Ottoni Santana","title":"Chairman & CEO"},{"name":"Mr. John A. Olin CPA","title":"Executive VP & CFO"},{"name":"Mr. Eric  Gebhardt","title":"Executive VP & Chief Technology Officer"}]},"sector_medians":{"fpe":20.42,"tpe":26.95,"ps":3.557,"pfcf":30.06,"peg":1.6,"pb":6.392,"ev_ebitda":17.15,"rev_growth":0.112,"eps_growth":0.158,"eps_growth_fwd":0.1329,"eps_growth_next":0.1204,"div_yield":0.01125,"roe":0.2064,"roa":0.07225,"de":74.13,"gross_margin":0.3662,"op_margin":0.1747,"profit_margin":0.1201,"current_ratio":1.339},"valuation":[{"k":"fpe","label":"Forward P/E","v":24.24,"sector":20.42,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":37.88,"sector":26.95,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":4.19,"sector":3.557,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":41.3,"sector":30.06,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.37,"sector":1.6,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":4.521,"sector":6.392,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":59.61,"sector":74.13,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.081,"sector":0.112,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.337,"sector":0.158,"verdict":"St