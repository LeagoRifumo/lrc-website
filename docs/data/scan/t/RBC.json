d defense aftermarket services; fasteners; precision mechanical components, for use in various general industrial applications; and machine tool collets that are used for holding circulars or rod-like pieces. It serves commercial and defense aerospace, construction, mining, forestry, energy, agricultural, food and beverage, metals and mining material handling, chemicals, oil and gas production, warehousing and logistics, semiconductor equipment, waste and water management, and rail and transportation applications through its direct sales force, and a network of industrial and aerospace distributors. The company was founded in 1919 and is based in Oxford, Connecticut.","employees":5816,"website":"https://www.rbcbearings.com","country":"United States","city":"Oxford","officers":[{"name":"Dr. Michael J. Hartnett Ph.D.","title":"Chairman, President & CEO"},{"name":"Mr. Robert M. Sullivan CPA","title":"VP & CFO"},{"name":"Mr. Daniel A. Bergeron","title":"VP, COO & Director"}]},"sector_medians":{"fpe":17.15,"tpe":24.27,"ps":2.021,"pfcf":25.57,"peg":1.39,"pb":3.332,"ev_ebitda":14.21,"rev_growth":0.118,"eps_growth":0.169,"eps_growth_fwd":0.1478,"eps_growth_next":0.1445,"div_yield":0.007,"roe":0.1452,"roa":0.05723,"de":67.59,"gross_margin":0.3181,"op_margin":0.1266,"profit_margin":0.07114,"current_ratio":1.706},"valuation":[{"k":"fpe","label":"Forward P/E","v":27.22,"sector":17.15,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":41.58,"sector":24.27,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":7.262,"sector":2.021,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":43.98,"sector":25.57,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.64,"sector":1.39,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":4.119,"sector":3.332,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":21.96,"sector":67.59,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.152,"sector":0.118,"verdict":"Strong"},{"k"