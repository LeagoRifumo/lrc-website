ls; Evergreen Architecture comprising Pure1, an AI-driven cloud-based management platform, as well as Evergreen//One and Evergreen//Flex data storage solutions; and Everpure Cloud, a virtual block storage array, that provides customers the flexibility to operate a hybrid cloud model with seamless data mobility across on-premises and public cloud environments. It sells its products and subscription services through a direct sales force and channel partners. Everpure, Inc. has a strategic alliance with Odine Solutions Teknoloji Ticaret ve Sanayi A.S. The company was formerly known as Pure Storage, Inc. and changed its name to Everpure, Inc. in February 2026. Everpure, Inc. was incorporated in 2009 and is headquartered in Santa Clara, California.","employees":6400,"website":"https://www.everpuredata.com","country":"United States","city":"Santa Clara","officers":[{"name":"Mr. Charles H. Giancarlo","title":"Chairman & CEO"},{"name":"Mr. John  Colgrove","title":"Founder, Chief Visionary Officer & Director"},{"name":"Mr. Tarek A. Robbiati M.B.A., M.Sc.","title":"Chief Financial Officer"}]},"sector_medians":{"fpe":17.88,"tpe":32.87,"ps":6.509,"pfcf":32.17,"peg":1.01,"pb":7.665,"ev_ebitda":21.94,"rev_growth":0.2175,"eps_growth":0.464,"eps_growth_fwd":0.2596,"eps_growth_next":0.1955,"div_yield":0.00105,"roe":0.2326,"roa":0.07978,"de":48.45,"gross_margin":0.586,"op_margin":0.2256,"profit_margin":0.1916,"current_ratio":1.562},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":17.88,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":190.0,"sector":32.87,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":10.85,"sector":6.509,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":32.17,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":1.52,"sector":1.01,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":30.01,"sector":7.665,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":14.62,"sector":48.45,"verdict":"Low de