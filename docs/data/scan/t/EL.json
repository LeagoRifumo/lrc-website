 Editions de Parfums Frédéric Malle, KILIAN PARIS, BALMAIN Beauty, Estée Lauder, Clinique, M·A·C, The Ordinary, Aveda, Bobbi Brown Cosmetics, Too Faced, Dr.Jart+, Bumble and bumble, Smashbox, Darphin Paris, Lab Series, Avestan, Loopha, Origins, NIOD, Aramis, and GLAMGLOW brands. It sells its products through department stores, duty-free retailers, specialty multi retailers, online pure players, upscale perfumeries and pharmacies, and top-tier salons and spas, as well as direct-to-consumer businesses across freestanding stores, and brand websites and third-party online platforms. The Estée Lauder Companies Inc. was founded in 1946 and is based in New York, New York.","employees":37950,"website":"https://www.elcompanies.com","country":"United States","city":"New York","officers":[{"name":"Mr. Stephane  de la Faverie","title":"CEO, President & Director"},{"name":"Mr. Akhil  Shrivastava","title":"Executive VP & CFO"},{"name":"Ms. Rashida K. La Lande","title":"Executive VP & General Counsel"}]},"sector_medians":{"fpe":14.32,"tpe":21.33,"ps":1.206,"pfcf":17.23,"peg":1.47,"pb":2.585,"ev_ebitda":10.79,"rev_growth":0.0445,"eps_growth":0.0985,"eps_growth_fwd":0.06965,"eps_growth_next":0.07085,"div_yield":0.0209,"roe":0.1317,"roa":0.05641,"de":81.13,"gross_margin":0.3618,"op_margin":0.1086,"profit_margin":0.0399,"current_ratio":1.277},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":14.32,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":218.4,"sector":21.33,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":2.629,"sector":1.206,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":21.84,"sector":17.23,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":2.12,"sector":1.47,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":10.38,"sector":2.585,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":242.9,"sector":81.13,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.063,"sector":0.0445,"verdict":"In li