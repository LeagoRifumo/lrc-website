 Oklahoma; and leases buildings, warehouses, office space, land, and equipment, including pipeline equipment, pipeline capacity, rail cars, and information technology equipment. Further, the company transports, stores, and distributes refined products, purity NGLs, and crude oil, as well as conducts commodity-related activities, including liquids blending and marketing activities. It serves integrated and independent exploration and production companies; other NGL and natural gas gathering and processing companies; crude oil and natural gas production companies; utilities; industrial companies; natural gasoline distributors; propane distributors; municipalities; ethanol producers; petrochemical, refining, and marketing companies; and diluent users, refineries, and exporters. ONEOK, Inc. was founded in 1906 and is headquartered in Tulsa, Oklahoma.","employees":6326,"website":"https://www.oneok.com","country":"United States","city":"Tulsa","officers":[{"name":"Mr. Pierce H. Norton II","title":"President, CEO & Director"},{"name":"Mr. Walter S. Hulse III","title":"CFO, Treasurer and Executive VP of Investor Relations & Corporate Development"},{"name":"Mr. Randy N. Lentz","title":"Executive VP & COO"}]},"sector_medians":{"fpe":11.02,"tpe":12.41,"ps":1.901,"pfcf":12.82,"peg":1.24,"pb":1.881,"ev_ebitda":6.974,"rev_growth":0.279,"eps_growth":0.676,"eps_growth_fwd":0.492,"eps_growth_next":0.0413,"div_yield":0.0208,"roe":0.1392,"roa":0.05975,"de":53.85,"gross_margin":0.4438,"op_margin":0.1927,"profit_margin":0.1162,"current_ratio":1.411},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.52,"sector":11.02,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":13.8,"sector":12.41,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.297,"sector":1.901,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":72.27,"sector":12.82,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.45,"sector":1.24,"verdict":"Fairly valued"},{"k":"pb","label":"Price / B