strial distributors and suppliers, mass retail and home center stores, value retailers, grocery stores, online retailers, warehouse club stores, farm supply stores, sport retailers, and independent bike dealers. WD-40 Company was founded in 1953 and is headquartered in San Diego, California.","employees":753,"website":"https://www.wd40company.com","country":"United States","city":"San Diego","officers":[{"name":"Mr. Steven A. Brass","title":"CEO, President & Director"},{"name":"Ms. Phenix Quach Kiamilev J.D.","title":"VP, General Counsel, Chief Compliance Officer & Corporate Secretary"},{"name":"Mr. Jeffrey G. Lindeman","title":"VP and Chief People, Culture & Capability Officer"}]},"sector_medians":{"fpe":12.2,"tpe":17.99,"ps":2.211,"pfcf":23.17,"peg":1.74,"pb":2.258,"ev_ebitda":9.149,"rev_growth":0.1635,"eps_growth":0.296,"eps_growth_fwd":0.3698,"eps_growth_next":0.1366,"div_yield":0.009,"roe":0.1295,"roa":0.06907,"de":43.23,"gross_margin":0.3315,"op_margin":0.1485,"profit_margin":0.07766,"current_ratio":2.28},"valuation":[{"k":"fpe","label":"Forward P/E","v":31.05,"sector":12.2,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":36.19,"sector":17.99,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":4.283,"sector":2.211,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":31.99,"sector":23.17,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":3.76,"sector":1.74,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":10.81,"sector":2.258,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":36.84,"sector":43.23,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.081,"sector":0.1635,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.322,"sector":0.296,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.0753,"sector":0.3698,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.0839,"sector":0.1366,"verdict":"Weak"