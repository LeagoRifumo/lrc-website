ouds, and surge tanks; cooling module generator sets; aluminum and stainless steel engine oil coolers, exhaust gas recirculation coolers, liquid charge air coolers, transmission and retarder oil coolers, chillers, and condensers; battery thermal management systems, electronics cooling packages, battery chillers, battery cooling plates, coolers and casings for electronics cooling, and coolers for electric axles; and coatings products and application services. The company was incorporated in 1916 and is headquartered in Racine, Wisconsin.","employees":13000,"website":"https://www.modine.com","country":"United States","city":"Racine","officers":[{"name":"Mr. Neil D. Brinker","title":"President, CEO & Director"},{"name":"Mr. Michael B. Lucareli C.F.A.","title":"Executive VP & CFO"},{"name":"Ms. Erin Jennifer Roth J.D.","title":"VP, General Counsel, Corporate Secretary & Chief Compliance Officer"}]},"sector_medians":{"fpe":14.19,"tpe":18.59,"ps":1.224,"pfcf":20.37,"peg":1.125,"pb":2.904,"ev_ebitda":11.61,"rev_growth":0.058,"eps_growth":0.167,"eps_growth_fwd":0.1068,"eps_growth_next":0.1284,"div_yield":0.0077,"roe":0.1518,"roa":0.06079,"de":109.9,"gross_margin":0.3789,"op_margin":0.09691,"profit_margin":0.05663,"current_ratio":1.447},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":14.19,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":51.32,"sector":18.59,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":2.153,"sector":1.224,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":20.37,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":0.48,"sector":1.125,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":6.033,"sector":2.904,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":55.5,"sector":109.9,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.28,"sector":0.058,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.442,"sector":0.167,"verdict":"Strong