e services. Bank of Hawaii Corporation was founded in 1897 and is headquartered in Honolulu, Hawaii.","employees":1877,"website":"https://www.boh.com","country":"United States","city":"Honolulu","officers":[{"name":"Mr. Bradley S. Satenberg","title":"Vice Chair & CFO"},{"name":"Mr. Patrick M. McGuirk","title":"Vice Chair, Chief Administrative Officer, General Counsel & Corporate Secretary"},{"name":"Mr. Peter S. Ho","title":"Consultant"}]},"sector_medians":{"fpe":10.82,"tpe":12.76,"ps":3.533,"pfcf":12.17,"peg":1.32,"pb":1.628,"ev_ebitda":10.81,"rev_growth":0.091,"eps_growth":0.138,"eps_growth_fwd":0.1351,"eps_growth_next":0.1043,"div_yield":0.02205,"roe":0.1287,"roa":0.01564,"de":54.12,"gross_margin":0.2367,"op_margin":0.3641,"profit_margin":0.2565,"current_ratio":1.513},"valuation":[{"k":"fpe","label":"Forward P/E","v":10.85,"sector":10.82,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":12.4,"sector":12.76,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":3.64,"sector":3.533,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":12.17,"verdict":"—"},{"k":"peg","label":"PEG","v":2.1,"sector":1.32,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.885,"sector":1.628,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":null,"sector":54.12,"verdict":"—"},{"k":"rev_growth","label":"Revenue growth","v":0.088,"sector":0.091,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.242,"sector":0.138,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2763,"sector":0.1351,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.1109,"sector":0.1043,"verdict":"In line"},{"k":"gross_margin","label":"Gross margin","v":0,"sector":0.2367,"verdict":"Weak"},{"k":"op_margin","label":"Operating margin","v":0.4424,"sector":0.3641,"verdict":"In line"},{"k":"profit_margin","label":"Net margin","v":0.3213,"sector":0.256