installation and workover control systems and ROV workover control systems; diving services; project management and engineering; and drill pipe riser services and systems and wellhead load relief solutions. Its Integrity Management & Digital Solution segment provides asset integrity management services, as well as software, digital, and connectivity solutions for the energy industry. The Aerospace and Defense Technologies segment offers services and products, such as engineering and related manufacturing in defense and space exploration activities. The company was founded in 1964 and is headquartered in Houston, Texas.","employees":11100,"website":"https://www.oceaneering.com","country":"United States","city":"Houston","officers":[{"name":"Mr. Roderick A. Larson","title":"President, CEO & Director"},{"name":"Mr. Benjamin M. Laura","title":"Senior VP & COO"},{"name":"Ms. Jennifer Fremont Simons J.D.","title":"Senior VP, Chief Legal Officer & Secretary"}]},"sector_medians":{"fpe":12.14,"tpe":15.03,"ps":2.181,"pfcf":17.22,"peg":1.34,"pb":2.188,"ev_ebitda":7.858,"rev_growth":0.268,"eps_growth":0.8195,"eps_growth_fwd":0.4909,"eps_growth_next":0.03715,"div_yield":0.019,"roe":0.1285,"roa":0.05512,"de":55.83,"gross_margin":0.4427,"op_margin":0.2391,"profit_margin":0.1013,"current_ratio":1.437},"valuation":[{"k":"fpe","label":"Forward P/E","v":18.48,"sector":12.14,"verdict":"Overvalued"},{"k":"tpe","label":"TTM P/E","v":12.67,"sector":15.03,"verdict":"Fairly valued"},{"k":"ps","label":"Price / Sales","v":1.42,"sector":2.181,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":14.7,"sector":17.22,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":8.01,"sector":1.34,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":3.382,"sector":2.188,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":64.85,"sector":55.83,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.056,"sector":0.268,"verdict":"Weak"},{"k":"eps_growth","label"