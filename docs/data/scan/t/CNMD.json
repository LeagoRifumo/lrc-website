in gastroenterology procedures; and products to treat diseases of dilation, hemostasis, biliary, stricture management, and infection prevention, as well as ECG electrodes, EEG electrodes, and cardiac defibrillation pads. The company markets its products directly to hospitals, surgery centers, and other healthcare institutions, as well as through medical specialty distributors. The company was incorporated in 1970 and is headquartered in Largo, Florida.","employees":3900,"website":"https://www.conmed.com","country":"United States","city":"Largo","officers":[{"name":"Mr. Patrick J. Beyer","title":"President, CEO & Director"},{"name":"Ms. Hollie K. Foust","title":"Executive VP, General Counsel & Corporate Secretary"},{"name":"Mr. Peter K. Shagory","title":"Executive Vice President of Strategy & Corporate Development"}]},"sector_medians":{"fpe":18.71,"tpe":29.69,"ps":4.265,"pfcf":27.49,"peg":1.36,"pb":4.478,"ev_ebitda":16.87,"rev_growth":0.094,"eps_growth":0.1505,"eps_growth_fwd":0.0951,"eps_growth_next":0.1081,"div_yield":0,"roe":0.02656,"roa":0.02593,"de":42.28,"gross_margin":0.5132,"op_margin":0.04529,"profit_margin":0,"current_ratio":2.998},"valuation":[{"k":"fpe","label":"Forward P/E","v":10.68,"sector":18.71,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":21.04,"sector":29.69,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.104,"sector":4.265,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":14.12,"sector":27.49,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.84,"sector":1.36,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.429,"sector":4.478,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":76.97,"sector":42.28,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":-0.007,"sector":0.094,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":6.333,"sector":0.1505,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.0