isión S.A. and changed its name to Telecom Argentina S.A. in January 2018. Telecom Argentina S.A. was founded in 1979 and is based in Buenos Aires, Argentina.","employees":17289,"website":"https://institucional.telecom.com.ar","country":"Argentina","city":"Buenos Aires","officers":[{"name":"Mr. Roberto  Daniel Nóbile CPA","title":"Chief Executive Officer"},{"name":"Mr. Manuel Garcia Diez","title":"Chief Financial Officer"},{"name":"Mr. Gonzalo  Hita","title":"Chief Operating Officer"}]},"sector_medians":{"fpe":12.0,"tpe":16.98,"ps":2.065,"pfcf":11.96,"peg":1.005,"pb":2.365,"ev_ebitda":12.48,"rev_growth":0.0905,"eps_growth":0.068,"eps_growth_fwd":0.1456,"eps_growth_next":0.1345,"div_yield":0,"roe":0.09388,"roa":0.04097,"de":59.99,"gross_margin":0.5601,"op_margin":0.1305,"profit_margin":0.07559,"current_ratio":1.317},"valuation":[{"k":"fpe","label":"Forward P/E","v":11.54,"sector":12.0,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":8.227,"sector":16.98,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":null,"sector":2.065,"verdict":"—"},{"k":"pfcf","label":"Price / FCF","v":null,"sector":11.96,"verdict":"—"},{"k":"peg","label":"PEG","v":1.41,"sector":1.005,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":0.7842,"sector":2.365,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":67.38,"sector":59.99,"verdict":"In line"},{"k":"rev_growth","label":"Revenue growth","v":0.004,"sector":0.0905,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.068,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":7.227,"sector":0.1456,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":-0.4795,"sector":0.1345,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.7645,"sector":0.5601,"verdict":"Strong"},{"k":"op_margin","label":"Operating margin","v":0.0946,"sector":0.1305,"verdict":"Weak"},{"k":"profit_margin","label":"Net m