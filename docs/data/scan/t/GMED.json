rm combined with ExcelsiusGPS that provides an intraoperative and image-guided robotic navigation solution; ExcelsiusHub, which provides real-time patient array monitoring, tissue sparing drills, and registration flexibility; and ExcelsiusFlex, a total knee arthroplasty robotic solution. Further, it distributes human cells, tissues, and cellular and tissue-based products. The company sells its products through direct and distributor sales representatives; and independent sales agents. Globus Medical, Inc. was incorporated in 2003 and is headquartered in Audubon, Pennsylvania.","employees":6000,"website":"https://www.globusmedical.com","country":"United States","city":"Audubon","officers":[{"name":"Mr. David C. Paul","title":"Co-Founder & Executive Chairman"},{"name":"Mr. Keith W. Pfeil","title":"CEO, President & Director"},{"name":"Mr. Kyle R. Klin","title":"Senior VP & CFO"}]},"sector_medians":{"fpe":19.37,"tpe":31.77,"ps":4.176,"pfcf":28.94,"peg":1.37,"pb":4.508,"ev_ebitda":17.22,"rev_growth":0.094,"eps_growth":0.147,"eps_growth_fwd":0.0883,"eps_growth_next":0.1182,"div_yield":0,"roe":0.01671,"roa":0.02341,"de":43.27,"gross_margin":0.5196,"op_margin":0.05617,"profit_margin":0,"current_ratio":3.001},"valuation":[{"k":"fpe","label":"Forward P/E","v":15.11,"sector":19.37,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":20.06,"sector":31.77,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":3.477,"sector":4.176,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":19.73,"sector":28.94,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":1.49,"sector":1.37,"verdict":"Fairly valued"},{"k":"pb","label":"Price / Book","v":2.293,"sector":4.508,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":2.347,"sector":43.27,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.059,"sector":0.094,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.262,"sector":0.147,"verdict":"Weak"},{"k":"e