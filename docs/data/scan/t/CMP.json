 well as growers. The company was formerly known as Salt Holdings Corporation and changed its name to Compass Minerals International, Inc. in December 2003. Compass Minerals International, Inc. was founded in 1844 and is headquartered in Overland Park, Kansas.","employees":1800,"website":"https://www.compassminerals.com","country":"United States","city":"Overland Park","officers":[{"name":"Dr. Edward C. Dowling Jr., B.Sc., M.Sc., Ph.D.","title":"President, CEO & Director"},{"name":"Mr. Peter  Fjellman","title":"Chief Financial Officer"},{"name":"Ms. Amy  Tills","title":"Chief Human Resources Officer"}]},"sector_medians":{"fpe":12.27,"tpe":17.94,"ps":2.182,"pfcf":22.91,"peg":1.72,"pb":2.187,"ev_ebitda":8.972,"rev_growth":0.152,"eps_growth":0.293,"eps_growth_fwd":0.386,"eps_growth_next":0.1367,"div_yield":0.00915,"roe":0.1302,"roa":0.06932,"de":45.78,"gross_margin":0.3255,"op_margin":0.1462,"profit_margin":0.07903,"current_ratio":2.285},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":12.27,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":54.95,"sector":17.94,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":0.732,"sector":2.182,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":10.38,"sector":22.91,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.12,"sector":1.72,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":3.589,"sector":2.187,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":294.0,"sector":45.78,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.003,"sector":0.152,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.293,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":2.863,"sector":0.386,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.4045,"sector":0.1367,"verdict":"Strong"},{"k":"gross_margin","label":"Gross margin","v":0.1722,"sector":0.3255,"verdict":"Wea