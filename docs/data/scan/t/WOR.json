quipment, industrial forklifts, and commercial/residential cooking; well water and expansion tanks used primarily in the residential and commercial markets; specialty products, including various fire suppression tanks, chemical tanks, and foam and adhesive tanks; and ceiling suspension systems and light gauge metal framing products. The company was formerly known as Worthington Industries, Inc. Worthington Enterprises, Inc. was founded in 1955 and is headquartered in Columbus, Ohio.","employees":4000,"website":"https://www.worthingtonenterprises.com","country":"United States","city":"Columbus","officers":[{"name":"Mr. Joseph B. Hayek","title":"President, CEO & Director"},{"name":"Mr. Colin J. Souza","title":"VP & CFO"},{"name":"Mr. Patrick J. Kennedy J.D.","title":"VP, General Counsel & Secretary"}]},"sector_medians":{"fpe":17.16,"tpe":24.82,"ps":2.022,"pfcf":25.93,"peg":1.39,"pb":3.436,"ev_ebitda":14.18,"rev_growth":0.118,"eps_growth":0.169,"eps_growth_fwd":0.1469,"eps_growth_next":0.1445,"div_yield":0.00735,"roe":0.1452,"roa":0.05723,"de":67.59,"gross_margin":0.3181,"op_margin":0.1266,"profit_margin":0.07114,"current_ratio":1.706},"valuation":[{"k":"fpe","label":"Forward P/E","v":14.52,"sector":17.16,"verdict":"Fairly valued"},{"k":"tpe","label":"TTM P/E","v":18.5,"sector":24.82,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":2.122,"sector":2.022,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":45.83,"sector":25.93,"verdict":"Overvalued"},{"k":"peg","label":"PEG","v":1.97,"sector":1.39,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":2.88,"sector":3.436,"verdict":"Fairly valued"},{"k":"de","label":"Debt / Equity (%)","v":33.19,"sector":67.59,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.132,"sector":0.118,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":0.243,"sector":0.169,"verdict":"Strong"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.1169,"s