hrough the contralateral ilium. The company markets its products primarily with a direct sales force, as well as through third-party sales agents and resellers. SI-BONE, Inc. was incorporated in 2008 and is headquartered in Santa Clara, California.","employees":376,"website":"https://si-bone.com","country":"United States","city":"Santa Clara","officers":[{"name":"Mr. Jeffrey W. Dunn","title":"Executive Chairman"},{"name":"Ms. Laura A. Francis MBA","title":"CEO & Director"},{"name":"Mr. Anshul  Maheshwari","title":"COO & CFO"}]},"sector_medians":{"fpe":19.11,"tpe":30.68,"ps":4.027,"pfcf":28.23,"peg":1.37,"pb":4.662,"ev_ebitda":16.89,"rev_growth":0.093,"eps_growth":0.155,"eps_growth_fwd":0.0901,"eps_growth_next":0.1182,"div_yield":0,"roe":0.02944,"roa":0.02544,"de":43.27,"gross_margin":0.5196,"op_margin":0.05279,"profit_margin":0,"current_ratio":2.981},"valuation":[{"k":"fpe","label":"Forward P/E","v":-1,"sector":19.11,"verdict":"Loss-making"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":30.68,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":4.912,"sector":4.027,"verdict":"Fairly valued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":28.23,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":null,"sector":1.37,"verdict":"—"},{"k":"pb","label":"Price / Book","v":5.854,"sector":4.662,"verdict":"Overvalued"},{"k":"de","label":"Debt / Equity (%)","v":23.18,"sector":43.27,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.145,"sector":0.093,"verdict":"Strong"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.155,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.2374,"sector":0.0901,"verdict":"Strong"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)","v":0.076,"sector":0.1182,"verdict":"Weak"},{"k":"gross_margin","label":"Gross margin","v":0.794,"sector":0.5196,"verdict":"Strong"},{"k":"op_margin","label":"Operating margin","v":-0.07811,"sector":0.05279,"verdict":"