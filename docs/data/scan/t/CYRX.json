ovides biological specimen cryopreservation storage and maintenance; archiving, monitoring, tracking, receipt, and delivery of samples; frozen biological specimens transportation; incoming and outgoing biological specimens management; and short-term logistics and engineering consulting services. The company was founded in 1999 and is based in Brentwood, Tennessee.","employees":684,"website":"https://www.cryoportinc.com","country":"United States","city":"Brentwood","officers":[{"name":"Mr. Jerrell W. Shelton","title":"Chairman, President & CEO"},{"name":"Mr. Robert S. Stefanovich MS","title":"Senior VP, CFO, Treasurer & Chief Administrative Officer"},{"name":"Mr. Edward J. Zecchini","title":"Senior VP and Chief Digital & Technology Officer"}]},"sector_medians":{"fpe":18.0,"tpe":25.61,"ps":2.127,"pfcf":27.19,"peg":1.4,"pb":3.62,"ev_ebitda":14.76,"rev_growth":0.119,"eps_growth":0.176,"eps_growth_fwd":0.1641,"eps_growth_next":0.1439,"div_yield":0.0071,"roe":0.1451,"roa":0.05694,"de":67.22,"gross_margin":0.3203,"op_margin":0.1163,"profit_margin":0.07298,"current_ratio":1.741},"valuation":[{"k":"fpe","label":"Forward P/E","v":-1,"sector":18.0,"verdict":"Loss-making"},{"k":"tpe","label":"TTM P/E","v":-1,"sector":25.61,"verdict":"Loss-making"},{"k":"ps","label":"Price / Sales","v":5.235,"sector":2.127,"verdict":"Overvalued"},{"k":"pfcf","label":"Price / FCF","v":-1,"sector":27.19,"verdict":"Negative FCF"},{"k":"peg","label":"PEG","v":null,"sector":1.4,"verdict":"—"},{"k":"pb","label":"Price / Book","v":2.316,"sector":3.62,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":47.88,"sector":67.22,"verdict":"Low debt"},{"k":"rev_growth","label":"Revenue growth","v":0.135,"sector":0.119,"verdict":"In line"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":null,"sector":0.176,"verdict":"—"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":-0.135,"sector":0.1641,"verdict":"Weak"},{"k":"eps_growth_next","label":"EPS growth (next year, est.)"