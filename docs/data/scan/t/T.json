ucts under the AT&T, AT&T Business, Cricket, AT&T PREPAID, AT&T Fiber, and AT&T Internet Air brand names. Its Latin America segment provides postpaid and prepaid wireless services in Mexico under the AT&T and Unefon brand names, as well as sells smartphones through its stores, agents and third-party retail stores. The company was formerly known as SBC Communications Inc. and changed its name to AT&T Inc. in 2005. AT&T Inc. was incorporated in 1983 and is based in Dallas, Texas.","employees":133030,"website":"https://www.att.com","country":"United States","city":"Dallas","officers":[{"name":"Mr. John T. Stankey","title":"CEO, President & Chairman"},{"name":"Mr. Pascal  Desroches CPA","title":"Senior EVP & CFO"},{"name":"Mr. Jeffery Scott McElfresh","title":"Chief Operating Officer"}]},"sector_medians":{"fpe":11.38,"tpe":18.59,"ps":2.135,"pfcf":12.53,"peg":0.98,"pb":2.224,"ev_ebitda":13.54,"rev_growth":0.0805,"eps_growth":0.028,"eps_growth_fwd":0.1467,"eps_growth_next":0.1456,"div_yield":0,"roe":0.0878,"roa":0.04007,"de":64.06,"gross_margin":0.5713,"op_margin":0.1332,"profit_margin":0.06819,"current_ratio":1.257},"valuation":[{"k":"fpe","label":"Forward P/E","v":8.263,"sector":11.38,"verdict":"Undervalued"},{"k":"tpe","label":"TTM P/E","v":11.46,"sector":18.59,"verdict":"Undervalued"},{"k":"ps","label":"Price / Sales","v":1.122,"sector":2.135,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":12.09,"sector":12.53,"verdict":"Fairly valued"},{"k":"peg","label":"PEG","v":1.24,"sector":0.98,"verdict":"Overvalued"},{"k":"pb","label":"Price / Book","v":1.359,"sector":2.224,"verdict":"Undervalued"},{"k":"de","label":"Debt / Equity (%)","v":144.8,"sector":64.06,"verdict":"High debt"},{"k":"rev_growth","label":"Revenue growth","v":0.053,"sector":0.0805,"verdict":"Weak"},{"k":"eps_growth","label":"EPS growth (last qtr, y/y)","v":-0.904,"sector":0.028,"verdict":"Weak"},{"k":"eps_growth_fwd","label":"EPS growth (this year, est.)","v":0.132,"sector":0.1467,"verdict":"I