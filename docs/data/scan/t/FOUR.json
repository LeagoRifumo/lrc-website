ools to manage product catalog, order fulfillment and inventory management, search engine optimization, and secure hosting; and Marketplace, which enables integrations into third-party applications, as well as loyalty and inventory management. In addition, the company offers merchant operations and support services, including underwriting, onboarding, and activation; training; risk management; and support services. Further, it provides software partner operations and support services, including software integrations and compliance management; partner support; and partner services. The company distributes its products through independent software vendors, internal sales and support networks, enterprises, and value-added resellers. Shift4 Payments, Inc. was founded in 1999 and is headquartered in Center Valley, Pennsylvania.","employees":6300,"website":"https://www.shift4.com","country":"United States","city":"Center Valley","officers":[{"name":"Mr. David Taylor Lauber","title":"Chairman of the Board, President & CEO"},{"name":"Mr. Christopher Nestor Cruz","title":"Chief Financial Officer"},{"name":"Mr. Jordan Ross Frankel","title":"Secretary, General Counsel and Executive VP Legal, Risk & Compliance"}]},"sector_medians":{"fpe":17.73,"tpe":31.01,"ps":4.582,"pfcf":26.55,"peg":1.16,"pb":4.831,"ev_ebitda":19.21,"rev_growth":0.1835,"eps_growth":0.3615,"eps_growth_fwd":0.2307,"eps_growth_next":0.1906,"div_yield":0,"roe":0.1245,"roa":0.04768,"de":32.58,"gross_margin":0.5372,"op_margin":0.1249,"profit_margin":0.09218,"current_ratio":1.81},"valuation":[{"k":"fpe","label":"Forward P/E","v":null,"sector":17.73,"verdict":"—"},{"k":"tpe","label":"TTM P/E","v":63.13,"sector":31.01,"verdict":"Overvalued"},{"k":"ps","label":"Price / Sales","v":0.6687,"sector":4.582,"verdict":"Undervalued"},{"k":"pfcf","label":"Price / FCF","v":9.046,"sector":26.55,"verdict":"Undervalued"},{"k":"peg","label":"PEG","v":0.28,"sector":1.16,"verdict":"Undervalued"},{"k":"pb","label":"Price / Book","v":5.